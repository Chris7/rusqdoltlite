#
# 23-March-2022
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_vtab1



bcv_mkdir testdir
bcv_create_container cont1
bcv_upload_new_db cont1 test.db {
  CREATE TABLE t1(x, y);
}

set cmd [bcvfs_create testdir "bcvfs"]
bcvfs_attach $cmd cont1

sqlite3 db /cont1/test.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  CREATE VIEW block AS 
    SELECT container, database, blockno, 
    CASE WHEN blockid IS NULL THEN 'null' ELSE 'ok' END AS blockid,
    cache, dirty FROM bcv_block;

  SELECT * FROM block;
} {
  cont1 test.db 0 ok 1 0
}

do_test 1.1 {
  execsql {
    WITH s(i) AS (
        SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<500
    )
    INSERT INTO t1 SELECT randomblob(400), randomblob(400) FROM s;
    PRAGMA wal_checkpoint;
  }
  execsql { SELECT * FROM block }
} [list {*}{
  cont1 test.db 0 ok 1 1 
  cont1 test.db 1 null 1 1 
  cont1 test.db 2 null 1 1 
  cont1 test.db 3 null 1 1
}]

do_execsql_test 1.2 {
  PRAGMA bcv_upload;
  SELECT * FROM block;
} {
  cont1 test.db 0 ok 1 0 
  cont1 test.db 1 ok 1 0 
  cont1 test.db 2 ok 1 0 
  cont1 test.db 3 ok 1 0
}

bcv_upload_new_db cont1 test.db2 {
  CREATE TABLE t1(x, y);
}
$cmd poll cont1

do_execsql_test 1.3 {
  PRAGMA bcv_upload;
  SELECT * FROM block;
} {
  cont1 test.db 0 ok 1 0 
  cont1 test.db 1 ok 1 0 
  cont1 test.db 2 ok 1 0 
  cont1 test.db 3 ok 1 0
  cont1 test.db2 0 ok 0 0
}

do_execsql_test 1.3 {
  PRAGMA bcv_upload;
  SELECT * FROM block;
} {
  cont1 test.db 0 ok 1 0 
  cont1 test.db 1 ok 1 0 
  cont1 test.db 2 ok 1 0 
  cont1 test.db 3 ok 1 0
  cont1 test.db2 0 ok 0 0
}

sqlite3 db2 /cont1/test.db2 -vfs bcvfs

do_execsql2_test 1.4 {
  ATTACH '/cont1/test.db' AS one;
  INSERT INTO t1 SELECT x, y FROM one.t1;
  PRAGMA bcv_upload;
}

do_execsql_test 1.3 {
  SELECT * FROM block;
} {
  cont1 test.db 0 ok 1 0 
  cont1 test.db 1 ok 1 0 
  cont1 test.db 2 ok 1 0 
  cont1 test.db 3 ok 1 0
  cont1 test.db2 0 ok 1 0 
  cont1 test.db2 1 ok 1 0 
  cont1 test.db2 2 ok 1 0 
  cont1 test.db2 3 ok 1 0
}

bcv_create_container cont2
bcv_upload_new_db cont2 abc.db {
  CREATE TABLE gold(silver, bronze);
}
bcvfs_attach $cmd cont2

do_execsql_test 1.4 {
  SELECT * FROM block;
} {
  cont2 abc.db 0 ok 0 0
  cont1 test.db 0 ok 1 0 
  cont1 test.db 1 ok 1 0 
  cont1 test.db 2 ok 1 0 
  cont1 test.db 3 ok 1 0
  cont1 test.db2 0 ok 1 0 
  cont1 test.db2 1 ok 1 0 
  cont1 test.db2 2 ok 1 0 
  cont1 test.db2 3 ok 1 0
}


db2 close
db close
$cmd destroy

finish_test

