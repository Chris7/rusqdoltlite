# 26-March-2023
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_file3

bcv_mkdir testdir
bcv_create_container cont1
bcv_upload_new_db cont1 t1.db {
  CREATE TABLE x1(x, y);
  INSERT INTO x1 VALUES('hello', 'world');
}

set cmd [bcvfs_create testdir bcvfs]
bcvfs_attach $cmd cont1
sqlite3 db /cont1/t1.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

#$cmd log http log_callback
proc log_callback {mask msg} { puts "$mask: $msg" }

do_execsql_test 1.1 {
  SELECT * FROM bcv_kv;
} {}

db eval { SELECT name, unixepoch(value) AS t FROM bcv_kv_meta } { 
  set D(1,$name) $t 
}
wait_ms 5000
db eval { SELECT name, unixepoch(value) AS t FROM bcv_kv_meta } { 
  set D(2,$name) $t 
}
wait_ms 5000
db eval { INSERT INTO bcv_kv values(1, 'hello'); }
db eval { SELECT name, unixepoch(value) AS t FROM bcv_kv_meta } { 
  set D(3,$name) $t 
}

do_test 1.2 {
  set v [expr $D(1,date) - $D(1,last-modified)]
  expr $v==0 || $v==1
} {1}

do_test 1.3 {
  set v [expr $D(2,date) - $D(1,date)]
  expr $v==5 || $v==6
} {1}

do_test 1.4 {
  expr {$D(2,last-modified)==$D(1,last-modified)}
} {1}

do_test 1.5 {
  set v [expr $D(3,date) - $D(3,last-modified)]
  expr $v==0 || $v==1
} {1}

do_test 1.6 {
  set v [expr $D(3,date) - $D(2,date)]
  expr $v==5 || $v==6
} {1}

db close
$cmd destroy

finish_test

