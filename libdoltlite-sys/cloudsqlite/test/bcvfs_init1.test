#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_init1


bcv_mkdir testdir
bcv_create_container cont1
bcv_upload_new_db cont1 x1.db {
  CREATE TABLE t1(a, b);
  INSERT INTO t1 VALUES(1, 2);
}

set cmd [bcvfs_create testdir "bcvfs"]
bcvfs_attach $cmd cont1
sqlite3 db /cont1/x1.db -vfs bcvfs

do_execsql_test 1.0 {
  INSERT INTO t1 VALUES(3, 4);
}

do_execsql_test 1.1 {
  PRAGMA wal_checkpoint;
} {0 1 1}

db close
$cmd destroy

set cmd [bcvfs_create testdir "bcvfs"]
sqlite3 db /cont1/x1.db -vfs bcvfs

do_execsql_test 1.2 {
  SELECT * FROM t1
} {1 2 3 4}

do_execsql_test 1.3 {
  PRAGMA bcv_upload;
}

db close
$cmd destroy

bcv_mkdir testdir
set cmd [bcvfs_create testdir "bcvfs"]
bcvfs_attach $cmd cont1
sqlite3 db /cont1/x1.db -vfs bcvfs

do_execsql_test 1.4 {
  SELECT * FROM t1
} {1 2 3 4}

db close
$cmd destroy

#-------------------------------------------------------------------------
bcv_mkdir testdir
bcv_create_container cont1
bcv_upload_new_db cont1 x1.db {
  CREATE TABLE t1(a, b);
  WITH s(i) AS (
    SELECT 1000 UNION ALL SELECT i-1 FROM s WHERE i>1
  )
  INSERT INTO t1 SELECT randomblob(700), randomblob(700) FROM s;
}

set cmd [bcvfs_create testdir "bcvfs"]
bcvfs_attach $cmd cont1
sqlite3 db /cont1/x1.db -vfs bcvfs
do_execsql_test 2.1 {
  UPDATE t1 SET b=randomblob(699);
}
db close
$cmd destroy

do_test 2.2 {
  sqlite3 dbX testdir/blocksdb.bcv
  dbX eval {
    UPDATE block SET container = 'cont2' WHERE cachefilepos=7
  }
  dbX close

  list [catch { bcvfs_create testdir "bcvfs" } msg] $msg
} {1 11}         ;# 11 == SQLITE_CORRUPT

do_test 2.3 {
  sqlite3 dbX testdir/blocksdb.bcv
  dbX eval {
    UPDATE block SET container = 'cont1' WHERE cachefilepos=7;
    UPDATE block SET db = 452 WHERE cachefilepos=7;
  }
  dbX close

  list [catch { bcvfs_create testdir "bcvfs" } msg] $msg
} {1 11}         ;# 11 == SQLITE_CORRUPT

do_test 2.4 {
  sqlite3 dbX testdir/blocksdb.bcv
  dbX eval {
    UPDATE block SET db = 1 WHERE cachefilepos=7;
  }
  dbX close
  set ::cmd [bcvfs_create testdir "bcvfs"]
  sqlite3 db /cont1/x1.db -vfs bcvfs
  db eval { PRAGMA integrity_check }
} {ok}

db close
$::cmd destroy



finish_test

