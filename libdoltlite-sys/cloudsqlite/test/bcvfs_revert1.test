#
# 19-June-2022
#
#-------------------------------------------------------------------------
#
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_revert1

bcv_create_container mycont
bcv_upload_new_db mycont x1.db {
  CREATE TABLE t1(x);
  INSERT INTO t1 VALUES(1), (4), (7);
}
bcv_upload_new_db mycont x2.db {
  CREATE TABLE t1(x);
  INSERT INTO t1 VALUES(2), (5), (8);
}
bcv_upload_new_db mycont x3.db {
  CREATE TABLE t1(x);
  INSERT INTO t1 VALUES(3), (6), (9);
}
bcv_upload_new_db mycont x4.db {
  CREATE TABLE t1(x);
}

bcv_mkdir testdir
set cmd [bcvfs_create testdir bcvfs]

bcvfs_attach $cmd mycont

sqlite3 db  /mycont/x1.db -vfs bcvfs
sqlite3 db2 /mycont/x3.db -vfs bcvfs

sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  INSERT INTO t1 VALUES('hello world');
  PRAGMA wal_checkpoint;
  SELECT * FROM t1;
} {0 1 1   1 4 7 {hello world}}

do_execsql2_test 1.1 {
  INSERT INTO t1 VALUES('world hello');
  SELECT * FROM t1;
} {3 6 9 {world hello}}

do_test 1.2 {
  $cmd copy mycont x2.db copy.db
  $cmd delete mycont x4.db
} {}

do_execsql_test 1.3 {
  SELECT * FROM bcv_database
} {
  mycont x1.db 1 1 1 1 {} 1 0 1
  mycont x2.db 1 0 0 0 {} 0 0 0 
  mycont x3.db 1 1 0 1 {} 1 0 0 
  mycont x4.db 0 0 0 0 deleted 0 0 0
  mycont copy.db 1 0 0 0 copied 0 0 0 
}

do_test 1.4 {
  $cmd revert mycont
} {}

sqlite3 db  /mycont/x1.db -vfs bcvfs
sqlite3 db2 /mycont/x3.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.5 {
  SELECT * FROM t1;
} {1 4 7}
do_execsql2_test 1.6 {
  SELECT * FROM t1;
} {3 6 9}
do_execsql_test 1.7 {
  SELECT * FROM bcv_database
} {
  mycont x1.db 1 1 0 0 {} 1 0 1
  mycont x2.db 1 0 0 0 {} 0 0 0
  mycont x3.db 1 1 0 0 {} 1 0 0
  mycont x4.db 1 0 0 0 {} 0 0 0
}

db close
db2 close
$cmd destroy

#-------------------------------------------------------------------------

bcv_create_container mycont
bcv_upload_new_db mycont x1.db {
  CREATE TABLE t1(x);
  INSERT INTO t1 VALUES(1), (4), (7);
}
bcv_upload_new_db mycont x2.db {
  CREATE TABLE t1(x);
  INSERT INTO t1 VALUES(2), (5), (8);
}
bcv_upload_new_db mycont x3.db {
  CREATE TABLE t1(x);
  INSERT INTO t1 VALUES(3), (6), (9);
}
bcv_mkdir testdir
set cmd [bcvfs_create testdir bcvfs]

bcvfs_attach $cmd mycont

do_test 2.0 {
  list [catch { $cmd revert nosuchcont} msg] $msg
} {1 {1 no such container: nosuchcont}}

do_test 2.1 {
  $cmd delete mycont x2.db
} {}

sqlite3 db  /mycont/x1.db -vfs bcvfs
do_execsql_test 2.2 {
  BEGIN;
    INSERT INTO t1 VALUES(10);
} {}

do_test 2.3 {
  list [catch { $cmd revert mycont} msg] $msg
} {1 {5 database is locked: x1.db}}

do_execsql_test 2.4 {
  COMMIT;
  BEGIN;
    SELECT * FROM t1
} {1 4 7 10}

do_test 2.5 {
  list [catch { $cmd revert mycont} msg] $msg
} {1 {5 database is locked: x1.db}}

do_execsql_test 2.6 {
  COMMIT;
} {}

do_test 2.7 {
  list [catch { $cmd revert mycont} msg] $msg
} {0 {}}

sqlite3_bcvfs_register_vtab db
do_execsql_test 2.8 {
  SELECT * FROM bcv_database
} {
  mycont x1.db 1 1 0 0 {} 1 0 1
  mycont x2.db 1 0 0 0 {} 0 0 0 
  mycont x3.db 1 0 0 0 {} 0 0 0
}

do_test 2.9 {
  $cmd copy mycont x2.db x4.db
  $cmd copy mycont x2.db x5.db
  $cmd delete mycont x4.db
} {}

do_execsql_test 2.10 {
  SELECT * FROM bcv_database
} {
  mycont x1.db 1 1 0 0 {} 1 0 1
  mycont x2.db 1 0 0 0 {} 0 0 0
  mycont x3.db 1 0 0 0 {} 0 0  0
  mycont x4.db 0 0 0 0 deleted 0 0 0
  mycont x5.db 1 0 0 0 copied 0 0 0
}

do_test 2.11 {
  list [catch { $cmd revert mycont} msg] $msg
} {0 {}}

do_execsql_test 2.12 {
  SELECT * FROM bcv_database
} {
  mycont x1.db 1 1 0 0 {} 1 0 1
  mycont x2.db 1 0 0 0 {} 0 0 0
  mycont x3.db 1 0 0 0 {} 0 0 0
}

db close
sqlite3 db  / -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_test 2.13 {
   $cmd delete mycont x3.db
   $cmd delete mycont x2.db
   $cmd delete mycont x1.db
} {}

do_execsql_test 2.14 {
  SELECT * FROM bcv_database
} {
  mycont x1.db 0 0 0 0 deleted 0 0 0
  mycont x2.db 0 0 0 0 deleted 0 0 0
  mycont x3.db 0 0 0 0 deleted 0 0 0
}

db close
$cmd destroy

finish_test

