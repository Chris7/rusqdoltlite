#
# 19-July-2020
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_vacuum3

if {$C(namebytes)<24} {
  finish_test
  return
}

#-------------------------------------------------------------------------
#
bcv_mkdir testdir
bcv_create_container cont1

bcv_upload_new_db cont1 t1.db {
  CREATE TABLE x1(x, y);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO x1 SELECT randomblob(400), randomblob(400) FROM s;
}

set cmd [bcvfs_create testdir bcvfs]
bcvfs_attach $cmd cont1
set bcv [bcv_open cont1]

sqlite3 db /cont1/t1.db -vfs bcvfs -uri 1
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  PRAGMA integrity_check;
  SELECT container, database, nblock, ncache, 0 FROM bcv_database
} {
  ok
  cont1 t1.db 7 7 0
}


do_test 1.1.1 {
  bcv_copy_database -container cont1 t1.db t2.db
} {}
$cmd poll cont1
do_execsql_test 1.1.2 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 0
  cont1 t2.db 7 7 0
}
do_test 1.1.3 {
  execsql {
    VACUUM;
    PRAGMA wal_checkpoint;
  }
} {0 202 202}
do_execsql_test 1.1.4 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 7
  cont1 t2.db 7 0 0
}
$cmd upload cont1
do_execsql_test 1.1.5 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 0
  cont1 t2.db 7 6 0
}

do_test 1.2.1 {
  bcv_copy_database -container cont1 t1.db t3.db
} {}
$cmd poll cont1
do_execsql_test 1.2.2 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 0
  cont1 t2.db 7 6 0
  cont1 t3.db 7 7 0
}
do_test 1.2.3 {
  execsql {
    VACUUM;
    PRAGMA wal_checkpoint;
  }
} {0 202 202}
do_execsql_test 1.2.4 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 7
  cont1 t2.db 7 0 0
  cont1 t3.db 7 0 0
}
$cmd upload cont1
do_execsql_test 1.2.5 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 0
  cont1 t2.db 7 6 0
  cont1 t3.db 7 6 0
}


do_test 1.3.1 {
  bcv_copy_database -container cont1 t1.db t4.db
} {}
$cmd poll cont1
do_execsql_test 1.3.2 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 0
  cont1 t2.db 7 6 0
  cont1 t3.db 7 6 0
  cont1 t4.db 7 7 0
}
do_test 1.3.3 {
  execsql {
    VACUUM;
    PRAGMA wal_checkpoint;
  }
} {0 202 202}
do_execsql_test 1.3.4 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 7
  cont1 t2.db 7 0 0
  cont1 t3.db 7 0 0
  cont1 t4.db 7 0 0
}
$cmd config nrequest 2
$cmd upload cont1
do_execsql_test 1.3.5 {
  SELECT container, database, nblock, ncache, ndirty FROM bcv_database
} {
  cont1 t1.db 7 7 0
  cont1 t2.db 7 6 0
  cont1 t3.db 7 6 0
  cont1 t4.db 7 6 0
}


db close
$cmd destroy
$bcv close

finish_test

