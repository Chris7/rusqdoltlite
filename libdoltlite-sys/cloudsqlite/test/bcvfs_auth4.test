#
# 19-July-2020
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_customuri1

if {[info exists ::C(sas_cmd)]==0 || $::C(sas_cmd)!="make_azure_sas"} {
  finish_test
  return
}

bcv_install_vfs_wrapper

#set conturi http://127.0.0.1:10000/devstoreaccount1/uricontainer
set conturi 127.0.0.1:10000/devstoreaccount1

bcv_create_container uricontainer
bcv_upload_new_db uricontainer test1.db {
  CREATE TABLE u1(x,y);
  INSERT INTO u1 VALUES('890', '444');
  CREATE TABLE v1(x,y);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO v1 SELECT randomblob(500), randomblob(500) FROM s;
  CREATE TABLE w1(x,y);
  INSERT INTO w1 VALUES('555', '231');
}

bcv_mkdir testdir
set cmd [bcvfs_create testdir "bcvfs"]
$cmd auth_callback local_auth_callback

set ::auth_count 0
proc local_auth_callback {zStorage zAccount zContainer} {
puts $zAccount
  set ::auth_account $zAccount
  incr ::auth_count
  make_sas uricontainer 2
}

bcvfs_attach -module azure?sas=1&customuri=1 -user $conturi $cmd uricontainer

do_test 1.0 {
  list $::auth_count $::auth_account
} [list 1 $conturi]

sqlite3 db /uricontainer/test1.db -vfs bcvfs
do_execsql_test 1.1 {
  SELECT * FROM u1
} {890 444}

wait_ms 3000

do_execsql_test 1.2 {
  SELECT * FROM w1
} {555 231}

do_test 1.3 {
  list $::auth_count $::auth_account
} [list 2 $conturi]

wait_ms 3000

do_test 1.4 {
  $cmd poll uricontainer
} {}

do_test 1.5 {
  list $::auth_count $::auth_account
} [list 3 $conturi]

db close
$cmd destroy

finish_test

