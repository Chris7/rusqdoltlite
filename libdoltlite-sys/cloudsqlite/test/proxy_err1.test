#
# 06-August-2022
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix proxy_err1

# This test is designed to run with the proxy.tcl/azurite combination 
# only. Print an error message and exit if it cannot be found.
if {[catch bcv_proxy_test msg]} { puts $msg ; exit }


# Configure the proxy to pass everything straight through.
#
bcv_proxy_config {
  DELETE FROM new_client_message;
}

# Initialize a new system
start_new_daemon 0 
set cmd [bcvfs_create testdir.0 "bcvfs"]
# $cmd config httptimeout 3

bcv_create_container cont1
bcv_upload_new_db cont1 t1.db {
  CREATE TABLE x1(x INTEGER PRIMARY KEY, y);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO x1 SELECT i, hex(randomblob(500)) FROM s;
}

bcvfs_attach $cmd cont1
sqlite3 db /cont1/t1.db -vfs bcvfs

do_execsql_test 1.0 {
  BEGIN;
    SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE x1(x INTEGER PRIMARY KEY, y)}
}

bcv_proxy_config {
  INSERT INTO new_client_message(pattern, action) 
    VALUES ('GET%', 'error 1 {SSL connection error}');
}

do_catchsql_test 1.1 {
    SELECT * FROM x1
} {1 {SQL logic error}}

do_catchsql_test 1.2 {
  SELECT * FROM x1
} {1 {SQL logic error}}

wait_ms 10

#-------------------------------------------------------------------------

bcv_proxy_config {
  DELETE FROM new_client_message;
}

bcv_upload_new_db cont1 t2.db {
  CREATE TABLE x1(x INTEGER PRIMARY KEY, y);
  CREATE TABLE x2(x INTEGER PRIMARY KEY, y);
  CREATE TABLE x3(x INTEGER PRIMARY KEY, y);

  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO x1 SELECT i, hex(randomblob(500)) FROM s;
  INSERT INTO x2 SELECT x, hex(randomblob(500)) FROM x1;
  INSERT INTO x3 SELECT x, hex(randomblob(500)) FROM x1;
}

$cmd poll cont1
sqlite3 db2 /cont1/t2.db -vfs bcvfs
db close
sqlite3 db /cont1/t2.db -vfs bcvfs
db2 close

do_execsql_test 2.0 {
  PRAGMA cache_size = 10;
  BEGIN;
    SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE x1(x INTEGER PRIMARY KEY, y)}
  {CREATE TABLE x2(x INTEGER PRIMARY KEY, y)}
  {CREATE TABLE x3(x INTEGER PRIMARY KEY, y)}
}

do_execsql_test 2.1 {
  SELECT count(y) FROM x3
} {1000}

bcv_proxy_config {
  INSERT INTO new_client_message(pattern, action) 
    VALUES ('GET%', 'error 1 {SSL connection error}');
}

breakpoint
do_catchsql_test 2.2.1 {
  SELECT count(y) FROM x1
} {1 {SQL logic error}}
do_catchsql_test 2.2.2 {
  SELECT count(y) FROM x1
} {1 {SQL logic error}}

do_execsql_test 2.3 {
  SELECT count(y) FROM x3
} {1000}

bcv_proxy_config {
  DELETE FROM new_client_message;
}

do_execsql_test 2.4 {
  SELECT count(y) FROM x1
} {1000}

wait_ms 10

db close
$cmd destroy

finish_test

