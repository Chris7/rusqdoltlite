#
# 25-Feb-2022
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix dmn_secure1

bcv_create_container cont1
bcv_upload_new_db cont1 t1.db {
  CREATE TABLE t1(a, b);
  INSERT INTO t1 VALUES('fox', 'guard');
}

start_new_daemon 0 
set cmd [bcvfs_create testdir.0 "bcvfs"]
bcvfs_attach -secure $cmd cont1

sqlite3 db /cont1/t1.db -vfs bcvfs

do_execsql_test 1.0 {
  SELECT * FROM t1
} {fox guard}

bcv_upload_new_db cont1 t2.db {
  CREATE TABLE t2(a, b);
  CREATE INDEX i1 ON t2(a);
  CREATE INDEX i2 ON t2(b);

  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO t2 SELECT randomblob(400), randomblob(401) FROM s;
}

$cmd poll cont1

sqlite3 db2 /cont1/t2.db -vfs bcvfs

do_execsql2_test 1.1 {
  PRAGMA integrity_check
} {ok}

db2 close
db close
$cmd destroy
wait_daemon 0

start_daemon 0 
set cmd [bcvfs_create testdir.0 "bcvfs"]
sqlite3 db / -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.2 {
  SELECT * FROM bcv_container;
}

bcvfs_attach -secure $cmd cont1
sqlite3 db2 /cont1/t1.db -vfs bcvfs
do_execsql2_test 1.3 {
  SELECT * FROM t1
} {fox guard}

bcvfs_attach -alias c1 $cmd cont1 
db2 close
sqlite3 db2 /c1/t1.db -vfs bcvfs
do_execsql2_test 1.4 {
  SELECT * FROM t1
} {fox guard}

db close
db2 close
$cmd destroy
wait_daemon 0

start_daemon 0 
set cmd [bcvfs_create testdir.0 "bcvfs"]
sqlite3 db / -vfs bcvfs
sqlite3_bcvfs_register_vtab db
do_execsql_test 1.5 {
  SELECT name, container FROM bcv_container;
} {c1 cont1}

db close
$cmd destroy
wait_daemon 0

finish_test

