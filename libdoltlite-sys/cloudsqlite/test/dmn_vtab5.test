#
# 26-August-2025
#
#-------------------------------------------------------------------------
#
# Tests for the bcv_stat table in daemon mode.
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix dmn_vtab5.test

bcv_create_container cont1
bcv_upload_new_db cont1 test.db {
  CREATE TABLE t1(x INTEGER PRIMARY KEY, y);
  BEGIN;
  WITH s(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<10000 )
  INSERT INTO t1(y) SELECT hex(randomblob(500)) FROM s;
  COMMIT;
}

bcv_upload_new_db cont1 test.db2 {
  CREATE TABLE t1(x INTEGER PRIMARY KEY, y);
  BEGIN;
  WITH s(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<8000 )
  INSERT INTO t1(y) SELECT hex(randomblob(500)) FROM s;
  COMMIT;
}

set ARRAY_SIZE 632

start_new_daemon 0
set cmd [bcvfs_create testdir.0 "bcvfs"]
bcvfs_attach $cmd cont1

sqlite3 db /cont1/test.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  SELECT count(*) FROM t1
} {10000}

do_execsql_test 1.1 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array $ARRAY_SIZE]

sqlite3 db2 /cont1/test.db -vfs bcvfs
do_execsql2_test 1.2 {
  SELECT count(*) FROM t1
} {10000}

do_execsql_test 1.3 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array $ARRAY_SIZE]

do_execsql2_test 1.4 {
  BEGIN;
    SELECT count(*) FROM t1;
} {10000}

do_execsql_test 1.5 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array [expr $ARRAY_SIZE*2]]

bcv_upload_new_db cont1 test.db3 {
  CREATE TABLE t1(x INTEGER PRIMARY KEY, y);
  BEGIN;
  WITH s(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<10000 )
  INSERT INTO t1(y) SELECT hex(randomblob(500)) FROM s;
  COMMIT;
}

$cmd poll cont1

do_execsql_test 1.6 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array [expr $ARRAY_SIZE*2]]

do_execsql2_test 1.7 { COMMIT }

sqlite3 db3 /cont1/test.db -vfs bcvfs

do_execsql2_test 1.8 { BEGIN; SELECT count(*) FROM t1; } {10000}
do_execsql3_test 1.9 { BEGIN; SELECT count(*) FROM t1; } {10000}

do_execsql_test 1.10 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array [expr $ARRAY_SIZE*3]]

bcv_upload_new_db cont1 test.db4 {
  CREATE TABLE t1(x INTEGER PRIMARY KEY, y);
  BEGIN;
  WITH s(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<10000 )
  INSERT INTO t1(y) SELECT hex(randomblob(500)) FROM s;
  COMMIT;
}

$cmd poll cont1

do_execsql_test 1.11 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array [expr $ARRAY_SIZE*3]]

do_execsql2_test 1.12 {
  COMMIT;
} 
do_execsql_test 1.13 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array [expr $ARRAY_SIZE*2]]

do_execsql3_test 1.14 {
  COMMIT;
} 

do_execsql_test 1.15 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array $ARRAY_SIZE]

do_execsql_test 1.16 { BEGIN; SELECT count(*) FROM t1; } {10000}

bcv_mkdir testdir1
set local [bcvfs_create testdir1 "local"]
bcvfs_attach $local cont1
sqlite3 db4 /cont1/test.db -vfs local
db4 eval { 
  INSERT INTO t1 DEFAULT VALUES;
  PRAGMA bcv_upload;
}
db4 close
$local destroy

do_execsql_test 1.17 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest 0 memory_client_array $ARRAY_SIZE]

$cmd poll cont1

set nbyte [expr 1616 + $::C(namebytes) * 300]
do_execsql_test 1.18 {
  SELECT * FROM bcv_stat WHERE name LIKE 'memory_client%'
} [list memory_client_manifest $nbyte memory_client_array $ARRAY_SIZE]

do_execsql_test 1.19 { SELECT count(*) FROM t1; END } {10000}
do_execsql_test 1.20 { SELECT count(*) FROM t1 } {10001}

db close
db2 close
db3 close
$cmd destroy
wait_daemon 0

finish_test


