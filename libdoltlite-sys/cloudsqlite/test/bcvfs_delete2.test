#
# 19-July-2020
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_delete2

# Test that the VFS uses existing blocks if possible.
set CNAME cont1
bcv_create_container $CNAME

bcv_upload_empty_database $CNAME a.db
bcv_upload_empty_database $CNAME b.db
bcv_upload_empty_database $CNAME c.db
bcv_upload_empty_database $CNAME d.db

bcv_mkdir testdir
set bcvfs [bcvfs_create testdir bcvfs]

bcvfs_attach $bcvfs $CNAME
sqlite3 db /$CNAME -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 a.db {}
  cont1 b.db {}
  cont1 c.db {}
  cont1 d.db {}
}

do_test 1.1 {
  $bcvfs delete cont1 c.db
} {}

do_execsql_test 1.2 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 a.db {}
  cont1 b.db {}
  cont1 c.db deleted
  cont1 d.db {}
}

do_catch_test 1.3 {
  sqlite3 db2 /cont1/c.db -vfs bcvfs
} {1 {unable to open database file}}

do_test 1.4 {
  $bcvfs upload cont1 
} {}

do_catch_test 1.5 {
  sqlite3 db2 /cont1/c.db -vfs bcvfs
} {1 {unable to open database file}}

do_execsql_test 1.6 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 a.db {}
  cont1 b.db {}
  cont1 d.db {}
}

bcv_mkdir testdir2
set bcvfs2 [bcvfs_create testdir2 bcvfs2]
bcvfs_attach $bcvfs2 $CNAME
sqlite3 db2 /$CNAME/d.db -vfs bcvfs2
sqlite3_bcvfs_register_vtab db2

do_execsql2_test 1.7 {
  CREATE TABLE xyz(x,y,z);
  INSERT INTO xyz VALUES('ex', 'why', 'zed');
  PRAGMA bcv_upload;
} {}

db2 close

do_test 1.8 {
  $bcvfs delete cont1 d.db
} {}
do_test 1.9 {
  set rc [catch {$bcvfs upload cont1} msg] 
  list $rc [lrange $msg 0 2]
} {1 {412 HTTP/1.1 412}}

do_catch_test 1.10 {
  $bcvfs poll cont1
} {1 {cannot update manifest - write collision on database d.db}}

do_execsql_test 1.11 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 a.db {}
  cont1 b.db {}
  cont1 d.db deleted
}

do_test 1.12 {
  $bcvfs2 delete cont1 d.db
  $bcvfs2 upload cont1
} {}

$bcvfs2 destroy

do_catch_test 1.13 {
  $bcvfs poll cont1
} {0 {}}

do_execsql_test 1.14 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 a.db {}
  cont1 b.db {}
}

$bcvfs delete cont1 a.db
do_execsql_test 1.15 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 a.db deleted
  cont1 b.db {}
}

db close
$bcvfs destroy

set bcvfs [bcvfs_create testdir bcvfs]
sqlite3 db /$CNAME -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.16 {
  SELECT container, database, state FROM bcv_database
} {
  cont1 a.db deleted
  cont1 b.db {}
}

$bcvfs upload cont1
do_execsql_test 1.16 {
  SELECT container, database, state FROM bcv_database
} {
  cont1 b.db {}
}

$bcvfs copy cont1 b.db x.db
$bcvfs delete cont1 b.db
do_execsql_test 1.17 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 b.db deleted
  cont1 x.db copied
}

$bcvfs upload cont1

do_execsql_test 1.18 {
  SELECT container, database, state FROM bcv_database
} { 
  cont1 x.db {}
}

db close
$bcvfs destroy

#-------------------------------------------------------------------------
# Check that it is not possible to delete a database while it is open
# by one or more clients.
#
bcv_create_container cont5

bcv_upload_new_db cont5 1.db {
  CREATE TABLE y1(x);
  INSERT INTO y1 VALUES(1);
}
bcv_upload_new_db cont5 2.db {
  CREATE TABLE x2(w);
  INSERT INTO x2 VALUES(2);
}
bcv_upload_new_db cont5 3.db {
  CREATE TABLE w3(v);
  INSERT INTO w3 VALUES(3);
}

bcv_mkdir testdir
set bcvfs [bcvfs_create testdir bcvfs]

bcvfs_attach $bcvfs cont5
sqlite3 db /cont5/2.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 2.0 {
  SELECT * FROM x2
} 2

do_catch_test 2.1 {
  $bcvfs delete cont5 2.db
} {1 {5 database is locked}}

do_execsql_test 2.2 {
  SELECT container, database, state FROM bcv_database
} { 
  cont5 1.db {}
  cont5 2.db {}
  cont5 3.db {}
}

db close
$bcvfs destroy

#-------------------------------------------------------------------------
# Deleting a dirty database.
#
bcv_create_container cont5
bcv_upload_new_db cont5 a.db {
  CREATE TABLE t1(x, y);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO t1 SELECT randomblob(400), randomblob(400) FROM s;
}
bcv_upload_new_db cont5 b.db {
  CREATE TABLE t1(x, y);
  INSERT INTO t1 VALUES('hello', 'world');
}

bcv_mkdir testdir
set bcvfs [bcvfs_create testdir bcvfs]
bcvfs_attach $bcvfs cont5
sqlite3 db /cont5/a.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 3.0 {
  SELECT * FROM bcv_database
} {
  cont5 a.db 7 1 0 0 {} 1 0 1
  cont5 b.db 1 0 0 0 {} 0 0 0
}

do_execsql_test 3.1 {
  UPDATE t1 SET y=1 WHERE rowid IN (100, 500, 900);
  PRAGMA wal_checkpoint = truncate;
} {0 0 0}

do_execsql_test 3.2 {
  SELECT * FROM bcv_database
} {
  cont5 a.db 7 3 3 0 {} 1 0 1
  cont5 b.db 1 0 0 0 {} 0 0 0
}

db close
$bcvfs delete cont5 a.db
$bcvfs upload cont5
sqlite3 db /cont5/b.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 3.3 {
  SELECT * FROM t1
} {
  hello world
}

do_execsql_test 3.2 {
  SELECT * FROM bcv_database
} {
  cont5 b.db 1 1 0 0 {} 1 0 1
}


db close
$bcvfs destroy

finish_test

