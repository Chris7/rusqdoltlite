#
# 30-March-2022
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_copy3

bcv_create_container cont1
bcv_upload_new_db cont1 t1.db {
  CREATE TABLE x1(x, y);
  INSERT INTO x1 VALUES('hello', 'world');
  INSERT INTO x1 VALUES('one', 'two');
}

bcv_mkdir testdir
set cmd [bcvfs_create testdir bcvfs]
bcvfs_attach $cmd cont1
sqlite3 db /cont1/t1.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  SELECT * FROM x1
} {hello world one two}
do_test 1.1 {
  $cmd copy cont1 t1.db t2.db
} {}
sqlite3 db2 /cont1/t2.db -vfs bcvfs
do_execsql2_test 1.1 {
  INSERT INTO x1 VALUES('a', 'b');
}

$cmd upload cont1

do_execsql2_test 1.2 {
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO x1 SELECT randomblob(400), randomblob(400) FROM s;
}

$cmd upload cont1

do_test 1.3 {
  $cmd copy cont1 t2.db t3.db
  sqlite3 db3 /cont1/t3.db -vfs bcvfs
} {}

do_execsql3_test 1.4 {
  UPDATE x1 SET y=1 WHERE rowid=500;
}

$cmd upload cont1

db3 close
db2 close
db close
$cmd destroy

#-------------------------------------------------------------------------

bcv_create_container cont4
bcv_upload_new_db cont4 t1.db {
  CREATE TABLE x1(x, y);
  INSERT INTO x1 VALUES('hello', 'world');
}
bcv_upload_new_db cont4 t2.db {
  CREATE TABLE x2(x, y);
  INSERT INTO x2 VALUES('hello', 'world');
}
bcv_upload_new_db cont4 t3.db {
  CREATE TABLE x3(x, y);
  INSERT INTO x3 VALUES('hello', 'world');
}

bcv_mkdir testdir
set cmd [bcvfs_create testdir bcvfs]
bcvfs_attach $cmd cont4

do_test 2.0 {
  $cmd delete cont4 t2.db
} {}

do_catch_test 2.1 {
  $cmd copy cont4 t2.db t4.db
} {1 {1 no such database: t2.db}}

do_catch_test 2.4 {
  $cmd delete cont4 t2.db
} {1 {1 no such database: t2.db}}

$cmd destroy
set cmd [bcvfs_create testdir bcvfs]

$cmd destroy

finish_test

