#
# 19-July-2020
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_vacuum1


#-------------------------------------------------------------------------
#
bcv_mkdir testdir
bcv_create_container cont1

bcv_upload_new_db cont1 t1.db {
  CREATE TABLE x1(x, y);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO x1 SELECT randomblob(400), randomblob(400) FROM s;
}

set cmd [bcvfs_create testdir bcvfs]
bcvfs_attach $cmd cont1
set bcv [bcv_open cont1]

sqlite3 db /cont1/t1.db -vfs bcvfs -uri 1
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  PRAGMA integrity_check;
  SELECT container, database, nblock, ncache, 0 FROM bcv_database
} {
  ok
  cont1 t1.db 7 7 0
}

do_test 1.1 { $bcv cleanup 0 } {0}
set nFilename [expr $::C(namebytes)*2 + 4]
do_execsql_test 1.2 {
  SELECT count(*) FROM bcv_tfs WHERE length(name)==$nFilename;
} {
  7
}

$cmd poll cont1
do_execsql_test 1.3 {
  DELETE FROM x1 WHERE rowid>10;
  VACUUM;
  PRAGMA bcv_upload;
  SELECT container, database, nblock, ncache, 0 FROM bcv_database
} {
  cont1 t1.db 1 1 0
}

do_execsql_test 1.4 {
  SELECT count(*) FROM bcv_tfs WHERE length(name)==$nFilename;
} {
  8
}

do_test 1.5 { $bcv cleanup 0 } {0}
do_execsql_test 1.2 {
  SELECT count(*) FROM bcv_tfs WHERE length(name)==$nFilename;
} {
  1
}

file delete -force x.db
do_execsql_test 1.6 {
  VACUUM INTO 'file:x.db?vfs=unix'
}

db close
$cmd destroy
$bcv close

finish_test

