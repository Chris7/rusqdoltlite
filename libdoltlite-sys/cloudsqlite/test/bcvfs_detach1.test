source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_detach1

bcv_create_container mycont
bcv_upload_new_db mycont xyz.db {
  CREATE TABLE t1(x);
}

bcv_mkdir testdir
set cmd [bcvfs_create testdir bcvfs]
bcvfs_attach -alias c2 $cmd mycont

do_test 1.0 {
  bcvfs_attach $cmd mycont
  bcvfs_attach -alias c3 $cmd mycont
  sqlite3 db /mycont/xyz.db -vfs bcvfs
  set {} {}
} {}

do_test 1.1 {
  list [catch { $::cmd detach nosuchcont } msg] $msg
} {1 {rc=1: no such container: nosuchcont}}

do_test 1.2 {
  list [catch { $::cmd detach mycont } msg] $msg
} {1 {rc=5: container is still in use: mycont}}

do_execsql_test 1.3 {
  INSERT INTO t1 VALUES('hello world');
}

do_test 1.2 {
  db close
  list [catch { $::cmd detach mycont } msg] $msg
} {1 {rc=5: container has local changes: mycont}}

sqlite3 db /mycont/xyz.db -vfs bcvfs
do_execsql_test 1.3 {
  PRAGMA bcv_upload;
  INSERT INTO t1 VALUES('hello world');
}

do_test 1.4 {
  db config no_ckpt_on_close 1
  breakpoint
  db close
  list [catch { $::cmd detach mycont } msg] $msg
} {1 {rc=5: container has local changes: mycont}}

sqlite3 db /mycont/xyz.db -vfs bcvfs
do_test 1.5 {
  execsql { PRAGMA bcv_upload }
  db close
  list [catch { $::cmd detach mycont } msg] $msg
} {0 {}}

# db close
$cmd destroy

finish_test

