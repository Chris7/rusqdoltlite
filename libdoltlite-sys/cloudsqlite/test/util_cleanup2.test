#
# 19-July-2020
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix util_cleanup2

bcv_mkdir testdir

# Create new container. Ensure there are no old blob files within 
# cloud storage.
#
bcv_create_container cont1
set bcv [bcv_open cont1]
$bcv cleanup 0
$bcv close

bcv_upload_new_db cont1 test.db {
  CREATE TABLE t1(x, y);
  WITH s(i) AS (
    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO t1 SELECT hex(randomblob(1000)), hex(randomblob(1000)) FROM s;
}

set cmd [bcvfs_create testdir "bcvfs"]
bcvfs_attach $cmd cont1

sqlite3 db /cont1/test.db -vfs bcvfs
sqlite3_bcvfs_register_vtab db

do_execsql_test 1.0 {
  SELECT name, ncleanup FROM bcv_container
} {cont1 0}

do_execsql_test 1.1 {
  SELECT container, database, nblock, ndirty FROM bcv_database
} {cont1 test.db 32 0}

do_execsql_test 1.2 {
  UPDATE t1 SET x = hex(randomblob(1000));
}

do_execsql_test 1.3 {
  SELECT container, database, nblock, ndirty FROM bcv_database
} {cont1 test.db 32 32}

$cmd upload cont1

do_execsql_test 1.4 {
  SELECT container, database, nblock, ndirty FROM bcv_database
} {cont1 test.db 32 0}

do_execsql_test 1.5 {
  SELECT name, ncleanup FROM bcv_container
} {cont1 32}

set ::progress_handler [list]
proc bcv_progress_handler {args} {
  lappend ::progress_handler $args
  return 0
}

do_test 1.6 {
  set bcv [bcv_open cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
  $bcv close
} {}

$cmd poll cont1
do_execsql_test 1.7 {
  SELECT name, ncleanup FROM bcv_container
} {cont1 0}

do_test 1.8 {
  set ::progress_handler
} [list {*}{
  {1 32} {2 32} {3 32} {4 32} {5 32} {6 32} {7 32} {8 32} 
  {9 32} {10 32} {11 32} {12 32} {13 32} {14 32} {15 32} {16 32} 
  {17 32} {18 32} {19 32} {20 32} {21 32} {22 32} {23 32} {24 32} 
  {25 32} {26 32} {27 32} {28 32} {29 32} {30 32} {31 32} {32 32}
}]

do_execsql_test 1.9 {
  UPDATE t1 SET x = hex(randomblob(1000));
}
$cmd upload cont1

set ::progress_handler [list]
proc bcv_progress_handler {nDone nTotal} {
  lappend ::progress_handler [list $nDone $nTotal]
  if {$nDone==16} { return 101 }
  return 0
}

do_test 1.10 {
  set bcv [bcv_open cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
  $bcv close
} {}

$cmd poll cont1
do_execsql_test 1.11 {
  SELECT name, ncleanup FROM bcv_container
} {cont1 16}

set ::progress_handler [list]
proc bcv_progress_handler {nDone nTotal} {
  lappend ::progress_handler [list $nDone $nTotal]
  if {$nDone==8} { return 1 }
  return 0
}

do_test 1.12 {
  set bcv [bcv_open cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {4}
$bcv close

$cmd poll cont1
do_execsql_test 1.13 {
  SELECT name, ncleanup FROM bcv_container
} {cont1 16}

set ::progress_handler [list]
proc bcv_progress_handler {nDone nTotal} {
  lappend ::progress_handler [list $nDone $nTotal]
  return 0
}
do_test 1.14 {
  set bcv [bcv_open cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {0}
$bcv close
do_test 1.15 {
  llength $::progress_handler 
} {16}

set ::progress_handler [list]
do_test 1.16 {
  set bcv [bcv_open cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {0}
$bcv close
do_test 1.17 {
  llength $::progress_handler 
} {0}

set ::progress_handler [list]
do_test 1.18 {
  set bcv [bcv_open -module $C(module)&maxresults=1 cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {0}
$bcv close
do_test 1.19 {
  expr [llength $::progress_handler]>=34
} {1}

proc bcv_progress_handler {nDone nTotal} {
  lappend ::progress_handler [list $nDone $nTotal]
  if {[llength $::progress_handler]==12} { return 1 }
  return 0
}
set ::progress_handler [list]
do_test 1.20 {
  set bcv [bcv_open -module $C(module)&maxresults=1 cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {4}
$bcv close

wait_ms 1000

proc bcv_progress_handler {nDone nTotal} {
  lappend ::progress_handler [list $nDone $nTotal]
  if {[llength $::progress_handler]==12} { return 101 }
  return 0
}
set ::progress_handler [list]
do_test 1.21 {
  set bcv [bcv_open -module $C(module)&maxresults=1 cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {0}
$bcv close

#-------------------------------------------------------------------------
# Run a full cleanup on the container.
#
do_test 2.0 {
  set bcv [bcv_open -module $C(module)&maxresults=1 cont1]
  $bcv cleanup 0
} {0}
$bcv close

proc bcv_progress_handler {nDone nTotal} {
  incr ::nProgressHandler 
  return 0
}
do_test 2.1.1 {
  set ::nProgressHandler 0
  set bcv [bcv_open -module $C(module)&maxresults=1 cont1]
  $bcv config progress bcv_progress_handler
  $bcv cleanup 0
} {0}
$bcv close
do_test 2.1.2 {
  expr {$::nProgressHandler > 0}
} 1
proc bcv_progress_handler {nDone nTotal} {
puts "PH: $nDone $nTotal"
  incr ::nProgressHandler 
  return 0
}
do_test 2.2.1 {
  set ::nProgressHandler 0
  set bcv [bcv_open -module $C(module)&maxresults=1 cont1]
  $bcv config progress bcv_progress_handler
  $bcv config find_orphans 0
  $bcv cleanup 0
} {0}
$bcv close
do_test 2.1.2 {
  expr {$::nProgressHandler > 0}
} 0



db close
$cmd destroy
finish_test

