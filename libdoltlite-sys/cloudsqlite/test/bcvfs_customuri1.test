#
# 19-July-2020
#
#-------------------------------------------------------------------------
#

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_customuri1

if {[info exists ::C(sas_cmd)]==0 || $::C(sas_cmd)!="make_azure_sas"} {
  finish_test
  return
}

bcv_install_vfs_wrapper

#set conturi http://127.0.0.1:10000/devstoreaccount1/uricontainer
set conturi 127.0.0.1:10000/devstoreaccount1

bcv_create_container uricontainer
bcv_upload_new_db uricontainer test1.db {
  CREATE TABLE u1(x,y);
  INSERT INTO u1 VALUES('890', '444');
}

bcv_mkdir testdir
set cmd [bcvfs_create testdir "bcvfs"]
#$cmd log http log_callback
#proc log_callback {mask msg} { puts "$mask: $msg" }

bcvfs_attach -module azure?sas=1&customuri=1 -user $conturi $cmd uricontainer

sqlite3 db /uricontainer/test1.db -vfs bcvfs
do_execsql_test 1.0 {
  SELECT * FROM u1;
} {890 444}

do_execsql_test 1.1 {
  INSERT INTO u1 VALUES(100, 634);
  PRAGMA bcv_upload;
}
  
db close
$cmd destroy

bcv_mkdir testdir
set cmd [bcvfs_create testdir "bcvfs"]
bcvfs_attach $cmd uricontainer

sqlite3 db /uricontainer/test1.db -vfs bcvfs
do_execsql_test 1.2 {
  SELECT * FROM u1;
} {890 444 100 634}

db close
$cmd destroy

bcv_mkdir testdir
set cmd [bcvfs_create testdir "bcvfs"]
$cmd auth_callback local_auth_callback
proc local_auth_callback {zStorage zAccount zContainer} {
  make_sas uricontainer
}

set conturi 127.0.0.1:10000/devstoreaccount1/uricontainer
bcvfs_attach -module azure?sas=1&customuri=1 -alias uricontainer -user $conturi $cmd {}

sqlite3 db /uricontainer/test1.db -vfs bcvfs
do_execsql_test 1.3 {
  SELECT * FROM u1;
} {890 444 100 634}

set broken http://127.0.0.2:10000/devstoreaccount1/uricontainer
do_catch_test 1.4 {
  bcvfs_attach -module azure?sas=1&customuri=1 -user $broken $cmd broken
} {1 {1 Couldn't connect to server}}

db close
$cmd destroy

finish_test

