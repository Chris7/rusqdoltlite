Subject: [PATCH] Reuse canonical paths for Windows chunk-store opens

The chunk store opens its backing file lazily on the first write. Keep the
VFS-normalized path on Windows as on every other platform so that delayed
opens use the same canonical filename as SQLite.

diff --git a/doltlite.c b/doltlite.c
--- a/doltlite.c
+++ b/doltlite.c
@@ -275393,11 +275393,4 @@ static int csCanonicalFilename(
   if( !zFull ) return SQLITE_NOMEM;
 
   rc = sqlite3OsFullPathname(pVfs, zFilename, nPath, zFull);
-#if SQLITE_OS_WIN
-  /* Windows reopens must use the caller's name, not xFullPathname output. */
-  if( rc==SQLITE_OK ){
-    sqlite3_free(zFull);
-    return chunkStoreDupFilenameDoubleNul(zFilename, pzOut);
-  }
-#endif
   if( rc==SQLITE_OK || rc==SQLITE_OK_SYMLINK ){
     rc = chunkStoreDupFilenameDoubleNul(zFull, pzOut);
     sqlite3_free(zFull);
