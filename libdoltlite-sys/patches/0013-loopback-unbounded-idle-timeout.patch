+/* Accept only dotted-decimal IPv4 literals in 127/8 for an unbounded
+** idle timeout.  Do not resolve names here: this is a loopback trust check. */
+static int httpIsNumericLoopbackHost(const char *zHost, int nHost){
+  int i;
+  int nPart = 0;
+  int value = 0;
+  int digits = 0;
+  int c;
+
+  for(i=0; i<=nHost; i++){
+    c = i==nHost ? 0 : (unsigned char)zHost[i];
+    if( c>='0' && c<='9' ){
+      digits++;
+      if( digits>3 ) return 0;
+      value = value*10 + (c-'0');
+      if( value>255 ) return 0;
+    }else if( c=='.' || c==0 ){
+      if( digits==0 || nPart>=4 ) return 0;
+      if( nPart==0 && value!=127 ) return 0;
+      nPart++;
+      value = 0;
+      digits = 0;
+    }else{
+      return 0;
+    }
+  }
+  return nPart==4;
+}
