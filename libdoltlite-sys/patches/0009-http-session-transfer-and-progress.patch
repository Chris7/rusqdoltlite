+typedef struct DoltlitePushProgressRegistration DoltlitePushProgressRegistration;
+struct DoltlitePushProgressRegistration {
+  void *pContext;
+  DoltlitePushProgressCallback xCallback;
+};
+
+static void doltlitePushProgressRegistrationFree(void *pArg){
