+static void doltlitePushProgressReportAcknowledged(
+  DoltliteRemote *pRemote,
+  sqlite3_int64 nChunks,
+  sqlite3_int64 nBytes
+){
+  if( !pRemote || !pRemote->xPushProgress || nChunks<0 || nBytes<0 ) return;
+  if( nChunks > pRemote->nPushPlannedChunks-pRemote->nPushAcknowledgedChunks
+   || nBytes > pRemote->nPushPlannedBytes-pRemote->nPushAcknowledgedBytes ){
+    return;
+  }
+  pRemote->nPushAcknowledgedChunks += nChunks;
+  pRemote->nPushAcknowledgedBytes += nBytes;
+  pRemote->xPushProgress(
+      pRemote->pPushProgressCtx,
+      DOLTLITE_PUSH_PROGRESS_UPLOADED,
+      pRemote->nPushAcknowledgedChunks,
+      pRemote->nPushAcknowledgedBytes
+  );
+}
