+SQLITE_API int SQLITE_APICALL sqlite3_doltlite_set_push_progress_callback(
+  sqlite3 *db,
+  void *pContext,
+  DoltlitePushProgressCallback xCallback
+){
+  DoltlitePushProgressRegistration *pRegistration;
+  int rc;
+  if( !db || !pContext || !xCallback ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  if( sqlite3_get_clientdata(db, DOLTLITE_PUSH_PROGRESS_CLIENTDATA) ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_MISUSE;
+  }
+  pRegistration = sqlite3_malloc64(sizeof(*pRegistration));
+  if( !pRegistration ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_NOMEM;
+  }
+  pRegistration->pContext = pContext;
+  pRegistration->xCallback = xCallback;
+  rc = sqlite3_set_clientdata(
+      db, DOLTLITE_PUSH_PROGRESS_CLIENTDATA, pRegistration,
+      doltlitePushProgressRegistrationFree
+  );
+  sqlite3_mutex_leave(db->mutex);
+  return rc;
+}
+
+SQLITE_API int SQLITE_APICALL sqlite3_doltlite_clear_push_progress_callback(
+  sqlite3 *db,
+  void *pContext
+){
+  DoltlitePushProgressRegistration *pRegistration;
+  if( !db || !pContext ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_PUSH_PROGRESS_CLIENTDATA);
+  if( !pRegistration || pRegistration->pContext!=pContext ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_MISUSE;
+  }
+  {
+    int rc = sqlite3_set_clientdata(
+        db, DOLTLITE_PUSH_PROGRESS_CLIENTDATA, 0, 0
+    );
+    sqlite3_mutex_leave(db->mutex);
+    return rc;
+  }
+}
+
+static void doltlitePushProgressAttach(sqlite3 *db, DoltliteRemote *pRemote){
+  DoltlitePushProgressRegistration *pRegistration;
+  if( !db || !pRemote ) return;
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_PUSH_PROGRESS_CLIENTDATA);
+  if( pRegistration ){
+    pRemote->pPushProgressDb = db;
+    pRemote->pPushProgressCtx = pRegistration->pContext;
+    pRemote->xPushProgress = pRegistration->xCallback;
+  }
+}
