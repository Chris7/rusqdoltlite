+typedef struct SyncPushPlanEntry SyncPushPlanEntry;
+struct SyncPushPlanEntry {
+  ProllyHash hash;
+  int nData;
+};
+
+typedef struct SyncPushPlan SyncPushPlan;
+struct SyncPushPlan {
+  SyncPushPlanEntry *aEntry;
+  int nEntry;
+  int nAlloc;
+  sqlite3_int64 nBytes;
+};
+
+static void syncPushPlanFree(SyncPushPlan *pPlan){
+  sqlite3_free(pPlan->aEntry);
+  memset(pPlan, 0, sizeof(*pPlan));
+}
+
+static int syncPushPlanAppend(
+  SyncPushPlan *pPlan,
+  const ProllyHash *pHash,
+  int nData
+){
+  if( nData<0 || pPlan->nBytes>0x7fffffffffffffffLL-nData ){
+    return SQLITE_TOOBIG;
+  }
+  if( pPlan->nEntry==0x7fffffff ) return SQLITE_TOOBIG;
+  if( pPlan->nEntry==pPlan->nAlloc ){
+    int nNext;
+    SyncPushPlanEntry *aNew;
+    if( pPlan->nAlloc==0 ){
+      nNext = 128;
+    }else if( pPlan->nAlloc>0x7fffffff/2 ){
+      nNext = 0x7fffffff;
+    }else{
+      nNext = pPlan->nAlloc*2;
+    }
+    aNew = sqlite3_realloc64(
+        pPlan->aEntry, (sqlite3_uint64)nNext*sizeof(*aNew)
+    );
+    if( !aNew ) return SQLITE_NOMEM;
+    pPlan->aEntry = aNew;
+    pPlan->nAlloc = nNext;
+  }
+  memcpy(&pPlan->aEntry[pPlan->nEntry].hash, pHash, sizeof(*pHash));
+  pPlan->aEntry[pPlan->nEntry].nData = nData;
+  pPlan->nEntry++;
+  pPlan->nBytes += nData;
+  return SQLITE_OK;
+}
