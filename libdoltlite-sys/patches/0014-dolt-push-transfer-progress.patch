+/* Make the same reachability/resume decision as doltliteSyncChunks, but keep
+** only each missing hash and payload length. Never retain chunk payloads. */
+static int syncBuildPushPlan(
+  DoltliteRemote *pSrc,
+  DoltliteRemote *pDst,
+  ProllyHash *aRoots,
+  int nRoots,
+  SyncPushPlan *pPlan
+){
+  SyncQueue queue;
+  ProllyHashSet seen;
+  SyncBatchBuf *pB = 0;
+  int bFirstBatch = 1;
+  int bResumeScan = 0;
+  int bQueueInit = 0;
+  int bSeenInit = 0;
+  int rc;
+  int i;
+
+  memset(&queue, 0, sizeof(queue));
+  memset(&seen, 0, sizeof(seen));
+  pB = sqlite3_malloc64(sizeof(*pB));
+  if( !pB ) return SQLITE_NOMEM;
+  rc = syncQueueInit(&queue);
+  if( rc!=SQLITE_OK ) goto plan_done;
+  bQueueInit = 1;
+  rc = prollyHashSetInit(&seen, 256);
+  if( rc!=SQLITE_OK ) goto plan_done;
+  bSeenInit = 1;
+  for(i=0; i<nRoots && rc==SQLITE_OK; i++){
+    if( !prollyHashIsEmpty(&aRoots[i])
+     && !prollyHashSetContains(&seen, &aRoots[i]) ){
+      rc = prollyHashSetAdd(&seen, &aRoots[i]);
+      if( rc==SQLITE_OK ) rc = syncQueuePush(&queue, &aRoots[i]);
+    }
+  }
+  while( rc==SQLITE_OK && syncQueuePending(&queue)>0 ){
+    int nBatch = 0;
+    if( doltlitePushProgressInterrupted(pDst) ){
+      rc = SQLITE_INTERRUPT;
+      break;
+    }
+    while( nBatch<SYNC_BATCH_SIZE
+        && syncQueuePop(&queue, &pB->aBatch[nBatch]) ){
+      nBatch++;
+    }
+    if( nBatch==0 ) break;
+    rc = pDst->xHasChunks(pDst, pB->aBatch, nBatch, pB->aPresent);
+    if( rc!=SQLITE_OK ) break;
+    if( bFirstBatch && pDst->bResumePartialPuts ){
+      bResumeScan = 1;
+      for(i=0; i<nBatch; i++){
+        if( !pB->aPresent[i] ){
+          bResumeScan = 0;
+          break;
+        }
+      }
+    }
+    bFirstBatch = 0;
+    {
+      int nFetch = 0;
+      for(i=0; i<nBatch; i++){
+        if( !pB->aPresent[i] || bResumeScan ){
+          pB->aFetch[nFetch] = pB->aBatch[i];
+          pB->aPut[nFetch] = !pB->aPresent[i];
+          nFetch++;
+        }
+      }
+      if( nFetch==0 ) continue;
+      if( pSrc->xGetChunks ){
+        memset(pB->apData, 0, sizeof(pB->apData[0])*nFetch);
+        rc = pSrc->xGetChunks(
+            pSrc,pB->aFetch,nFetch,pB->apData,pB->anData
+        );
+        for(i=0; i<nFetch && rc==SQLITE_OK; i++){
+          if( !pB->apData[i] ){
+            rc = SQLITE_NOTFOUND;
+            break;
+          }
+          rc = syncVerifyFetchedChunk(
+              &pB->aFetch[i],pB->apData[i],pB->anData[i]
+          );
+          if( rc==SQLITE_OK && pB->aPut[i] ){
+            rc = syncPushPlanAppend(
+                pPlan,&pB->aFetch[i],pB->anData[i]
+            );
+          }
+          if( rc==SQLITE_OK ){
+            rc = syncEnqueueChildren(
+                pB->apData[i],pB->anData[i],&queue,&seen
+            );
+          }
+        }
+        for(i=0; i<nFetch; i++) sqlite3_free(pB->apData[i]);
+      }else{
+        for(i=0; i<nFetch && rc==SQLITE_OK; i++){
+          u8 *pData = 0;
+          int nData = 0;
+          rc = pSrc->xGetChunk(pSrc,&pB->aFetch[i],&pData,&nData);
+          if( rc==SQLITE_OK ){
+            rc = syncVerifyFetchedChunk(&pB->aFetch[i],pData,nData);
+          }
+          if( rc==SQLITE_OK && pB->aPut[i] ){
+            rc = syncPushPlanAppend(pPlan,&pB->aFetch[i],nData);
+          }
+          if( rc==SQLITE_OK ){
+            rc = syncEnqueueChildren(pData,nData,&queue,&seen);
+          }
+          sqlite3_free(pData);
+        }
+      }
+    }
+  }
+plan_done:
+  if( bSeenInit ) prollyHashSetFree(&seen);
+  if( bQueueInit ) syncQueueFree(&queue);
+  sqlite3_free(pB);
+  return rc;
+}
+
+static int syncUploadPushPlan(
+  DoltliteRemote *pSrc,
+  DoltliteRemote *pDst,
+  const SyncPushPlan *pPlan
+){
+  int offset;
+  int rc = SQLITE_OK;
+  for(offset=0; offset<pPlan->nEntry && rc==SQLITE_OK; ){
+    int nBatch = pPlan->nEntry-offset;
+    int i;
+    if( doltlitePushProgressInterrupted(pDst) ) return SQLITE_INTERRUPT;
+    if( nBatch>SYNC_BATCH_SIZE ) nBatch = SYNC_BATCH_SIZE;
+    if( pSrc->xGetChunks ){
+      u8 *apData[SYNC_BATCH_SIZE];
+      int anData[SYNC_BATCH_SIZE];
+      ProllyHash aHash[SYNC_BATCH_SIZE];
+      memset(apData, 0, sizeof(apData));
+      for(i=0; i<nBatch; i++){
+        memcpy(&aHash[i], &pPlan->aEntry[offset+i].hash, sizeof(ProllyHash));
+      }
+      rc = pSrc->xGetChunks(pSrc,aHash,nBatch,apData,anData);
+      for(i=0; i<nBatch && rc==SQLITE_OK; i++){
+        if( !apData[i] ){
+          rc = SQLITE_NOTFOUND;
+          break;
+        }
+        rc = syncVerifyFetchedChunk(&aHash[i],apData[i],anData[i]);
+        if( rc==SQLITE_OK && anData[i]!=pPlan->aEntry[offset+i].nData ){
+          rc = SQLITE_CORRUPT;
+        }
+        if( rc==SQLITE_OK ){
+          rc = pDst->xPutChunk(pDst,&aHash[i],apData[i],anData[i]);
+        }
+        if( rc==SQLITE_OK && !pDst->bPushPutsAckOnFlush ){
+          doltlitePushProgressReportAcknowledged(pDst,1,anData[i]);
+        }
+      }
+      for(i=0; i<nBatch; i++) sqlite3_free(apData[i]);
+    }else{
+      for(i=0; i<nBatch && rc==SQLITE_OK; i++){
+        const SyncPushPlanEntry *pEntry = &pPlan->aEntry[offset+i];
+        u8 *pData = 0;
+        int nData = 0;
+        rc = pSrc->xGetChunk(pSrc,&pEntry->hash,&pData,&nData);
+        if( rc==SQLITE_OK ){
+          rc = syncVerifyFetchedChunk(&pEntry->hash,pData,nData);
+        }
+        if( rc==SQLITE_OK && nData!=pEntry->nData ) rc = SQLITE_CORRUPT;
+        if( rc==SQLITE_OK ){
+          rc = pDst->xPutChunk(pDst,&pEntry->hash,pData,nData);
+        }
+        if( rc==SQLITE_OK && !pDst->bPushPutsAckOnFlush ){
+          doltlitePushProgressReportAcknowledged(pDst,1,nData);
+        }
+        sqlite3_free(pData);
+      }
+    }
+    offset += nBatch;
+  }
+  return rc;
+}
+
+static int doltliteSyncChunksWithPushProgress(
+  DoltliteRemote *pSrc,
+  DoltliteRemote *pDst,
+  ProllyHash *aRoots,
+  int nRoots
+){
+  SyncPushPlan plan;
+  int rc;
+  memset(&plan, 0, sizeof(plan));
+  if( !pDst->xPushProgress ){
+    return doltliteSyncChunks(pSrc,pDst,aRoots,nRoots);
+  }
+  rc = syncBuildPushPlan(pSrc,pDst,aRoots,nRoots,&plan);
+  if( rc==SQLITE_OK ){
+    doltlitePushProgressReportPlan(pDst,plan.nEntry,plan.nBytes);
+    if( doltlitePushProgressInterrupted(pDst) ) rc = SQLITE_INTERRUPT;
+    if( rc==SQLITE_OK ) rc = syncUploadPushPlan(pSrc,pDst,&plan);
+    if( rc==SQLITE_OK && doltlitePushProgressInterrupted(pDst) ){
+      rc = SQLITE_INTERRUPT;
+    }
+  }
+  syncPushPlanFree(&plan);
+  return rc;
+}
