+/* Oversized aggregate replies are retried as smaller hash ranges. Every
+** request remains bounded, and data is written into the caller's original
+** result slots so the reply order remains unchanged. */
+static int httpGetChunksRange(
+  HttpRemote *p,
+  const ProllyHash *aHash,
+  int nHash,
+  u8 **apData,
+  int *anData
+){
+  int bTooBig = 0;
+  int rc;
+
+  rc = httpGetChunksRequest(p, aHash, nHash, apData, anData, &bTooBig);
+  if( rc!=SQLITE_TOOBIG || !bTooBig || nHash<=1 ) return rc;
+
+  {
+    int nFirst = nHash / 2;
+    rc = httpGetChunksRange(p, aHash, nFirst, apData, anData);
+    if( rc==SQLITE_OK ){
+      rc = httpGetChunksRange(p, aHash+nFirst, nHash-nFirst,
+                              apData+nFirst, anData+nFirst);
+    }
+  }
+  return rc;
+}
