+  int i;
+
+  for(i=0; i<nHash; i++){ apData[i] = 0; anData[i] = 0; }
+  if( nHash <= 0 ) return SQLITE_OK;
+
+  rc = httpGetChunksRange(p, aHash, nHash, apData, anData);
+  if( rc!=SQLITE_OK ){
+    /* Free successful sub-batch outputs before returning an error. */
+    for(i=0; i<nHash; i++){
+      sqlite3_free(apData[i]);
+      apData[i] = 0;
+      anData[i] = 0;
+    }
+  }
+  return rc;
