+static int doltliteLoadCatalogTableColumns(
+  sqlite3 *db,
+  const ProllyHash *pCatalog,
+  const char *zTable,
+  DoltliteColInfo *pCols,
+  int *pFound
+){
+  ChunkStore *cs = doltliteGetChunkStore(db);
+  ProllyCache *pCache = doltliteGetCache(db);
+  SchemaEntry entry;
+  sqlite3 *tmp = 0;
+  int found = 0;
+  int rc;
+
+  *pFound = 0;
+  if( !cs || !pCache || !pCatalog || prollyHashIsEmpty(pCatalog) ){
+    return SQLITE_OK;
+  }
+
+  rc = loadSchemaEntryFromCatalog(
+    db, cs, pCache, pCatalog, zTable, &entry, &found
+  );
+  if( rc!=SQLITE_OK ) return rc;
+  if( !found || !entry.zSql ){
+    clearSchemaEntry(&entry);
+    return SQLITE_OK;
+  }
+
+  rc = sqlite3_open(":memory:", &tmp);
+  if( rc==SQLITE_OK ) rc = sqlite3_exec(tmp, entry.zSql, 0, 0, 0);
+  if( rc==SQLITE_OK ) rc = doltliteGetColumnNames(tmp, zTable, pCols);
+  if( rc==SQLITE_OK && pCols->nCol>0 ) *pFound = 1;
+
+  if( tmp ) sqlite3_close(tmp);
+  clearSchemaEntry(&entry);
+  return rc;
+}
+
+static int doltliteLoadCommitTableColumns(
+  sqlite3 *db,
+  const ProllyHash *pCommit,
+  const char *zTable,
+  DoltliteColInfo *pCols,
+  int *pFound
+){
+  ProllyHash catalog;
+  int rc;
+
+  *pFound = 0;
+  if( !pCommit || prollyHashIsEmpty(pCommit) ) return SQLITE_OK;
+  rc = doltliteCommitCatalogHash(db, pCommit, &catalog);
+  if( rc!=SQLITE_OK ) return rc;
+  return doltliteLoadCatalogTableColumns(
+    db, &catalog, zTable, pCols, pFound
+  );
+}
+
+int doltliteLoadUserTableColumns(
+  sqlite3 *db,
+  const char *zTable,
+  DoltliteColInfo *pCols,
+  char **pzErr
+){
+  ChunkStore *cs = doltliteGetChunkStore(db);
+  ProllyHash headCommit;
+  const BranchRef *aBranches = 0;
+  const TagRef *aTags = 0;
+  const TrackingBranch *aTracking = 0;
+  int nBranches = 0, nTags = 0, nTracking = 0;
+  int found = 0;
+  int i, rc;
+
+  rc = doltliteGetColumnNames(db, zTable, pCols);
+  if( rc!=SQLITE_OK || pCols->nCol>0 ) return rc;
+  doltliteFreeColInfo(pCols);
+
+  doltliteGetSessionHead(db, &headCommit);
+  rc = doltliteLoadCommitTableColumns(
+    db, &headCommit, zTable, pCols, &found
+  );
+  if( rc!=SQLITE_OK || found ) return rc;
+
+  if( cs ){
+    refsTableGetBranches(&cs->refs, &nBranches, &aBranches);
+    for(i=0; i<nBranches && !found; i++){
+      rc = doltliteLoadCommitTableColumns(
+        db, &aBranches[i].commitHash, zTable, pCols, &found
+      );
+      if( rc!=SQLITE_OK ) return rc;
+    }
+
+    refsTableGetTags(&cs->refs, &nTags, &aTags);
+    for(i=0; i<nTags && !found; i++){
+      rc = doltliteLoadCommitTableColumns(
+        db, &aTags[i].commitHash, zTable, pCols, &found
+      );
+      if( rc!=SQLITE_OK ) return rc;
+    }
+
+    refsTableGetTracking(&cs->refs, &nTracking, &aTracking);
+    for(i=0; i<nTracking && !found; i++){
+      rc = doltliteLoadCommitTableColumns(
+        db, &aTracking[i].commitHash, zTable, pCols, &found
+      );
+      if( rc!=SQLITE_OK && rc!=SQLITE_NOTFOUND ) return rc;
+    }
+  }
+
+  if( found ) return SQLITE_OK;
+  if( pzErr ){
+    *pzErr = sqlite3_mprintf("table '%s' not found or has no columns",
+                             zTable ? zTable : "");
+    if( !*pzErr ) return SQLITE_NOMEM;
+  }
+  return SQLITE_ERROR;
+}
