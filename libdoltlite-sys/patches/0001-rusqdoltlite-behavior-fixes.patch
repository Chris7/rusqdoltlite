+static int doltliteRegisterCommitUserTables(
+  sqlite3 *db,
+  const ProllyHash *pCommit,
+  const char *zPrefix,
+  const sqlite3_module *pModule
+){
+  ProllyHash catalog;
+  int rc;
+
+  if( !pCommit || prollyHashIsEmpty(pCommit) ) return SQLITE_OK;
+  rc = doltliteCommitCatalogHash(db, pCommit, &catalog);
+  if( rc!=SQLITE_OK ) return rc;
+  return doltliteRegisterCatalogUserTables(db, &catalog, zPrefix, pModule);
+}
+
+int doltliteForEachUserTable(
+  sqlite3 *db,
+  const char *zPrefix,
+  const sqlite3_module *pModule
+){
+  ChunkStore *cs = doltliteGetChunkStore(db);
+  ProllyHash headCommit;
+  const BranchRef *aBranches = 0;
+  const TagRef *aTags = 0;
+  const TrackingBranch *aTracking = 0;
+  int nBranches = 0, nTags = 0, nTracking = 0;
+  int i, rc;
+
+  doltliteGetSessionHead(db, &headCommit);
+  rc = doltliteRegisterCommitUserTables(db, &headCommit, zPrefix, pModule);
+  if( rc!=SQLITE_OK || !cs ) return rc;
+
+  refsTableGetBranches(&cs->refs, &nBranches, &aBranches);
+  for(i=0; i<nBranches; i++){
+    rc = doltliteRegisterCommitUserTables(
+      db, &aBranches[i].commitHash, zPrefix, pModule
+    );
+    if( rc!=SQLITE_OK ) return rc;
+  }
+
+  refsTableGetTags(&cs->refs, &nTags, &aTags);
+  for(i=0; i<nTags; i++){
+    rc = doltliteRegisterCommitUserTables(
+      db, &aTags[i].commitHash, zPrefix, pModule
+    );
+    if( rc!=SQLITE_OK ) return rc;
+  }
+
+  refsTableGetTracking(&cs->refs, &nTracking, &aTracking);
+  for(i=0; i<nTracking; i++){
+    rc = doltliteRegisterCommitUserTables(
+      db, &aTracking[i].commitHash, zPrefix, pModule
+    );
+    if( rc!=SQLITE_OK && rc!=SQLITE_NOTFOUND ) return rc;
+  }
+
+  return SQLITE_OK;
+}
