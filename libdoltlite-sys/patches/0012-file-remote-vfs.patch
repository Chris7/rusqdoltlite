+/* A file remote may name the VFS that owns its remote database. This is
+** used by CAB-backed direct sessions, whose registered VFS is distinct from
+** the local graph connection's default VFS. Only a single plain vfs= query
+** parameter is accepted; every other query spelling remains invalid rather
+** than becoming part of a filesystem path. */
+static DoltliteRemote *doltliteFileRemoteOpen(
+  sqlite3_vfs *pVfs,
+  const char *zUrl,
+  int flags
+){
+  const char *zPath = zUrl + 7;
+  const char *zQuery = strchr(zPath, '?');
+  char *zPathCopy = 0;
+  DoltliteRemote *pRemote;
+
+  if( zQuery ){
+    const char *zVfs = zQuery + 5;
+    const char *z;
+    if( strncmp(zQuery, "?vfs=", 5)!=0 || zVfs[0]=='\0' ) return 0;
+    for(z=zVfs; z[0]; z++){
+      if( !( (*z>='A' && *z<='Z') || (*z>='a' && *z<='z')
+          || (*z>='0' && *z<='9') || *z=='_' || *z=='-' ) ) return 0;
+    }
+    pVfs = sqlite3_vfs_find(zVfs);
+    if( !pVfs || zQuery-zPath>INT_MAX ) return 0;
+    zPathCopy = sqlite3_mprintf("%.*s", (int)(zQuery-zPath), zPath);
+    if( !zPathCopy ) return 0;
+    zPath = zPathCopy;
+  }
+  pRemote = fsRemoteOpen(pVfs, zPath, flags);
+  sqlite3_free(zPathCopy);
+  return pRemote;
+}
