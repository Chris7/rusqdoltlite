+/* Private flag used by CBS's checkpoint connection to avoid graph seeding. */
+#define SQLITE_OPEN_DOLTLITE_NO_SEED 0x00800000
 
 /* Reserved:                         0x00F00000 */
 /* Legacy compatibility: */
@@ -19121,6 +19123,7 @@ struct sqlite3 {
