+int sqlite3_bcvfs_upload_progress_callback(
+  sqlite3_bcvfs *pFs,
+  void *pProgressCtx,
+  void(*xProgress)(void*, int, sqlite3_int64)
+){
+  if( pFs==0 ) return SQLITE_MISUSE;
+  ENTER_VFS_MUTEX; {
+    pFs->pUploadProgressCtx = pProgressCtx;
+    pFs->xUploadProgress = xProgress;
+  } LEAVE_VFS_MUTEX;
+  return SQLITE_OK;
+}
+
+static void bcvfsReportUploadProgress(
+  sqlite3_bcvfs *pFs,
+  int bReused,
+  sqlite3_int64 nBytes
+){
+  void *pCtx = 0;
+  void(*xProgress)(void*, int, sqlite3_int64) = 0;
+  if( pFs==0 ) return;
+  ENTER_VFS_MUTEX; {
+    pCtx = pFs->pUploadProgressCtx;
+    xProgress = pFs->xUploadProgress;
+  } LEAVE_VFS_MUTEX;
+  if( xProgress ) xProgress(pCtx,bReused,nBytes);
+}
