+/*
+** Create a new cloud storage manifest without replacing an existing one.
+** The provider conditional PUT is the concurrency boundary: two callers may
+** race, but only one can create the manifest. A failed first request causes
+** bucket creation and a conditional PUT retry; a bucket-create conflict is
+** treated as a concurrent creator and also retried.
+*/
+int sqlite3_bcv_create_if_not_exists(sqlite3_bcv *p, int szName, int szBlock){
+  Manifest man;
+
+  if( p->pCont==0 ) return p->errCode;
+  if( szName<=0 ) szName = BCV_DEFAULT_NAMEBYTES;
+  if( szBlock<=0 ) szBlock = BCV_DEFAULT_BLOCKSIZE;
+  if( szName<BCV_MIN_NAMEBYTES || szName>BCV_MAX_NAMEBYTES ){
+    return bcvApiError(p, SQLITE_RANGE, "parameter szName out of range");
+  }
+
+  memset(&man, 0, sizeof(man));
+  man.szBlk = szBlock;
+  man.nNamebytes = szName;
+  {
+    Manifest *pExisting = 0;
+    int rc = bcvManifestFetchParsed(p, &pExisting);
+    if( rc==SQLITE_OK ){
+      bcvManifestFree(pExisting);
+      return bcvApiError(p, SQLITE_CONSTRAINT,
+          "manifest already exists; refusing to replace it"
+      );
+    }
+    if( rc!=HTTP_NOT_FOUND && rc<500 ) return p->errCode;
+    bcvApiErrorClear(p);
+  }
+  bcvApiErrorClear(p);
+  if( bcvManifestUploadIfNotExists(p, &man)!=SQLITE_OK ){
+    BcvDispatch *pDisp = p->pDisp;
+    bcvApiErrorClear(p);
+    p->errCode = bcvDispatchCreate(pDisp, p->pCont, (void*)p, bcvCollectError);
+    if( p->errCode==SQLITE_OK ){
+      bcvDispatchRunAll(pDisp);
+    }
+    if( p->errCode==409 ){
+      bcvApiErrorClear(p);
+    }
+    if( p->errCode==SQLITE_OK ){
+      bcvManifestUploadIfNotExists(p, &man);
+    }
+  }
+
+  /* If the manifest was uploaded, upload an empty KV database. */
+  if( p->errCode==SQLITE_OK ){
+    int nKV = 0;
+    u8 *aKV = bcvEmptyKV(&p->errCode, &nKV);
+    if( aKV ){
+      int rc;
+      if( p->bTestNoKv==0 ){
+        rc = bcvDispatchPut(p->pDisp,
+            p->pCont, BCV_KV_FILE, 0, aKV, nKV, (void*)p, bcvKVUploadCb
+        );
+      }else{
+        rc = bcvDispatchDelete(p->pDisp,
+            p->pCont, BCV_KV_FILE, 0, (void*)p, bcvKVUploadCb
+        );
+      }
+      if( rc==SQLITE_OK ){
+        rc = bcvDispatchRunAll(p->pDisp);
+        if( p->errCode ) rc = p->errCode;
+      }
+      p->errCode = rc;
+      sqlite3_free(aKV);
+    }
+  }
+  return p->errCode;
+}
