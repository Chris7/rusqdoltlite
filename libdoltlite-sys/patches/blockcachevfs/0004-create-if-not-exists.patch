+/* Upload a new manifest only if no manifest currently exists. The '*'
+** sentinel is interpreted by each provider module as its conditional-create
+** primitive (If-None-Match: * or the provider equivalent).
+*/
+static int bcvManifestUploadIfNotExists(sqlite3_bcv *p, Manifest *pMan){
+  ManifestCtx ctx;
+  u8 *aMan = 0;
+  int nMan = 0;
+
+  ctx.p = p;
+  ctx.pMan = 0;
+  aMan = bcvManifestCompose(pMan, &nMan);
+  if( aMan==0 ){
+    p->errCode = SQLITE_NOMEM;
+  }else{
+    int rc = bcvDispatchPut(p->pDisp,
+        p->pCont, BCV_MANIFEST_FILE, "*", aMan, nMan,
+        (void*)&ctx, bcvManifestUploadParsedCb
+    );
+    if( rc==SQLITE_OK ){
+      rc = bcvDispatchRunAll(p->pDisp);
+      if( p->errCode ) rc = p->errCode;
+    }
+    p->errCode = rc;
+  }
+  sqlite3_free(aMan);
+  return p->errCode;
+}
