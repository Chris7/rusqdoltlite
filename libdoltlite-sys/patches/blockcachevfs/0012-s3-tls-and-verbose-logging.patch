+/*
+** CURLOPT_VERBOSE normally writes the complete request and response headers,
+** including Authorization and x-amz-security-token values, to stderr. Keep
+** useful connection diagnostics while omitting all HTTP headers and body
+** data. Ignoring both header callback types here is safe even if libcurl
+** splits one header line across several callbacks or a server reflects a
+** credential in its response.
+*/
+static int bcvCurlDebug(
+  CURL *pCurl, curl_infotype eType, char *pData, size_t nData, void *pCtx
+){
+  const char *zPrefix;
+  (void)pCurl;
+  (void)pCtx;
+  if( eType==CURLINFO_TEXT ){
+    zPrefix = "* ";
+  }else{
+    /* This includes both header types and all request/response body data. */
+    return 0;
+  }
+  fwrite(zPrefix, 1, strlen(zPrefix), stderr);
+  fwrite(pData, 1, nData, stderr);
+  fflush(stderr);
+  return 0;
+}
