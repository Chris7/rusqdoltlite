+/* Validate one complete JSON object, including trailing bytes. */
+static int bcvJsonRootObject(const u8 *a, int n){
+  int i = 0;
+  while( i<n && isspace(a[i]) ) i++;
+  if( bcvJsonSkipObject(a, n, &i)!=SQLITE_OK ) return SQLITE_ERROR;
+  while( i<n && isspace(a[i]) ) i++;
+  return i==n ? SQLITE_OK : SQLITE_ERROR;
+}
+
+static int bcvJsonHex4(const u8 *a, unsigned *pOut){
+  int i;
+  unsigned v = 0;
+  for(i=0; i<4; i++){
+    int c = a[i];
+    if( c>='0' && c<='9' ) v = (v<<4) | (unsigned)(c-'0');
+    else if( c>='a' && c<='f' ) v = (v<<4) | (unsigned)(c-'a'+10);
+    else if( c>='A' && c<='F' ) v = (v<<4) | (unsigned)(c-'A'+10);
+    else return SQLITE_ERROR;
+  }
+  *pOut = v;
+  return SQLITE_OK;
+}
+
+static int bcvJsonAppendUtf8(char **pzOut, int *pnOut, unsigned cp){
+  char *z = *pzOut;
+  if( cp<=0x7F ){
+    z[(*pnOut)++] = (char)cp;
+  }else if( cp<=0x7FF ){
+    z[(*pnOut)++] = (char)(0xC0 | (cp>>6));
+    z[(*pnOut)++] = (char)(0x80 | (cp&0x3F));
+  }else if( cp<=0xFFFF ){
+    z[(*pnOut)++] = (char)(0xE0 | (cp>>12));
+    z[(*pnOut)++] = (char)(0x80 | ((cp>>6)&0x3F));
+    z[(*pnOut)++] = (char)(0x80 | (cp&0x3F));
+  }else if( cp<=0x10FFFF ){
+    z[(*pnOut)++] = (char)(0xF0 | (cp>>18));
+    z[(*pnOut)++] = (char)(0x80 | ((cp>>12)&0x3F));
+    z[(*pnOut)++] = (char)(0x80 | ((cp>>6)&0x3F));
+    z[(*pnOut)++] = (char)(0x80 | (cp&0x3F));
+  }else{
+    return SQLITE_ERROR;
+  }
+  return SQLITE_OK;
+}
+
+static int bcvJsonDecodeString(
+  const u8 *a, int iStart, int iEnd, char **pzOut
+){
+  int i = iStart;
+  int nOut = 0;
+  char *zOut;
+  if( iStart>=iEnd || a[iStart]!='"' || a[iEnd-1]!='"' ) return SQLITE_ERROR;
+  zOut = sqlite3_malloc(iEnd-iStart+1);
+  if( zOut==0 ) return SQLITE_NOMEM;
+  i++;
+  while( i<iEnd-1 ){
+    unsigned cp;
+    if( a[i]!='\\' ){
+      zOut[nOut++] = (char)a[i++];
+      continue;
+    }
+    i++;
+    if( i>=iEnd-1 ) goto json_error;
+    switch( a[i++] ){
+      case '"': zOut[nOut++] = '"'; break;
+      case '\\': zOut[nOut++] = '\\'; break;
+      case '/': zOut[nOut++] = '/'; break;
+      case 'b': zOut[nOut++] = '\b'; break;
+      case 'f': zOut[nOut++] = '\f'; break;
+      case 'n': zOut[nOut++] = '\n'; break;
+      case 'r': zOut[nOut++] = '\r'; break;
+      case 't': zOut[nOut++] = '\t'; break;
+      case 'u':
+        if( i+4>iEnd-1 || bcvJsonHex4(&a[i], &cp)!=SQLITE_OK ) goto json_error;
+        i += 4;
+        if( cp>=0xD800 && cp<=0xDBFF ){
+          unsigned lo;
+          if( i+6>iEnd-1 || a[i]!='\\' || a[i+1]!='u'
+           || bcvJsonHex4(&a[i+2], &lo)!=SQLITE_OK
+           || lo<0xDC00 || lo>0xDFFF
+          ) goto json_error;
+          i += 6;
+          cp = 0x10000 + ((cp-0xD800)<<10) + (lo-0xDC00);
+        }else if( cp>=0xDC00 && cp<=0xDFFF ){
+          goto json_error;
+        }
+        if( cp==0 || bcvJsonAppendUtf8(&zOut, &nOut, cp)!=SQLITE_OK ) goto json_error;
+        break;
+      default:
+        goto json_error;
+    }
+  }
+  zOut[nOut] = '\0';
+  *pzOut = zOut;
+  return SQLITE_OK;
+
+json_error:
+  sqlite3_free(zOut);
+  return SQLITE_ERROR;
+}
+
+/* Locate an object member and return its value range. */
+static int bcvJsonObjectMember(
+  const u8 *a, int iStart, int iEnd, const char *zKey,
+  int *piValue, int *piValueEnd
+){
+  int i = iStart;
+  int nKey = strlen(zKey);
+  if( i>=iEnd || a[i]!='{' ) return SQLITE_ERROR;
+  i++;
+  while( 1 ){
+    int iKeyStart, iKeyEnd, iValStart, iValEnd;
+    while( i<iEnd && isspace(a[i]) ) i++;
+    if( i<iEnd && a[i]=='}' ) return SQLITE_NOTFOUND;
+    iKeyStart = i;
+    if( bcvJsonSkipString(a, iEnd, &i)!=SQLITE_OK ) return SQLITE_ERROR;
+    iKeyEnd = i;
+    while( i<iEnd && isspace(a[i]) ) i++;
+    if( i>=iEnd || a[i++]!=':' ) return SQLITE_ERROR;
+    while( i<iEnd && isspace(a[i]) ) i++;
+    iValStart = i;
+    if( bcvJsonSkipValue(a, iEnd, &i)!=SQLITE_OK ) return SQLITE_ERROR;
+    iValEnd = i;
+    {
+      int bMatch = iKeyEnd-iKeyStart==nKey+2
+          && 0==memcmp(&a[iKeyStart+1], zKey, nKey);
+      while( i<iEnd && isspace(a[i]) ) i++;
+      if( i<iEnd && a[i]=='}' ){
+        if( bMatch ){
+          *piValue = iValStart;
+          *piValueEnd = iValEnd;
+          return SQLITE_OK;
+        }
+        return SQLITE_NOTFOUND;
+      }
+      if( i>=iEnd || a[i]!=',' ) return SQLITE_ERROR;
+      if( bMatch ){
+        *piValue = iValStart;
+        *piValueEnd = iValEnd;
+        return SQLITE_OK;
+      }
+      i++;
+    }
+  }
+}
