+static int bcvGoogleUrlSafe(unsigned char c){
+  return (c>='A' && c<='Z') || (c>='a' && c<='z')
+      || (c>='0' && c<='9') || c=='-' || c=='_' || c=='.' || c=='~';
+}
+
+static char *bcvGoogleUrlEncode(const char *zIn){
+  static const char aHex[] = "0123456789ABCDEF";
+  int nIn = strlen(zIn);
+  int i;
+  int nOut = 0;
+  char *zOut;
+  for(i=0; i<nIn; i++){
+    unsigned char c = (unsigned char)zIn[i];
+    nOut += bcvGoogleUrlSafe(c) ? 1 : 3;
+  }
+  zOut = sqlite3_malloc(nOut+1);
+  if( zOut ){
+    int j = 0;
+    for(i=0; i<nIn; i++){
+      unsigned char c = (unsigned char)zIn[i];
+      if( bcvGoogleUrlSafe(c) ){
+        zOut[j++] = (char)c;
+      }else{
+        zOut[j++] = '%';
+        zOut[j++] = aHex[c>>4];
+        zOut[j++] = aHex[c&0x0F];
+      }
+    }
+    zOut[j] = '\0';
+  }
+  return zOut;
+}
+
+/* Return the object name relative to the bucket, including any configured
+** container prefix. The prefix is normalized to end in '/'. */
+static char *bcvGoogleJsonObjectName(
+  BcvGoogle *p, const char *zFile
+){
+  if( p->zPrefix && p->zPrefix[0] ){
+    return sqlite3_mprintf("%s%s", p->zPrefix, zFile);
+  }
+  return sqlite3_mprintf("%s", zFile);
+}
+
+static char *bcvGoogleJsonQuote(const char *zIn){
+  int nIn = strlen(zIn);
+  int i;
+  int nOut = 2;
+  char *zOut;
+  for(i=0; i<nIn; i++){
+    unsigned char c = (unsigned char)zIn[i];
+    nOut += c<0x20 ? 6 : (c=='"' || c=='\\' ? 2 : 1);
+  }
+  zOut = sqlite3_malloc(nOut+1);
+  if( zOut ){
+    int j = 0;
+    zOut[j++] = '"';
+    for(i=0; i<nIn; i++){
+      unsigned char c = (unsigned char)zIn[i];
+      if( c=='"' || c=='\\' ) zOut[j++] = '\\';
+      if( c<0x20 ){
+        static const char aHex[] = "0123456789ABCDEF";
+        zOut[j++] = '\\';
+        zOut[j++] = 'u';
+        zOut[j++] = '0';
+        zOut[j++] = '0';
+        zOut[j++] = aHex[c>>4];
+        zOut[j++] = aHex[c&0x0F];
+      }else{
+        zOut[j++] = (char)c;
+      }
+    }
+    zOut[j++] = '"';
+    zOut[j] = '\0';
+  }
+  return zOut;
+}
