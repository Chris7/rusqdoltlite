+static int bcvGoogleJsonGeneration(
+  sqlite3_bcv_job *pCtx, sqlite3_bcv_request *pReq
+){
+  const u8 *aBody;
+  int nBody;
+  int iValue, iValueEnd;
+  char *zGeneration = 0;
+  int rc;
+
+  aBody = sqlite3_bcv_request_body(pReq, &nBody);
+  rc = bcvJsonRootObject(aBody, nBody);
+  if( rc==SQLITE_OK ){
+    rc = bcvJsonObjectMember(
+        aBody, 0, nBody, "generation", &iValue, &iValueEnd
+    );
+  }
+  if( rc==SQLITE_OK && aBody[iValue]=='"' ){
+    rc = bcvJsonDecodeString(aBody, iValue, iValueEnd, &zGeneration);
+  }else if( rc==SQLITE_OK ){
+    rc = SQLITE_ERROR;
+  }
+  if( rc==SQLITE_OK ){
+    sqlite3_bcv_job_etag(pCtx, zGeneration);
+  }else if( rc==SQLITE_NOTFOUND ){
+    rc = SQLITE_ERROR;
+  }
+  sqlite3_free(zGeneration);
+  return rc;
+}
