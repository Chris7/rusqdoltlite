+/*
+** Small, strict JSON helpers used by the Google JSON API.  This is not a
+** general-purpose JSON implementation: it validates the structure while
+** locating object members, and decodes only JSON strings.  In particular,
+** it does not use strstr() to find fields, so a name or value containing a
+** field name cannot confuse the response parser.
+*/
+static int bcvJsonSkipString(const u8 *a, int n, int *pi){
+  int i = *pi;
+  if( i>=n || a[i]!='"' ) return SQLITE_ERROR;
+  i++;
+  while( i<n ){
+    if( a[i]=='"' ){
+      *pi = i+1;
+      return SQLITE_OK;
+    }
+    if( a[i]=='\\' ){
+      i++;
+      if( i>=n ) return SQLITE_ERROR;
+      if( a[i]=='u' ){
+        int j;
+        for(j=0; j<4; j++){
+          i++;
+          if( i>=n || !isxdigit(a[i]) ) return SQLITE_ERROR;
+        }
+      }else if( !strchr("\\\"/bfnrt", a[i]) ){
+        return SQLITE_ERROR;
+      }
+    }else if( a[i]<0x20 ){
+      return SQLITE_ERROR;
+    }
+    i++;
+  }
+  return SQLITE_ERROR;
+}
+
+static int bcvJsonSkipValue(const u8 *a, int n, int *pi);
+
+static int bcvJsonSkipObject(const u8 *a, int n, int *pi){
+  int i = *pi;
+  if( i>=n || a[i]!='{' ) return SQLITE_ERROR;
+  i++;
+  while( i<n && isspace(a[i]) ) i++;
+  if( i<n && a[i]=='}' ){
+    *pi = i+1;
+    return SQLITE_OK;
+  }
+  while( 1 ){
+    if( bcvJsonSkipString(a, n, &i)!=SQLITE_OK ) return SQLITE_ERROR;
+    while( i<n && isspace(a[i]) ) i++;
+    if( i>=n || a[i++]!=':' ) return SQLITE_ERROR;
+    if( bcvJsonSkipValue(a, n, &i)!=SQLITE_OK ) return SQLITE_ERROR;
+    while( i<n && isspace(a[i]) ) i++;
+    if( i<n && a[i]==',' ){
+      i++;
+      while( i<n && isspace(a[i]) ) i++;
+      if( i<n && a[i]=='}' ) return SQLITE_ERROR;
+      continue;
+    }
+    if( i<n && a[i]=='}' ){
+      *pi = i+1;
+      return SQLITE_OK;
+    }
+    return SQLITE_ERROR;
+  }
+}
+
+static int bcvJsonSkipArray(const u8 *a, int n, int *pi){
+  int i = *pi;
+  if( i>=n || a[i]!='[' ) return SQLITE_ERROR;
+  i++;
+  while( i<n && isspace(a[i]) ) i++;
+  if( i<n && a[i]==']' ){
+    *pi = i+1;
+    return SQLITE_OK;
+  }
+  while( 1 ){
+    if( bcvJsonSkipValue(a, n, &i)!=SQLITE_OK ) return SQLITE_ERROR;
+    while( i<n && isspace(a[i]) ) i++;
+    if( i<n && a[i]==',' ){
+      i++;
+      while( i<n && isspace(a[i]) ) i++;
+      if( i<n && a[i]==']' ) return SQLITE_ERROR;
+      continue;
+    }
+    if( i<n && a[i]==']' ){
+      *pi = i+1;
+      return SQLITE_OK;
+    }
+    return SQLITE_ERROR;
+  }
+}
+
+static int bcvJsonSkipValue(const u8 *a, int n, int *pi){
+  int i = *pi;
+  int j;
+  while( i<n && isspace(a[i]) ) i++;
+  if( i>=n ) return SQLITE_ERROR;
+  *pi = i;
+  if( a[i]=='"' ) return bcvJsonSkipString(a, n, pi);
+  if( a[i]=='{' ) return bcvJsonSkipObject(a, n, pi);
+  if( a[i]=='[' ) return bcvJsonSkipArray(a, n, pi);
+  if( n-i>=4 && 0==memcmp(&a[i], "true", 4) ){
+    j = i+4;
+    if( j==n || isspace(a[j]) || a[j]==',' || a[j]==']' || a[j]=='}' ){
+      *pi = j;
+      return SQLITE_OK;
+    }
+    return SQLITE_ERROR;
+  }
+  if( n-i>=5 && 0==memcmp(&a[i], "false", 5) ){
+    j = i+5;
+    if( j==n || isspace(a[j]) || a[j]==',' || a[j]==']' || a[j]=='}' ){
+      *pi = j;
+      return SQLITE_OK;
+    }
+    return SQLITE_ERROR;
+  }
+  if( n-i>=4 && 0==memcmp(&a[i], "null", 4) ){
+    j = i+4;
+    if( j==n || isspace(a[j]) || a[j]==',' || a[j]==']' || a[j]=='}' ){
+      *pi = j;
+      return SQLITE_OK;
+    }
+    return SQLITE_ERROR;
+  }
+  if( a[i]=='-' || (a[i]>='0' && a[i]<='9') ){
+    if( a[i]=='-' ) i++;
+    if( i>=n ) return SQLITE_ERROR;
+    if( a[i]=='0' ){
+      i++;
+    }else{
+      if( a[i]<'1' || a[i]>'9' ) return SQLITE_ERROR;
+      while( i<n && a[i]>='0' && a[i]<='9' ) i++;
+    }
+    if( i<n && a[i]=='.' ){
+      i++;
+      if( i>=n || a[i]<'0' || a[i]>'9' ) return SQLITE_ERROR;
+      while( i<n && a[i]>='0' && a[i]<='9' ) i++;
+    }
+    if( i<n && (a[i]=='e' || a[i]=='E') ){
+      i++;
+      if( i<n && (a[i]=='+' || a[i]=='-' ) ) i++;
+      if( i>=n || a[i]<'0' || a[i]>'9' ) return SQLITE_ERROR;
+      while( i<n && a[i]>='0' && a[i]<='9' ) i++;
+    }
+    if( i<n && !isspace(a[i]) && a[i]!=',' && a[i]!=']' && a[i]!='}' ){
+      return SQLITE_ERROR;
+    }
+    *pi = i;
+    return SQLITE_OK;
+  }
+  return SQLITE_ERROR;
+}
