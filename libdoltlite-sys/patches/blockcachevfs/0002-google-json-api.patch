+static int bcvGoogleJsonList(
+  sqlite3_bcv_container *pCont,
+  sqlite3_bcv_job *pCtx, sqlite3_bcv_request *pReq, char **pzNext
+){
+  BcvGoogle *p = (BcvGoogle*)pCont;
+  const u8 *aBody;
+  int nBody;
+  int iItems, iItemsEnd;
+  int i = 0;
+  int rc;
+  *pzNext = 0;
+  aBody = sqlite3_bcv_request_body(pReq, &nBody);
+  if( bcvJsonRootObject(aBody, nBody)!=SQLITE_OK ) return SQLITE_ERROR;
+  rc = bcvJsonObjectMember(aBody, 0, nBody, "items", &iItems, &iItemsEnd);
+  if( rc!=SQLITE_NOTFOUND ){
+    if( rc!=SQLITE_OK ) return SQLITE_ERROR;
+    if( aBody[iItems]=='n' ){
+      if( iItemsEnd-iItems==4 && 0==memcmp(&aBody[iItems], "null", 4) ){
+        iItems = 0;
+      }else{
+        return SQLITE_ERROR;
+      }
+    }
+  }
+  if( rc==SQLITE_OK && iItems ){
+    if( aBody[iItems]!='[' ) return SQLITE_ERROR;
+    i = iItems+1;
+    while( 1 ){
+      int iObj, iObjEnd, iName, iNameEnd;
+      char *zName = 0;
+      while( i<iItemsEnd && isspace(aBody[i]) ) i++;
+      if( i<iItemsEnd && aBody[i]==']' ) break;
+      iObj = i;
+      if( bcvJsonSkipObject(aBody, iItemsEnd, &i)!=SQLITE_OK ){
+        return SQLITE_ERROR;
+      }
+      iObjEnd = i;
+      rc = bcvJsonObjectMember(
+          aBody, iObj, iObjEnd, "name", &iName, &iNameEnd
+      );
+      if( rc!=SQLITE_OK || aBody[iName]!='"' ) return SQLITE_ERROR;
+      rc = bcvJsonDecodeString(aBody, iName, iNameEnd, &zName);
+      if( rc!=SQLITE_OK ) return rc;
+      if( p->zPrefix && p->zPrefix[0] ){
+        int nPrefix = strlen(p->zPrefix);
+        if( strncmp(zName, p->zPrefix, nPrefix)!=0 ){
+          sqlite3_free(zName);
+          return SQLITE_ERROR;
+        }
+        sqlite3_bcv_job_result(
+            pCtx, (const u8*)&zName[nPrefix], -1
+        );
+      }else{
+        sqlite3_bcv_job_result(pCtx, (const u8*)zName, -1);
+      }
+      sqlite3_free(zName);
+      while( i<iItemsEnd && isspace(aBody[i]) ) i++;
+      if( i<iItemsEnd && aBody[i]==',' ){
+        i++;
+        continue;
+      }
+      if( i<iItemsEnd && aBody[i]==']' ) break;
+      return SQLITE_ERROR;
+    }
+  }
+
+  rc = bcvJsonObjectMember(aBody, 0, nBody, "nextPageToken", &iItems, &iItemsEnd);
+  if( rc==SQLITE_OK ){
+    if( aBody[iItems]!='"' ) return SQLITE_ERROR;
+    rc = bcvJsonDecodeString(aBody, iItems, iItemsEnd, pzNext);
+  }else if( rc==SQLITE_NOTFOUND ){
+    rc = SQLITE_OK;
+  }
+  return rc;
+}
