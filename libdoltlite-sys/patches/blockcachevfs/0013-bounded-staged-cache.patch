+static int bcvfsReconcileCacheFile(BcvCommon *p, const char *zDir){
+  sqlite3_file *pFile = 0;
+  char *zFile = 0;
+  sqlite3_int64 nFile = 0;
+  sqlite3_int64 nExpected;
+  int rc = SQLITE_OK;
