+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_bind_int64(pStmt, 2, iMax);
+  sqlite3_step(pStmt);
+  rc = sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  if( rc==SQLITE_OK ){
+    pStmt = p->pDeleteStagedGcBefore;
+    sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+    sqlite3_bind_int64(pStmt, 2, iMax);
+    sqlite3_step(pStmt);
+    rc = sqlite3_reset(pStmt);
+    sqlite3_clear_bindings(pStmt);
+  }
+  return rc;
+}
+
+static int bcvfsStagedHasAfter(
+  BcvCommon *p,
+  const char *zContainer,
+  i64 iMax
+){
+  sqlite3_stmt *pStmt = p->pFindStagedAfter;
+  int step;
+  int rc;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_bind_int64(pStmt, 2, iMax);
+  step = sqlite3_step(pStmt);
+  rc = (step==SQLITE_ROW) ? SQLITE_BUSY :
+       (step==SQLITE_DONE) ? SQLITE_NOTFOUND : step;
+  sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
