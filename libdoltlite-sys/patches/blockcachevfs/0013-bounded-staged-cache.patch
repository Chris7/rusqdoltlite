+    const char *zName = (const char*)sqlite3_column_text(pStmt, 1);
+    if( zName && strcmp(zName, zColumn)==0 ){
+      *pbFound = 1;
+      break;
+    }
+  }
+  if( rc==SQLITE_OK && step!=SQLITE_ROW && step!=SQLITE_DONE ){
+    rc = step;
+  }
+  if( pStmt ){
+    int rc2 = sqlite3_finalize(pStmt);
+    if( rc==SQLITE_OK ) rc = rc2;
+  }
+  return rc;
