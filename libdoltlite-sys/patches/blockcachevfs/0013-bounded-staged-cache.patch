+/* Return SQLITE_OK only if the durable pending marker is byte-for-byte the
+** same manifest. A manifest marker is deliberately independent of its ETag,
+** which is assigned by the remote object store. */
+static int bcvfsPendingPublishMatches(
+  BcvCommon *p,
+  const char *zContainer,
+  Manifest *pMan,
+  i64 *piMax
+){
+  u8 *aPending = 0;
+  u8 *aMan = 0;
+  int nPending = 0;
+  int nMan = 0;
+  int rc;
+
+  aMan = bcvManifestCompose(pMan, &nMan);
+  if( aMan==0 ) return SQLITE_NOMEM;
+  rc = bcvfsPendingPublishFind(
+      p, zContainer, &aPending, &nPending, piMax
+  );
+  if( rc==SQLITE_OK ){
+    rc = (nPending==nMan && 0==memcmp(aPending, aMan, nMan))
+       ? SQLITE_OK : SQLITE_NOTFOUND;
+  }
+  sqlite3_free(aPending);
+  sqlite3_free(aMan);
+  return rc;
+}
