+  );
+  int rc = zSql ? sqlite3_prepare_v2(db, zSql, -1, &pStmt, 0) : SQLITE_NOMEM;
+  int step = SQLITE_DONE;
+  sqlite3_free(zSql);
+  *pbFound = 0;
+  if( rc==SQLITE_OK ){
+    step = sqlite3_step(pStmt);
+    if( step==SQLITE_ROW ){
+      *pbFound = 1;
+    }else if( step!=SQLITE_DONE ){
+      rc = step;
+    }
+  }
+  if( pStmt ){
+    int rc2 = sqlite3_finalize(pStmt);
+    if( rc==SQLITE_OK ) rc = rc2;
+  }
+  return rc;
+}
