+  sqlite3 *db,
+  const char *zTable,
+  const char *zColumn,
+  int *pbFound
+){
+  sqlite3_stmt *pStmt = 0;
+  char *zSql = sqlite3_mprintf("PRAGMA table_info(%Q)", zTable);
+  int rc = zSql ? sqlite3_prepare_v2(db, zSql, -1, &pStmt, 0) : SQLITE_NOMEM;
