+/*
+** Return SQLITE_OK if the current generation has a staged object,
+** SQLITE_NOTFOUND if it does not, or another SQLite error.
+*/
+static int bcvfsStagedFind(
+  BcvCommon *p,
+  const char *zContainer,
+  i64 iDbId,
+  int iDbPos,
+  const u8 *aGeneration,
+  int nGeneration,
+  u8 *aBlock,
+  int *pnBlock
+){
+  sqlite3_stmt *pStmt = p->pFindStaged;
+  int step;
+  int rc;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_bind_int64(pStmt, 2, iDbId);
+  sqlite3_bind_int(pStmt, 3, iDbPos);
+  sqlite3_bind_blob(pStmt, 4, aGeneration, nGeneration, SQLITE_STATIC);
+  step = sqlite3_step(pStmt);
+  if( step==SQLITE_ROW ){
+    int n = sqlite3_column_bytes(pStmt, 0);
+    if( aBlock && n<=BCV_MAX_NAMEBYTES ){
+      memcpy(aBlock, sqlite3_column_blob(pStmt, 0), n);
+      if( pnBlock ) *pnBlock = n;
+    }
+    rc = SQLITE_OK;
+  }else if( step==SQLITE_DONE ){
+    rc = SQLITE_NOTFOUND;
+  }else{
+    rc = step;
+  }
+  sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
