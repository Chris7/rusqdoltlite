+/*
+** Record an uploaded-but-unpublished block. The generation is the block
+** identifier currently present in ManifestDb.aBlkLocal[]. Keeping it in a
+** separate table means that the cache slot may be reused without losing the
+** object needed to assemble the next manifest.
+*/
+static int bcvfsStagedNextSequence(
+  BcvCommon *p,
+  const char *zContainer,
+  i64 *piSeq
+){
+  sqlite3_stmt *pStmt;
+  int rc;
+  int step;
+
+  pStmt = p->pInsertStageSeq;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_step(pStmt);
+  rc = sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  if( rc!=SQLITE_OK ) return rc;
+
+  pStmt = p->pUpdateStageSeq;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_step(pStmt);
+  rc = sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  if( rc!=SQLITE_OK ) return rc;
+
+  pStmt = p->pFindStageSeq;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  step = sqlite3_step(pStmt);
+  if( step==SQLITE_ROW ){
+    *piSeq = sqlite3_column_int64(pStmt, 0);
+    rc = SQLITE_OK;
+  }else{
+    rc = (step==SQLITE_DONE) ? SQLITE_CORRUPT : step;
+  }
+  sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
+
+static int bcvfsStagedPut(
+  BcvCommon *p,
+  const char *zContainer,
+  i64 iDbId,
+  int iDbPos,
+  const u8 *aGeneration,
+  int nGeneration,
+  const u8 *aBlock,
+  int nBlock
+){
+  sqlite3_stmt *pStmt = p->pInsertStaged;
+  i64 iSeq = 0;
+  int rc;
+  rc = bcvfsStagedNextSequence(p, zContainer, &iSeq);
+  if( rc!=SQLITE_OK ) return rc;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_bind_int64(pStmt, 2, iDbId);
+  sqlite3_bind_int(pStmt, 3, iDbPos);
+  sqlite3_bind_blob(pStmt, 4, aGeneration, nGeneration, SQLITE_STATIC);
+  sqlite3_bind_blob(pStmt, 5, aBlock, nBlock, SQLITE_STATIC);
+  sqlite3_bind_int64(pStmt, 6, iSeq);
+  sqlite3_step(pStmt);
+  rc = sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
