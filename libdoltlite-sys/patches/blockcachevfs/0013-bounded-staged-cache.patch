+/*
+** Mark all staged generations for one logical block as discarded. The rows
+** remain in staged so that this operation is crash-safe: a restart can see
+** both the original mapping and the durable tombstone, and will not replay a
+** generation that was truncated or reverted. The object ids remain available
+** to the delayed-GC pass at the next publication.
+*/
+static int bcvfsStagedDelete(
+  BcvCommon *p,
+  const char *zContainer,
+  i64 iDbId,
+  int iDbPos
+){
+  sqlite3_stmt *pStmt = p->pDeleteStaged;
+  int rc;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_bind_int64(pStmt, 2, iDbId);
+  sqlite3_bind_int(pStmt, 3, iDbPos);
+  sqlite3_step(pStmt);
+  rc = sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
