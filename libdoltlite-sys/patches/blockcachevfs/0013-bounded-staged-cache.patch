+static int bcvfsPendingPublishPut(
+  BcvCommon *p,
+  const char *zContainer,
+  Manifest *pMan,
+  i64 *piMax
+){
+  sqlite3_stmt *pStmt = p->pInsertPending;
+  u8 *aMan = 0;
+  int nMan = 0;
+  int rc = SQLITE_OK;
+
+  aMan = bcvManifestCompose(pMan, &nMan);
+  if( aMan==0 ) rc = SQLITE_NOMEM;
+  if( rc==SQLITE_OK ) rc = bcvfsStagedMax(p, zContainer, piMax);
+  if( rc==SQLITE_OK ){
+    sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+    sqlite3_bind_blob(pStmt, 2, aMan, nMan, SQLITE_STATIC);
+    sqlite3_bind_int64(pStmt, 3, *piMax);
+    sqlite3_step(pStmt);
+    rc = sqlite3_reset(pStmt);
+    sqlite3_clear_bindings(pStmt);
+  }
+  sqlite3_free(aMan);
+  return rc;
+}
+
+static int bcvfsPendingPublishFind(
+  BcvCommon *p,
+  const char *zContainer,
+  u8 **paMan,
+  int *pnMan,
+  i64 *piMax
+){
+  sqlite3_stmt *pStmt = p->pFindPending;
+  const u8 *aMan;
+  int nMan;
+  int step;
+  int rc = SQLITE_OK;
+  *paMan = 0;
+  *pnMan = 0;
+  *piMax = 0;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  step = sqlite3_step(pStmt);
+  if( step==SQLITE_ROW ){
+    aMan = sqlite3_column_blob(pStmt, 0);
+    nMan = sqlite3_column_bytes(pStmt, 0);
+    *piMax = sqlite3_column_int64(pStmt, 1);
+    if( aMan==0 || nMan<=0 ){
+      rc = SQLITE_CORRUPT;
+    }else{
+      *paMan = (u8*)sqlite3_malloc(nMan);
+      if( *paMan==0 ){
+        rc = SQLITE_NOMEM;
+      }else{
+        memcpy(*paMan, aMan, nMan);
+        *pnMan = nMan;
+      }
+    }
+  }else if( step==SQLITE_DONE ){
+    rc = SQLITE_NOTFOUND;
+  }else{
+    rc = step;
+  }
+  sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
+
+static int bcvfsPendingPublishDelete(BcvCommon *p, const char *zContainer){
+  sqlite3_stmt *pStmt = p->pDeletePending;
+  int rc;
+  sqlite3_bind_text(pStmt, 1, zContainer, -1, SQLITE_STATIC);
+  sqlite3_step(pStmt);
+  rc = sqlite3_reset(pStmt);
+  sqlite3_clear_bindings(pStmt);
+  return rc;
+}
