+int bcvContainerSetAuthRefreshCallback(
+  BcvContainer *p,
+  void *pCtx,
+  int(*xAuth)(void*, const char*, const char*, const char*, int, char**),
+  const char *zStorage,
+  const char *zAccount,
+  const char *zContainer
+){
+  int rc = SQLITE_OK;
+  char *zStorageCopy = 0;
+  char *zAccountCopy = 0;
+  char *zContainerCopy = 0;
+  if( p==0 || xAuth==0 ) return SQLITE_MISUSE;
+  zStorageCopy = bcvStrdupRc(&rc, zStorage);
+  zAccountCopy = bcvStrdupRc(&rc, zAccount);
+  zContainerCopy = bcvStrdupRc(&rc, zContainer);
+  if( rc!=SQLITE_OK ){
+    sqlite3_free(zStorageCopy);
+    sqlite3_free(zAccountCopy);
+    sqlite3_free(zContainerCopy);
+    return rc;
+  }
+  sqlite3_free(p->zAuthStorage);
+  sqlite3_free(p->zAuthAccount);
+  sqlite3_free(p->zAuthContainer);
+  p->pAuthCtx = pCtx;
+  p->xAuthRefresh = xAuth;
+  p->zAuthStorage = zStorageCopy;
+  p->zAuthAccount = zAccountCopy;
+  p->zAuthContainer = zContainerCopy;
+  return SQLITE_OK;
+}
+
+static int bcvContainerRefreshAuth(
+  BcvContainer *p,
+  int eReason,
+  char **pzToken
+){
+  if( p==0 || p->xAuthRefresh==0 ) return SQLITE_NOTFOUND;
+  *pzToken = 0;
+  return p->xAuthRefresh(
+      p->pAuthCtx, p->zAuthStorage, p->zAuthAccount,
+      p->zAuthContainer, eReason, pzToken
+  );
+}
+
+int sqlite3_bcv_request_set_bearer_auth(
+  sqlite3_bcv_job *pJob,
+  sqlite3_bcv_request *pReq,
+  const char *zFallbackToken
+){
+  char *zHeader = 0;
+  int rc;
+  if( pJob==0 || pReq==0 || zFallbackToken==0 ) return SQLITE_MISUSE;
+  zHeader = sqlite3_mprintf("Authorization: Bearer %s", zFallbackToken);
+  rc = zHeader ? SQLITE_OK : SQLITE_NOMEM;
+  if( rc==SQLITE_OK ){
+    sqlite3_bcv_request_set_header(pReq, zHeader);
+    pReq->bBearerAuth = pJob->pCont->xAuthRefresh!=0;
+  }
+  sqlite3_free(zHeader);
+  return rc;
+}
+
+static int bcvRequestReplaceBearerHeader(
+  BcvDispatchReq *pReq,
+  const char *zToken
+){
+  struct curl_slist *pNew = 0;
+  struct curl_slist *pHdr;
+  char *zHeader = sqlite3_mprintf("Authorization: Bearer %s", zToken);
+  int rc = zHeader ? SQLITE_OK : SQLITE_NOMEM;
+  for(pHdr=pReq->pList; rc==SQLITE_OK && pHdr; pHdr=pHdr->next){
+    struct curl_slist *pAppend;
+    if( sqlite3_strnicmp(pHdr->data,"Authorization:",14)==0 ) continue;
+    pAppend = curl_slist_append(pNew,pHdr->data);
+    if( pAppend==0 ) rc = SQLITE_NOMEM;
+    else pNew = pAppend;
+  }
+  if( rc==SQLITE_OK ){
+    struct curl_slist *pWithAuth = curl_slist_append(pNew,zHeader);
+    if( pWithAuth==0 ) rc = SQLITE_NOMEM;
+    else pNew = pWithAuth;
+  }
+  if( rc==SQLITE_OK ){
+    curl_slist_free_all(pReq->pList);
+    pReq->pList = pNew;
+  }else{
+    curl_slist_free_all(pNew);
+  }
+  sqlite3_free(zHeader);
+  return rc;
+}
+
+static int bcvDispatchRequestAuth(
+  BcvDispatchReq *pReq,
+  int eReason
+){
+  char *zToken = 0;
+  int rc;
+  if( !pReq->bBearerAuth ) return SQLITE_NOTFOUND;
+  rc = bcvContainerRefreshAuth(pReq->pJob->pCont,eReason,&zToken);
+  if( rc==SQLITE_OK && (zToken==0 || zToken[0]=='\0') ) rc = SQLITE_AUTH;
+  if( rc==SQLITE_OK ) rc = bcvRequestReplaceBearerHeader(pReq,zToken);
+  sqlite3_free(zToken);
+  return rc;
+}
