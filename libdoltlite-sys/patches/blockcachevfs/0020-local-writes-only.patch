+/* Read the opt-in mode under the VFS lock because callers may configure a
+** process-lifetime VFS after it has been created. */
+static int bcvfsLocalWritesOnly(sqlite3_bcvfs *pFs){
+  int bLocal = 0;
+  if( pFs ){
+    ENTER_VFS_MUTEX; {
+      bLocal = pFs->bLocalWritesOnly;
+    } LEAVE_VFS_MUTEX;
+  }
+  return bLocal;
+}
+
+/* Mutating CBS APIs use this before opening a provider handle or dispatching
+** a request, so a read-capability VFS never attempts a cloud write. */
+static int bcvfsDenyCloudWrites(sqlite3_bcvfs *pFs, char **pzErr){
+  if( pzErr ) *pzErr = 0;
+  if( bcvfsLocalWritesOnly(pFs) ){
+    if( pzErr ) *pzErr = sqlite3_mprintf(
+        "VFS is configured for local writes only"
+    );
+    return SQLITE_READONLY;
+  }
+  return SQLITE_OK;
+}
+
+
