 static int bcvfsStageOneForFile(BcvfsFile *pFile){
+  /* Preserve dirty cache contents when no upload capability is available.
+  ** The caller can still write while a clean cache slot is available. */
+  if( bcvfsLocalWritesOnly(pFile->pFs) ) return SQLITE_FULL;
   return bcvfsStageOneForFileInternal(pFile, 0);
 }
 
 static int bcvfsStageOneForSession(BcvfsFile *pFile){
+  /* Session writes use a separate staging path; keep them local as well. */
+  if( bcvfsLocalWritesOnly(pFile->pFs) ) return SQLITE_FULL;
   return bcvfsStageOneForFileInternal(pFile, pFile->pCont);
 }
 
