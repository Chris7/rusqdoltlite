+      if( pEntry->pCont==pCont && pEntry->bDirty ){
+        if( pEntry->nRef!=0 || pEntry->bStaging ){
+          bBlocked = 1;
+        }else if( nBlocks==nLimit || nBlockSize<=0
+               || nBytes>nLimit-nBlockSize ){
+          bOverflow = 1;
+        }else{
+          nBlocks++;
+          nBytes += nBlockSize;
+        }
+      }
+    }
+  }
+  *pnBlocks = nBlocks;
+  *pnBytes = nBytes;
+  *pbBlocked = bBlocked;
+  *pbOverflow = bOverflow;
