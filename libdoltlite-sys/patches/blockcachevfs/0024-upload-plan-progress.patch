+  int bOverflow = 0;
+  int nBlockSize = pCont->pMan->szBlk;
+  const sqlite3_int64 nLimit = (sqlite3_int64)0x7fffffffffffffffLL;
+  for(ii=0; ii<pFs->c.nHash && !bOverflow; ii++){
