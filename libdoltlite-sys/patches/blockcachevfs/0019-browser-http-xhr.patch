+    Module.__bcv_headers = response_headers;
+    HEAPU32[status >> 2] = xhr.status;
+    HEAPU32[response_length >> 2] = response_body.length;
+    HEAPU32[headers_length >> 2] = lengthBytesUTF8(response_headers);
+    return 0;
