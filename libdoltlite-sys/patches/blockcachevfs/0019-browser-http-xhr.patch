+EM_JS(int, bcv_http_request_js,
+      (const char *method, const char *url, const char **headers, int count,
+       const u8 *body, size_t body_length, uint32_t *status,
+       size_t *response_length, size_t *headers_length,
+       uint32_t timeout_seconds), {
+  Module.__bcv_body = null;
+  Module.__bcv_headers = null;
+  try {
+    const request_url = UTF8ToString(url);
+    if (new URL(request_url).origin === self.location.origin) return -1;
+    const xhr = new XMLHttpRequest();
+    xhr.open(UTF8ToString(method), request_url, false);
+    xhr.withCredentials = false;
+    xhr.responseType = "arraybuffer";
