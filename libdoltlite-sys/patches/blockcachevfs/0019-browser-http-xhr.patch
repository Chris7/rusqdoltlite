+    case SQLITE_BCV_METHOD_PUT: method = "PUT"; break;
+    case SQLITE_BCV_METHOD_POST: method = "POST"; break;
+    case SQLITE_BCV_METHOD_HEAD: method = "HEAD"; break;
+    case SQLITE_BCV_METHOD_DELETE: method = "DELETE"; break;
