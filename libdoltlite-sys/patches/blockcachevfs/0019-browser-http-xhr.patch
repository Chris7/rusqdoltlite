+    request->rc = SQLITE_ERROR;
+    request->zStatus = bcvMprintfRc(&request->rc, "browser cloud HTTP request failed");
+    bcv_http_clear();
+    return request->rc;
+  }
+  if(body_length>0x7fffffff || headers_length>0x7fffffff
+   || (request->nMaxBody>=0 && body_length>(size_t)request->nMaxBody)
+   || (request->nMaxHdrs>=0 && headers_length>(size_t)request->nMaxHdrs)
+  ){
