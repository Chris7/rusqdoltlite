+  BcvCommon *pCommon = &pFs->c;
+  i64 nLimit;
+  i64 nCacheBlocks = 1;
+  i64 nBufferBlocks = 1;
+  ENTER_VFS_MUTEX; {
+    nLimit = pFs->nRequest;
+    if( nLimit<1 ) nLimit = 1;
+    if( nLimit>BCVFS_STAGE_BATCH_MAX ) nLimit = BCVFS_STAGE_BATCH_MAX;
+    if( pCommon->szBlk>0 ){
+      nCacheBlocks = pCommon->nMaxCache / pCommon->szBlk;
+      if( nCacheBlocks<1 ) nCacheBlocks = 1;
+      nBufferBlocks = BCVFS_STAGE_BUFFER_LIMIT / pCommon->szBlk;
+      if( nBufferBlocks<1 ) nBufferBlocks = 1;
+    }
+    if( nLimit>nCacheBlocks ) nLimit = nCacheBlocks;
+    if( nLimit>nBufferBlocks ) nLimit = nBufferBlocks;
+  } LEAVE_VFS_MUTEX;
+  return (int)nLimit;
+}
