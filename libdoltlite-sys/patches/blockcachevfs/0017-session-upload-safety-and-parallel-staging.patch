+){
+  const char *zStatus = 0;
+  const char *zETag;
+  const u8 *aBody;
+  const u8 *aHdrs;
+  int nBody;
+  int nHdrs;
+  int rc = sqlite3_bcv_request_status(pReq, &zStatus);
+  if( rc!=SQLITE_OK ){
+    /* Preserve HTTP_PRECONDITION_FAILED (GCS 304) for conditional download
+    ** callers, which use it to retain their existing local block. */
+    sqlite3_bcv_job_error(pCtx, rc, zStatus);
+    return;
+  }
+  aBody = sqlite3_bcv_request_body(pReq, &nBody);
+  rc = bcvGoogleJsonVerifyCrc32c(
+      aBody, nBody, sqlite3_bcv_request_header(pReq, "x-goog-hash")
+  );
+  if( rc!=SQLITE_OK ){
+    sqlite3_bcv_job_error(pCtx, rc,
+        "missing, malformed, or mismatched Google JSON CRC32C");
+    return;
+  }
+  sqlite3_bcv_job_result(pCtx, aBody, nBody);
+  aHdrs = sqlite3_bcv_request_hdrs(pReq, &nHdrs);
+  sqlite3_bcv_job_hdrs(pCtx, aHdrs, nHdrs);
+  zETag = sqlite3_bcv_request_header(pReq, (const char*)pApp);
+  sqlite3_bcv_job_etag(pCtx, zETag);
+}
