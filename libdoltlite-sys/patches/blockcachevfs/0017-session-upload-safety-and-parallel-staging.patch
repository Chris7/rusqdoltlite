+static char *bcvGoogleJsonCrc32c(const u8 *aData, int nData){
+  u32 aTable[256];
+  u32 crc = 0xFFFFFFFFU;
+  u8 aCrc[4];
+  int i;
+  int j;
+  for(i=0; i<256; i++){
+    u32 value = (u32)i;
+    for(j=0; j<8; j++){
+      u32 mask = (u32)-(int)(value & 1U);
+      value = (value >> 1) ^ (0x82F63B78U & mask);
+    }
+    aTable[i] = value;
+  }
+  for(i=0; i<nData; i++){
+    crc = aTable[(crc ^ aData[i]) & 0xFFU] ^ (crc >> 8);
+  }
+  crc = ~crc;
+  aCrc[0] = (u8)(crc >> 24);
+  aCrc[1] = (u8)(crc >> 16);
+  aCrc[2] = (u8)(crc >> 8);
+  aCrc[3] = (u8)crc;
+  return bcvBase64Encode(aCrc, sizeof(aCrc));
+}
+
+/* Google JSON media downloads include the stored CRC32C in X-Goog-Hash.
+** Require exactly one well-formed crc32c token and compare it before passing
+** the response body to a CBS consumer or cache writer. */
+static int bcvGoogleJsonVerifyCrc32c(
+  const u8 *aData, int nData, const char *zHash
+){
+  char *zExpected;
+  const char *zCsr = zHash;
+  int bFound = 0;
+  int rc = SQLITE_CORRUPT;
+  if( zCsr==0 || nData<0 || (nData>0 && aData==0) ) return SQLITE_CORRUPT;
+  zExpected = bcvGoogleJsonCrc32c(aData, nData);
+  if( zExpected==0 ) return SQLITE_NOMEM;
+  while( *zCsr ){
+    const char *zValue;
+    const char *zEnd;
+    while( *zCsr && (*zCsr==',' || isspace((unsigned char)*zCsr)) ) zCsr++;
+    if( *zCsr==0 ) break;
+    if( sqlite3_strnicmp(zCsr, "crc32c=", 7)==0 ){
+      zValue = zCsr+7;
+      zEnd = zValue;
+      while( *zEnd && *zEnd!=',' && !isspace((unsigned char)*zEnd) ) zEnd++;
+      if( bFound || zEnd-zValue!=8 ){
+        sqlite3_free(zExpected);
+        return SQLITE_CORRUPT;
+      }
+      bFound = 1;
+      if( 0==memcmp(zValue, zExpected, 8) ) rc = SQLITE_OK;
+      zCsr = zEnd;
+      if( rc!=SQLITE_OK ) break;
+    }else{
+      while( *zCsr && *zCsr!=',' ) zCsr++;
+    }
+  }
+  sqlite3_free(zExpected);
+  return bFound ? rc : SQLITE_CORRUPT;
+}
