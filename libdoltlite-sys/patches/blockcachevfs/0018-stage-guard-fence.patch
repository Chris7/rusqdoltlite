+#define BCVFS_SESSION_GUARD_RETRIES 120
+#define BCVFS_SESSION_GUARD_RETRY_MS 100
+
+/* Register the block with a durable attempt marker only when no cleanup
+** sweep overlaps marker publication. Cleanup acquires the global guard before
+** listing attempt markers. Matching idle ETags prove either that no sweep
+** crossed this window or that the marker predates the current sweep. */
+static int bcvfsSessionProtectBlockFenced(
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  const char *zSessionId,
+  const u8 *aOperationId,
+  const u8 *aScopeHash,
+  const u8 *aBlock,
+  int nBlock
+){
+  int iTry;
+  int rc = SQLITE_BUSY;
+  for(iTry=0; iTry<BCVFS_SESSION_GUARD_RETRIES; iTry++){
+    char *zBefore = 0;
+    char *zAfter = 0;
+    rc = bcvSessionGuardReadIdle(pDisp,pBcv,&zBefore);
+    if( rc==SQLITE_BUSY ){
+      sqlite3_free(zBefore);
+      sqlite3_sleep(BCVFS_SESSION_GUARD_RETRY_MS);
+      continue;
+    }
+    if( rc==SQLITE_OK ){
+      rc = bcvfsSessionProtectBlock(
+          pDisp,pBcv,zSessionId,aOperationId,aScopeHash,aBlock,nBlock
+      );
+    }
+    if( rc==SQLITE_OK ){
+      rc = bcvSessionGuardReadIdle(pDisp,pBcv,&zAfter);
+    }
+    if( rc==SQLITE_OK
+     && ((zBefore==0 && zAfter==0)
+      || (zBefore && zAfter && strcmp(zBefore,zAfter)==0))
+    ){
+      sqlite3_free(zBefore);
+      sqlite3_free(zAfter);
+      return SQLITE_OK;
+    }
+    sqlite3_free(zBefore);
+    sqlite3_free(zAfter);
+    if( rc!=SQLITE_OK && rc!=SQLITE_BUSY ) return rc;
+    rc = SQLITE_BUSY;
+    sqlite3_sleep(BCVFS_SESSION_GUARD_RETRY_MS);
+  }
+  return rc;
+}
