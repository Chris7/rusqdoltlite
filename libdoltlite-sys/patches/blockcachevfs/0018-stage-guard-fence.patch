+int bcvSessionGuardReadIdle(
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  char **pzETag
+){
+  BcvSessionGcFetch fetch;
+  u8 aOwner[16];
+  int eMode = 0;
+  i64 iExpires = 0;
+  int rc;
+  if( pzETag ) *pzETag = 0;
+  if( pDisp==0 || pBcv==0 || pzETag==0 ) return SQLITE_MISUSE;
+  rc = bcvSessionGuardFetch(pDisp,pBcv,&fetch);
+  if( rc==HTTP_NOT_FOUND ){
+    sqlite3_free(fetch.aData);
+    sqlite3_free(fetch.zETag);
+    sqlite3_free(fetch.zErr);
+    return SQLITE_OK;
+  }
+  if( rc==SQLITE_OK ){
+    rc = bcvSessionGuardDecode(
+        fetch.aData,fetch.nData,&eMode,&iExpires,aOwner
+    );
+  }
+  if( rc==SQLITE_OK && eMode!=BCV_SESSION_GC_GUARD_IDLE ) rc = SQLITE_BUSY;
+  if( rc==SQLITE_OK ){
+    if( fetch.zETag==0 ){
+      rc = SQLITE_CORRUPT;
+    }else{
+      *pzETag = sqlite3_mprintf("%s",fetch.zETag);
+      if( *pzETag==0 ) rc = SQLITE_NOMEM;
+    }
+  }
+  sqlite3_free(fetch.aData);
+  sqlite3_free(fetch.zETag);
+  sqlite3_free(fetch.zErr);
   return rc;
 }
 
