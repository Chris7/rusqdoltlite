+#define SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES (16*1024*1024)
+#define SQLITE_BCVFS_SESSION_ETAG_MAX_BYTES 4096
+#define SQLITE_BCVFS_SESSION_BODY_MAX_BYTES \
+  (SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES \
+   - SQLITE_BCVFS_SESSION_RECORD_HEADER_BYTES \
+   - SQLITE_BCVFS_SESSION_HASH_BYTES)
+
+#define SQLITE_BCVFS_SESSION_CHECKPOINT 1
+#define SQLITE_BCVFS_SESSION_HEAD       2
+#define SQLITE_BCVFS_SESSION_PUBLICATION 3
+#define SQLITE_BCVFS_SESSION_HISTORY 4
+
+/* A compacted checkpoint is a complete immutable overlay snapshot.  Its
+** body carries the accepted predecessor so the record header can terminate
+** the old checkpoint chain at the compaction boundary. */
+#define SQLITE_BCVFS_SESSION_COMPACTED_BODY_BYTES 32
+
+#define SQLITE_BCVFS_SESSION_OPEN       1
+#define SQLITE_BCVFS_SESSION_ACCEPTED   2
+#define SQLITE_BCVFS_SESSION_PUBLISHING 3
+#define SQLITE_BCVFS_SESSION_COMMITTED  4
+#define SQLITE_BCVFS_SESSION_ABORTED    5
+#define SQLITE_BCVFS_SESSION_EXPIRED    6
+
+#define SQLITE_BCVFS_SESSION_OUTCOME_NONE     0
+#define SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS  1
+#define SQLITE_BCVFS_SESSION_OUTCOME_FAILURE  2
+#define SQLITE_BCVFS_SESSION_OUTCOME_CONFLICT 3
+
+/* Application-visible result of checking an operation before retrying its
+** mutating handler.  A different operation at the current session head is a
+** conflict, never permission to rerun blindly. */
+#define SQLITE_BCVFS_SESSION_STATUS_NEW       0
+#define SQLITE_BCVFS_SESSION_STATUS_ACCEPTED  1
+#define SQLITE_BCVFS_SESSION_STATUS_COMMITTED 2
+#define SQLITE_BCVFS_SESSION_STATUS_FAILED    3
+#define SQLITE_BCVFS_SESSION_STATUS_CONFLICT  4
+
+typedef struct sqlite3_bcvfs_session_record sqlite3_bcvfs_session_record;
+struct sqlite3_bcvfs_session_record {
+  int eType;                       /* SQLITE_BCVFS_SESSION_XXX */
+  int eState;                      /* SQLITE_BCVFS_SESSION_XXX */
+  int eOutcome;                    /* SQLITE_BCVFS_SESSION_OUTCOME_XXX */
+  sqlite3_uint64 iSequence;        /* Monotonic within a session */
+  sqlite3_int64 iCreated;          /* SQLite xCurrentTimeInt64 units */
+  sqlite3_int64 iExpires;          /* Strictly greater than iCreated */
+  char zSessionId[SQLITE_BCVFS_SESSION_ID_TEXT_BYTES];
+  unsigned char aScopeHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aPredecessorHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES]; /* Required for checkpoints and non-open request heads */
+  const unsigned char *aBody;       /* Borrowed from encoded bytes */
+  int nBody;
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+};
+
+/* Typed body views.  The view borrows bytes from the encoded record.  A
+** CHECKPOINT body is "BCVCP01\0", u64 file-size, u32 manifest length,
+** u32 base-manifest-ETag length, then the ETag and exact serialized CBS
+** Manifest bytes.  A HEAD body is "BCVHD02\0", u32 history operation count
+** at offset 108, u32 ETag length at offset 112, a checkpoint hash,
+** candidate-manifest hash, history root, bounded operation-ID tail, then the
+** base-manifest ETag.  A PUBLICATION body is
+** "BCVPH01\0", a UUID, checkpoint hash, candidate-manifest hash, u32 ETag
+** length and the base-manifest ETag.  Lengths are bounded and there are no
+** trailing bytes.  ETags are opaque provider tokens, not content hashes.
+** The session-record encoder/decoder validates this schema for each type. */
+typedef struct sqlite3_bcvfs_session_body sqlite3_bcvfs_session_body;
+struct sqlite3_bcvfs_session_body {
+  int eType;
+  int bCompacted;                 /* CHECKPOINT body carries base hash */
+  sqlite3_uint64 iFileSize;       /* CHECKPOINT only */
+  unsigned char aSessionId[16];   /* PUBLICATION only */
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCandidateManifestHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHistoryHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  const unsigned char *aBaseManifestETag;
+  int nBaseManifestETag;
+  const unsigned char *aManifest;
+  int nManifest;
+  unsigned char aBaseCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  /* HEAD V2 and HISTORY V2 expose a bounded operation-ID vector.  The view
+  ** borrows bytes from the encoded body; individual IDs are contiguous. */
+  const unsigned char *aHistoryOperations;
+  int nHistoryOperations;
+};
