+typedef struct CollectCtx CollectCtx;
+
+/* Session-aware cleanup is deliberately implemented in the CBS utility
+** layer.  The ordinary cleanup handle has no VFS attachment (and therefore
+** no session scope), so it treats the session namespace as opaque metadata
+** and validates only the authenticated record envelope and its embedded
+** immutable checkpoint manifests.  A malformed or ambiguous record stops
+** cleanup before any remote delete is issued.
+*/
+#define BCV_SESSION_GC_PREFIX "bcv-session/v1/"
+#define BCV_SESSION_GC_CHECKPOINT_PREFIX BCV_SESSION_GC_PREFIX "checkpoint/"
+#define BCV_SESSION_GC_HISTORY_PREFIX BCV_SESSION_GC_PREFIX "history/"
+#define BCV_SESSION_GC_CANDIDATE_PREFIX BCV_SESSION_GC_PREFIX "candidate/"
+#define BCV_SESSION_GC_ATTEMPT_PREFIX BCV_SESSION_GC_PREFIX "attempt/"
+#define BCV_SESSION_GC_VERSION 1
+#define BCV_SESSION_GC_HEADER_BYTES 168
+#define BCV_SESSION_GC_HASH_BYTES 32
+#define BCV_SESSION_GC_TRAILER_BYTES BCV_SESSION_GC_HASH_BYTES
+#define BCV_SESSION_GC_RECORD_MAX (16*1024*1024)
+#define BCV_SESSION_GC_MAX_ETAG 4096
+#define BCV_SESSION_GC_MAX_OBJECTS 65536
+#define BCV_SESSION_GC_MAX_HISTORY_OPERATIONS 1024
+#define BCV_SESSION_GC_MAX_CHAIN 1024
+#define BCV_SESSION_GC_MAX_BLOCKS 262144
+#define BCV_SESSION_GC_MAX_DATABASES 4096
+#define BCV_SESSION_GC_MAX_TTL (30LL*24*60*60*1000)
+#define BCV_SESSION_GC_ATTEMPT_BODY_BYTES 172
+#define BCV_SESSION_GC_ATTEMPT_TTL (30LL*24*60*60*1000)
+#define BCV_SESSION_GC_GUARD_NAME BCV_SESSION_GC_PREFIX "guard.bcv"
+#define BCV_SESSION_GC_GUARD_BODY_BYTES 68
+#define BCV_SESSION_GC_GUARD_TTL (30LL*24*60*60*1000)
+#define BCV_SESSION_GC_GUARD_IDLE 0
+#define BCV_SESSION_GC_GUARD_SWEEP_STATE 1
+#define BCV_SESSION_GC_GUARD_WRITER 1
+#define BCV_SESSION_GC_GUARD_SWEEP 2
+/* A SWEEP guard is never stolen on the basis of wall-clock expiry. If a
+** process dies after acquiring it, cleanup remains fail-closed until an
+** explicit recovery operation can prove that the old sweep stopped. */
+
+typedef struct BcvSessionGcObject BcvSessionGcObject;
+typedef struct BcvSessionGc BcvSessionGc;
+typedef struct BcvSessionGcRecord BcvSessionGcRecord;
+
+static void bcvExtraLog(sqlite3_bcv*, const char*, ...);
