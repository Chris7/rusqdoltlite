+    if( nFile && aData==0 ) rc = SQLITE_NOMEM;
+  }
+  if( rc==SQLITE_OK && nFile ) rc = bcvReadfile(pFd,aData,(int)nFile,0);
+  bcvCloseLocal(pFd);
