+static int bcvfsSessionManifestFetch(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  unsigned char **paData,
+  int *pnData,
+  char **pzETag,
+  char **pzErr
+){
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  BcvSessionManifestCtx ctx;
+  int rc;
+  int bAcquired = 0;
+  if( paData ) *paData = 0;
+  if( pnData ) *pnData = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( paData==0 || pnData==0 || pzETag==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"manifest fetch outputs are required");
+  }
+  rc = bcvSessionAcquire(pFs,zAlias,0,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc==SQLITE_OK ){
+    bAcquired = 1;
+    if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session publication scope is not bound");
+    }
+  }
+  memset(&ctx,0,sizeof(ctx));
+  if( rc==SQLITE_OK ){
+    rc = bcvDispatchFetchMax(
+        pDisp,pBcv,BCV_MANIFEST_FILE,0,0,
+        SQLITE_BCVFS_SESSION_BODY_MAX_BYTES,64*1024,
+        &ctx,bcvSessionManifestFetchCb
+    );
+  }
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  if( rc==SQLITE_OK ){
+    *paData = ctx.aData;
+    *pnData = ctx.nData;
+    *pzETag = ctx.zETag;
+    ctx.aData = 0;
+    ctx.zETag = 0;
+  }else if( pzErr && *pzErr==0 && ctx.zErr ){
+    *pzErr = ctx.zErr;
+    ctx.zErr = 0;
+  }
+  sqlite3_free(ctx.aData);
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  if( bAcquired ) bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
