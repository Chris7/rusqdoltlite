+/* Candidate manifests are immutable, storage-scoped objects.  The object
+** name is derived solely from the exact candidate bytes' SHA-256 digest, so a
+** later request can recover a publication that died before its manifest PUT
+** without knowing the original owner's principal or full request scope.  The
+** key intentionally carries no inferred creation time: cleanup must retain a
+** candidate that is not yet referenced by a head (there is no safe age from
+** which to delete a PUT-before-head-CAS object).  Once a head references it,
+** cleanup may use that head's record expiry plus its grace interval. */
+static int bcvfsSessionCandidateName(
+  const unsigned char *aCandidateHash,
+  char *zOut,
+  int nOut,
+  char **pzErr
+){
+  char zHash[SQLITE_BCVFS_SESSION_HASH_BYTES*2+1];
+  size_t n;
+  if( pzErr ) *pzErr = 0;
+  if( zOut==0 || nOut<=0 || aCandidateHash==0
+   || bcvSessionAllZero(aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"candidate object identity is invalid");
+  }
+  hex_encode(
+      aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES,zHash,0
+  );
+  sqlite3_snprintf(nOut,zOut,BCV_SESSION_ROOT "candidate/%s.bcv",zHash);
+  n = strlen(zOut);
+  if( n>= (size_t)nOut ){
+    if( nOut>0 ) zOut[0] = '\0';
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"candidate object name is too long");
+  }
+  return SQLITE_OK;
+}
+
+static int bcvfsSessionCandidateFetch(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const unsigned char *aCandidateHash,
+  unsigned char **paData,
+  int *pnData,
+  char **pzETag,
+  char **pzErr
+){
+  char zName[256];
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  BcvSessionManifestCtx ctx;
+  int rc;
+  int bAcquired = 0;
+  if( paData ) *paData = 0;
+  if( pnData ) *pnData = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( paData==0 || pnData==0 || pzETag==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"candidate fetch outputs are required");
+  }
+  rc = bcvfsSessionCandidateName(aCandidateHash,zName,sizeof(zName),pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionAcquire(pFs,zAlias,0,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc==SQLITE_OK ){
+    bAcquired = 1;
+    if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"candidate scope is not bound");
+    }
+  }
+  memset(&ctx,0,sizeof(ctx));
+  if( rc==SQLITE_OK ) rc = bcvDispatchFetchMax(
+      pDisp,pBcv,zName,0,0,SQLITE_BCVFS_SESSION_BODY_MAX_BYTES,64*1024,
+      &ctx,bcvSessionManifestFetchCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  if( rc==SQLITE_OK ){
+    *paData = ctx.aData;
+    *pnData = ctx.nData;
+    *pzETag = ctx.zETag;
+    ctx.aData = 0;
+    ctx.zETag = 0;
+  }else if( pzErr && *pzErr==0 && ctx.zErr ){
+    *pzErr = ctx.zErr;
+    ctx.zErr = 0;
+  }
+  sqlite3_free(ctx.aData);
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  if( bAcquired ) bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
+
+static int bcvfsSessionCandidatePut(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const unsigned char *aCandidateHash,
+  const unsigned char *aData,
+  int nData,
+  char **pzETag,
+  char **pzErr
+){
+  char zName[256];
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  BcvSessionPutCtx ctx;
+  int rc;
+  int bAcquired = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( pzETag==0 || aData==0 || nData<=0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"candidate PUT arguments are required");
+  }
+  if( nData>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES ){
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"candidate manifest is too large");
+  }
+  rc = bcvfsSessionCandidateName(aCandidateHash,zName,sizeof(zName),pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionAcquire(pFs,zAlias,0,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc==SQLITE_OK ){
+    bAcquired = 1;
+    if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"candidate scope is not bound");
+    }
+  }
+  memset(&ctx,0,sizeof(ctx));
+  if( rc==SQLITE_OK ) rc = bcvDispatchPutMax(
+      pDisp,pBcv,zName,"*",aData,nData,
+      SQLITE_BCVFS_SESSION_BODY_MAX_BYTES,64*1024,&ctx,bcvSessionPutCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  if( rc!=SQLITE_OK ){
+    int rcPut = rc;
+    char *zPutErr = ctx.zErr;
+    unsigned char *aExisting = 0;
+    int nExisting = 0;
+    char *zExistingETag = 0;
+    char *zFetchErr = 0;
+    ctx.zErr = 0;
+    if( bAcquired ){
+      bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+      pCont = 0;
+      pDisp = 0;
+      pBcv = 0;
+      bAcquired = 0;
+    }
+    rc = bcvfsSessionCandidateFetch(
+        pFs,zAlias,aCandidateHash,&aExisting,&nExisting,
+        &zExistingETag,&zFetchErr
+    );
+    if( rc==SQLITE_OK
+     && nExisting==nData
+     && memcmp(aExisting,aData,nData)==0
+    ){
+      *pzETag = zExistingETag;
+      zExistingETag = 0;
+    }else if( rc==SQLITE_OK ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "candidate object already contains different bytes"
+      );
+    }else{
+      rc = rcPut;
+      if( pzErr && *pzErr==0 ){
+        *pzErr = zPutErr ? zPutErr : zFetchErr;
+        if( *pzErr==zPutErr ) zPutErr = 0;
+        if( *pzErr==zFetchErr ) zFetchErr = 0;
+      }
+    }
+    sqlite3_free(zPutErr);
+    sqlite3_free(zFetchErr);
+    sqlite3_free(aExisting);
+    sqlite3_free(zExistingETag);
+  }else{
+    *pzETag = ctx.zETag;
+    ctx.zETag = 0;
+  }
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  if( bAcquired ) bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
+
+static int bcvfsSessionHeadBody(
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  const unsigned char *aHistoryHeadHash,
+  const unsigned char *aHistoryOperations,
+  int nHistoryOperations,
+  unsigned char **paBody,
+  int *pnBody,
+  char **pzErr
+){
+  size_t nETag;
+  sqlite3_uint64 nBody64;
+  unsigned char *aBody;
+  if( paBody ) *paBody = 0;
+  if( pnBody ) *pnBody = 0;
+  if( zBaseETag==0 || aCheckpointHash==0 || aCandidateHash==0
+   || paBody==0 || pnBody==0 || nHistoryOperations<0
+   || nHistoryOperations>BCV_SESSION_MAX_HISTORY_OPERATIONS
+   || (nHistoryOperations>0 && aHistoryOperations==0)
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session head body arguments are required");
+  }
+  nETag = strlen(zBaseETag);
+  if( nETag==0 || nETag>BCV_SESSION_MAX_ETAG_BYTES ){
+    return bcvSessionError(SQLITE_CORRUPT,pzErr,"session head requires a base manifest ETag");
+  }
+  nBody64 = 116 + (sqlite3_uint64)nHistoryOperations
+      * SQLITE_BCVFS_SESSION_HASH_BYTES + nETag;
+  if( nBody64>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES || nBody64>0x7fffffffULL ){
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"session head body is too large");
+  }
+  aBody = (unsigned char*)sqlite3_malloc64(nBody64);
+  if( aBody==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  memset(aBody,0,(size_t)nBody64);
+  memcpy(aBody,aBcvSessionHeadBodyMagic,8);
+  memcpy(&aBody[12],aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memcpy(&aBody[44],aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  if( aHistoryHeadHash ) memcpy(
+      &aBody[76],aHistoryHeadHash,SQLITE_BCVFS_SESSION_HASH_BYTES
+  );
+  bcvPutU32(&aBody[108],(u32)nHistoryOperations);
+  bcvPutU32(&aBody[112],(u32)nETag);
+  if( nHistoryOperations ) memcpy(
+      &aBody[116],aHistoryOperations,
+      (size_t)nHistoryOperations*SQLITE_BCVFS_SESSION_HASH_BYTES
+  );
+  memcpy(&aBody[116 + (size_t)nHistoryOperations
+      * SQLITE_BCVFS_SESSION_HASH_BYTES],zBaseETag,nETag);
+  *paBody = aBody;
+  *pnBody = (int)nBody64;
+  return SQLITE_OK;
+}
+
+static int bcvfsSessionPublicationBody(
+  const char *zSessionId,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  unsigned char **paBody,
+  int *pnBody,
+  char **pzErr
+){
+  unsigned char aUuid[16];
+  size_t nETag;
+  unsigned char *aBody;
+  if( paBody ) *paBody = 0;
+  if( pnBody ) *pnBody = 0;
+  if( paBody==0 || pnBody==0 || aCheckpointHash==0 || aCandidateHash==0
+   || !bcvSessionUuidDecode(zSessionId,aUuid) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"publication body identity is invalid");
+  }
+  nETag = zBaseETag ? strlen(zBaseETag) : 0;
+  if( nETag==0 || nETag>BCV_SESSION_MAX_ETAG_BYTES ){
+    return bcvSessionError(SQLITE_CORRUPT,pzErr,"publication requires a base manifest ETag");
+  }
+  aBody = (unsigned char*)sqlite3_malloc64(92+nETag);
+  if( aBody==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  memcpy(aBody,aBcvSessionPublicationBodyMagic,8);
+  memcpy(&aBody[8],aUuid,sizeof(aUuid));
+  memcpy(&aBody[24],aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memcpy(&aBody[56],aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  bcvPutU32(&aBody[88],(u32)nETag);
+  memcpy(&aBody[92],zBaseETag,nETag);
+  *paBody = aBody;
+  *pnBody = 92+(int)nETag;
+  return SQLITE_OK;
+}
+
+static int bcvfsSessionEncodeHeadStateEx(
+  const sqlite3_bcvfs_session_record *pOld,
+  int eState,
+  int eOutcome,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  const unsigned char *aHistoryHeadHash,
+  const unsigned char *aHistoryOperations,
+  int nHistoryOperations,
+  unsigned char **paEncoded,
+  int *pnEncoded,
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  sqlite3_bcvfs_session_record record;
+  unsigned char *aBody = 0;
+  int nBody = 0;
+  int rc;
+  unsigned char aOldHistoryHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  const unsigned char *aUseHistoryHeadHash = aHistoryHeadHash;
+  const unsigned char *aUseHistoryOperations = aHistoryOperations;
+  int nUseHistoryOperations = nHistoryOperations;
+  if( paEncoded ) *paEncoded = 0;
+  if( pnEncoded ) *pnEncoded = 0;
+  memset(aRecordHash,0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memset(aOldHistoryHeadHash,0,sizeof(aOldHistoryHeadHash));
+  if( aHistoryHeadHash==0 && aHistoryOperations==0 && nHistoryOperations==0
+   && pOld!=0 && pOld->eType==SQLITE_BCVFS_SESSION_HEAD
+   && pOld->aBody!=0 && pOld->nBody>0
+  ){
+    sqlite3_bcvfs_session_body oldBody;
+    memset(&oldBody,0,sizeof(oldBody));
+    rc = sqlite3_bcvfs_session_body_decode(
+        pOld->eType,pOld->eState,pOld->zSessionId,
+        pOld->aBody,pOld->nBody,&oldBody,pzErr
+    );
+    if( rc!=SQLITE_OK ) return rc;
+    memcpy(aOldHistoryHeadHash,oldBody.aHistoryHeadHash,
+        sizeof(aOldHistoryHeadHash));
+    aUseHistoryHeadHash = aOldHistoryHeadHash;
+    aUseHistoryOperations = oldBody.aHistoryOperations;
+    nUseHistoryOperations = oldBody.nHistoryOperations;
+  }
+  rc = bcvfsSessionHeadBody(
+      aCheckpointHash,aCandidateHash,zBaseETag,
+      aUseHistoryHeadHash,aUseHistoryOperations,nUseHistoryOperations,
+      &aBody,&nBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) return rc;
+  memset(&record,0,sizeof(record));
+  record = *pOld;
+  record.eState = eState;
+  record.eOutcome = eOutcome;
+  if( pOld->eState!=eState || pOld->eOutcome!=eOutcome ){
+    memcpy(record.aPredecessorHash,pOld->aRecordHash,sizeof(record.aPredecessorHash));
+  }
+  record.aBody = aBody;
+  record.nBody = nBody;
+  rc = sqlite3_bcvfs_session_record_encode(
+      &record,paEncoded,pnEncoded,aRecordHash,pzErr
+  );
+  sqlite3_free(aBody);
+  return rc;
+}
+
+/* Existing publication/finalization callers do not change the operation
+** history. Decode and carry the immutable history state forward. */
+static int bcvfsSessionEncodeHeadState(
+  const sqlite3_bcvfs_session_record *pOld,
+  int eState,
+  int eOutcome,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  unsigned char **paEncoded,
+  int *pnEncoded,
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  return bcvfsSessionEncodeHeadStateEx(
+      pOld,eState,eOutcome,aCheckpointHash,aCandidateHash,zBaseETag,
+      0,0,0,paEncoded,pnEncoded,aRecordHash,pzErr
+  );
+}
+
+static int bcvfsSessionEncodePublicationState(
+  const sqlite3_bcvfs_session_record *pBase,
+  const char *zSessionId,
+  const unsigned char aStorageScope[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  const unsigned char *aOperationId,
+  int eState,
+  int eOutcome,
+  unsigned char **paEncoded,
+  int *pnEncoded,
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  sqlite3_bcvfs_session_record record;
+  unsigned char *aBody = 0;
+  sqlite3_bcvfs_session_body oldBody;
+  sqlite3_int64 iNow;
+  int bSameCandidate = 0;
+  int nBody = 0;
+  int rc;
+  if( paEncoded ) *paEncoded = 0;
+  if( pnEncoded ) *pnEncoded = 0;
+  memset(aRecordHash,0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  rc = bcvfsSessionPublicationBody(
+      zSessionId,aCheckpointHash,aCandidateHash,zBaseETag,
+      &aBody,&nBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) return rc;
+  memset(&record,0,sizeof(record));
+  memset(&oldBody,0,sizeof(oldBody));
+  if( pBase ){
+    record = *pBase;
+    if( pBase->eType==SQLITE_BCVFS_SESSION_PUBLICATION ){
+      if( pBase->iSequence==0xFFFFFFFFFFFFFFFFULL ){
+        sqlite3_free(aBody);
+        return bcvSessionError(SQLITE_TOOBIG,pzErr,"publication sequence exhausted");
+      }
+      record.iSequence = pBase->iSequence+1;
+    }else{
+      record.iSequence = pBase->iSequence;
+    }
+    record.iCreated = pBase->iCreated;
+    record.iExpires = pBase->iExpires;
+    memcpy(record.aPredecessorHash,pBase->aRecordHash,sizeof(record.aPredecessorHash));
+    if( pBase->eType==SQLITE_BCVFS_SESSION_PUBLICATION ){
+      rc = sqlite3_bcvfs_session_body_decode(
+          pBase->eType,pBase->eState,pBase->zSessionId,
+          pBase->aBody,pBase->nBody,&oldBody,pzErr
+      );
+      if( rc==SQLITE_OK
+       && 0==strcmp(pBase->zSessionId,zSessionId)
+       && oldBody.nBaseManifestETag==(int)strlen(zBaseETag)
+       && 0==memcmp(oldBody.aBaseManifestETag,zBaseETag,
+           oldBody.nBaseManifestETag)
+       && 0==memcmp(oldBody.aCheckpointHash,aCheckpointHash,
+           SQLITE_BCVFS_SESSION_HASH_BYTES)
+       && 0==memcmp(oldBody.aCandidateManifestHash,aCandidateHash,
+           SQLITE_BCVFS_SESSION_HASH_BYTES)
+      ){
+        bSameCandidate = 1;
+      }
+      if( rc!=SQLITE_OK ){
+        sqlite3_free(aBody);
+        return rc;
+      }
+    }
+  }else{
+    record.iSequence = 1;
+  }
+  if( !bSameCandidate ){
+    iNow = sqlite_timestamp();
+    record.iCreated = iNow;
+    record.iExpires = iNow + BCV_SESSION_TTL_MILLISECONDS;
+  }
+  record.eType = SQLITE_BCVFS_SESSION_PUBLICATION;
+  record.eState = eState;
+  record.eOutcome = eOutcome;
+  memcpy(record.zSessionId,zSessionId,strlen(zSessionId)+1);
+  memcpy(record.aScopeHash,aStorageScope,sizeof(record.aScopeHash));
+  if( aOperationId ) memcpy(record.aOperationId,aOperationId,sizeof(record.aOperationId));
+  else memcpy(record.aOperationId,aCandidateHash,sizeof(record.aOperationId));
+  record.aBody = aBody;
+  record.nBody = nBody;
+  rc = sqlite3_bcvfs_session_record_encode(
+      &record,paEncoded,pnEncoded,aRecordHash,pzErr
+  );
+  sqlite3_free(aBody);
+  return rc;
+}
+
+static int bcvfsSessionHeadMatches(
+  const sqlite3_bcvfs_session_record *pRecord,
+  int eState,
+  int eOutcome,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  char **pzErr
+){
+  sqlite3_bcvfs_session_body body;
+  if( pRecord==0 || pRecord->eType!=SQLITE_BCVFS_SESSION_HEAD
+   || pRecord->eState!=eState || pRecord->eOutcome!=eOutcome ) return 0;
+  if( sqlite3_bcvfs_session_body_decode(
+          pRecord->eType,pRecord->eState,pRecord->zSessionId,
+          pRecord->aBody,pRecord->nBody,&body,pzErr
+  )!=SQLITE_OK
+  ) return 0;
+  return !memcmp(body.aCheckpointHash,aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+      && (aCandidateHash==0
+          || !memcmp(body.aCandidateManifestHash,aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES))
+      && body.nBaseManifestETag==(int)strlen(zBaseETag)
+      && !memcmp(body.aBaseManifestETag,zBaseETag,body.nBaseManifestETag);
+}
+
+static int bcvfsSessionPublicationMatches(
+  const sqlite3_bcvfs_session_record *pRecord,
+  int eState,
+  const char *zSessionId,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  char **pzErr
+){
+  sqlite3_bcvfs_session_body body;
+  if( pRecord==0 || pRecord->eType!=SQLITE_BCVFS_SESSION_PUBLICATION
+   || pRecord->eState!=eState
+   || strcmp(pRecord->zSessionId,zSessionId)!=0 ) return 0;
+  if( sqlite3_bcvfs_session_body_decode(
+          pRecord->eType,pRecord->eState,pRecord->zSessionId,
+          pRecord->aBody,pRecord->nBody,&body,pzErr
+      )!=SQLITE_OK
+  ) return 0;
+  return !memcmp(body.aCheckpointHash,aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+      && !memcmp(body.aCandidateManifestHash,aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+      && body.nBaseManifestETag==(int)strlen(zBaseETag)
+      && !memcmp(body.aBaseManifestETag,zBaseETag,body.nBaseManifestETag);
+}
+
+static int bcvfsSessionReadHead(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  unsigned char **paData,
+  int *pnData,
+  char **pzETag,
+  sqlite3_bcvfs_session_record *pRecord,
+  char **pzErr
+){
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc;
+  rc = bcvSessionAcquire(pFs,zAlias,zSessionId,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc==SQLITE_OK ){
+    rc = sqlite3_bcvfs_session_scope_hash(
+        pCont->zStorage,pCont->zAccount,pCont->zContainer,
+        zPrincipal,zDatabase,zOperations,aScope,pzErr
+    );
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  }
+  if( rc!=SQLITE_OK ) return rc;
+  rc = sqlite3_bcvfs_session_fetch(
+      pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+      zPrincipal,zDatabase,zOperations,paData,pnData,pzETag,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    rc = sqlite3_bcvfs_session_record_decode(
+        *paData,*pnData,zSessionId,aScope,pRecord,pzErr
+    );
+  }
+  return rc;
+}
+
+static int bcvfsSessionPublish(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  char **pzErr
+){
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  const char *zPrincipal = 0;
+  const char *zDatabase = 0;
+  const char *zOperations = 0;
+  unsigned char aFullScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aStorageScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char *aHead = 0;
+  unsigned char *aCheckpoint = 0;
+  unsigned char *aPub = 0;
+  unsigned char *aEncoded = 0;
+  unsigned char *aNewEncoded = 0;
+  unsigned char aCandidateHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHeadCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHeadCandidateHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aNewRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_bcvfs_session_record head;
+  sqlite3_bcvfs_session_record checkpoint;
+  sqlite3_bcvfs_session_record pub;
+  sqlite3_bcvfs_session_body headBody;
+  sqlite3_bcvfs_session_body checkpointBody;
+  char *zHeadETag = 0;
+  char *zCheckpointETag = 0;
+  char *zPubETag = 0;
+  char *zNewETag = 0;
+  char *zManifestETag = 0;
+  char *zBaseETag = 0;
+  char *zPutErr = 0;
+  char *zReconcileErr = 0;
+  char *zCandidateETag = 0;
+  unsigned char *aCandidateObject = 0;
+  unsigned char *aManifest = 0;
+  int nHead = 0;
+  int nCheckpoint = 0;
+  int nPub = 0;
+  int nManifest = 0;
+  int nCandidateObject = 0;
+  int nEncoded = 0;
+  int nNewEncoded = 0;
+  int rc = SQLITE_OK;
+  int bEntered = 0;
+  int bPinned = 0;
+  int bPublicationCommitted = 0;
+  int bPublicationLoaded = 0;
+  int eHeadState = 0;
+
+  memset(&head,0,sizeof(head));
+  memset(&checkpoint,0,sizeof(checkpoint));
+  memset(&pub,0,sizeof(pub));
+  memset(&headBody,0,sizeof(headBody));
+  memset(&checkpointBody,0,sizeof(checkpointBody));
+  memset(aCandidateHash,0,sizeof(aCandidateHash));
+  memset(aHeadCheckpointHash,0,sizeof(aHeadCheckpointHash));
+  memset(aHeadCandidateHash,0,sizeof(aHeadCandidateHash));
+  memset(aRecordHash,0,sizeof(aRecordHash));
+  memset(aNewRecordHash,0,sizeof(aNewRecordHash));
+  if( pzErr ) *pzErr = 0;
+  if( pFs==0 || zAlias==0 || !bcvfsValidSessionId(zSessionId) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session publication identity is invalid");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session publication is unavailable through the CBS daemon");
+  }
+
+  ENTER_VFS_MUTEX; {
+    pCont = bcvfsFindContAlias(&pFs->c,zAlias,pzErr);
+    if( pCont==0 ){
+      rc = SQLITE_ERROR;
+    }else if( pCont->zSessionId==0 || strcmp(pCont->zSessionId,zSessionId)!=0
+           || pCont->nSessionRef<=0 ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session does not own container alias");
+    }else if( !pCont->bSessionContext
+           || pCont->zSessionPrincipal==0
+           || pCont->zSessionDatabase==0
+           || pCont->zSessionOperations==0 ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session publication scope is not bound");
+    }else if( pCont->eState!=CONTAINER_STATE_NONE ){
+      rc = bcvSessionError(SQLITE_BUSY,pzErr,"session container is busy");
+    }else{
+      zPrincipal = pCont->zSessionPrincipal;
+      zDatabase = pCont->zSessionDatabase;
+      zOperations = pCont->zSessionOperations;
+      /* Keep the resolved container alive for every network phase. The
+      ** per-call session acquire pins it only temporarily; detach may not
+      ** free an otherwise idle container while this publication is active. */
+      pCont->nClient++;
+      bPinned = 1;
+      bcvfsEnterState(pFs,pCont,CONTAINER_STATE_UPLOAD);
+      bEntered = 1;
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+
+  rc = sqlite3_bcvfs_session_scope_hash(
+      pCont->zStorage,pCont->zAccount,pCont->zContainer,
+      zPrincipal,zDatabase,zOperations,aFullScope,pzErr
+  );
+  if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_storage_scope_hash(
+      pCont->zStorage,pCont->zAccount,pCont->zContainer,
+      aStorageScope,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+
+  rc = bcvfsSessionReadHead(
+      pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+      &aHead,&nHead,&zHeadETag,&head,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  if( head.eState!=SQLITE_BCVFS_SESSION_ACCEPTED
+   && head.eState!=SQLITE_BCVFS_SESSION_PUBLISHING
+   && head.eState!=SQLITE_BCVFS_SESSION_COMMITTED
+  ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session head is not publishable");
+    goto session_publish_done;
+  }
+  eHeadState = head.eState;
+  if( head.eState==SQLITE_BCVFS_SESSION_ACCEPTED
+   && head.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS
+  ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session head outcome is not successful");
+    goto session_publish_done;
+  }
+  if( head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+   && head.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+  ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"publishing session head has an outcome");
+    goto session_publish_done;
+  }
+  if( head.eState==SQLITE_BCVFS_SESSION_COMMITTED
+   && head.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS
+  ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"committed session head has no success outcome");
+    goto session_publish_done;
+  }
+  rc = sqlite3_bcvfs_session_body_decode(
+      head.eType,head.eState,head.zSessionId,
+      head.aBody,head.nBody,&headBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  if( sqlite3_bcvfs_session_record_is_expired(&head,sqlite_timestamp()) ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session head has expired");
+    goto session_publish_done;
+  }
+  memcpy(aHeadCheckpointHash,headBody.aCheckpointHash,
+      sizeof(aHeadCheckpointHash));
+  memcpy(aHeadCandidateHash,headBody.aCandidateManifestHash,
+      sizeof(aHeadCandidateHash));
+  if( headBody.nBaseManifestETag<=0 ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session candidate has no base manifest ETag");
+    goto session_publish_done;
+  }
+  zBaseETag = sqlite3_mprintf(
+      "%.*s",headBody.nBaseManifestETag,headBody.aBaseManifestETag
+  );
+  if( zBaseETag==0 ){
+    rc = SQLITE_NOMEM;
+    goto session_publish_done;
+  }
+
+  rc = sqlite3_bcvfs_session_fetch(
+      pFs,zAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zSessionId,
+      headBody.aCheckpointHash,zPrincipal,zDatabase,zOperations,
+      &aCheckpoint,&nCheckpoint,&zCheckpointETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  rc = sqlite3_bcvfs_session_record_decode(
+      aCheckpoint,nCheckpoint,zSessionId,aFullScope,&checkpoint,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  if( checkpoint.eType!=SQLITE_BCVFS_SESSION_CHECKPOINT
+   || checkpoint.eState!=SQLITE_BCVFS_SESSION_OPEN
+   || checkpoint.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+  ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"accepted head does not reference an open checkpoint");
+    goto session_publish_done;
+  }
+  rc = sqlite3_bcvfs_session_body_decode(
+      checkpoint.eType,checkpoint.eState,checkpoint.zSessionId,
+      checkpoint.aBody,checkpoint.nBody,&checkpointBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  if( checkpointBody.nBaseManifestETag!=headBody.nBaseManifestETag
+   || memcmp(
+          checkpointBody.aBaseManifestETag,headBody.aBaseManifestETag,
+          headBody.nBaseManifestETag
+      )!=0
+  ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"checkpoint base manifest does not match accepted head");
+    goto session_publish_done;
+  }
+  if( checkpointBody.nManifest<=0 ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"checkpoint has no candidate manifest");
+    goto session_publish_done;
+  }
+  {
+    SHA256_CTX sha;
+    SHA256_Init(&sha);
+    SHA256_Update(&sha,checkpointBody.aManifest,checkpointBody.nManifest);
+    SHA256_Final(aCandidateHash,&sha);
+  }
+  if( (head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+       || head.eState==SQLITE_BCVFS_SESSION_COMMITTED)
+   && memcmp(aHeadCandidateHash,aCandidateHash,
+       SQLITE_BCVFS_SESSION_HASH_BYTES)!=0
+  ){
+    rc = bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,
+        "session head candidate hash does not match its checkpoint"
+    );
+    goto session_publish_done;
+  }
+
+  /* Persist the exact candidate before claiming the shared publication
+  ** fence. This is the recovery source for a different cooperative
+  ** publisher if this process dies before the manifest PUT. */
+  rc = bcvfsSessionCandidatePut(
+      pFs,zAlias,aCandidateHash,checkpointBody.aManifest,
+      checkpointBody.nManifest,&zCandidateETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  sqlite3_free(zCandidateETag);
+  zCandidateETag = 0;
+
+  /* Move the accepted request into publishing before taking the shared
+  ** publication fence. A lost CAS is reconciled only if the exact same
+  ** checkpoint is already publishing. */
+  if( eHeadState==SQLITE_BCVFS_SESSION_ACCEPTED ){
+    rc = bcvfsSessionEncodeHeadState(
+        &head,SQLITE_BCVFS_SESSION_PUBLISHING,
+        SQLITE_BCVFS_SESSION_OUTCOME_NONE,headBody.aCheckpointHash,
+        aCandidateHash,zBaseETag,
+        &aEncoded,&nEncoded,aRecordHash,pzErr
+    );
+    if( rc==SQLITE_OK ){
+      rc = sqlite3_bcvfs_session_put(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+          zPrincipal,zDatabase,zOperations,zHeadETag,
+          aEncoded,nEncoded,&zNewETag,pzErr
+      );
+    }
+    if( rc!=SQLITE_OK ){
+      int rcOriginal = rc;
+      char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+      if( pzErr ) *pzErr = 0;
+      sqlite3_free(aHead); aHead = 0;
+      sqlite3_free(zHeadETag); zHeadETag = 0;
+      memset(&head,0,sizeof(head));
+      rc = bcvfsSessionReadHead(
+          pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+          &aHead,&nHead,&zHeadETag,&head,&zReconcileErr
+      );
+      if( rc==SQLITE_OK
+       && ((nHead==nEncoded && !memcmp(aHead,aEncoded,nEncoded))
+           || (head.eState==SQLITE_BCVFS_SESSION_COMMITTED
+               && bcvfsSessionHeadMatches(
+                      &head,SQLITE_BCVFS_SESSION_COMMITTED,
+                      SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+                      aHeadCheckpointHash,
+                      aCandidateHash,zBaseETag,&zReconcileErr
+                  )))
+      ){
+        eHeadState = head.eState;
+        rc = SQLITE_OK;
+      }else{
+        rc = rcOriginal;
+        if( pzErr && *pzErr==0 ){
+          *pzErr = zOriginal ? zOriginal : zReconcileErr;
+          if( *pzErr==zOriginal ) zOriginal = 0;
+          if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+        }
+      }
+      sqlite3_free(zOriginal);
+    }
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+  }
+  sqlite3_free(aManifest); aManifest = 0;
+  sqlite3_free(zManifestETag); zManifestETag = 0;
+  sqlite3_free(aEncoded); aEncoded = 0;
+  sqlite3_free(zNewETag); zNewETag = 0;
+
+  /* Acquire the per-container publication fence before reading or writing
+  ** manifest.bcv. A missing head is created conditionally; a race is
+  ** reconciled only when the winning record names this exact candidate. */
+publication_head_fetch:
+  if( !bPublicationLoaded ){
+    rc = sqlite3_bcvfs_session_fetch(
+        pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+        zPrincipal,zDatabase,zOperations,&aPub,&nPub,&zPubETag,&zPutErr
+    );
+    if( rc==HTTP_NOT_FOUND || rc==SQLITE_NOTFOUND ){
+      sqlite3_free(zPutErr); zPutErr = 0;
+      rc = SQLITE_OK;
+      memset(&pub,0,sizeof(pub));
+    }else if( rc==SQLITE_OK ){
+      rc = sqlite3_bcvfs_session_record_decode(
+          aPub,nPub,0,aStorageScope,&pub,pzErr
+      );
+      if( rc==SQLITE_OK && pub.eType!=SQLITE_BCVFS_SESSION_PUBLICATION ){
+        rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"publication head has the wrong record type");
+      }
+    }else if( pzErr && *pzErr==0 ){
+      *pzErr = zPutErr;
+      zPutErr = 0;
+    }
+    sqlite3_free(zPutErr); zPutErr = 0;
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+  }
+  bPublicationLoaded = 0;
+  if( pub.eType==SQLITE_BCVFS_SESSION_PUBLICATION ){
+    if( pub.eState==SQLITE_BCVFS_SESSION_COMMITTED
+     && bcvfsSessionPublicationMatches(
+            &pub,SQLITE_BCVFS_SESSION_COMMITTED,zSessionId,
+            aHeadCheckpointHash,aCandidateHash,zBaseETag,pzErr
+        )
+    ){
+      bPublicationCommitted = 1;
+    }else if( pub.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+           && bcvfsSessionPublicationMatches(
+                  &pub,SQLITE_BCVFS_SESSION_PUBLISHING,zSessionId,
+                  aHeadCheckpointHash,aCandidateHash,zBaseETag,pzErr
+              )
+           && !sqlite3_bcvfs_session_record_is_expired(&pub,sqlite_timestamp())
+    ){
+      /* A live same-owner publication can continue through the normal
+      ** manifest/reconciliation path. An expired one is handled below by
+      ** the immutable candidate recovery path; expiry is not a lease that
+      ** permits takeover or deletion of a pending fence. */
+    }else if( pub.eState==SQLITE_BCVFS_SESSION_COMMITTED ){
+      /* A committed head may be reused only after proving that its exact
+      ** candidate is still the visible manifest and that the new request's
+      ** base ETag is the provider version now being replaced. A committed
+      ** record is immutable history, so its old TTL does not prevent a new
+      ** candidate from renewing the publication lease after lineage proof. */
+      {
+        sqlite3_bcvfs_session_body pubBody;
+        unsigned char aPublishedHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+        rc = sqlite3_bcvfs_session_body_decode(
+            pub.eType,pub.eState,pub.zSessionId,
+            pub.aBody,pub.nBody,&pubBody,pzErr
+        );
+        if( rc==SQLITE_OK ) rc = bcvfsSessionManifestFetch(
+            pFs,zAlias,&aManifest,&nManifest,&zManifestETag,pzErr
+        );
+        if( rc==SQLITE_OK ){
+          SHA256_CTX sha;
+          SHA256_Init(&sha);
+          SHA256_Update(&sha,aManifest,nManifest);
+          SHA256_Final(aPublishedHash,&sha);
+          if( memcmp(aPublishedHash,pubBody.aCandidateManifestHash,
+              sizeof(aPublishedHash))!=0
+           || strcmp(zManifestETag,zBaseETag)!=0
+          ){
+            rc = bcvSessionError(
+                SQLITE_CONSTRAINT,pzErr,
+                "published manifest does not match the committed publication head"
+            );
+          }
+        }
+        if( rc!=SQLITE_OK ) goto session_publish_done;
+      }
+      sqlite3_free(aManifest); aManifest = 0;
+      sqlite3_free(zManifestETag); zManifestETag = 0;
+      rc = bcvfsSessionEncodePublicationState(
+          &pub,zSessionId,aStorageScope,aHeadCheckpointHash,
+          aCandidateHash,zBaseETag,head.aOperationId,
+          SQLITE_BCVFS_SESSION_PUBLISHING,SQLITE_BCVFS_SESSION_OUTCOME_NONE,
+          &aEncoded,&nEncoded,aRecordHash,pzErr
+      );
+      if( rc==SQLITE_OK ){
+        rc = sqlite3_bcvfs_session_put(
+            pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+            zPrincipal,zDatabase,zOperations,zPubETag,aEncoded,nEncoded,
+            &zNewETag,pzErr
+        );
+      }
+      if( rc!=SQLITE_OK ){
+        int rcOriginal = rc;
+        char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+        if( pzErr ) *pzErr = 0;
+        sqlite3_free(aPub); aPub = 0;
+        sqlite3_free(zPubETag); zPubETag = 0;
+        memset(&pub,0,sizeof(pub));
+        rc = sqlite3_bcvfs_session_fetch(
+            pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+            zPrincipal,zDatabase,zOperations,&aPub,&nPub,&zPubETag,
+            &zReconcileErr
+        );
+        if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_record_decode(
+            aPub,nPub,0,aStorageScope,&pub,&zReconcileErr
+        );
+        if( rc==SQLITE_OK
+         && ((nPub==nEncoded && !memcmp(aPub,aEncoded,nEncoded))
+             || bcvfsSessionPublicationMatches(
+                    &pub,SQLITE_BCVFS_SESSION_COMMITTED,zSessionId,
+                    aHeadCheckpointHash,aCandidateHash,zBaseETag,
+                    &zReconcileErr
+                ))
+        ){
+          bPublicationCommitted = pub.eState==SQLITE_BCVFS_SESSION_COMMITTED;
+          rc = SQLITE_OK;
+        }else{
+          rc = rcOriginal;
+          if( pzErr && *pzErr==0 ){
+            *pzErr = zOriginal ? zOriginal : zReconcileErr;
+            if( *pzErr==zOriginal ) zOriginal = 0;
+            if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+          }
+        }
+        sqlite3_free(zOriginal);
+      }
+      if( rc!=SQLITE_OK ) goto session_publish_done;
+      if( bPublicationCommitted==0 ){
+        if( zNewETag ){
+          sqlite3_free(zPubETag); zPubETag = zNewETag; zNewETag = 0;
+        }
+        rc = sqlite3_bcvfs_session_record_decode(
+            aEncoded,nEncoded,0,aStorageScope,&pub,pzErr
+        );
+        if( rc!=SQLITE_OK ) goto session_publish_done;
+      }
+    }else if( pub.eState==SQLITE_BCVFS_SESSION_PUBLISHING ){
+      sqlite3_bcvfs_session_body pubBody;
+      unsigned char aPendingCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+      unsigned char aPendingCandidateHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+      unsigned char aPendingOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+      char zPendingSessionId[SQLITE_BCVFS_SESSION_ID_TEXT_BYTES];
+      char *zPendingBaseETag = 0;
+      int bPendingVisible = 0;
+      memset(aPendingCheckpointHash,0,sizeof(aPendingCheckpointHash));
+      memset(aPendingCandidateHash,0,sizeof(aPendingCandidateHash));
+      memset(aPendingOperationId,0,sizeof(aPendingOperationId));
+      memset(zPendingSessionId,0,sizeof(zPendingSessionId));
+      rc = sqlite3_bcvfs_session_body_decode(
+          pub.eType,pub.eState,pub.zSessionId,
+          pub.aBody,pub.nBody,&pubBody,pzErr
+      );
+      if( rc==SQLITE_OK ){
+        memcpy(aPendingCheckpointHash,pubBody.aCheckpointHash,
+            sizeof(aPendingCheckpointHash));
+        memcpy(aPendingCandidateHash,pubBody.aCandidateManifestHash,
+            sizeof(aPendingCandidateHash));
+        memcpy(aPendingOperationId,pub.aOperationId,
+            sizeof(aPendingOperationId));
+        memcpy(zPendingSessionId,pub.zSessionId,
+            sizeof(zPendingSessionId));
+      }
+      if( rc==SQLITE_OK ){
+        zPendingBaseETag = sqlite3_mprintf(
+            "%.*s",pubBody.nBaseManifestETag,pubBody.aBaseManifestETag
+        );
+        if( zPendingBaseETag==0 ) rc = SQLITE_NOMEM;
+      }
+      if( rc==SQLITE_OK ) rc = bcvfsSessionCandidateFetch(
+          pFs,zAlias,aPendingCandidateHash,&aCandidateObject,
+          &nCandidateObject,&zCandidateETag,pzErr
+      );
+      if( rc==HTTP_NOT_FOUND || rc==SQLITE_NOTFOUND ){
+        rc = bcvSessionError(
+            SQLITE_CONSTRAINT,pzErr,
+            "publication candidate object is not yet visible"
+        );
+      }
+      if( rc==SQLITE_OK ){
+        unsigned char aCandidateObjectHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+        SHA256_CTX sha;
+        if( nCandidateObject<=0 || aCandidateObject==0 ){
+          rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"publication candidate object is empty");
+        }else{
+          SHA256_Init(&sha);
+          SHA256_Update(&sha,aCandidateObject,nCandidateObject);
+          SHA256_Final(aCandidateObjectHash,&sha);
+          if( memcmp(aCandidateObjectHash,aPendingCandidateHash,
+              sizeof(aCandidateObjectHash))!=0
+          ){
+            rc = bcvSessionError(
+                SQLITE_CORRUPT,pzErr,
+                "publication candidate object hash does not match its head"
+            );
+          }
+        }
+      }
+      if( rc==SQLITE_OK ) rc = bcvfsSessionManifestFetch(
+          pFs,zAlias,&aManifest,&nManifest,&zManifestETag,pzErr
+      );
+      if( rc==SQLITE_OK
+       && nManifest==nCandidateObject
+       && memcmp(aManifest,aCandidateObject,nCandidateObject)==0
+      ){
+        bPendingVisible = 1;
+      }
+      if( rc==SQLITE_OK && !bPendingVisible
+       && strcmp(zManifestETag,zPendingBaseETag)!=0
+      ){
+        rc = bcvSessionError(
+            SQLITE_CONSTRAINT,pzErr,
+            "manifest changed before pending candidate recovery"
+        );
+      }
+      if( rc==SQLITE_OK && !bPendingVisible ){
+        rc = bcvfsSessionManifestPut(
+            pFs,zAlias,zPendingBaseETag,aCandidateObject,
+            nCandidateObject,&zNewETag,&zPutErr
+        );
+        if( rc!=SQLITE_OK ){
+          int rcPutManifest = rc;
+          char *zPutManifestErr = zPutErr;
+          zPutErr = 0;
+          sqlite3_free(aManifest); aManifest = 0;
+          sqlite3_free(zManifestETag); zManifestETag = 0;
+          rc = bcvfsSessionManifestFetch(
+              pFs,zAlias,&aManifest,&nManifest,&zManifestETag,
+              &zReconcileErr
+          );
+          if( rc==SQLITE_OK
+           && nManifest==nCandidateObject
+           && memcmp(aManifest,aCandidateObject,nCandidateObject)==0
+          ){
+            rc = SQLITE_OK;
+          }else{
+            rc = rcPutManifest;
+            if( pzErr && *pzErr==0 ){
+              *pzErr = zPutManifestErr ? zPutManifestErr : zReconcileErr;
+              if( *pzErr==zPutManifestErr ) zPutManifestErr = 0;
+              if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+            }
+          }
+          sqlite3_free(zPutManifestErr);
+        }
+        sqlite3_free(zNewETag); zNewETag = 0;
+      }
+      if( rc==SQLITE_OK ) rc = bcvfsSessionEncodePublicationState(
+          &pub,zPendingSessionId,aStorageScope,aPendingCheckpointHash,
+          aPendingCandidateHash,zPendingBaseETag,aPendingOperationId,
+          SQLITE_BCVFS_SESSION_COMMITTED,SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+          &aEncoded,&nEncoded,aRecordHash,pzErr
+      );
+      if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_put(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+          zPrincipal,zDatabase,zOperations,zPubETag,aEncoded,nEncoded,
+          &zNewETag,pzErr
+      );
+      if( rc!=SQLITE_OK ){
+        int rcOriginal = rc;
+        char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+        if( pzErr ) *pzErr = 0;
+        sqlite3_free(aPub); aPub = 0;
+        sqlite3_free(zPubETag); zPubETag = 0;
+        memset(&pub,0,sizeof(pub));
+        rc = sqlite3_bcvfs_session_fetch(
+            pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+            zPrincipal,zDatabase,zOperations,&aPub,&nPub,&zPubETag,
+            &zReconcileErr
+        );
+        if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_record_decode(
+            aPub,nPub,0,aStorageScope,&pub,&zReconcileErr
+        );
+        if( rc==SQLITE_OK
+         && ((nPub==nEncoded && !memcmp(aPub,aEncoded,nEncoded))
+             || (pub.eState==SQLITE_BCVFS_SESSION_COMMITTED
+                 && bcvfsSessionPublicationMatches(
+                        &pub,SQLITE_BCVFS_SESSION_COMMITTED,zPendingSessionId,
+                        aPendingCheckpointHash,aPendingCandidateHash,
+                        zPendingBaseETag,&zReconcileErr
+                    )))
+        ){
+          rc = SQLITE_OK;
+        }else{
+          rc = rcOriginal;
+          if( pzErr && *pzErr==0 ){
+            *pzErr = zOriginal ? zOriginal : zReconcileErr;
+            if( *pzErr==zOriginal ) zOriginal = 0;
+            if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+          }
+        }
+        sqlite3_free(zOriginal);
+      }
+      if( rc==SQLITE_OK ){
+        if( zNewETag ){
+          sqlite3_free(zPubETag);
+          zPubETag = zNewETag;
+          zNewETag = 0;
+        }
+        if( aEncoded ){
+          sqlite3_free(aPub);
+          aPub = aEncoded;
+          aEncoded = 0;
+          nPub = nEncoded;
+          rc = sqlite3_bcvfs_session_record_decode(
+              aPub,nPub,0,aStorageScope,&pub,pzErr
+          );
+        }
+      }
+      sqlite3_free(zPendingBaseETag);
+      sqlite3_free(aCandidateObject); aCandidateObject = 0;
+      nCandidateObject = 0;
+      sqlite3_free(zCandidateETag); zCandidateETag = 0;
+      sqlite3_free(aManifest); aManifest = 0;
+      sqlite3_free(zManifestETag); zManifestETag = 0;
+      if( rc!=SQLITE_OK ) goto session_publish_done;
+      bPublicationLoaded = 1;
+      goto publication_head_fetch;
+    }else{
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "publication head has an unresolved different candidate"
+      );
+      goto session_publish_done;
+    }
+  }else{
+    rc = bcvfsSessionEncodePublicationState(
+        &head,zSessionId,aStorageScope,aHeadCheckpointHash,
+        aCandidateHash,zBaseETag,head.aOperationId,
+        SQLITE_BCVFS_SESSION_PUBLISHING,SQLITE_BCVFS_SESSION_OUTCOME_NONE,
+        &aEncoded,&nEncoded,aRecordHash,pzErr
+    );
+    if( rc==SQLITE_OK ){
+      rc = sqlite3_bcvfs_session_put(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+          zPrincipal,zDatabase,zOperations,"*",aEncoded,nEncoded,
+          &zNewETag,pzErr
+      );
+    }
+    if( rc!=SQLITE_OK ){
+      int rcOriginal = rc;
+      char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+      if( pzErr ) *pzErr = 0;
+      sqlite3_free(aPub); aPub = 0;
+      sqlite3_free(zPubETag); zPubETag = 0;
+      memset(&pub,0,sizeof(pub));
+      rc = sqlite3_bcvfs_session_fetch(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+          zPrincipal,zDatabase,zOperations,&aPub,&nPub,&zPubETag,
+          &zReconcileErr
+      );
+      if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_record_decode(
+          aPub,nPub,0,aStorageScope,&pub,&zReconcileErr
+      );
+      if( rc==SQLITE_OK
+       && ((pub.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+            && nPub==nEncoded
+            && !memcmp(aPub,aEncoded,nEncoded))
+           || (pub.eState==SQLITE_BCVFS_SESSION_COMMITTED
+            && bcvfsSessionPublicationMatches(
+                   &pub,SQLITE_BCVFS_SESSION_COMMITTED,zSessionId,
+                   aHeadCheckpointHash,aCandidateHash,zBaseETag,
+                   &zReconcileErr
+               )))
+      ){
+        bPublicationCommitted = pub.eState==SQLITE_BCVFS_SESSION_COMMITTED;
+        rc = SQLITE_OK;
+      }else{
+        rc = rcOriginal;
+        if( pzErr && *pzErr==0 ){
+          *pzErr = zOriginal;
+          zOriginal = 0;
+        }
+      }
+      sqlite3_free(zOriginal);
+    }
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+    if( bPublicationCommitted==0 ){
+      if( zNewETag ){
+        sqlite3_free(zPubETag); zPubETag = zNewETag; zNewETag = 0;
+      }
+      rc = sqlite3_bcvfs_session_record_decode(
+          aEncoded,nEncoded,0,aStorageScope,&pub,pzErr
+      );
+      if( rc!=SQLITE_OK ) goto session_publish_done;
+    }
+  }
+  if( bPublicationCommitted ){
+    rc = bcvfsSessionManifestFetch(
+        pFs,zAlias,&aManifest,&nManifest,&zManifestETag,pzErr
+    );
+    if( rc==SQLITE_OK
+     && (nManifest!=checkpointBody.nManifest
+         || memcmp(aManifest,checkpointBody.aManifest,nManifest)!=0)
+    ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "committed publication head does not name the visible manifest"
+      );
+    }
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+  }
+  sqlite3_free(aManifest); aManifest = 0;
+  sqlite3_free(zManifestETag); zManifestETag = 0;
+  /* Keep aEncoded alive while pub borrows its body. */
+  sqlite3_free(zNewETag); zNewETag = 0;
+
+  if( !bPublicationCommitted ){
+    int bCandidateAlreadyVisible = 0;
+    rc = bcvfsSessionManifestFetch(
+        pFs,zAlias,&aManifest,&nManifest,&zManifestETag,pzErr
+    );
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+    if( nManifest==checkpointBody.nManifest
+     && memcmp(aManifest,checkpointBody.aManifest,nManifest)==0
+    ){
+      bCandidateAlreadyVisible = 1;
+    }
+    {
+      if( !bCandidateAlreadyVisible
+             && strcmp(zManifestETag,zBaseETag)!=0 ){
+        rc = bcvSessionError(
+            SQLITE_CONSTRAINT,pzErr,
+            "manifest changed before fenced publication"
+        );
+      }else if( !bCandidateAlreadyVisible ){
+        rc = bcvfsSessionManifestPut(
+            pFs,zAlias,zBaseETag,checkpointBody.aManifest,
+            checkpointBody.nManifest,&zNewETag,&zPutErr
+        );
+        if( rc!=SQLITE_OK ){
+          int rcPutManifest = rc;
+          char *zPutManifestErr = zPutErr;
+          zPutErr = 0;
+          sqlite3_free(aManifest); aManifest = 0;
+          sqlite3_free(zManifestETag); zManifestETag = 0;
+          rc = bcvfsSessionManifestFetch(
+              pFs,zAlias,&aManifest,&nManifest,&zManifestETag,
+              &zReconcileErr
+          );
+          if( rc==SQLITE_OK
+           && nManifest==checkpointBody.nManifest
+           && memcmp(aManifest,checkpointBody.aManifest,nManifest)==0
+          ){
+            rc = SQLITE_OK;
+          }else{
+            rc = rcPutManifest;
+            if( pzErr && *pzErr==0 ){
+              *pzErr = zPutManifestErr ? zPutManifestErr : zReconcileErr;
+              if( *pzErr==zPutManifestErr ) zPutManifestErr = 0;
+              if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+            }
+          }
+          sqlite3_free(zPutManifestErr);
+        }
+        sqlite3_free(zNewETag); zNewETag = 0;
+      }
+    }
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+    if( !bCandidateAlreadyVisible ){
+      /* Confirm successful and ambiguous PUTs with the exact candidate bytes.
+      ** An ETag alone is never treated as proof of publication. */
+      sqlite3_free(aManifest); aManifest = 0;
+      sqlite3_free(zManifestETag); zManifestETag = 0;
+      rc = bcvfsSessionManifestFetch(
+          pFs,zAlias,&aManifest,&nManifest,&zManifestETag,pzErr
+      );
+      if( rc!=SQLITE_OK ) goto session_publish_done;
+      if( nManifest!=checkpointBody.nManifest
+       || memcmp(aManifest,checkpointBody.aManifest,nManifest)!=0
+      ){
+        rc = bcvSessionError(
+            SQLITE_CONSTRAINT,pzErr,
+            "manifest PUT did not produce the exact fenced candidate"
+        );
+        goto session_publish_done;
+      }
+    }
+  }
+
+  /* Commit the publication head. A process may die after the manifest PUT;
+  ** an identical committed record is therefore a successful reconciliation,
+  ** but a different owner or candidate is never overwritten. */
+  if( !bPublicationCommitted ){
+    sqlite3_bcvfs_session_record pending = pub;
+    rc = bcvfsSessionEncodePublicationState(
+        &pending,zSessionId,aStorageScope,aHeadCheckpointHash,
+        aCandidateHash,zBaseETag,pending.aOperationId,
+        SQLITE_BCVFS_SESSION_COMMITTED,SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+        &aNewEncoded,&nNewEncoded,aNewRecordHash,pzErr
+    );
+    if( rc==SQLITE_OK ){
+      rc = sqlite3_bcvfs_session_put(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+          zPrincipal,zDatabase,zOperations,zPubETag,aNewEncoded,nNewEncoded,
+          &zNewETag,pzErr
+      );
+    }
+    if( rc!=SQLITE_OK ){
+      int rcOriginal = rc;
+      char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+      if( pzErr ) *pzErr = 0;
+      sqlite3_free(aPub); aPub = 0;
+      sqlite3_free(zPubETag); zPubETag = 0;
+      memset(&pub,0,sizeof(pub));
+      rc = sqlite3_bcvfs_session_fetch(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,aStorageScope,
+          zPrincipal,zDatabase,zOperations,&aPub,&nPub,&zPubETag,&zReconcileErr
+      );
+      if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_record_decode(
+          aPub,nPub,0,aStorageScope,&pub,&zReconcileErr
+      );
+      if( rc==SQLITE_OK
+       && ((nPub==nNewEncoded && !memcmp(aPub,aNewEncoded,nNewEncoded))
+           || bcvfsSessionPublicationMatches(
+                  &pub,SQLITE_BCVFS_SESSION_COMMITTED,zSessionId,
+                  aHeadCheckpointHash,aCandidateHash,
+                  zBaseETag,&zReconcileErr
+              ))
+      ){
+        rc = SQLITE_OK;
+      }else{
+        rc = rcOriginal;
+        if( pzErr && *pzErr==0 ){
+          *pzErr = zOriginal ? zOriginal : zReconcileErr;
+          if( *pzErr==zOriginal ) zOriginal = 0;
+          if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+        }
+      }
+      sqlite3_free(zOriginal);
+    }
+    if( rc!=SQLITE_OK ) goto session_publish_done;
+    bPublicationCommitted = 1;
+    sqlite3_free(aNewEncoded); aNewEncoded = 0;
+    sqlite3_free(zNewETag); zNewETag = 0;
+  }
+
+  /* Finally mark the session head committed. The final read is important:
+  ** it prevents a stale local ETag from acknowledging a different request
+  ** that won the session fence while this invocation was publishing. */
+  sqlite3_free(aHead); aHead = 0;
+  sqlite3_free(zHeadETag); zHeadETag = 0;
+  memset(&head,0,sizeof(head));
+  rc = bcvfsSessionReadHead(
+      pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+      &aHead,&nHead,&zHeadETag,&head,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_publish_done;
+  if( head.eState==SQLITE_BCVFS_SESSION_COMMITTED ){
+    if( !bcvfsSessionHeadMatches(
+            &head,SQLITE_BCVFS_SESSION_COMMITTED,
+            SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+            aHeadCheckpointHash,
+            aCandidateHash,zBaseETag,pzErr
+        )
+    ){
+      rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session head was committed to another candidate");
+    }
+  }else if( head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+         || (head.eState==SQLITE_BCVFS_SESSION_ACCEPTED
+             && head.eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS)
+  ){
+    rc = bcvfsSessionEncodeHeadState(
+        &head,SQLITE_BCVFS_SESSION_COMMITTED,
+        SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,aHeadCheckpointHash,
+        aCandidateHash,zBaseETag,
+        &aNewEncoded,&nNewEncoded,aNewRecordHash,pzErr
+    );
+    if( rc==SQLITE_OK ){
+      rc = sqlite3_bcvfs_session_put(
+          pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+          zPrincipal,zDatabase,zOperations,zHeadETag,
+          aNewEncoded,nNewEncoded,&zNewETag,pzErr
+      );
+    }
+    if( rc!=SQLITE_OK ){
+      int rcOriginal = rc;
+      char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+      if( pzErr ) *pzErr = 0;
+      sqlite3_free(aHead); aHead = 0;
+      sqlite3_free(zHeadETag); zHeadETag = 0;
+      memset(&head,0,sizeof(head));
+      rc = bcvfsSessionReadHead(
+          pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+          &aHead,&nHead,&zHeadETag,&head,&zReconcileErr
+      );
+      if( rc==SQLITE_OK
+       && ((nHead==nNewEncoded && !memcmp(aHead,aNewEncoded,nNewEncoded))
+           || bcvfsSessionHeadMatches(
+                  &head,SQLITE_BCVFS_SESSION_COMMITTED,
+                  SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+                  aHeadCheckpointHash,
+                  aCandidateHash,zBaseETag,&zReconcileErr
+              ))
+      ){
+        rc = SQLITE_OK;
+      }else{
+        rc = rcOriginal;
+        if( pzErr && *pzErr==0 ){
+          *pzErr = zOriginal ? zOriginal : zReconcileErr;
+          if( *pzErr==zOriginal ) zOriginal = 0;
+          if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+        }
+      }
+      sqlite3_free(zOriginal);
+    }
+  }else{
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session head is not finalizable");
+  }
+
+session_publish_done:
+  sqlite3_free(aHead);
+  sqlite3_free(aCheckpoint);
+  sqlite3_free(aPub);
+  sqlite3_free(aEncoded);
+  sqlite3_free(aNewEncoded);
+  sqlite3_free(aManifest);
+  sqlite3_free(zHeadETag);
+  sqlite3_free(zCheckpointETag);
+  sqlite3_free(zPubETag);
+  sqlite3_free(zNewETag);
+  sqlite3_free(zManifestETag);
+  sqlite3_free(zBaseETag);
+  sqlite3_free(zPutErr);
+  sqlite3_free(zReconcileErr);
+  sqlite3_free(aCandidateObject);
+  sqlite3_free(zCandidateETag);
+  if( bEntered ){
+    ENTER_VFS_MUTEX; {
+      if( pCont->eState==CONTAINER_STATE_UPLOAD ) bcvfsLeaveState(pFs,pCont);
+    } LEAVE_VFS_MUTEX;
+  }
+  if( bPinned ){
+    ENTER_VFS_MUTEX; {
+      assert(pCont->nClient>0);
+      pCont->nClient--;
+    } LEAVE_VFS_MUTEX;
+  }
+  return rc;
+}
+
+int sqlite3_bcvfs_session_upload(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  char **pzErr
+){
+  return bcvfsSessionPublish(pFs,zAlias,zSessionId,pzErr);
+}
+
+/*
+** Finalize a quiesced request without exposing an ACCEPTED head.
+**
+** A new operation writes its immutable checkpoint and candidate first, then
+** conditionally creates a PUBLISHING session head from the predecessor that
+** was captured by scoped attach. The normal publisher then owns the
+** manifest and COMMITTED transitions. If a head already names this
+** operation, this is an idempotent recovery call; a different operation is
+** never overwritten.
+*/
+static int bcvfsSessionFinalizeNew(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  char **pzErr
+){
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  char *zStorage = 0;
+  char *zAccount = 0;
+  char *zContainer = 0;
+  char *zPrincipal = 0;
+  char *zDatabase = 0;
+  char *zOperations = 0;
+  char *zExpectedETag = 0;
+  char *zHeadETag = 0;
+  char *zCheckpointETag = 0;
+  char *zCandidateETag = 0;
+  char *zBaseETag = 0;
+  char *zReconcileErr = 0;
+  unsigned char *aHead = 0;
+  unsigned char *aCheckpoint = 0;
+  unsigned char *aEncoded = 0;
+  unsigned char aExpectedHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointPredecessorHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCandidateHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aNewRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_bcvfs_session_record head;
+  sqlite3_bcvfs_session_record checkpoint;
+  sqlite3_bcvfs_session_record base;
+  sqlite3_bcvfs_session_body checkpointBody;
+  int nHead = 0;
+  int nCheckpoint = 0;
+  int nEncoded = 0;
+  int rc = SQLITE_OK;
+  int bExpected = 0;
+  int bPinned = 0;
+  int bHeadMissing = 0;
+  sqlite3_uint64 iExpectedSequence = 0;
+  sqlite3_uint64 iCheckpointExpectedSequence = 0;
+
+  if( pzErr ) *pzErr = 0;
+  memset(aExpectedHeadHash,0,sizeof(aExpectedHeadHash));
+  memset(aCheckpointPredecessorHash,0,sizeof(aCheckpointPredecessorHash));
+  memset(aOperationId,0,sizeof(aOperationId));
+  memset(aScope,0,sizeof(aScope));
+  memset(aCheckpointHash,0,sizeof(aCheckpointHash));
+  memset(aCandidateHash,0,sizeof(aCandidateHash));
+  memset(aNewRecordHash,0,sizeof(aNewRecordHash));
+  memset(&head,0,sizeof(head));
+  memset(&checkpoint,0,sizeof(checkpoint));
+  memset(&base,0,sizeof(base));
+  memset(&checkpointBody,0,sizeof(checkpointBody));
+  if( pFs==0 || zAlias==0 || !bcvfsValidSessionId(zSessionId) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,
+        "session finalization identity is invalid");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,
+        "session finalization is unavailable through the CBS daemon");
+  }
+
+  /* Keep the attached Container alive while the checkpoint, candidate, and
+  ** predecessor CAS are in flight. The native helper's temporary acquire
+  ** pins are not sufficient across those separate calls. */
+  rc = bcvSessionAcquire(
+      pFs,zAlias,zSessionId,&pCont,&pDisp,&pBcv,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    ENTER_VFS_MUTEX; {
+      if( !pCont->bSessionContext
+       || pCont->zSessionPrincipal==0
+       || pCont->zSessionDatabase==0
+       || pCont->zSessionOperations==0
+       || pCont->zStorage==0 || pCont->zAccount==0 || pCont->zContainer==0
+      ){
+        rc = bcvSessionError(SQLITE_AUTH,pzErr,
+            "session finalization scope is not bound");
+      }else if( pCont->eState!=CONTAINER_STATE_NONE ){
+        rc = bcvSessionError(SQLITE_BUSY,pzErr,
+            "session finalization requires a quiescent container");
+      }else{
+        zStorage = sqlite3_mprintf("%s",pCont->zStorage);
+        zAccount = sqlite3_mprintf("%s",pCont->zAccount);
+        zContainer = sqlite3_mprintf("%s",pCont->zContainer);
+        zPrincipal = sqlite3_mprintf("%s",pCont->zSessionPrincipal);
+        zDatabase = sqlite3_mprintf("%s",pCont->zSessionDatabase);
+        zOperations = sqlite3_mprintf("%s",pCont->zSessionOperations);
+        bExpected = pCont->bSessionPredecessorPresent;
+        iExpectedSequence = pCont->iSessionExpectedSequence;
+        iCheckpointExpectedSequence = pCont->iSessionSequence;
+        memcpy(aCheckpointPredecessorHash,pCont->aSessionPredecessorHash,
+            sizeof(aCheckpointPredecessorHash));
+        memcpy(aExpectedHeadHash,pCont->aSessionExpectedHeadHash,
+            sizeof(aExpectedHeadHash));
+        memcpy(aOperationId,pCont->aSessionOperationId,
+            sizeof(aOperationId));
+        if( bExpected && pCont->zSessionPredecessorETag==0 ){
+          rc = bcvSessionError(SQLITE_CORRUPT,pzErr,
+              "session predecessor is missing its ETag");
+        }else if( bExpected ){
+          zExpectedETag = sqlite3_mprintf(
+              "%s",pCont->zSessionPredecessorETag
+          );
+        }
+        if( rc==SQLITE_OK
+         && (zStorage==0 || zAccount==0 || zContainer==0
+             || zPrincipal==0 || zDatabase==0 || zOperations==0
+             || (bExpected && zExpectedETag==0))
+        ){
+          rc = bcvSessionError(SQLITE_NOMEM,pzErr,0);
+        }
+        if( rc==SQLITE_OK ){
+          pCont->nClient++;
+          bPinned = 1;
+        }
+      }
+    } LEAVE_VFS_MUTEX;
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+    pDisp = 0;
+    pBcv = 0;
+  }
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+
+  /* The current HEAD is the predecessor captured by scoped attach for a
+  ** new operation. Only an exact record hash/ETag pair is acceptable. A
+  ** different operation may be that valid predecessor (ordinary requests
+  ** advance the same session); only a pending PUBLISHING predecessor is a
+  ** conflict that must be reconciled before a successor can proceed. */
+  rc = bcvfsSessionReadHead(
+      pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+      &aHead,&nHead,&zHeadETag,&head,pzErr
+  );
+  if( rc==HTTP_NOT_FOUND ){
+    if( pzErr ){
+      sqlite3_free(*pzErr);
+      *pzErr = 0;
+    }
+    rc = SQLITE_OK;
+    bHeadMissing = 1;
+  }
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  if( !bHeadMissing ){
+    if( !bExpected
+     || memcmp(head.aRecordHash,aExpectedHeadHash,
+         sizeof(aExpectedHeadHash))!=0
+     || zHeadETag==0 || strcmp(zHeadETag,zExpectedETag)!=0
+    ){
+      rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,
+          "session head changed after scoped attach");
+      goto session_finalize_done;
+    }
+    if( memcmp(head.aOperationId,aOperationId,sizeof(aOperationId))==0 ){
+      if( head.eState==SQLITE_BCVFS_SESSION_ACCEPTED
+       || head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+       || head.eState==SQLITE_BCVFS_SESSION_COMMITTED
+      ){
+        rc = bcvfsSessionPublish(pFs,zAlias,zSessionId,pzErr);
+        goto session_finalize_done;
+      }
+      rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,
+          "session head is not finalizable");
+      goto session_finalize_done;
+    }
+    if( head.eState==SQLITE_BCVFS_SESSION_PUBLISHING ){
+      rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,
+          "another operation is awaiting publication reconciliation");
+      goto session_finalize_done;
+    }
+    if( head.eState!=SQLITE_BCVFS_SESSION_ACCEPTED
+     && head.eState!=SQLITE_BCVFS_SESSION_COMMITTED
+    ){
+      rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,
+          "session predecessor is not finalizable");
+      goto session_finalize_done;
+    }
+  }
+  if( bHeadMissing && bExpected ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,
+        "expected session predecessor head is missing");
+    goto session_finalize_done;
+  }
+  if( iExpectedSequence==0xFFFFFFFFFFFFFFFFULL
+   || iCheckpointExpectedSequence==0xFFFFFFFFFFFFFFFFULL
+  ){
+    rc = bcvSessionError(SQLITE_TOOBIG,pzErr,
+        "session finalization sequence exhausted");
+    goto session_finalize_done;
+  }
+
+  /* xSync/checkpoint is the only operation that snapshots the mutable
+  ** overlay. It writes an immutable checkpoint but does not advance HEAD. */
+  rc = sqlite3_bcvfs_session_checkpoint(
+      pFs,zAlias,zSessionId,aCheckpointHash,&zCheckpointETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  sqlite3_free(zCheckpointETag);
+  zCheckpointETag = 0;
+  rc = sqlite3_bcvfs_session_scope_hash(
+      zStorage,zAccount,zContainer,zPrincipal,zDatabase,zOperations,
+      aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  rc = sqlite3_bcvfs_session_fetch(
+      pFs,zAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zSessionId,
+      aCheckpointHash,zPrincipal,zDatabase,zOperations,
+      &aCheckpoint,&nCheckpoint,&zCheckpointETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  rc = sqlite3_bcvfs_session_record_decode(
+      aCheckpoint,nCheckpoint,zSessionId,aScope,&checkpoint,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  if( checkpoint.eType!=SQLITE_BCVFS_SESSION_CHECKPOINT
+   || checkpoint.eState!=SQLITE_BCVFS_SESSION_OPEN
+   || checkpoint.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+   || checkpoint.iSequence!=iCheckpointExpectedSequence+1
+   || memcmp(checkpoint.aPredecessorHash,aCheckpointPredecessorHash,
+       sizeof(aCheckpointPredecessorHash))!=0
+   || memcmp(checkpoint.aOperationId,aOperationId,sizeof(aOperationId))!=0
+  ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,
+        "session checkpoint does not match its current predecessor");
+    goto session_finalize_done;
+  }
+  rc = sqlite3_bcvfs_session_body_decode(
+      checkpoint.eType,checkpoint.eState,checkpoint.zSessionId,
+      checkpoint.aBody,checkpoint.nBody,&checkpointBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  if( checkpointBody.nBaseManifestETag<=0
+   || checkpointBody.nManifest<=0
+  ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,
+        "session checkpoint has no publication candidate");
+    goto session_finalize_done;
+  }
+  zBaseETag = sqlite3_mprintf("%.*s",checkpointBody.nBaseManifestETag,
+      checkpointBody.aBaseManifestETag);
+  if( zBaseETag==0 ){
+    rc = SQLITE_NOMEM;
+    goto session_finalize_done;
+  }
+  {
+    SHA256_CTX sha;
+    SHA256_Init(&sha);
+    SHA256_Update(&sha,checkpointBody.aManifest,checkpointBody.nManifest);
+    SHA256_Final(aCandidateHash,&sha);
+  }
+
+  /* The exact candidate must exist before a PUBLISHING head can make it
+  ** recoverable by another serverless invocation. */
+  rc = bcvfsSessionCandidatePut(
+      pFs,zAlias,aCandidateHash,checkpointBody.aManifest,
+      checkpointBody.nManifest,&zCandidateETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  sqlite3_free(zCandidateETag);
+  zCandidateETag = 0;
+
+  /* Synthesize an OPEN predecessor solely to reuse the canonical head
+  ** encoder. Its record hash is the captured predecessor hash, so the
+  ** resulting PUBLISHING record carries the exact predecessor fence. */
+  base.eType = SQLITE_BCVFS_SESSION_HEAD;
+  base.eState = SQLITE_BCVFS_SESSION_OPEN;
+  base.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+  base.iSequence = checkpoint.iSequence;
+  base.iCreated = checkpoint.iCreated;
+  base.iExpires = checkpoint.iExpires;
+  memcpy(base.zSessionId,zSessionId,strlen(zSessionId)+1);
+  memcpy(base.aScopeHash,aScope,sizeof(aScope));
+  memcpy(base.aRecordHash,aExpectedHeadHash,sizeof(aExpectedHeadHash));
+  memcpy(base.aOperationId,aOperationId,sizeof(aOperationId));
+  /* Preserve the V2 history root/tail while synthesizing the OPEN
+  ** predecessor for direct finalization.  Dropping it would make a later
+  ** retry look NEW after the finalizer crossed the publication fence. */
+  if( !bHeadMissing ){
+    base.aBody = head.aBody;
+    base.nBody = head.nBody;
+  }
+  rc = bcvfsSessionEncodeHeadState(
+      &base,SQLITE_BCVFS_SESSION_PUBLISHING,
+      SQLITE_BCVFS_SESSION_OUTCOME_NONE,aCheckpointHash,aCandidateHash,
+      zBaseETag,&aEncoded,&nEncoded,aNewRecordHash,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_finalize_done;
+  {
+    const char *zIfMatch = bExpected ? zExpectedETag : "*";
+    sqlite3_free(zHeadETag);
+    zHeadETag = 0;
+    rc = sqlite3_bcvfs_session_put(
+        pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+        zPrincipal,zDatabase,zOperations,zIfMatch,
+        aEncoded,nEncoded,&zHeadETag,pzErr
+    );
+  }
+  if( rc!=SQLITE_OK ){
+    int rcOriginal = rc;
+    char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+    if( pzErr ) *pzErr = 0;
+    sqlite3_free(aHead); aHead = 0;
+    sqlite3_free(zHeadETag); zHeadETag = 0;
+    memset(&head,0,sizeof(head));
+    rc = bcvfsSessionReadHead(
+        pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+        &aHead,&nHead,&zHeadETag,&head,&zReconcileErr
+    );
+    if( rc==SQLITE_OK && nHead==nEncoded
+     && memcmp(aHead,aEncoded,nEncoded)==0
+    ){
+      rc = SQLITE_OK;
+    }else{
+      rc = rcOriginal;
+      if( pzErr && *pzErr==0 ){
+        *pzErr = zOriginal ? zOriginal : zReconcileErr;
+        if( *pzErr==zOriginal ) zOriginal = 0;
+        if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+      }
+    }
+    sqlite3_free(zOriginal);
+  }
+  if( rc==SQLITE_OK ){
+    sqlite3_free(aEncoded);
+    aEncoded = 0;
+    rc = bcvfsSessionPublish(pFs,zAlias,zSessionId,pzErr);
+  }
+
+session_finalize_done:
+  sqlite3_free(zStorage);
+  sqlite3_free(zAccount);
+  sqlite3_free(zContainer);
+  sqlite3_free(zPrincipal);
+  sqlite3_free(zDatabase);
+  sqlite3_free(zOperations);
+  sqlite3_free(zExpectedETag);
+  sqlite3_free(zHeadETag);
+  sqlite3_free(zCheckpointETag);
+  sqlite3_free(zCandidateETag);
+  sqlite3_free(zBaseETag);
+  sqlite3_free(zReconcileErr);
+  sqlite3_free(aHead);
+  sqlite3_free(aCheckpoint);
+  sqlite3_free(aEncoded);
+  if( bPinned ){
+    ENTER_VFS_MUTEX; {
+      assert(pCont->nClient>0);
+      pCont->nClient--;
+    } LEAVE_VFS_MUTEX;
+  }
+  return rc;
+}
+
+int sqlite3_bcvfs_session_finalize(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  char **pzErr
+){
+  return bcvfsSessionFinalizeNew(pFs,zAlias,zSessionId,pzErr);
+}
+static int bcvfsSessionVerifyCheckpointBlocks(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  const sqlite3_bcvfs_session_body *pBody,
+  char **pzErr
+){
+  Manifest *pMan = 0;
+  char *zBaseETag = 0;
+  char *zParseErr = 0;
+  int rc = SQLITE_OK;
+  if( pzErr ) *pzErr = 0;
+  if( pFs==0 || pCont==0 || pBody==0
+   || pBody->aManifest==0 || pBody->nManifest<=0
+  ){
+    return bcvSessionError(SQLITE_CORRUPT,pzErr,"checkpoint has no manifest to verify");
+  }
+  zBaseETag = sqlite3_malloc64((sqlite3_uint64)pBody->nBaseManifestETag+1);
+  if( zBaseETag==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  memcpy(zBaseETag,pBody->aBaseManifestETag,pBody->nBaseManifestETag);
+  zBaseETag[pBody->nBaseManifestETag] = '\0';
+  rc = bcvManifestParseCopy(
+      pBody->aManifest,pBody->nManifest,zBaseETag,&pMan,&zParseErr
+  );
+  if( rc!=SQLITE_OK ){
+    if( pzErr ) *pzErr = zParseErr;
+    else sqlite3_free(zParseErr);
+    zParseErr = 0;
+    goto session_verify_blocks_done;
+  }
+  if( pFs->c.szBlk>0 && pFs->c.szBlk!=pMan->szBlk ){
+    rc = bcvSessionError(
+        SQLITE_CORRUPT,pzErr,"checkpoint manifest block size does not match the VFS"
+    );
+  }
+  if( rc==SQLITE_OK ) rc = bcvfsSessionManifestShapeValid(
+      pCont->pMan,pMan,pCont->zSessionDatabase,pBody->iFileSize,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    /* Checkpoint creation successfully staged every changed mapping and
+    ** recorded it in the local staged-object ledger. Unchanged mappings are
+    ** already part of the published base manifest. Re-check only this
+    ** ledger: fetching every original block here would make each tiny
+    ** request O(database size), and a successful staged PUT is the exact
+    ** durability proof available to the checkpoint protocol. */
+    rc = bcvfsSessionVerifyMappings(pFs,pCont,pMan,pzErr);
+  }
+
+session_verify_blocks_done:
+  sqlite3_free(zParseErr);
+  sqlite3_free(zBaseETag);
+  if( pMan ) bcvManifestDeref(pMan);
+  return rc;
+}
+
+static int bcvfsSessionAcceptHeadMatches(
+  const sqlite3_bcvfs_session_record *pHead,
+  const sqlite3_bcvfs_session_body *pHeadBody,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash,
+  const char *zBaseETag,
+  const unsigned char *aOperationId,
+  sqlite3_uint64 iSequence,
+  const char *zSessionId
+){
+  return pHead!=0
+      && pHeadBody!=0
+      && (pHead->eState==SQLITE_BCVFS_SESSION_ACCEPTED
+          || pHead->eState==SQLITE_BCVFS_SESSION_COMMITTED)
+      && pHead->eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS
+      && pHead->iSequence==iSequence
+      && strcmp(pHead->zSessionId,zSessionId)==0
+      && bcvSessionEqual(pHead->aOperationId,aOperationId,
+          SQLITE_BCVFS_SESSION_HASH_BYTES)
+      && bcvSessionEqual(pHeadBody->aCheckpointHash,aCheckpointHash,
+          SQLITE_BCVFS_SESSION_HASH_BYTES)
+      && bcvSessionEqual(pHeadBody->aCandidateManifestHash,aCandidateHash,
+          SQLITE_BCVFS_SESSION_HASH_BYTES)
+      && pHeadBody->nBaseManifestETag==(int)strlen(zBaseETag)
+      && 0==memcmp(pHeadBody->aBaseManifestETag,zBaseETag,
+          (size_t)pHeadBody->nBaseManifestETag);
+}
+
+static int bcvfsSessionExpectedHeadMatches(
+  Container *pCont,
+  const sqlite3_bcvfs_session_record *pHead,
+  const char *zHeadETag,
+  char **pzErr
+){
+  int bExpected = pCont->bSessionPredecessorPresent;
+  int bMatches = bExpected == (pHead!=0)
+      && (!bExpected
+          || (zHeadETag!=0 && pCont->zSessionPredecessorETag!=0
+              && strcmp(zHeadETag,pCont->zSessionPredecessorETag)==0
+              && pHead!=0
+              && bcvSessionEqual(
+                   pHead->aRecordHash,pCont->aSessionExpectedHeadHash,
+                   SQLITE_BCVFS_SESSION_HASH_BYTES
+              )));
+  if( !bMatches ){
+    return bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,"session accepted-head predecessor changed"
+    );
+  }
+  return SQLITE_OK;
+}
+
+/* Return true when the durable HEAD is exactly the predecessor captured by
+** this attachment.  Status checks use this distinction to permit a genuinely
+** new operation after a committed predecessor while still rejecting a stale
+** attachment that races a changed head. */
+static int bcvfsSessionExpectedHeadIsCurrent(
+  Container *pCont,
+  const sqlite3_bcvfs_session_record *pHead,
+  const char *zHeadETag
+){
+  if( pCont->bSessionPredecessorPresent != (pHead!=0) ) return 0;
+  if( !pCont->bSessionPredecessorPresent ) return 1;
+  return zHeadETag!=0 && pCont->zSessionPredecessorETag!=0
+      && pHead!=0
+      && strcmp(zHeadETag,pCont->zSessionPredecessorETag)==0
+      && bcvSessionEqual(
+          pHead->aRecordHash,pCont->aSessionExpectedHeadHash,
+          SQLITE_BCVFS_SESSION_HASH_BYTES
+      );
+}
+
+static int bcvfsSessionHistoryContainsDirect(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const unsigned char aHistoryRoot[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  const unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  int *pbFound,
+  char **pzErr
+);
+
+/* Check the bounded operation tail in HEAD, then its immutable history root. */
+static int bcvfsSessionHistoryContainsOperation(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const sqlite3_bcvfs_session_body *pHeadBody,
+  const unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  int *pbFound,
+  char **pzErr
+){
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc;
+  int ii;
+  if( pbFound ) *pbFound = 0;
+  if( pzErr ) *pzErr = 0;
+  if( pFs==0 || pCont==0 || zAlias==0 || zSessionId==0
+   || zPrincipal==0 || zDatabase==0 || zOperations==0
+   || pHeadBody==0 || aOperationId==0 || pbFound==0
+   || (pHeadBody->nHistoryOperations>0
+       && pHeadBody->aHistoryOperations==0)
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session history arguments are required");
+  }
+  rc = bcvSessionBoundScope(
+      pCont,SQLITE_BCVFS_SESSION_CHECKPOINT,
+      zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ) return rc;
+  for(ii=0; ii<pHeadBody->nHistoryOperations; ii++){
+    if( bcvSessionEqual(
+            &pHeadBody->aHistoryOperations[ii*SQLITE_BCVFS_SESSION_HASH_BYTES],
+            aOperationId,SQLITE_BCVFS_SESSION_HASH_BYTES
+        )
+    ){
+      *pbFound = 1;
+      return SQLITE_OK;
+    }
+  }
+  if( !bcvSessionAllZero(pHeadBody->aHistoryHeadHash,
+      SQLITE_BCVFS_SESSION_HASH_BYTES)
+  ){
+    return bcvfsSessionHistoryContainsDirect(
+        pFs,pCont,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+        pHeadBody->aHistoryHeadHash,aOperationId,pbFound,pzErr
+    );
+  }
+  return SQLITE_OK;
+}
+
+
+/* Verify that the final checkpoint is descended from the checkpoint captured
+** when this attachment was created. xSync may create several immutable
+** checkpoints before the application decides to accept the request. The
+** accepted-head CAS must therefore fence the complete checkpoint ancestry,
+** rather than comparing the final checkpoint's predecessor with the HEAD
+** record hash (those are different hash domains). */
+static int bcvfsSessionCheckpointChainMatches(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const sqlite3_bcvfs_session_record *pLatest,
+  const sqlite3_bcvfs_session_body *pLatestBody,
+  const unsigned char aLatestHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  unsigned char aHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aSeen[BCV_SESSION_REHYDRATE_MAX_CHAIN]
+      [SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char *aData = 0;
+  char *zETag = 0;
+  sqlite3_bcvfs_session_record record;
+  sqlite3_bcvfs_session_body body;
+  sqlite3_uint64 iUpperSequence;
+  int nData = 0;
+  int nSeen = 0;
+  int rc = SQLITE_OK;
+  int ii;
+  if( pzErr ) *pzErr = 0;
+  if( pFs==0 || pCont==0 || pLatest==0 || pLatestBody==0 || aLatestHash==0
+   || zAlias==0 || zSessionId==0 || zPrincipal==0
+   || zDatabase==0 || zOperations==0
+  ){
+    return bcvSessionError(
+        SQLITE_MISUSE,pzErr,"session checkpoint chain arguments are required"
+    );
+  }
+  rc = bcvSessionBoundScope(
+      pCont,SQLITE_BCVFS_SESSION_CHECKPOINT,
+      zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ) return rc;
+  if( bcvSessionEqual(aLatestHash,pCont->aSessionExpectedCheckpointHash,
+      SQLITE_BCVFS_SESSION_HASH_BYTES) ){
+    return bcvSessionError(
+        SQLITE_CORRUPT,pzErr,"session checkpoint chain points to itself"
+    );
+  }
+  if( pLatest->iSequence<=pCont->iSessionExpectedSequence
+   || bcvSessionAllZero(pLatest->aOperationId,
+       SQLITE_BCVFS_SESSION_HASH_BYTES)
+   || !bcvSessionEqual(pLatest->aOperationId,pCont->aSessionOperationId,
+       SQLITE_BCVFS_SESSION_HASH_BYTES)
+  ){
+    return bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,"session checkpoint is not descended from its bound operation"
+    );
+  }
+  if( pLatestBody->bCompacted ){
+    if( !bcvSessionEqual(
+          pLatest->aPredecessorHash,
+          pLatestBody->aBaseCheckpointHash,
+          SQLITE_BCVFS_SESSION_HASH_BYTES
+        )
+     || !bcvSessionEqual(
+          pLatestBody->aBaseCheckpointHash,
+          pCont->aSessionExpectedCheckpointHash,
+          SQLITE_BCVFS_SESSION_HASH_BYTES
+        )
+    ){
+      return bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "compacted checkpoint does not match its captured predecessor"
+      );
+    }
+    return SQLITE_OK;
+  }
+  memcpy(aHash,pLatest->aPredecessorHash,sizeof(aHash));
+  iUpperSequence = pLatest->iSequence;
+  while( !bcvSessionEqual(
+      aHash,pCont->aSessionExpectedCheckpointHash,
+      SQLITE_BCVFS_SESSION_HASH_BYTES
+  ) ){
+    if( bcvSessionAllZero(aHash,sizeof(aHash)) ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "session checkpoint chain does not reach its captured predecessor"
+      );
+      break;
+    }
+    if( nSeen>=BCV_SESSION_REHYDRATE_MAX_CHAIN ){
+      rc = bcvSessionError(
+          SQLITE_TOOBIG,pzErr,"session checkpoint chain is too deep"
+      );
+      break;
+    }
+    for(ii=0; ii<nSeen; ii++){
+      if( bcvSessionEqual(aSeen[ii],aHash,sizeof(aHash)) ){
+        rc = bcvSessionError(
+            SQLITE_CORRUPT,pzErr,"session checkpoint chain contains a cycle"
+        );
+        break;
+      }
+    }
+    if( rc!=SQLITE_OK ) break;
+    memcpy(aSeen[nSeen],aHash,sizeof(aHash));
+    nSeen++;
+    rc = sqlite3_bcvfs_session_fetch(
+        pFs,zAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zSessionId,aHash,
+        zPrincipal,zDatabase,zOperations,&aData,&nData,&zETag,pzErr
+    );
+    if( rc!=SQLITE_OK ) break;
+    memset(&record,0,sizeof(record));
+    memset(&body,0,sizeof(body));
+    rc = sqlite3_bcvfs_session_record_decode(
+        aData,nData,zSessionId,aScope,&record,pzErr
+    );
+    if( rc==SQLITE_OK && (
+        record.eType!=SQLITE_BCVFS_SESSION_CHECKPOINT
+        || record.eState!=SQLITE_BCVFS_SESSION_OPEN
+        || record.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+        || record.iSequence==0
+        || record.iSequence>=iUpperSequence
+        || record.iSequence<=pCont->iSessionExpectedSequence
+        || !bcvSessionEqual(record.aOperationId,pCont->aSessionOperationId,
+            SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ) ){
+      rc = bcvSessionError(
+          SQLITE_CORRUPT,pzErr,
+          "session checkpoint chain identity or sequence is invalid"
+      );
+    }
+    if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_body_decode(
+        record.eType,record.eState,record.zSessionId,
+        record.aBody,record.nBody,&body,pzErr
+    );
+    if( rc==SQLITE_OK && body.bCompacted
+     && (!bcvSessionEqual(
+             record.aPredecessorHash,body.aBaseCheckpointHash,
+             SQLITE_BCVFS_SESSION_HASH_BYTES
+         )
+         || !bcvSessionEqual(
+             body.aBaseCheckpointHash,pCont->aSessionExpectedCheckpointHash,
+             SQLITE_BCVFS_SESSION_HASH_BYTES
+         ))
+    ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "compacted checkpoint does not match its captured predecessor"
+      );
+    }
+    if( rc==SQLITE_OK ){
+      iUpperSequence = record.iSequence;
+      memcpy(aHash,record.aPredecessorHash,sizeof(aHash));
+    }
+    sqlite3_free(aData);
+    aData = 0;
+    sqlite3_free(zETag);
+    zETag = 0;
+  }
+  sqlite3_free(aData);
+  sqlite3_free(zETag);
+  return rc;
+}
+
+/* Build one immutable history segment.  The segment key is its record hash,
+** not an operation ID.  Its body contains a bounded operation-ID batch and
+** the predecessor segment root.  A segment uploaded before the HEAD CAS is
+** harmless if the CAS loses: only a root named by HEAD is authoritative. */
+static int bcvfsSessionHistoryBody(
+  const unsigned char aPredecessorRoot[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  const unsigned char *aOperations,
+  int nOperations,
+  unsigned char **paBody,
+  int *pnBody,
+  char **pzErr
+){
+  sqlite3_uint64 nBody;
+  unsigned char *aBody = 0;
+  int ii;
+  if( paBody ) *paBody = 0;
+  if( pnBody ) *pnBody = 0;
+  if( aPredecessorRoot==0 || aOperations==0 || nOperations<=0
+   || nOperations>BCV_SESSION_MAX_HISTORY_OPERATIONS
+   || paBody==0 || pnBody==0
+  ) return bcvSessionError(SQLITE_MISUSE,pzErr,"history body arguments are required");
+  for(ii=0; ii<nOperations; ii++){
+    if( bcvSessionAllZero(
+            &aOperations[ii*SQLITE_BCVFS_SESSION_HASH_BYTES],
+            SQLITE_BCVFS_SESSION_HASH_BYTES
+        )
+    ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,
+          "history body contains an empty operation ID");
+    }
+  }
+  nBody = 48 + (sqlite3_uint64)nOperations
+      * SQLITE_BCVFS_SESSION_HASH_BYTES;
+  if( nBody>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES || nBody>0x7fffffffULL ){
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"history body exceeds the size limit");
+  }
+  aBody = (unsigned char*)sqlite3_malloc64(nBody);
+  if( aBody==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  memset(aBody,0,(size_t)nBody);
+  memcpy(aBody,aBcvSessionHistoryBodyMagic,8);
+  memcpy(&aBody[8],aPredecessorRoot,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  bcvPutU32(&aBody[40],(u32)nOperations);
+  bcvPutU32(&aBody[44],0);
+  memcpy(&aBody[48],aOperations,
+      (size_t)nOperations*SQLITE_BCVFS_SESSION_HASH_BYTES);
+  *paBody = aBody;
+  *pnBody = (int)nBody;
+  return SQLITE_OK;
+}
+
+static int bcvfsSessionHistoryContainsDirect(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const unsigned char aHistoryRoot[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  const unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  int *pbFound,
+  char **pzErr
+){
+  unsigned char *aData = 0;
+  char *zETag = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_bcvfs_session_record record;
+  sqlite3_bcvfs_session_body body;
+  int nData = 0;
+  int rc = SQLITE_OK;
+  if( pbFound ) *pbFound = 0;
+  if( pzErr ) *pzErr = 0;
+  unsigned char aSeen[BCV_SESSION_REHYDRATE_MAX_CHAIN]
+      [SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aRoot[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int nSeen = 0;
+  int ii;
+  if( pCont==0 || aHistoryRoot==0 || aOperationId==0 || pbFound==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"history lookup arguments are required");
+  }
+  rc = bcvSessionBoundScope(
+      pCont,SQLITE_BCVFS_SESSION_HISTORY,
+      zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ) return rc;
+  memcpy(aRoot,aHistoryRoot,sizeof(aRoot));
+  while( rc==SQLITE_OK && !bcvSessionAllZero(aRoot,sizeof(aRoot)) ){
+    if( nSeen>=BCV_SESSION_REHYDRATE_MAX_CHAIN ){
+      rc = bcvSessionError(SQLITE_TOOBIG,pzErr,
+          "session history segment chain is too deep");
+      break;
+    }
+    for(ii=0; ii<nSeen; ii++){
+      if( bcvSessionEqual(aSeen[ii],aRoot,sizeof(aRoot)) ){
+        rc = bcvSessionError(SQLITE_CORRUPT,pzErr,
+            "session history segment chain contains a cycle");
+        break;
+      }
+    }
+    if( rc!=SQLITE_OK ) break;
+    memcpy(aSeen[nSeen++],aRoot,sizeof(aRoot));
+    sqlite3_free(aData); aData = 0;
+    sqlite3_free(zETag); zETag = 0;
+    rc = sqlite3_bcvfs_session_fetch(
+        pFs,zAlias,SQLITE_BCVFS_SESSION_HISTORY,zSessionId,aRoot,
+        zPrincipal,zDatabase,zOperations,&aData,&nData,&zETag,pzErr
+    );
+    if( rc==HTTP_NOT_FOUND ){
+      rc = bcvSessionError(SQLITE_CORRUPT,pzErr,
+          "session history root is missing");
+      break;
+    }
+    if( rc!=SQLITE_OK ) break;
+    memset(&record,0,sizeof(record));
+    memset(&body,0,sizeof(body));
+    rc = sqlite3_bcvfs_session_record_decode(
+        aData,nData,zSessionId,aScope,&record,pzErr
+    );
+    if( rc==SQLITE_OK && (
+        record.eType!=SQLITE_BCVFS_SESSION_HISTORY
+        || record.eState!=SQLITE_BCVFS_SESSION_ACCEPTED
+        || record.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS
+        || !bcvSessionEqual(record.aRecordHash,aRoot,
+            SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ) ){
+      rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid session history segment");
+    }
+    if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_body_decode(
+        record.eType,record.eState,record.zSessionId,
+        record.aBody,record.nBody,&body,pzErr
+    );
+    if( rc==SQLITE_OK
+     && (body.nHistoryOperations<=0 || body.aHistoryOperations==0)
+    ){
+      rc = bcvSessionError(SQLITE_CORRUPT,pzErr,
+          "session history segment has no operations");
+    }
+    if( rc==SQLITE_OK ){
+      for(ii=0; ii<body.nHistoryOperations; ii++){
+        if( bcvSessionEqual(
+                &body.aHistoryOperations[ii*SQLITE_BCVFS_SESSION_HASH_BYTES],
+                aOperationId,SQLITE_BCVFS_SESSION_HASH_BYTES
+            )
+        ){
+          *pbFound = 1;
+          break;
+        }
+      }
+      memcpy(aRoot,body.aHistoryHeadHash,sizeof(aRoot));
+    }
+  }
+  sqlite3_free(aData);
+  sqlite3_free(zETag);
+  return rc;
+}
+
+int sqlite3_bcvfs_session_accept(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  char **pzETag,
+  char **pzErr
+){
+  Container *pCont = 0;
+  char *zPrincipal = 0;
+  char *zDatabase = 0;
+  char *zOperations = 0;
+  char *zHeadETag = 0;
+  char *zCheckpointETag = 0;
+  char *zNewETag = 0;
+  char *zReconcileErr = 0;
+  char *zBaseETag = 0;
+  char *zManifestETag = 0;
+  char *zHistoryETag = 0;
+  unsigned char *aHead = 0;
+  unsigned char *aCheckpoint = 0;
+  unsigned char *aManifest = 0;
+  unsigned char *aEncoded = 0;
+  unsigned char *aHistoryBody = 0;
+  unsigned char *aHistoryEncoded = 0;
+  unsigned char *aNewHistoryOperations = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCandidateHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHistoryRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aNewHistoryRoot[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_bcvfs_session_record head;
+  sqlite3_bcvfs_session_record checkpoint;
+  sqlite3_bcvfs_session_body headBody;
+  sqlite3_bcvfs_session_body checkpointBody;
+  sqlite3_bcvfs_session_record accepted;
+  sqlite3_bcvfs_session_body acceptedBody;
+  int nHead = 0;
+  int nCheckpoint = 0;
+  int nEncoded = 0;
+  int nHistoryBody = 0;
+  int nHistoryEncoded = 0;
+  int nNewHistoryOperations = 0;
+  int rc = SQLITE_OK;
+  int bPinned = 0;
+  int bEntered = 0;
+  sqlite3_int64 iNow = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  memset(&head,0,sizeof(head));
+  memset(&checkpoint,0,sizeof(checkpoint));
+  memset(&accepted,0,sizeof(accepted));
+  memset(&headBody,0,sizeof(headBody));
+  memset(&checkpointBody,0,sizeof(checkpointBody));
+  memset(&acceptedBody,0,sizeof(acceptedBody));
+  memset(aCheckpointHash,0,sizeof(aCheckpointHash));
+  memset(aCandidateHash,0,sizeof(aCandidateHash));
+  memset(aRecordHash,0,sizeof(aRecordHash));
+  memset(aHistoryRecordHash,0,sizeof(aHistoryRecordHash));
+  memset(aNewHistoryRoot,0,sizeof(aNewHistoryRoot));
+  memset(aScope,0,sizeof(aScope));
+  if( pFs==0 || zAlias==0 || !bcvfsValidSessionId(zSessionId) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session acceptance identity is invalid");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session acceptance is unavailable through the CBS daemon");
+  }
+  ENTER_VFS_MUTEX; {
+    pCont = bcvfsFindContAlias(&pFs->c,zAlias,pzErr);
+    if( pCont==0 ){
+      rc = SQLITE_ERROR;
+    }else if( pCont->zSessionId==0 || strcmp(pCont->zSessionId,zSessionId)!=0
+           || pCont->nSessionRef<=0 ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session acceptance does not own container alias");
+    }else if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session acceptance scope is not bound");
+    }else if( pCont->nClient>0 || pCont->eState!=CONTAINER_STATE_NONE ){
+      rc = bcvSessionError(SQLITE_BUSY,pzErr,"session acceptance requires a quiescent container");
+    }else if( !pCont->bSessionOverlay ){
+      rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session acceptance requires a final checkpoint");
+    }else{
+      zPrincipal = sqlite3_mprintf("%s",pCont->zSessionPrincipal);
+      zDatabase = sqlite3_mprintf("%s",pCont->zSessionDatabase);
+      zOperations = sqlite3_mprintf("%s",pCont->zSessionOperations);
+      if( zPrincipal==0 || zDatabase==0 || zOperations==0 ){
+        rc = bcvSessionError(SQLITE_NOMEM,pzErr,0);
+      }else{
+        bcvfsEnterState(pFs,pCont,CONTAINER_STATE_UPLOAD);
+        bEntered = 1;
+        pCont->nClient++;
+        bPinned = 1;
+      }
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+
+  rc = sqlite3_bcvfs_session_scope_hash(
+      pCont->zStorage,pCont->zAccount,pCont->zContainer,
+      zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+  rc = bcvfsSessionReadHead(
+      pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+      &aHead,&nHead,&zHeadETag,&head,pzErr
+  );
+  if( rc==HTTP_NOT_FOUND ){
+    sqlite3_free(aHead); aHead = 0;
+    sqlite3_free(zHeadETag); zHeadETag = 0;
+    if( pzErr ){
+      sqlite3_free(*pzErr);
+      *pzErr = 0;
+    }
+    memset(&head,0,sizeof(head));
+    rc = SQLITE_OK;
+  }
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+  memcpy(aCheckpointHash,pCont->aSessionPredecessorHash,sizeof(aCheckpointHash));
+  if( bcvSessionAllZero(aCheckpointHash,sizeof(aCheckpointHash)) ){
+    rc = bcvSessionError(SQLITE_CONSTRAINT,pzErr,"session acceptance has no checkpoint hash");
+    goto session_accept_done;
+  }
+  rc = sqlite3_bcvfs_session_fetch(
+      pFs,zAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zSessionId,
+      aCheckpointHash,zPrincipal,zDatabase,zOperations,
+      &aCheckpoint,&nCheckpoint,&zCheckpointETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+  rc = sqlite3_bcvfs_session_record_decode(
+      aCheckpoint,nCheckpoint,zSessionId,aScope,&checkpoint,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+  rc = sqlite3_bcvfs_session_body_decode(
+      checkpoint.eType,checkpoint.eState,checkpoint.zSessionId,
+      checkpoint.aBody,checkpoint.nBody,&checkpointBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+  if( checkpoint.eType!=SQLITE_BCVFS_SESSION_CHECKPOINT
+   || checkpoint.eState!=SQLITE_BCVFS_SESSION_OPEN
+   || checkpoint.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+   || checkpoint.iSequence!=pCont->iSessionSequence
+   || checkpoint.iSequence<=pCont->iSessionExpectedSequence
+   || memcmp(checkpoint.aOperationId,pCont->aSessionOperationId,
+       sizeof(checkpoint.aOperationId))!=0
+  ){
+    rc = bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,"session checkpoint does not match its bound operation"
+    );
+    goto session_accept_done;
+  }
+  rc = bcvfsSessionCheckpointChainMatches(
+      pFs,pCont,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+      &checkpoint,&checkpointBody,aCheckpointHash,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+  if( pFs->c.pVfs->xCurrentTimeInt64(
+          pFs->c.pVfs,&iNow
+      )!=SQLITE_OK
+   || sqlite3_bcvfs_session_record_is_expired(&checkpoint,iNow)
+  ){
+    rc = bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint has expired");
+    goto session_accept_done;
+  }
+  if( checkpointBody.nBaseManifestETag<=0 ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"session checkpoint has no base manifest ETag");
+    goto session_accept_done;
+  }
+  zBaseETag = sqlite3_malloc64((sqlite3_uint64)checkpointBody.nBaseManifestETag+1);
+  if( zBaseETag==0 ){
+    rc = SQLITE_NOMEM;
+    goto session_accept_done;
+  }
+  memcpy(zBaseETag,checkpointBody.aBaseManifestETag,checkpointBody.nBaseManifestETag);
+  zBaseETag[checkpointBody.nBaseManifestETag] = '\0';
+  {
+    SHA256_CTX sha;
+    SHA256_Init(&sha);
+    SHA256_Update(&sha,checkpointBody.aManifest,checkpointBody.nManifest);
+    SHA256_Final(aCandidateHash,&sha);
+  }
+
+  /* A retry may arrive on the same attachment after the HEAD CAS succeeded
+  ** but its response was lost.  Its expected predecessor is the head that
+  ** was captured at attachment time, so the ordinary predecessor check
+  ** would reject this exact duplicate.  Reconcile the complete candidate
+  ** first; a different operation or candidate still falls through to the
+  ** creation-time fence below. */
+  if( nHead>0 ){
+    rc = sqlite3_bcvfs_session_body_decode(
+        head.eType,head.eState,head.zSessionId,
+        head.aBody,head.nBody,&headBody,pzErr
+    );
+    if( rc!=SQLITE_OK ) goto session_accept_done;
+    if( !sqlite3_bcvfs_session_record_is_expired(&head,sqlite_timestamp())
+     && bcvfsSessionAcceptHeadMatches(
+          &head,&headBody,aCheckpointHash,aCandidateHash,zBaseETag,
+          pCont->aSessionOperationId,checkpoint.iSequence,zSessionId
+        )
+    ){
+      if( pzETag && zHeadETag ){
+        *pzETag = sqlite3_mprintf("%s",zHeadETag);
+        if( *pzETag==0 ) rc = SQLITE_NOMEM;
+      }
+      if( rc==SQLITE_OK ) goto session_accept_done;
+    }
+  }
+
+  /* A publishing head has already crossed the publication fence and is an
+  ** in-flight manifest update.  A plain accepted head remains a valid
+  ** predecessor for the next request, provided the operation-history check
+  ** below proves that this is not a replay of an older operation. */
+  if( nHead>0
+   && head.eState==SQLITE_BCVFS_SESSION_COMMITTED
+   && memcmp(head.aOperationId,pCont->aSessionOperationId,
+       sizeof(head.aOperationId))!=0
+  ){
+    rc = bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,"committed session head cannot accept another operation"
+    );
+    goto session_accept_done;
+  }
+  if( nHead>0
+   && head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+   && memcmp(head.aOperationId,pCont->aSessionOperationId,
+       sizeof(head.aOperationId))!=0
+  ){
+    rc = bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,"another session operation is awaiting reconciliation"
+    );
+    goto session_accept_done;
+  }
+
+  if( nHead>0
+   && bcvfsSessionExpectedHeadIsCurrent(pCont,&head,zHeadETag)
+   && memcmp(head.aOperationId,pCont->aSessionOperationId,
+       sizeof(head.aOperationId))!=0
+  ){
+    int bFound = 0;
+    rc = bcvfsSessionHistoryContainsOperation(
+        pFs,pCont,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+        &headBody,pCont->aSessionOperationId,
+        &bFound,pzErr
+    );
+    if( rc!=SQLITE_OK ) goto session_accept_done;
+    if( bFound ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "session operation was already superseded by a later operation"
+      );
+      goto session_accept_done;
+    }
+  }
+
+  if( checkpoint.iSequence<=pCont->iSessionExpectedSequence ){
+    rc = bcvSessionError(
+        SQLITE_CONSTRAINT,pzErr,"session checkpoint sequence is not newer than its predecessor"
+    );
+    goto session_accept_done;
+  }
+
+  rc = bcvfsSessionExpectedHeadMatches(
+      pCont,(nHead>0 ? &head : 0),zHeadETag,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+
+  {
+    int nManifest = 0;
+    rc = bcvfsSessionManifestFetch(
+        pFs,zAlias,&aManifest,&nManifest,&zManifestETag,pzErr
+    );
+    if( rc==SQLITE_OK
+     && (zManifestETag==0 || strcmp(zManifestETag,zBaseETag)!=0)
+    ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "published manifest changed before session acceptance"
+      );
+    }
+    sqlite3_free(aManifest); aManifest = 0;
+    sqlite3_free(zManifestETag); zManifestETag = 0;
+    if( rc!=SQLITE_OK ) goto session_accept_done;
+  }
+  rc = bcvfsSessionVerifyCheckpointBlocks(
+      pFs,pCont,&checkpointBody,pzErr
+  );
+  if( rc!=SQLITE_OK ) goto session_accept_done;
+
+  /* Carry the accepted HEAD's bounded tail forward.  At the watermark,
+  ** first persist an immutable segment containing the entire tail plus this
+  ** operation, then publish a HEAD that names that segment.  The segment PUT
+  ** is deliberately before the HEAD CAS so a visible root can never point at
+  ** an object that was not durable; a losing CAS leaves an unreferenced,
+  ** safely collectable object. */
+  nNewHistoryOperations = headBody.nHistoryOperations + 1;
+  if( nNewHistoryOperations<=0
+   || nNewHistoryOperations>BCV_SESSION_MAX_HISTORY_OPERATIONS
+  ){
+    rc = bcvSessionError(SQLITE_TOOBIG,pzErr,
+        "session operation history tail is full");
+    goto session_accept_done;
+  }
+  aNewHistoryOperations = (unsigned char*)sqlite3_malloc64(
+      (sqlite3_uint64)nNewHistoryOperations
+          * SQLITE_BCVFS_SESSION_HASH_BYTES
+  );
+  if( aNewHistoryOperations==0 ){
+    rc = bcvSessionError(SQLITE_NOMEM,pzErr,0);
+    goto session_accept_done;
+  }
+  if( headBody.nHistoryOperations>0 ) memcpy(
+      aNewHistoryOperations,
+      headBody.aHistoryOperations,
+      (size_t)headBody.nHistoryOperations*SQLITE_BCVFS_SESSION_HASH_BYTES
+  );
+  memcpy(
+      &aNewHistoryOperations[headBody.nHistoryOperations
+          * SQLITE_BCVFS_SESSION_HASH_BYTES],
+      pCont->aSessionOperationId,SQLITE_BCVFS_SESSION_HASH_BYTES
+  );
+  memcpy(aNewHistoryRoot,headBody.aHistoryHeadHash,sizeof(aNewHistoryRoot));
+
+  if( nNewHistoryOperations>=BCV_SESSION_COMPACTION_THRESHOLD ){
+    sqlite3_bcvfs_session_record history;
+    memset(&history,0,sizeof(history));
+    history.eType = SQLITE_BCVFS_SESSION_HISTORY;
+    history.eState = SQLITE_BCVFS_SESSION_ACCEPTED;
+    history.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS;
+    history.iSequence = checkpoint.iSequence;
+    history.iCreated = checkpoint.iCreated;
+    history.iExpires = checkpoint.iExpires;
+    memcpy(history.zSessionId,zSessionId,strlen(zSessionId)+1);
+    memcpy(history.aScopeHash,aScope,sizeof(aScope));
+    memcpy(history.aPredecessorHash,aNewHistoryRoot,
+        sizeof(history.aPredecessorHash));
+    memcpy(history.aOperationId,pCont->aSessionOperationId,
+        sizeof(history.aOperationId));
+    rc = bcvfsSessionHistoryBody(
+        aNewHistoryRoot,aNewHistoryOperations,nNewHistoryOperations,
+        &aHistoryBody,&nHistoryBody,pzErr
+    );
+    if( rc==SQLITE_OK ){
+      history.aBody = aHistoryBody;
+      history.nBody = nHistoryBody;
+      rc = sqlite3_bcvfs_session_record_encode(
+          &history,&aHistoryEncoded,&nHistoryEncoded,aHistoryRecordHash,pzErr
+      );
+    }
+    if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_put(
+        pFs,zAlias,SQLITE_BCVFS_SESSION_HISTORY,zSessionId,
+        aHistoryRecordHash,zPrincipal,zDatabase,zOperations,"*",
+        aHistoryEncoded,nHistoryEncoded,&zHistoryETag,pzErr
+    );
+    if( rc!=SQLITE_OK ) goto session_accept_done;
+    memcpy(aNewHistoryRoot,aHistoryRecordHash,sizeof(aNewHistoryRoot));
+    nNewHistoryOperations = 0;
+  }
+
+  memset(&accepted,0,sizeof(accepted));
+  accepted.eType = SQLITE_BCVFS_SESSION_HEAD;
+  accepted.eState = SQLITE_BCVFS_SESSION_ACCEPTED;
+  accepted.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS;
+  accepted.iSequence = checkpoint.iSequence;
+  accepted.iCreated = checkpoint.iCreated;
+  accepted.iExpires = checkpoint.iExpires;
+  memcpy(accepted.zSessionId,zSessionId,strlen(zSessionId)+1);
+  memcpy(accepted.aScopeHash,aScope,sizeof(aScope));
+  memcpy(accepted.aPredecessorHash,pCont->aSessionExpectedHeadHash,
+      sizeof(accepted.aPredecessorHash));
+  memcpy(accepted.aOperationId,pCont->aSessionOperationId,
+      sizeof(accepted.aOperationId));
+  accepted.aBody = 0;
+  accepted.nBody = 0;
+  rc = bcvfsSessionEncodeHeadStateEx(
+      &accepted,SQLITE_BCVFS_SESSION_ACCEPTED,
+      SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,aCheckpointHash,
+      aCandidateHash,zBaseETag,aNewHistoryRoot,aNewHistoryOperations
+          ? aNewHistoryOperations : 0,nNewHistoryOperations,
+      &aEncoded,&nEncoded,aRecordHash,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    const char *zIfMatch = pCont->bSessionPredecessorPresent
+        ? pCont->zSessionPredecessorETag : "*";
+    rc = sqlite3_bcvfs_session_put(
+        pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+        zPrincipal,zDatabase,zOperations,zIfMatch,aEncoded,nEncoded,
+        &zNewETag,pzErr
+    );
+  }
+  if( rc!=SQLITE_OK ){
+    int rcOriginal = rc;
+    char *zOriginal = pzErr && *pzErr ? *pzErr : 0;
+    if( pzErr ) *pzErr = 0;
+    sqlite3_free(aHead); aHead = 0;
+    sqlite3_free(zHeadETag); zHeadETag = 0;
+    memset(&head,0,sizeof(head));
+    nHead = 0;
+    rc = bcvfsSessionReadHead(
+        pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+        &aHead,&nHead,&zHeadETag,&head,&zReconcileErr
+    );
+    if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_body_decode(
+        head.eType,head.eState,head.zSessionId,
+        head.aBody,head.nBody,&acceptedBody,&zReconcileErr
+    );
+    if( rc==SQLITE_OK
+     && bcvfsSessionAcceptHeadMatches(
+            &head,&acceptedBody,aCheckpointHash,aCandidateHash,zBaseETag,
+            pCont->aSessionOperationId,checkpoint.iSequence,zSessionId
+        )
+    ){
+      rc = SQLITE_OK;
+      if( pzErr ){
+        sqlite3_free(*pzErr);
+        *pzErr = 0;
+      }
+    }else{
+      rc = rcOriginal;
+      if( pzErr && *pzErr==0 ){
+        *pzErr = zOriginal ? zOriginal : zReconcileErr;
+        if( *pzErr==zOriginal ) zOriginal = 0;
+        if( *pzErr==zReconcileErr ) zReconcileErr = 0;
+      }
+    }
+    sqlite3_free(zOriginal);
+  }
+  if( rc==SQLITE_OK && pzETag ){
+    *pzETag = zNewETag;
+    zNewETag = 0;
+  }
+
+session_accept_done:
+  sqlite3_free(zPrincipal);
+  sqlite3_free(zDatabase);
+  sqlite3_free(zOperations);
+  sqlite3_free(zHeadETag);
+  sqlite3_free(zCheckpointETag);
+  sqlite3_free(zNewETag);
+  sqlite3_free(zHistoryETag);
+  sqlite3_free(zReconcileErr);
+  sqlite3_free(zBaseETag);
+  sqlite3_free(zManifestETag);
+  sqlite3_free(aHead);
+  sqlite3_free(aCheckpoint);
+  sqlite3_free(aManifest);
+  sqlite3_free(aEncoded);
+  sqlite3_free(aHistoryBody);
+  sqlite3_free(aHistoryEncoded);
+  sqlite3_free(aNewHistoryOperations);
+  if( bEntered ){
+    ENTER_VFS_MUTEX; {
+      if( pCont->eState==CONTAINER_STATE_UPLOAD ) bcvfsLeaveState(pFs,pCont);
+    } LEAVE_VFS_MUTEX;
+  }
+  if( bPinned ){
+    ENTER_VFS_MUTEX; {
+      assert(pCont->nClient>0);
+      pCont->nClient--;
+    } LEAVE_VFS_MUTEX;
+  }
+  return rc;
+}
+
+int sqlite3_bcvfs_session_operation_status(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  int *pStatus,
+  char **pzErr
+){
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  char *zPrincipal = 0;
+  char *zDatabase = 0;
+  char *zOperations = 0;
+  char *zExpectedHeadETag = 0;
+  unsigned char aExpectedHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int bExpectedHeadPresent = 0;
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char *aHead = 0;
+  char *zHeadETag = 0;
+  sqlite3_bcvfs_session_record head;
+  sqlite3_bcvfs_session_body headBody;
+  int nHead = 0;
+  int rc = SQLITE_OK;
+  int bAcquired = 0;
+  if( pStatus ) *pStatus = SQLITE_BCVFS_SESSION_STATUS_NEW;
+  if( pzErr ) *pzErr = 0;
+  memset(&head,0,sizeof(head));
+  memset(&headBody,0,sizeof(headBody));
+  memset(aExpectedHeadHash,0,sizeof(aExpectedHeadHash));
+  memset(aOperationId,0,sizeof(aOperationId));
+  if( pFs==0 || zAlias==0 || !bcvfsValidSessionId(zSessionId) || pStatus==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session operation status arguments are invalid");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session operation status is unavailable through the CBS daemon");
+  }
+  rc = bcvSessionAcquire(
+      pFs,zAlias,zSessionId,&pCont,&pDisp,&pBcv,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    bAcquired = 1;
+    ENTER_VFS_MUTEX; {
+      if( !pCont->bSessionContext
+       || pCont->zSessionPrincipal==0
+       || pCont->zSessionDatabase==0
+       || pCont->zSessionOperations==0
+      ){
+        rc = bcvSessionError(
+            SQLITE_AUTH,pzErr,
+            "session operation status does not own a bound attachment"
+        );
+      }else{
+        zPrincipal = sqlite3_mprintf("%s",pCont->zSessionPrincipal);
+        zDatabase = sqlite3_mprintf("%s",pCont->zSessionDatabase);
+        zOperations = sqlite3_mprintf("%s",pCont->zSessionOperations);
+        bExpectedHeadPresent = pCont->bSessionPredecessorPresent;
+        memcpy(aExpectedHeadHash,pCont->aSessionExpectedHeadHash,
+            sizeof(aExpectedHeadHash));
+        if( bExpectedHeadPresent ){
+          zExpectedHeadETag = sqlite3_mprintf(
+              "%s",pCont->zSessionPredecessorETag
+          );
+        }
+        memcpy(aOperationId,pCont->aSessionOperationId,sizeof(aOperationId));
+        if( zPrincipal==0 || zDatabase==0 || zOperations==0
+         || (bExpectedHeadPresent && zExpectedHeadETag==0)
+        ) rc = SQLITE_NOMEM;
+      }
+    } LEAVE_VFS_MUTEX;
+  }
+  if( rc!=SQLITE_OK ) goto session_status_done;
+  rc = bcvfsSessionReadHead(
+      pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+      &aHead,&nHead,&zHeadETag,&head,pzErr
+  );
+  if( rc==HTTP_NOT_FOUND ){
+    if( pzErr ){
+      sqlite3_free(*pzErr);
+      *pzErr = 0;
+    }
+    rc = SQLITE_OK;
+    goto session_status_done;
+  }
+  if( rc!=SQLITE_OK ) goto session_status_done;
+  if( memcmp(head.aOperationId,aOperationId,
+      sizeof(head.aOperationId))!=0
+  ){
+    int bExpected = bExpectedHeadPresent == (nHead>0);
+    if( bExpectedHeadPresent ){
+      bExpected = bExpected && zExpectedHeadETag!=0 && zHeadETag!=0
+          && strcmp(zExpectedHeadETag,zHeadETag)==0
+          && bcvSessionEqual(
+              aExpectedHeadHash,head.aRecordHash,
+              SQLITE_BCVFS_SESSION_HASH_BYTES
+          );
+    }
+    if( head.eState==SQLITE_BCVFS_SESSION_COMMITTED
+     || head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+    ){
+      *pStatus = SQLITE_BCVFS_SESSION_STATUS_CONFLICT;
+    }else if( !bExpected ){
+      *pStatus = SQLITE_BCVFS_SESSION_STATUS_CONFLICT;
+    }else{
+      int bFound = 0;
+      rc = sqlite3_bcvfs_session_body_decode(
+          head.eType,head.eState,head.zSessionId,
+          head.aBody,head.nBody,&headBody,pzErr
+      );
+      if( rc==SQLITE_OK ) rc = bcvfsSessionHistoryContainsOperation(
+          pFs,pCont,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+          &headBody,aOperationId,&bFound,pzErr
+      );
+      if( rc==SQLITE_OK ){
+        *pStatus = bFound
+            ? SQLITE_BCVFS_SESSION_STATUS_CONFLICT
+            : SQLITE_BCVFS_SESSION_STATUS_NEW;
+      }
+    }
+  }else if( head.eState==SQLITE_BCVFS_SESSION_COMMITTED ){
+    *pStatus = SQLITE_BCVFS_SESSION_STATUS_COMMITTED;
+  }else if( head.eState==SQLITE_BCVFS_SESSION_ACCEPTED
+         || head.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+  ){
+    *pStatus = SQLITE_BCVFS_SESSION_STATUS_ACCEPTED;
+  }else if( head.eState==SQLITE_BCVFS_SESSION_ABORTED
+         || head.eState==SQLITE_BCVFS_SESSION_EXPIRED
+         || head.eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_FAILURE
+         || head.eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_CONFLICT
+  ){
+    *pStatus = SQLITE_BCVFS_SESSION_STATUS_FAILED;
+  }else{
+    *pStatus = SQLITE_BCVFS_SESSION_STATUS_CONFLICT;
+  }
+
+session_status_done:
+  sqlite3_free(zPrincipal);
+  sqlite3_free(zDatabase);
+  sqlite3_free(zOperations);
+  sqlite3_free(zExpectedHeadETag);
+  sqlite3_free(aHead);
+  sqlite3_free(zHeadETag);
+  if( bAcquired ) bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
