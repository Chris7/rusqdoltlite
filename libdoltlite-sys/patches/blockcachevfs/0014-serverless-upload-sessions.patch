+/*
+** Serverless session records
+**
+** Session state is deliberately kept in a namespace that cannot be confused
+** with a CBS manifest or block object.  The record format is binary and
+** length-delimited.  Its final SHA-256 digest covers the complete header and
+** body, but never a provider ETag: an ETag is an opaque conditional-version
+** token and is not assumed to be a content hash.
+*/
+#define BCV_SESSION_MAGIC_BYTES 8
+#define BCV_SESSION_VERSION 1
+#define BCV_SESSION_HEADER_BYTES 168
+#define BCV_SESSION_TRAILER_BYTES SHA256_DIGEST_LENGTH
+#define BCV_SESSION_TTL_MILLISECONDS (30LL*24*60*60*1000)
+#define BCV_SESSION_MAX_FIELD_BYTES 4096
+#define BCV_SESSION_MAX_ETAG_BYTES 4096
+#define BCV_SESSION_ROOT "bcv-session/v1/"
+
+static const unsigned char aBcvSessionCheckpointBodyMagic[8] = {
+  'B','C','V','C','P','0','1','\0'
+};
+static const unsigned char aBcvSessionCompactedCheckpointBodyMagic[8] = {
+  'B','C','V','C','S','0','1','\0'
+};
+static const unsigned char aBcvSessionHeadBodyMagic[8] = {
+  'B','C','V','H','D','0','2','\0'
+};
+static const unsigned char aBcvSessionPublicationBodyMagic[8] = {
+  'B','C','V','P','H','0','1','\0'
+};
+static const unsigned char aBcvSessionHistoryBodyMagic[8] = {
+  'B','C','V','H','S','0','2','\0'
+};
+
+static const unsigned char aBcvSessionMagic[BCV_SESSION_MAGIC_BYTES] = {
+  'B','C','V','S','R','0','1','\0'
+};
+
+/* Once the accepted session sequence reaches this bound, new request
+** checkpoints are self-contained snapshots.  Test builds may lower the
+** bound, but production keeps the immutable metadata bounded by the normal
+** session-record size limit. */
+#ifndef BCV_SESSION_COMPACTION_THRESHOLD
+# ifdef SQLITE_BCVFS_TESTING
+#  define BCV_SESSION_COMPACTION_THRESHOLD 4
+# else
+#  define BCV_SESSION_COMPACTION_THRESHOLD 1024
+# endif
+#endif
+
+/* A HEAD retains only the tail since its most recent immutable history
+** segment.  The segment itself contains the same bounded number of IDs and
+** points at the previous segment by record hash. */
+#define BCV_SESSION_MAX_HISTORY_OPERATIONS BCV_SESSION_COMPACTION_THRESHOLD
+
+static void bcvSessionPutU16(unsigned char *a, unsigned int v){
+  a[0] = (unsigned char)((v>>8)&0xFF);
+  a[1] = (unsigned char)(v&0xFF);
+}
+
+static unsigned int bcvSessionGetU16(const unsigned char *a){
+  return ((unsigned int)a[0]<<8) | (unsigned int)a[1];
+}
+
+static int bcvSessionAllZero(const unsigned char *a, int n){
+  int ii;
+  unsigned char v = 0;
+  for(ii=0; ii<n; ii++) v |= a[ii];
+  return v==0;
+}
+
+static int bcvSessionEqual(const unsigned char *a, const unsigned char *b, int n){
+  int ii;
+  unsigned char v = 0;
+  for(ii=0; ii<n; ii++) v |= (unsigned char)(a[ii]^b[ii]);
+  return v==0;
+}
+
+static int bcvSessionError(int rc, char **pzErr, const char *zMsg){
+  if( pzErr ){
+    sqlite3_free(*pzErr);
+    *pzErr = zMsg ? sqlite3_mprintf("%s", zMsg) : 0;
+  }
+  return rc;
+}
