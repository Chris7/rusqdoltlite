+struct BcvSessionGc {
+  sqlite3_bcv *p;
+  Manifest *pMan;
+  int nName;
+  BcvSessionGcObject *aObject;
+  int nObject;
+  int nObjectAlloc;
+  u8 **aKeep;
+  int nKeep;
+  int nKeepAlloc;
+  u8 *aOrphan;
+  int nOrphan;
+  int nOrphanAlloc;
+  ManifestHash *pOrphanHash;
+  ManifestHash *pMainHash;
+  ManifestHash *pKeepHash;
+  int nSecond;
+  i64 iNow;
+  int bLive;
+  int bGuardHeld;
+  u8 aGuardOwner[16];
+  char *zGuardETag;
+};
+
+static int bcvSessionGcError(char **pzErr, int rc, const char *zMsg){
+  if( pzErr ){
+    sqlite3_free(*pzErr);
+    *pzErr = zMsg ? sqlite3_mprintf("%s",zMsg) : 0;
+  }
+  return rc;
+}
+
+static int bcvSessionGcAllZero(const u8 *a, int n){
+  int ii;
+  u8 v = 0;
+  for(ii=0; ii<n; ii++) v |= a[ii];
+  return v==0;
+}
+
+static int bcvSessionGcHex(int c){
+  if( c>='0' && c<='9' ) return c-'0';
+  if( c>='a' && c<='f' ) return c-'a'+10;
+  if( c>='A' && c<='F' ) return c-'A'+10;
+  return -1;
+}
+
+static int bcvSessionGcDecodeHex(
+  const char *z,
+  int n,
+  u8 *aOut,
+  int nOut
+){
+  int ii;
+  if( z==0 || aOut==0 || n!=2*nOut ) return 0;
+  for(ii=0; ii<nOut; ii++){
+    int hi = bcvSessionGcHex((unsigned char)z[ii*2]);
+    int lo = bcvSessionGcHex((unsigned char)z[ii*2+1]);
+    if( hi<0 || lo<0 ) return 0;
+    aOut[ii] = (u8)((hi<<4)|lo);
+  }
+  return 1;
+}
+
+static int bcvSessionGcUuid(
+  const char *z,
+  int n,
+  u8 aUuid[16]
+){
+  static const int aDash[] = {8,13,18,23};
+  int ii;
+  int iOut = 0;
+  if( z==0 || aUuid==0 || n!=36 ) return 0;
+  for(ii=0; ii<n; ){
+    int i;
+    for(i=0; i<4; i++) if( ii==aDash[i] ){
+      if( z[ii++]!='-' ) return 0;
+      break;
+    }
+    if( ii>=n ) break;
+    if( i<4 && ii==aDash[i] ) continue;
+    if( iOut>=16 ) return 0;
+    {
+      int hi = bcvSessionGcHex((unsigned char)z[ii++]);
+      int lo = (ii<n) ? bcvSessionGcHex((unsigned char)z[ii++]) : -1;
+      if( hi<0 || lo<0 ) return 0;
+      aUuid[iOut++] = (u8)((hi<<4)|lo);
+    }
+  }
+  return iOut==16 && !bcvSessionGcAllZero(aUuid,16);
+}
+
+static void bcvSessionGcUuidText(
+  const u8 aUuid[16],
+  char zOut[37]
+){
+  static const char aHex[] = "0123456789abcdef";
+  int ii;
+  int jj = 0;
+  for(ii=0; ii<16; ii++){
+    zOut[jj++] = aHex[aUuid[ii]>>4];
+    zOut[jj++] = aHex[aUuid[ii]&15];
+    if( ii==3 || ii==5 || ii==7 || ii==9 ) zOut[jj++] = '-';
+  }
+  zOut[jj] = '\0';
+}
+
+/* Return the session-record kind and decode the canonical object suffix. */
+static int bcvSessionGcObjectParse(
+  const char *zName,
+  BcvSessionGcObject *pOut
+){
+  const char *z;
+  int n;
+  memset(pOut,0,sizeof(*pOut));
+  if( zName==0 || strncmp(zName,BCV_SESSION_GC_PREFIX,
+      sizeof(BCV_SESSION_GC_PREFIX)-1)!=0 ) return 0;
+  z = zName + sizeof(BCV_SESSION_GC_PREFIX)-1;
+  if( strcmp(z,"guard.bcv")==0 ){
+    /* The guard is a coordination object, not a session record. It is
+    ** acquired and validated by the CAS path and must never be swept as an
+    ** unknown session object. */
+    return 0;
+  }else if( strncmp(z,"head/",5)==0 ){
+    z += 5;
+    n = (int)strlen(z);
+    if( n!=40 || memcmp(&z[36],".bcv",4)!=0
+     || !bcvSessionGcUuid(z,36,pOut->aUuid)
+    ) return -1;
+    pOut->eType = 2;
+  }else if( strncmp(z,"checkpoint/",11)==0 ){
+    const char *zSlash;
+    z += 11;
+    n = (int)strlen(z);
+    zSlash = strchr(z,'/');
+    if( zSlash==0 || zSlash-z!=36 || n!=(36+1+64+4)
+     || zSlash[1+64]!='.' || memcmp(&zSlash[1+64],".bcv",4)!=0
+     || !bcvSessionGcUuid(z,36,pOut->aUuid)
+     || !bcvSessionGcDecodeHex(zSlash+1,64,pOut->aObjectId,32)
+    ) return -1;
+    pOut->eType = 1;
+  }else if( strncmp(z,"history/",8)==0 ){
+    const char *zSlash;
+    z += 8;
+    n = (int)strlen(z);
+    zSlash = strchr(z,'/');
+    if( zSlash==0 || zSlash-z!=36 || n!=(36+1+64+4)
+     || zSlash[1+64]!='.' || memcmp(&zSlash[1+64],".bcv",4)!=0
+     || !bcvSessionGcUuid(z,36,pOut->aUuid)
+     || !bcvSessionGcDecodeHex(zSlash+1,64,pOut->aObjectId,32)
+     || bcvSessionGcAllZero(pOut->aObjectId,32)
+    ) return -1;
+    pOut->eType = 6;
+  }else if( strncmp(z,"publication/",12)==0 ){
+    z += 12;
+    n = (int)strlen(z);
+    if( n!=68 || memcmp(&z[64],".bcv",4)!=0
+     || !bcvSessionGcDecodeHex(z,64,pOut->aObjectId,32)
+    ) return -1;
+    pOut->eType = 3;
+  }else if( strncmp(z,"candidate/",10)==0 ){
+    z += 10;
+    n = (int)strlen(z);
+    if( n!=68 || memcmp(&z[64],".bcv",4)!=0
+     || !bcvSessionGcDecodeHex(z,64,pOut->aObjectId,32)
+     || bcvSessionGcAllZero(pOut->aObjectId,32)
+    ) return -1;
+    pOut->eType = 4;
+  }else if( strncmp(z,"attempt/",8)==0 ){
+    const char *zSlash1;
+    const char *zSlash2;
+    const char *zSlash3;
+    u8 aAttemptId[16];
+    int nOperation;
+    int nBlock;
+    int nAttempt;
+    z += 8;
+    n = (int)strlen(z);
+    zSlash1 = strchr(z,'/');
+    zSlash2 = zSlash1 ? strchr(zSlash1+1,'/') : 0;
+    zSlash3 = zSlash2 ? strchr(zSlash2+1,'/') : 0;
+    nOperation = zSlash1 && zSlash2 ? (int)(zSlash2-zSlash1-1) : 0;
+    nBlock = zSlash3 ? (int)(zSlash3-zSlash2-1) : 0;
+    nAttempt = zSlash3 ? n-(int)(zSlash3-z)-1-4 : 0;
+    if( zSlash1==0 || zSlash2==0 || zSlash3==0
+     || zSlash1-z!=36 || nOperation!=64
+     || nBlock<2*BCV_MIN_NAMEBYTES || nBlock>2*BCV_MAX_NAMEBYTES
+     || (nBlock&1)!=0
+     || nAttempt!=32
+     || memcmp(&z[n-4],".bcv",4)!=0
+     || !bcvSessionGcUuid(z,36,pOut->aUuid)
+     || !bcvSessionGcDecodeHex(zSlash1+1,64,pOut->aOperationId,32)
+     || !bcvSessionGcDecodeHex(zSlash2+1,nBlock,pOut->aObjectId,nBlock/2)
+     || !bcvSessionGcDecodeHex(zSlash3+1,nAttempt,aAttemptId,16)
+     || bcvSessionGcAllZero(pOut->aOperationId,32)
+     || bcvSessionGcAllZero(pOut->aObjectId,nBlock/2)
+     || bcvSessionGcAllZero(aAttemptId,16)
+    ) return -1;
+    pOut->nObjectId = nBlock/2;
+    pOut->eType = 5;
+  }else{
+    return -1;
+  }
+  return pOut->eType;
+}
+
+static void bcvSessionGcObjectFree(BcvSessionGcObject *pObj){
+  sqlite3_free(pObj->zName);
+  sqlite3_free(pObj->zETag);
+  memset(pObj,0,sizeof(*pObj));
+}
+
+static void bcvSessionGcFree(BcvSessionGc *pGc){
+  int ii;
+  sqlite3_free(pGc->zGuardETag);
+  for(ii=0; ii<pGc->nObject; ii++) bcvSessionGcObjectFree(&pGc->aObject[ii]);
+  sqlite3_free(pGc->aObject);
+  for(ii=0; ii<pGc->nKeep; ii++) sqlite3_free(pGc->aKeep[ii]);
+  sqlite3_free(pGc->aKeep);
+  sqlite3_free(pGc->aOrphan);
+  bcvMHashFree(pGc->pOrphanHash);
+  bcvMHashFree(pGc->pKeepHash);
+  memset(pGc,0,sizeof(*pGc));
+}
+
+static int bcvSessionGcKeepHashResize(BcvSessionGc *pGc, int nHash){
+  ManifestHash *pNew;
+  int ii;
+  pNew = (ManifestHash*)sqlite3_malloc64(
+      sizeof(*pNew)+(sqlite3_uint64)nHash*sizeof(u8*)
+  );
+  if( pNew==0 ) return SQLITE_NOMEM;
+  pNew->nHash = nHash;
+  pNew->aHash = (u8**)&pNew[1];
+  memset(pNew->aHash,0,(size_t)nHash*sizeof(u8*));
+  for(ii=0; ii<pGc->nKeep; ii++){
+    bcvMHashAdd(pNew,pGc->aKeep[ii],pGc->nName);
+  }
+  bcvMHashFree(pGc->pKeepHash);
+  pGc->pKeepHash = pNew;
+  return SQLITE_OK;
+}
+
+/* Add one block id to the bounded protected set. */
+static int bcvSessionGcKeepAdd(BcvSessionGc *pGc, const u8 *aBlock){
+  if( pGc->nKeepAlloc==0 ){
+    pGc->nKeepAlloc = 256;
+    pGc->aKeep = (u8**)sqlite3_malloc64(
+        (sqlite3_uint64)pGc->nKeepAlloc*sizeof(u8*)
+    );
+    if( pGc->aKeep==0 ){
+      pGc->nKeepAlloc = 0;
+      return SQLITE_NOMEM;
+    }
+    memset(pGc->aKeep,0,(size_t)pGc->nKeepAlloc*sizeof(u8*));
+  }
+  if( pGc->nKeep>=BCV_SESSION_GC_MAX_BLOCKS ) return SQLITE_TOOBIG;
+  if( pGc->pKeepHash==0 ){
+    int rc = bcvSessionGcKeepHashResize(pGc,256);
+    if( rc!=SQLITE_OK ) return rc;
+  }else if( pGc->nKeep*2>=pGc->pKeepHash->nHash ){
+    int nHash = pGc->pKeepHash->nHash;
+    if( nHash>0x3FFFFFFF ) return SQLITE_TOOBIG;
+    nHash *= 2;
+    {
+      int rc = bcvSessionGcKeepHashResize(pGc,nHash);
+      if( rc!=SQLITE_OK ) return rc;
+    }
+  }
+  if( bcvMHashQuery(pGc->pKeepHash,(u8*)aBlock,pGc->nName) ) return SQLITE_OK;
+  if( pGc->nKeep>=pGc->nKeepAlloc ){
+    int nNew = pGc->nKeepAlloc*2;
+    u8 **aNew = (u8**)sqlite3_realloc64(
+        pGc->aKeep,(sqlite3_uint64)nNew*sizeof(u8*)
+    );
+    if( aNew==0 ) return SQLITE_NOMEM;
+    pGc->aKeep = aNew;
+    pGc->nKeepAlloc = nNew;
+  }
+  pGc->aKeep[pGc->nKeep] = (u8*)sqlite3_malloc(pGc->nName);
+  if( pGc->aKeep[pGc->nKeep]==0 ) return SQLITE_NOMEM;
+  memcpy(pGc->aKeep[pGc->nKeep],aBlock,pGc->nName);
+  bcvMHashAdd(pGc->pKeepHash,pGc->aKeep[pGc->nKeep],pGc->nName);
+  pGc->nKeep++;
+  return SQLITE_OK;
+}
+
+static int bcvSessionGcKeepQuery(BcvSessionGc *pGc, const u8 *aBlock){
+  int ii;
+  if( pGc->pKeepHash
+  ) return bcvMHashQuery(pGc->pKeepHash,(u8*)aBlock,pGc->nName)!=0;
+  for(ii=0; ii<pGc->nKeep; ii++){
+    if( memcmp(pGc->aKeep[ii],aBlock,pGc->nName)==0 ) return 1;
+  }
+  return 0;
+}
+
+static int bcvSessionGcOrphanHashResize(BcvSessionGc *pGc, int nHash){
+  ManifestHash *pNew;
+  int ii;
+  pNew = (ManifestHash*)sqlite3_malloc64(
+      sizeof(*pNew)+(sqlite3_uint64)nHash*sizeof(u8*)
+  );
+  if( pNew==0 ) return SQLITE_NOMEM;
+  pNew->nHash = nHash;
+  pNew->aHash = (u8**)&pNew[1];
+  memset(pNew->aHash,0,(size_t)nHash*sizeof(u8*));
+  for(ii=0; ii<pGc->nOrphan; ii++){
+    bcvMHashAdd(pNew,&pGc->aOrphan[ii*(pGc->nName+8)],pGc->nName);
+  }
+  bcvMHashFree(pGc->pOrphanHash);
+  pGc->pOrphanHash = pNew;
+  return SQLITE_OK;
+}
+
+/* Queue a newly-unreachable block for ordinary manifest-delete processing.
+** Use the observation time, not the expired record's timestamp, so the first
+** cleanup after a long outage still gets the normal delete grace interval. */
+static int bcvSessionGcOrphanAdd(
+  BcvSessionGc *pGc,
+  const u8 *aBlock,
+  i64 iObserved
+){
+  int nGC = pGc->nName + 8;
+  int rc;
+  if( pGc->p->bFindOrphans ) return SQLITE_OK;
+  if( pGc->pMainHash
+   && bcvMHashQuery(pGc->pMainHash,(u8*)aBlock,pGc->nName)
+  ) return SQLITE_OK;
+  if( bcvSessionGcKeepQuery(pGc,aBlock) ) return SQLITE_OK;
+  if( pGc->pOrphanHash==0 ){
+    rc = bcvSessionGcOrphanHashResize(pGc,256);
+    if( rc!=SQLITE_OK ) return rc;
+  }else if( pGc->nOrphan*2>=pGc->pOrphanHash->nHash ){
+    if( pGc->pOrphanHash->nHash>0x3FFFFFFF ) return SQLITE_TOOBIG;
+    rc = bcvSessionGcOrphanHashResize(pGc,pGc->pOrphanHash->nHash*2);
+    if( rc!=SQLITE_OK ) return rc;
+  }
+  if( bcvMHashQuery(pGc->pOrphanHash,(u8*)aBlock,pGc->nName) ) return SQLITE_OK;
+  if( pGc->nOrphan>=BCV_SESSION_GC_MAX_BLOCKS ) return SQLITE_TOOBIG;
+  if( pGc->nOrphan>=pGc->nOrphanAlloc ){
+    int nNew = pGc->nOrphanAlloc ? pGc->nOrphanAlloc*2 : 16;
+    u8 *aNew;
+    if( nNew>BCV_SESSION_GC_MAX_BLOCKS ) nNew=BCV_SESSION_GC_MAX_BLOCKS;
+    aNew = (u8*)sqlite3_realloc64(
+        pGc->aOrphan,(sqlite3_uint64)nNew*nGC
+    );
+    if( aNew==0 ) return SQLITE_NOMEM;
+    pGc->aOrphan = aNew;
+    pGc->nOrphanAlloc = nNew;
+    if( pGc->pOrphanHash ){
+      rc = bcvSessionGcOrphanHashResize(
+          pGc,pGc->pOrphanHash->nHash
+      );
+      if( rc!=SQLITE_OK ){
+        bcvMHashFree(pGc->pOrphanHash);
+        pGc->pOrphanHash = 0;
+        return rc;
+      }
+    }
+  }
+  memcpy(&pGc->aOrphan[pGc->nOrphan*nGC],aBlock,pGc->nName);
+  bcvPutU64(&pGc->aOrphan[pGc->nOrphan*nGC+pGc->nName],(u64)iObserved);
+  bcvMHashAdd(pGc->pOrphanHash,
+      &pGc->aOrphan[pGc->nOrphan*nGC],pGc->nName);
+  pGc->nOrphan++;
+  return SQLITE_OK;
+}
+
+static int bcvSessionGcObjectAdd(
+  BcvSessionGc *pGc,
+  const char *zName
+){
+  BcvSessionGcObject obj;
+  int ii;
+  int eType = bcvSessionGcObjectParse(zName,&obj);
+  if( eType==0 ) return SQLITE_OK;
+  if( eType<0 ) return SQLITE_CORRUPT;
+  if( pGc->nObject>=BCV_SESSION_GC_MAX_OBJECTS ) return SQLITE_TOOBIG;
+  for(ii=0; ii<pGc->nObject; ii++){
+    if( strcmp(pGc->aObject[ii].zName,zName)==0 ) return SQLITE_CORRUPT;
+  }
+  obj.zName = sqlite3_mprintf("%s",zName);
+  if( obj.zName==0 ) return SQLITE_NOMEM;
+  if( pGc->nObject>=pGc->nObjectAlloc ){
+    int nNew = pGc->nObjectAlloc ? pGc->nObjectAlloc*2 : 64;
+    BcvSessionGcObject *aNew = (BcvSessionGcObject*)sqlite3_realloc64(
+        pGc->aObject,(sqlite3_uint64)nNew*sizeof(*aNew)
+    );
+    if( aNew==0 ){
+      bcvSessionGcObjectFree(&obj);
+      return SQLITE_NOMEM;
+    }
+    pGc->aObject = aNew;
+    pGc->nObjectAlloc = nNew;
+  }
+  pGc->aObject[pGc->nObject++] = obj;
+  return SQLITE_OK;
+}
+
+static int bcvSessionGcRecordDecode(
+  const u8 *aData,
+  int nData,
+  const BcvSessionGcObject *pObj,
+  BcvSessionGcRecord *pRec,
+  char **pzErr
+){
+  static const u8 aMagic[8] = {'B','C','V','S','R','0','1','\0'};
+  u8 aHash[BCV_SESSION_GC_HASH_BYTES];
+  SHA256_CTX sha;
+  u32 nBody;
+  u32 nTotal;
+  u32 nHeader;
+  u64 iCreated;
+  u64 iExpires;
+  char zUuid[37];
+  if( pzErr ) *pzErr = 0;
+  memset(pRec,0,sizeof(*pRec));
+  if( aData==0 || nData<BCV_SESSION_GC_HEADER_BYTES+BCV_SESSION_GC_TRAILER_BYTES
+   || nData>BCV_SESSION_GC_RECORD_MAX
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session record size");
+  if( memcmp(aData,aMagic,sizeof(aMagic))!=0
+   || bcvGetU16(&aData[8])!=BCV_SESSION_GC_VERSION
+   || aData[13]!=0 || bcvGetU16(&aData[14])!=0
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session record header");
+  nHeader = bcvGetU32(&aData[16]);
+  nTotal = bcvGetU32(&aData[20]);
+  nBody = bcvGetU32(&aData[160]);
+  if( nHeader!=BCV_SESSION_GC_HEADER_BYTES || nTotal!=(u32)nData
+   || bcvGetU32(&aData[164])!=0
+   || nBody>(u32)nData-BCV_SESSION_GC_HEADER_BYTES-BCV_SESSION_GC_TRAILER_BYTES
+   || nTotal!=BCV_SESSION_GC_HEADER_BYTES+nBody+BCV_SESSION_GC_TRAILER_BYTES
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session record lengths");
+  SHA256_Init(&sha);
+  SHA256_Update(&sha,aData,nData-BCV_SESSION_GC_TRAILER_BYTES);
+  SHA256_Final(aHash,&sha);
+  if( memcmp(aHash,&aData[nData-BCV_SESSION_GC_TRAILER_BYTES],sizeof(aHash))!=0 ){
+    return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"session record hash mismatch");
+  }
+  memcpy(pRec->aUuid,&aData[48],sizeof(pRec->aUuid));
+  if( bcvSessionGcAllZero(pRec->aUuid,sizeof(pRec->aUuid)) ){
+    return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"session record UUID is empty");
+  }
+  memcpy(pRec->aScope,&aData[64],sizeof(pRec->aScope));
+  if( bcvSessionGcAllZero(pRec->aScope,sizeof(pRec->aScope)) ){
+    return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"session record scope is empty");
+  }
+  bcvSessionGcUuidText(pRec->aUuid,zUuid);
+  if( (pObj->eType==1 || pObj->eType==2 || pObj->eType==6)
+   && memcmp(pRec->aUuid,pObj->aUuid,sizeof(pRec->aUuid))!=0
+  ){
+    return bcvSessionGcError(pzErr,SQLITE_AUTH,"session head UUID does not match its key");
+  }
+  iCreated = bcvGetU64(&aData[32]);
+  iExpires = bcvGetU64(&aData[40]);
+  if( iCreated>0x7FFFFFFFFFFFFFFFULL || iExpires>0x7FFFFFFFFFFFFFFFULL
+   || iExpires<=iCreated
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session record expiration");
+  pRec->eType = aData[10];
+  pRec->eState = aData[11];
+  pRec->eOutcome = aData[12];
+  if( (pObj->eType==6 ? pRec->eType!=4 : pRec->eType!=pObj->eType)
+   || pRec->eType<1 || pRec->eType>4
+   || pRec->eState<1 || pRec->eState>6
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"session record type or state mismatch");
+  pRec->iSequence = bcvGetU64(&aData[24]);
+  if( pRec->eOutcome<0 || pRec->eOutcome>3 || pRec->iSequence==0
+   || (iExpires-iCreated)>BCV_SESSION_GC_MAX_TTL
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session record lifecycle");
+  if( (pRec->eType==1
+       && (pRec->eState!=1 || pRec->eOutcome!=0))
+   || (pRec->eState==4 && pRec->eOutcome!=1)
+   || (pRec->eState==5 && pRec->eOutcome!=2 && pRec->eOutcome!=3)
+   || (pRec->eState==6 && pRec->eOutcome!=2)
+   || (pRec->eType==4
+       && (pRec->eState!=2 || pRec->eOutcome!=1))
+   || (pRec->eType!=4 && pRec->eState==2
+       && (pRec->eType!=2 || (pRec->eOutcome!=0 && pRec->eOutcome!=1)))
+   || (pRec->eType!=4
+       && (pRec->eState==1 || pRec->eState==3) && pRec->eOutcome!=0)
+  ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session record outcome");
+  if( pRec->eType==1
+   || (pRec->eType==2 && (pRec->eState==2 || pRec->eState==3 || pRec->eState==4))
+   || pRec->eType==3 || pRec->eType==4
+  ){
+    if( bcvSessionGcAllZero(&aData[128],BCV_SESSION_GC_HASH_BYTES) ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"session operation ID is empty");
+    }
+  }
+  pRec->iCreated = (i64)iCreated;
+  pRec->iExpires = (i64)iExpires;
+  memcpy(pRec->aPredecessor,&aData[96],sizeof(pRec->aPredecessor));
+  memcpy(pRec->aRecordHash,aHash,sizeof(pRec->aRecordHash));
+  memcpy(pRec->zSessionId,zUuid,sizeof(pRec->zSessionId));
+  pRec->aBody = &aData[BCV_SESSION_GC_HEADER_BYTES];
+  pRec->nBody = (int)nBody;
+  if( pRec->eType==1 ){
+    const u8 *a = pRec->aBody;
+    u32 nManifest;
+    u32 nEtag;
+    int bCompacted = 0;
+    if( pRec->nBody<24
+     || (memcmp(a,"BCVCP01\0",8)!=0
+         && memcmp(a,"BCVCS01\0",8)!=0)
+    ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid checkpoint body");
+    }
+    bCompacted = memcmp(a,"BCVCS01\0",8)==0;
+    nManifest = bcvGetU32(&a[16]);
+    nEtag = bcvGetU32(&a[20]);
+    if( nEtag==0 || nEtag>4096 || nManifest==0
+     || nEtag>(u32)pRec->nBody-24
+     || (u64)nManifest+(u64)nEtag+24>(u64)pRec->nBody
+     || (bCompacted
+         ? (u64)pRec->nBody!=(u64)nManifest+(u64)nEtag+24+32
+         : (u64)pRec->nBody!=(u64)nManifest+(u64)nEtag+24)
+    ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid checkpoint body lengths");
+    if( bCompacted && bcvSessionGcAllZero(&a[24+nEtag+nManifest],32) ){
+      return bcvSessionGcError(
+          pzErr,SQLITE_CORRUPT,"compacted checkpoint has no predecessor root"
+      );
+    }
+    if( bCompacted
+     && memcmp(&a[24+nEtag+nManifest],pRec->aPredecessor,32)!=0
+    ){
+      return bcvSessionGcError(
+          pzErr,SQLITE_CORRUPT,"compacted checkpoint predecessor mismatch"
+      );
+    }
+    {
+      u32 ii;
+      for(ii=0; ii<nEtag; ii++){
+        unsigned char c = a[24+ii];
+        if( c<0x20 || c==0x7F ){
+          return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid checkpoint ETag");
+        }
+      }
+    }
+    if( pObj->eType==1
+     && memcmp(pRec->aRecordHash,pObj->aObjectId,sizeof(pRec->aRecordHash))!=0
+    ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"checkpoint hash does not match its key");
+  }else if( pRec->eType==2 ){
+    const u8 *a = pRec->aBody;
+    u32 nHistory;
+    u32 nEtag;
+    u64 nExpected;
+    if( pRec->nBody<116 || memcmp(a,"BCVHD02\0",8)!=0 ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session head body");
+    }
+    nHistory = bcvGetU32(&a[108]);
+    nEtag = bcvGetU32(&a[112]);
+    nExpected = 116 + (u64)nHistory*32 + nEtag;
+    if( nHistory>BCV_SESSION_GC_MAX_HISTORY_OPERATIONS
+     || bcvGetU32(&a[8])!=0
+     || nEtag==0 || nEtag>4096
+     || nExpected!=(u64)pRec->nBody
+    ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,
+        "invalid version 2 session head body length");
+    {
+      u32 ii;
+      for(ii=0; ii<nEtag; ii++){
+        unsigned char c = a[116 + nHistory*32 + ii];
+        if( c<0x20 || c==0x7F ){
+          return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session head ETag");
+        }
+      }
+    }
+    {
+      u32 ii;
+      for(ii=0; ii<nHistory; ii++){
+        if( bcvSessionGcAllZero(&a[116+ii*32],32) ){
+          return bcvSessionGcError(pzErr,SQLITE_CORRUPT,
+              "session head has an empty history operation");
+        }
+      }
+    }
+    if( pRec->eState!=1 && bcvSessionGcAllZero(&a[12],32) ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"non-open session head has no checkpoint");
+    }
+    if( (pRec->eState==3 || pRec->eState==4)
+     && bcvSessionGcAllZero(&a[44],32)
+    ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"publishing session head has no candidate");
+  }else if( pRec->eType==4 ){
+    const u8 *a = pRec->aBody;
+    u32 nHistory;
+    u64 nExpected;
+    if( pRec->nBody<48 || memcmp(a,"BCVHS02\0",8)!=0 ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid session history body");
+    }
+    nHistory = bcvGetU32(&a[40]);
+    nExpected = 48 + (u64)nHistory*32;
+    if( nHistory==0 || nHistory>BCV_SESSION_GC_MAX_HISTORY_OPERATIONS
+     || bcvGetU32(&a[44])!=0 || nExpected!=(u64)pRec->nBody
+    ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,
+          "invalid session history body length");
+    }
+    {
+      u32 ii;
+      for(ii=0; ii<nHistory; ii++){
+        if( bcvSessionGcAllZero(&a[48+ii*32],32) ){
+          return bcvSessionGcError(pzErr,SQLITE_CORRUPT,
+              "invalid session history operation");
+        }
+      }
+    }
+    if( pObj->eType!=6
+     || memcmp(pRec->aRecordHash,pObj->aObjectId,32)!=0
+    ) return bcvSessionGcError(pzErr,SQLITE_AUTH,
+        "history key does not match record hash");
+  }else{
+    const u8 *a = pRec->aBody;
+    u32 nEtag;
+    if( pRec->nBody<92 || memcmp(a,"BCVPH01\0",8)!=0
+     || bcvSessionGcAllZero(&a[8],16)
+     || bcvSessionGcAllZero(&a[24],32)
+     || bcvSessionGcAllZero(&a[56],32)
+    ) return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid publication body");
+    nEtag = bcvGetU32(&a[88]);
+    if( nEtag==0 || nEtag>4096 || pRec->nBody!=92+nEtag ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid publication body length");
+    }
+    {
+      u32 ii;
+      for(ii=0; ii<nEtag; ii++){
+        unsigned char c = a[92+ii];
+        if( c<0x20 || c==0x7F ){
+          return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"invalid publication ETag");
+        }
+      }
+    }
+    if( memcmp(&a[8],pRec->aUuid,16)!=0 ){
+      return bcvSessionGcError(pzErr,SQLITE_CORRUPT,"publication session UUID mismatch");
+    }
+    if( pObj->eType==3
+     && memcmp(pRec->aScope,pObj->aObjectId,sizeof(pRec->aScope))!=0
+    ) return bcvSessionGcError(pzErr,SQLITE_AUTH,"publication key does not match its scope");
+  }
+  return SQLITE_OK;
+}
+
+/* bcvManifestParse() predates hostile session metadata and assumes that its
+** byte buffer is a well-formed manifest. Validate all offsets and counts
+** before calling it so a corrupt checkpoint cannot make cleanup read past the
+** fetched object or trip a debug assertion. */
+static int bcvSessionGcManifestValid(
+  const u8 *a,
+  int n,
+  const char **pzReason
+){
+  u64 iCursor;
+  u32 nDb;
+  u32 nDelete;
+  u32 nName;
+  u32 iLastDb = 0;
+  int ii;
+#define BCV_SESSION_GC_MANIFEST_INVALID(z) \
+  do{ if( pzReason ) *pzReason = (z); return 0; }while(0)
+  if( a==0 || n<MANIFEST_HDR_SIZE ){
+    BCV_SESSION_GC_MANIFEST_INVALID("invalid argument or short header");
+  }
+  if( bcvGetU32(&a[0])!=BCV_MANIFEST_VERSION ){
+    BCV_SESSION_GC_MANIFEST_INVALID("unsupported manifest version");
+  }
+  if( bcvGetU32(&a[4])==0 ){
+    BCV_SESSION_GC_MANIFEST_INVALID("zero manifest block size");
+  }
+  nDb = bcvGetU32(&a[8]);
+  nDelete = bcvGetU32(&a[12]);
+  nName = bcvGetU32(&a[16]);
+  if( nName<BCV_MIN_NAMEBYTES || nName>BCV_MAX_NAMEBYTES ){
+    BCV_SESSION_GC_MANIFEST_INVALID("manifest block-name size out of range");
+  }
+  if( nDb>BCV_SESSION_GC_MAX_DATABASES ){
+    BCV_SESSION_GC_MANIFEST_INVALID("manifest database count exceeds limit");
+  }
+  if( nDb>(u32)((n-MANIFEST_HDR_SIZE)/MANIFEST_DBHDR_SIZE) ){
+    BCV_SESSION_GC_MANIFEST_INVALID("database headers exceed manifest length");
+  }
+  iCursor = (u64)MANIFEST_HDR_SIZE + (u64)nDb*MANIFEST_DBHDR_SIZE;
+  if( nDelete>(u32)(((u64)n-iCursor)/(nName+sizeof(u64))) ){
+    BCV_SESSION_GC_MANIFEST_INVALID("delete list exceeds manifest length");
+  }
+  iCursor += (u64)nDelete*(nName+sizeof(u64));
+  for(ii=0; ii<(int)nDb; ii++){
+    u64 iHdr = MANIFEST_HDR_SIZE + (u64)ii*MANIFEST_DBHDR_SIZE;
+    u32 iDb = bcvGetU32(&a[iHdr]);
+    u32 iParent = bcvGetU32(&a[iHdr+4]);
+    u32 nBlockRaw = bcvGetU32(&a[iHdr+16]);
+    u32 nBlock = nBlockRaw & 0x7FFFFFFF;
+    u32 nEntry = bcvGetU32(&a[iHdr+20]);
+    u32 iOff = bcvGetU32(&a[iHdr+12]);
+    u64 nBytes;
+    int bParentFound = 0;
+    if( iDb==0 || (ii>0 && iDb<=iLastDb) ){
+      BCV_SESSION_GC_MANIFEST_INVALID("database IDs are zero or not increasing");
+    }
+    if( iParent && (iParent>=iDb || (ii==0)) ){
+      BCV_SESSION_GC_MANIFEST_INVALID("database parent ID is invalid");
+    }
+    if( (u64)iOff!=iCursor ){
+      BCV_SESSION_GC_MANIFEST_INVALID("database block offset is not contiguous");
+    }
+    if( iParent ){
+      int jj;
+      for(jj=0; jj<ii; jj++){
+        if( bcvGetU32(&a[MANIFEST_HDR_SIZE+(u64)jj*MANIFEST_DBHDR_SIZE])==iParent ){
+          bParentFound = 1;
+          break;
+        }
+      }
+      if( !bParentFound ){
+        BCV_SESSION_GC_MANIFEST_INVALID("database parent is missing");
+      }
+    }
+    if( iParent==0 ){
+      if( nEntry!=0 ){
+        BCV_SESSION_GC_MANIFEST_INVALID("root database has sparse entries");
+      }
+      nBytes = (u64)nBlock*nName;
+    }else{
+      u32 jj;
+      if( nEntry>nBlock ){
+        BCV_SESSION_GC_MANIFEST_INVALID("sparse entry count exceeds block count");
+      }
+      nBytes = (u64)nEntry*(nName+sizeof(u32));
+      if( iCursor+nBytes>(u64)n ){
+        BCV_SESSION_GC_MANIFEST_INVALID("sparse entries exceed manifest length");
+      }
+      for(jj=0; jj<nEntry; jj++){
+        u32 iBlock = bcvGetU32(&a[iCursor+(u64)jj*(nName+sizeof(u32))]);
+        if( iBlock>=nBlock ){
+          BCV_SESSION_GC_MANIFEST_INVALID("sparse block index is out of range");
+        }
+      }
+    }
+    if( iCursor+nBytes>(u64)n ){
+      BCV_SESSION_GC_MANIFEST_INVALID("database blocks exceed manifest length");
+    }
+    iCursor += nBytes;
+    iLastDb = iDb;
+  }
+  if( bcvGetU32(&a[20])<iLastDb ){
+    BCV_SESSION_GC_MANIFEST_INVALID("maximum database ID is too small");
+  }
+  if( iCursor>(u64)n ){
+    BCV_SESSION_GC_MANIFEST_INVALID("manifest arrays exceed the manifest length");
+  }
+  if( iCursor<(u64)n
+   && (u64)n-iCursor>=BCV_MANIFEST_SIZE_EXT_HEADER_BYTES
+   && memcmp(&a[iCursor],BCV_MANIFEST_SIZE_EXT_MAGIC,
+       BCV_MANIFEST_SIZE_EXT_MAGIC_BYTES)==0
+  ){
+    u32 nSize = bcvGetU32(&a[iCursor+8]);
+    u64 nExt = (u64)BCV_MANIFEST_SIZE_EXT_HEADER_BYTES
+        + (u64)nSize*BCV_MANIFEST_SIZE_EXT_ENTRY_BYTES;
+    u32 iEntry;
+    if( nSize>nDb || nExt!=(u64)n-iCursor ){
+      BCV_SESSION_GC_MANIFEST_INVALID("invalid file-size extension length");
+    }
+    for(iEntry=0; iEntry<nSize; iEntry++){
+      u64 iEntryOff = iCursor+BCV_MANIFEST_SIZE_EXT_HEADER_BYTES
+          +(u64)iEntry*BCV_MANIFEST_SIZE_EXT_ENTRY_BYTES;
+      u32 iExtDb = bcvGetU32(&a[iEntryOff]);
+      u64 iFileSize = bcvGetU64(&a[iEntryOff+4]);
+      u32 nBlock = 0;
+      int bDbFound = 0;
+      u32 jj;
+      for(jj=0; jj<iEntry; jj++){
+        u64 iPrev = iCursor+BCV_MANIFEST_SIZE_EXT_HEADER_BYTES
+            +(u64)jj*BCV_MANIFEST_SIZE_EXT_ENTRY_BYTES;
+        if( bcvGetU32(&a[iPrev])==iExtDb ){
+          BCV_SESSION_GC_MANIFEST_INVALID("duplicate file-size extension database ID");
+        }
+      }
+      for(jj=0; jj<nDb; jj++){
+        u64 iHdr = MANIFEST_HDR_SIZE+(u64)jj*MANIFEST_DBHDR_SIZE;
+        if( bcvGetU32(&a[iHdr])==iExtDb ){
+          nBlock = bcvGetU32(&a[iHdr+16]) & 0x7FFFFFFF;
+          bDbFound = 1;
+          break;
+        }
+      }
+      if( !bDbFound || iFileSize==0 || iFileSize>0x7FFFFFFFFFFFFFFFULL
+       || iFileSize>(u64)nBlock*bcvGetU32(&a[4])
+      ){
+        BCV_SESSION_GC_MANIFEST_INVALID("invalid file-size extension entry");
+      }
+    }
+  }
+  /* bcvManifestParse() deliberately tolerates opaque trailing bytes that do
+  ** not begin with BCVSZ001. They do not participate in block reachability. */
+#undef BCV_SESSION_GC_MANIFEST_INVALID
+  return 1;
+}
+
+typedef struct BcvSessionGcFetch BcvSessionGcFetch;
+struct BcvSessionGcFetch {
+  int rc;
+  u8 *aData;
+  int nData;
+  char *zETag;
+  char *zErr;
+};
+
+static void bcvSessionGcFetchCb(
+  void *pArg,
+  int rc,
+  char *zETag,
+  const u8 *aData,
+  int nData,
+  const u8 *aHdrs,
+  int nHdrs
+){
+  BcvSessionGcFetch *p = (BcvSessionGcFetch*)pArg;
+  (void)aHdrs;
+  (void)nHdrs;
+  p->rc = rc;
+  if( rc==SQLITE_OK ){
+    if( nData<0 || nData>BCV_SESSION_GC_RECORD_MAX ){
+      p->rc = nData<0 ? SQLITE_CORRUPT : SQLITE_TOOBIG;
+    }else{
+      p->aData = (u8*)sqlite3_malloc64((sqlite3_uint64)nData);
+      p->zETag = zETag ? sqlite3_mprintf("%s",zETag) : 0;
+      if( (nData && p->aData==0) || p->zETag==0 ){
+        p->rc = SQLITE_NOMEM;
+      }else if( nData ){
+        memcpy(p->aData,aData,nData);
+      }
+      p->nData = nData;
+      if( p->rc==SQLITE_OK ){
+        int ii;
+        size_t nEtag = strlen(p->zETag);
+        if( nEtag==0 || nEtag>BCV_SESSION_GC_MAX_ETAG ){
+          p->rc = SQLITE_CORRUPT;
+        }else for(ii=0; ii<(int)nEtag; ii++){
+          unsigned char c = (unsigned char)p->zETag[ii];
+          if( c<0x20 || c==0x7F ){
+            p->rc = SQLITE_CORRUPT;
+            break;
+          }
+        }
+      }
+    }
+  }else if( zETag ){
+    p->zErr = sqlite3_mprintf("%s",zETag);
+  }
+}
+
+static int bcvSessionGcFetch(
+  BcvSessionGc *pGc,
+  const char *zName,
+  BcvSessionGcFetch *pFetch
+){
+  int rc;
+  memset(pFetch,0,sizeof(*pFetch));
+  rc = bcvDispatchFetchMax(
+      pGc->p->pDisp,pGc->p->pCont,zName,0,0,
+      BCV_SESSION_GC_RECORD_MAX,64*1024,pFetch,bcvSessionGcFetchCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pGc->p->pDisp);
+  if( rc==SQLITE_OK ) rc = pFetch->rc;
+  return rc;
+}
+
+typedef struct BcvSessionGcPut BcvSessionGcPut;
+struct BcvSessionGcPut {
+  int rc;
+  char *zETag;
+  char *zErr;
+};
+
+static void bcvSessionGcPutCb(void *pArg, int rc, char *zETag){
+  BcvSessionGcPut *p = (BcvSessionGcPut*)pArg;
+  p->rc = rc;
+  if( rc==SQLITE_OK ){
+    p->zETag = zETag ? sqlite3_mprintf("%s",zETag) : 0;
+    if( p->zETag==0 ) p->rc = SQLITE_NOMEM;
+  }else if( zETag ){
+    p->zErr = sqlite3_mprintf("%s",zETag);
+  }
+}
+
+static int bcvSessionGuardConflict(int rc){
+  return rc==HTTP_BUSY_SNAPSHOT || rc==HTTP_PRECONDITION_FAILED || rc==409;
+}
+
+static void bcvSessionGuardBody(
+  u8 aBody[BCV_SESSION_GC_GUARD_BODY_BYTES],
+  int eMode,
+  i64 iExpires,
+  const u8 *aOwner
+){
+  u8 aHash[BCV_SESSION_GC_HASH_BYTES];
+  memset(aBody,0,BCV_SESSION_GC_GUARD_BODY_BYTES);
+  memcpy(aBody,"BCVGD01",7);
+  aBody[9] = BCV_SESSION_GC_VERSION;
+  aBody[10] = (u8)eMode;
+  bcvPutU64(&aBody[12],(u64)iExpires);
+  if( aOwner ) memcpy(&aBody[20],aOwner,16);
+  SHA256(aBody,36,aHash);
+  memcpy(&aBody[36],aHash,sizeof(aHash));
+}
+
+static int bcvSessionGuardDecode(
+  const u8 *aBody,
+  int nBody,
+  int *peMode,
+  i64 *piExpires,
+  u8 aOwner[16]
+){
+  u8 aHash[BCV_SESSION_GC_HASH_BYTES];
+  int eMode;
+  u64 iExpires;
+  if( aBody==0 || nBody!=BCV_SESSION_GC_GUARD_BODY_BYTES
+   || memcmp(aBody,"BCVGD01",7)!=0
+   || aBody[7]!=0 || bcvGetU16(&aBody[8])!=BCV_SESSION_GC_VERSION
+   || aBody[11]!=0
+  ) return SQLITE_CORRUPT;
+  SHA256(aBody,36,aHash);
+  if( memcmp(&aBody[36],aHash,sizeof(aHash))!=0 ) return SQLITE_CORRUPT;
+  eMode = aBody[10];
+  iExpires = bcvGetU64(&aBody[12]);
+  if( eMode<BCV_SESSION_GC_GUARD_IDLE
+   || eMode>BCV_SESSION_GC_GUARD_SWEEP_STATE
+   || iExpires>0x7FFFFFFFFFFFFFFFULL
+  ) return SQLITE_CORRUPT;
+  memcpy(aOwner,&aBody[20],16);
+  if( eMode==BCV_SESSION_GC_GUARD_IDLE ){
+    /* Idle guard bodies carry a random epoch token after a writer's
+    ** marker PUT. The token changes the S3 ETag while remaining nonexclusive;
+    ** the marker itself protects every block from that request. */
+    if( iExpires!=0 ) return SQLITE_CORRUPT;
+  }else if( iExpires<=0 || bcvSessionGcAllZero(aOwner,16) ){
+    return SQLITE_CORRUPT;
+  }
+  *peMode = eMode;
+  *piExpires = (i64)iExpires;
+  return SQLITE_OK;
+}
+
+static int bcvSessionGuardFetch(
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  BcvSessionGcFetch *pFetch
+){
+  int rc;
+  memset(pFetch,0,sizeof(*pFetch));
+  rc = bcvDispatchFetchMax(
+      pDisp,pBcv,BCV_SESSION_GC_GUARD_NAME,0,0,
+      64*1024,64*1024,pFetch,bcvSessionGcFetchCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = pFetch->rc;
+  return rc;
+}
+
+static int bcvSessionGuardPut(
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  const char *zETag,
+  const u8 aBody[BCV_SESSION_GC_GUARD_BODY_BYTES],
+  BcvSessionGcPut *pPut
+){
+  int rc;
+  memset(pPut,0,sizeof(*pPut));
+  rc = bcvDispatchPut(
+      pDisp,pBcv,BCV_SESSION_GC_GUARD_NAME,zETag,aBody,
+      BCV_SESSION_GC_GUARD_BODY_BYTES,pPut,bcvSessionGcPutCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = pPut->rc;
+  return rc;
+}
+
+int bcvSessionGuardAcquire(
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  int eMode,
+  u8 aOwner[16],
+  char **pzETag
+){
+  u8 aBody[BCV_SESSION_GC_GUARD_BODY_BYTES];
+  u8 aOwnerLocal[16];
+  int ii;
+  int rc;
+  if( pzETag ) *pzETag = 0;
+  if( pDisp==0 || pBcv==0 || aOwner==0 || pzETag==0
+   || (eMode!=BCV_SESSION_GC_GUARD_WRITER
+       && eMode!=BCV_SESSION_GC_GUARD_SWEEP)
+  ) return SQLITE_MISUSE;
+  sqlite3_randomness(sizeof(aOwnerLocal),aOwnerLocal);
+  if( bcvSessionGcAllZero(aOwnerLocal,sizeof(aOwnerLocal)) ) aOwnerLocal[0] = 1;
+  memcpy(aOwner,aOwnerLocal,sizeof(aOwnerLocal));
+  for(ii=0; ii<8; ii++){
+    BcvSessionGcFetch fetch;
+    BcvSessionGcPut put;
+    int eCurrent;
+    i64 iCurrentExpires;
+    i64 iNow;
+    rc = bcvSessionGuardFetch(pDisp,pBcv,&fetch);
+    if( rc==HTTP_NOT_FOUND ){
+      if( eMode==BCV_SESSION_GC_GUARD_WRITER ){
+        /* Establish the canonical idle object before registering a writer.
+        ** Its ETag becomes the CAS base for the next iteration. */
+        bcvSessionGuardBody(aBody,BCV_SESSION_GC_GUARD_IDLE,0,0);
+      }else{
+        iNow = sqlite_timestamp();
+        if( iNow>0x7FFFFFFFFFFFFFFFLL-BCV_SESSION_GC_GUARD_TTL ){
+          return SQLITE_TOOBIG;
+        }
+        bcvSessionGuardBody(aBody,BCV_SESSION_GC_GUARD_SWEEP_STATE,
+            iNow+BCV_SESSION_GC_GUARD_TTL,aOwner);
+      }
+      rc = bcvSessionGuardPut(pDisp,pBcv,"*",aBody,&put);
+      sqlite3_free(fetch.aData);
+      sqlite3_free(fetch.zETag);
+      sqlite3_free(fetch.zErr);
+      if( rc==SQLITE_OK ){
+        if( eMode==BCV_SESSION_GC_GUARD_WRITER ){
+          sqlite3_free(put.zETag);
+          sqlite3_free(put.zErr);
+          continue;
+        }
+        *pzETag = put.zETag;
+        put.zETag = 0;
+        sqlite3_free(put.zErr);
+        return SQLITE_OK;
+      }
+      sqlite3_free(put.zETag);
+      sqlite3_free(put.zErr);
+      if( bcvSessionGuardConflict(rc) ) continue;
+      return rc;
+    }
+    if( rc!=SQLITE_OK ){
+      sqlite3_free(fetch.aData);
+      sqlite3_free(fetch.zETag);
+      sqlite3_free(fetch.zErr);
+      return rc;
+    }
+    rc = bcvSessionGuardDecode(
+        fetch.aData,fetch.nData,&eCurrent,&iCurrentExpires,aOwnerLocal
+    );
+    if( rc!=SQLITE_OK ){
+      sqlite3_free(fetch.aData);
+      sqlite3_free(fetch.zETag);
+      sqlite3_free(fetch.zErr);
+      return rc;
+    }
+    iNow = sqlite_timestamp();
+    if( eCurrent==BCV_SESSION_GC_GUARD_SWEEP_STATE ){
+      /* A sweep owns the guard until it explicitly releases it. A crashed
+      ** sweep therefore fails closed rather than taking over by timeout. */
+      sqlite3_free(fetch.aData);
+      sqlite3_free(fetch.zETag);
+      sqlite3_free(fetch.zErr);
+      return SQLITE_BUSY;
+    }
+    if( eMode==BCV_SESSION_GC_GUARD_WRITER ){
+      bcvSessionGuardBody(aBody,BCV_SESSION_GC_GUARD_IDLE,0,aOwner);
+    }else{
+      if( iNow>0x7FFFFFFFFFFFFFFFLL-BCV_SESSION_GC_GUARD_TTL ){
+        sqlite3_free(fetch.aData);
+        sqlite3_free(fetch.zETag);
+        sqlite3_free(fetch.zErr);
+        return SQLITE_TOOBIG;
+      }
+      bcvSessionGuardBody(aBody,BCV_SESSION_GC_GUARD_SWEEP_STATE,
+          iNow+BCV_SESSION_GC_GUARD_TTL,aOwner);
+    }
+    rc = bcvSessionGuardPut(pDisp,pBcv,fetch.zETag,aBody,&put);
+    sqlite3_free(fetch.aData);
+    sqlite3_free(fetch.zETag);
+    sqlite3_free(fetch.zErr);
+    if( rc==SQLITE_OK ){
+      if( eMode==BCV_SESSION_GC_GUARD_WRITER ){
+        sqlite3_free(put.zETag);
+      }else{
+        *pzETag = put.zETag;
+        put.zETag = 0;
+      }
+      sqlite3_free(put.zErr);
+      return SQLITE_OK;
+    }
+    sqlite3_free(put.zETag);
+    sqlite3_free(put.zErr);
+    if( !bcvSessionGuardConflict(rc) ) return rc;
+  }
+  return SQLITE_BUSY;
+}
+
+int bcvSessionGuardRelease(
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  const u8 aOwner[16],
+  const char *zETag
+){
+  u8 aBody[BCV_SESSION_GC_GUARD_BODY_BYTES];
+  BcvSessionGcPut put;
+  int rc;
+  if( pDisp==0 || pBcv==0 || aOwner==0 || zETag==0 ) return SQLITE_MISUSE;
+  (void)aOwner;
+  bcvSessionGuardBody(aBody,BCV_SESSION_GC_GUARD_IDLE,0,0);
+  rc = bcvSessionGuardPut(pDisp,pBcv,zETag,aBody,&put);
+  sqlite3_free(put.zETag);
+  sqlite3_free(put.zErr);
+  return rc;
+}
+
+/* An expired head is not safe to sweep merely because its wall-clock TTL
+** elapsed.  First CAS the exact fetched bytes to EXPIRED.  A concurrent
+** accept/renewal then either wins the ETag race (and this cleanup aborts), or
+** observes the terminal head before any child object is deleted. */
+static int bcvSessionGcExpireHead(
+  BcvSessionGc *pGc,
+  BcvSessionGcObject *pObj,
+  const BcvSessionGcRecord *pRec,
+  const BcvSessionGcFetch *pFetch
+){
+  unsigned char *aNew = 0;
+  u8 aHash[BCV_SESSION_GC_HASH_BYTES];
+  SHA256_CTX sha;
+  BcvSessionGcPut ctx;
+  int rc;
+  if( pRec->eType!=2 || pFetch->aData==0
+   || pFetch->nData<BCV_SESSION_GC_HEADER_BYTES+BCV_SESSION_GC_TRAILER_BYTES
+   || pObj->zETag==0
+  ) return SQLITE_CORRUPT;
+  if( pRec->eState==5 || pRec->eState==6 ){
+    pObj->eState = pRec->eState;
+    return SQLITE_OK;
+  }
+  if( bcvSessionGcObjectProtected(pGc,pRec->iExpires) ) return SQLITE_OK;
+  aNew = (u8*)sqlite3_malloc64((sqlite3_uint64)pFetch->nData);
+  if( aNew==0 ) return SQLITE_NOMEM;
+  memcpy(aNew,pFetch->aData,(size_t)pFetch->nData);
+  /* EXPIRED carries the failure outcome required by the record schema.  The
+  ** predecessor is the exact prior record hash, making this transition an
+  ** auditable CAS rather than an in-place lifecycle edit. */
+  aNew[11] = 6;
+  aNew[12] = 2;
+  memcpy(&aNew[96],&aNew[pFetch->nData-BCV_SESSION_GC_TRAILER_BYTES],
+      BCV_SESSION_GC_HASH_BYTES);
+  SHA256_Init(&sha);
+  SHA256_Update(&sha,aNew,pFetch->nData-BCV_SESSION_GC_TRAILER_BYTES);
+  SHA256_Final(aHash,&sha);
+  memcpy(&aNew[pFetch->nData-BCV_SESSION_GC_TRAILER_BYTES],aHash,
+      BCV_SESSION_GC_HASH_BYTES);
+  memset(&ctx,0,sizeof(ctx));
+  rc = bcvDispatchPut(
+      pGc->p->pDisp,pGc->p->pCont,pObj->zName,pObj->zETag,
+      aNew,pFetch->nData,&ctx,bcvSessionGcPutCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pGc->p->pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  if( rc==SQLITE_OK ){
+    sqlite3_free(pObj->zETag);
+    pObj->zETag = ctx.zETag;
+    ctx.zETag = 0;
+    pObj->eState = 6;
+  }
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  sqlite3_free(aNew);
+  return rc;
+}
+static int bcvSessionGcKeepManifest(BcvSessionGc *pGc, Manifest *pMan){
+  int ii;
+  int rc = SQLITE_OK;
+  for(ii=0; rc==SQLITE_OK && ii<pMan->nDb; ii++){
+    ManifestDb *pDb = &pMan->aDb[ii];
+    int jj;
+    for(jj=0; rc==SQLITE_OK && jj<pDb->nBlkLocal; jj++){
+      rc = bcvSessionGcKeepAdd(
+          pGc,&pDb->aBlkLocal[jj*NAMEBYTES(pMan)]
+      );
+    }
+  }
+  /* The delete list is part of a checkpoint snapshot's exact reachability
+  ** envelope. Keep it while the checkpoint is live; otherwise a cleanup
+  ** racing a later retry could remove a block needed to reconstruct it. */
+  for(ii=0; rc==SQLITE_OK && ii<pMan->nDelBlk; ii++){
+    rc = bcvSessionGcKeepAdd(
+        pGc,&pMan->aDelBlk[ii*GCENTRYBYTES(pMan)]
+    );
+  }
+  return rc;
+}
+
+/* Protect the currently published database mapping from expired session
+** overlays. The current manifest's delete list is intentionally excluded. */
+static int bcvSessionGcKeepCurrent(BcvSessionGc *pGc){
+  int ii;
+  int rc = SQLITE_OK;
+  for(ii=0; rc==SQLITE_OK && ii<pGc->pMan->nDb; ii++){
+    ManifestDb *pDb = &pGc->pMan->aDb[ii];
+    int jj;
+    for(jj=0; rc==SQLITE_OK && jj<pDb->nBlkLocal; jj++){
+      rc = bcvSessionGcKeepAdd(
+          pGc,&pDb->aBlkLocal[jj*NAMEBYTES(pGc->pMan)]
+      );
+    }
+  }
+  return rc;
+}
+
+static int bcvSessionGcRecordBodyManifest(
+  BcvSessionGc *pGc,
+  const BcvSessionGcRecord *pRec,
+  Manifest **ppMan,
+  u8 aManifestHash[BCV_SESSION_GC_HASH_BYTES],
+  int bKeep
+){
+  const u8 *a = pRec->aBody;
+  u32 nManifest;
+  u32 nEtag;
+  char *zEtag;
+  char *zErr = 0;
+  const char *zManifestReason = 0;
+  Manifest *pMan = 0;
+  SHA256_CTX sha;
+  int rc;
+  if( pRec->eType!=1 ) return SQLITE_MISUSE;
+  nManifest = bcvGetU32(&a[16]);
+  nEtag = bcvGetU32(&a[20]);
+  zEtag = sqlite3_mprintf("%.*s",(int)nEtag,&a[24]);
+  if( zEtag==0 ) return SQLITE_NOMEM;
+  if( !bcvSessionGcManifestValid(&a[24+nEtag],(int)nManifest,&zManifestReason) ){
+    if( pGc->p->nLogLevel>=BCV_LOGLEVEL_DEBUG ){
+      bcvExtraLog(pGc->p,"cleanup: checkpoint manifest rejected: %s",
+          zManifestReason ? zManifestReason : "unknown validation error");
+    }
+    sqlite3_free(zEtag);
+    return SQLITE_CORRUPT;
+  }
+  rc = bcvManifestParseCopy(
+      &a[24+nEtag],(int)nManifest,zEtag,&pMan,&zErr
+  );
+  sqlite3_free(zEtag);
+  sqlite3_free(zErr);
+  if( rc!=SQLITE_OK ) return rc;
+  SHA256_Init(&sha);
+  SHA256_Update(&sha,&a[24+nEtag],nManifest);
+  SHA256_Final(aManifestHash,&sha);
+  rc = bKeep ? bcvSessionGcKeepManifest(pGc,pMan) : SQLITE_OK;
+  if( rc==SQLITE_OK ) *ppMan = pMan;
+  else bcvManifestFree(pMan);
+  return rc;
+}
+
+static BcvSessionGcObject *bcvSessionGcFindObject(
+  BcvSessionGc *pGc,
+  const char *zName
+){
+  int ii;
+  for(ii=0; ii<pGc->nObject; ii++){
+    if( 0==strcmp(pGc->aObject[ii].zName,zName) ) return &pGc->aObject[ii];
+  }
+  return 0;
+}
+
+static void bcvSessionGcSetExpiry(
+  BcvSessionGcObject *pObj,
+  i64 iExpires
+){
+  if( pObj && iExpires>pObj->iExpires ) pObj->iExpires = iExpires;
+}
+
+static int bcvSessionGcAssociateCandidate(
+  BcvSessionGc *pGc,
+  const u8 *aCandidateHash,
+  i64 iExpires
+  ){
+  char zHash[BCV_SESSION_GC_HASH_BYTES*2+1];
+  char *zName;
+  BcvSessionGcObject *pObj;
+  hex_encode(aCandidateHash,BCV_SESSION_GC_HASH_BYTES,zHash,0);
+  zName = sqlite3_mprintf(
+      BCV_SESSION_GC_CANDIDATE_PREFIX "%s.bcv",zHash
+  );
+  if( zName==0 ) return SQLITE_NOMEM;
+  pObj = bcvSessionGcFindObject(pGc,zName);
+  if( pObj ){
+    pObj->bHasCheckpoint = 1;
+    bcvSessionGcSetExpiry(pObj,iExpires);
+  }
+  sqlite3_free(zName);
+  return SQLITE_OK;
+}
+
+static int bcvSessionGcValidateCandidate(
+  BcvSessionGc *pGc,
+  BcvSessionGcObject *pObj,
+  const BcvSessionGcFetch *pFetch,
+  int bKeep,
+  Manifest **ppMan
+){
+  Manifest *pMan = 0;
+  char *zErr = 0;
+  const char *zManifestReason = 0;
+  u8 aHash[BCV_SESSION_GC_HASH_BYTES];
+  SHA256_CTX sha;
+  int rc;
+  if( pFetch->nData<=0 || pFetch->nData>BCV_SESSION_GC_RECORD_MAX ){
+    return SQLITE_CORRUPT;
+  }
+  SHA256_Init(&sha);
+  SHA256_Update(&sha,pFetch->aData,pFetch->nData);
+  SHA256_Final(aHash,&sha);
+  if( memcmp(aHash,pObj->aObjectId,sizeof(aHash))!=0 ) return SQLITE_CORRUPT;
+  if( !bcvSessionGcManifestValid(pFetch->aData,pFetch->nData,&zManifestReason) ){
+    if( pGc->p->nLogLevel>=BCV_LOGLEVEL_DEBUG ){
+      bcvExtraLog(pGc->p,"cleanup: candidate manifest rejected: %s",
+          zManifestReason ? zManifestReason : "unknown validation error");
+    }
+    return SQLITE_CORRUPT;
+  }
+  rc = bcvManifestParseCopy(
+      pFetch->aData,pFetch->nData,"",&pMan,&zErr
+  );
+  sqlite3_free(zErr);
+  if( rc==SQLITE_OK && bKeep ) rc = bcvSessionGcKeepManifest(pGc,pMan);
+  if( rc==SQLITE_OK ){
+    pObj->bValidated = 1;
+    memcpy(pObj->aManifestHash,aHash,sizeof(aHash));
+    if( ppMan ){
+      *ppMan = pMan;
+      pMan = 0;
+    }
+  }
+  bcvManifestFree(pMan);
+  return rc;
+}
+
+static int bcvSessionGcTrackManifestBlocks(
+  BcvSessionGc *pGc,
+  Manifest *pMan
+){
+  int ii;
+  int rc = SQLITE_OK;
+  int nGC = GCENTRYBYTES(pMan);
+  for(ii=0; rc==SQLITE_OK && ii<pMan->nDb; ii++){
+    ManifestDb *pDb = &pMan->aDb[ii];
+    int jj;
+    for(jj=0; rc==SQLITE_OK && jj<pDb->nBlkLocal; jj++){
+      rc = bcvSessionGcOrphanAdd(
+          pGc,&pDb->aBlkLocal[jj*NAMEBYTES(pMan)],pGc->iNow
+      );
+    }
+  }
+  for(ii=0; rc==SQLITE_OK && ii<pMan->nDelBlk; ii++){
+    rc = bcvSessionGcOrphanAdd(
+        pGc,&pMan->aDelBlk[ii*nGC],pGc->iNow
+    );
+  }
+  return rc;
+}
+
+/* Validate a pre-head attempt marker and protect the block named by it while
+** the marker's bounded lifetime is active.  The marker is written before the
+** corresponding block PUT, so a cleanup pass cannot mistake a long-running
+** request's block for an unowned legacy orphan. */
+static int bcvSessionGcValidateAttempt(
+  BcvSessionGc *pGc,
+  BcvSessionGcObject *pObj,
+  const BcvSessionGcFetch *pFetch
+){
+  static const u8 aMagic[8] = {'B','C','V','A','T','0','1','\0'};
+  u8 aHash[BCV_SESSION_GC_HASH_BYTES];
+  u8 aUuid[16];
+  u64 iCreated;
+  u64 iExpires;
+  u16 nBlock;
+  SHA256_CTX sha;
+  if( pFetch->nData!=BCV_SESSION_GC_ATTEMPT_BODY_BYTES
+   || memcmp(pFetch->aData,aMagic,sizeof(aMagic))!=0
+   || bcvGetU16(&pFetch->aData[8])!=BCV_SESSION_GC_VERSION
+  ) return SQLITE_CORRUPT;
+  iCreated = bcvGetU64(&pFetch->aData[12]);
+  iExpires = bcvGetU64(&pFetch->aData[20]);
+  nBlock = bcvGetU16(&pFetch->aData[10]);
+  if( iCreated>0x7FFFFFFFFFFFFFFFULL || iExpires>0x7FFFFFFFFFFFFFFFULL
+   || iExpires<=iCreated || iExpires-iCreated>BCV_SESSION_GC_ATTEMPT_TTL
+   || nBlock!=pObj->nObjectId
+   || nBlock!=pGc->nName
+   || nBlock<BCV_MIN_NAMEBYTES || nBlock>BCV_MAX_NAMEBYTES
+  ) return SQLITE_CORRUPT;
+  memcpy(aUuid,&pFetch->aData[28],sizeof(aUuid));
+  if( memcmp(aUuid,pObj->aUuid,sizeof(aUuid))!=0
+   || memcmp(&pFetch->aData[44],pObj->aOperationId,32)!=0
+   || memcmp(&pFetch->aData[76],pObj->aObjectId,nBlock)!=0
+   || bcvSessionGcAllZero(&pFetch->aData[108],32)
+  ) return SQLITE_AUTH;
+  SHA256_Init(&sha);
+  SHA256_Update(&sha,pFetch->aData,
+      BCV_SESSION_GC_ATTEMPT_BODY_BYTES-BCV_SESSION_GC_TRAILER_BYTES);
+  SHA256_Final(aHash,&sha);
+  if( memcmp(aHash,
+      &pFetch->aData[BCV_SESSION_GC_ATTEMPT_BODY_BYTES
+                    -BCV_SESSION_GC_TRAILER_BYTES],32)!=0
+  ) return SQLITE_CORRUPT;
+  pObj->iExpires = (i64)iExpires;
+  pObj->bValidated = 1;
+  if( bcvSessionGcObjectProtected(pGc,pObj->iExpires) ){
+    int rc = bcvSessionGcKeepAdd(pGc,pObj->aObjectId);
+    if( rc==SQLITE_OK ){
+      pObj->bReferenced = 1;
+      pGc->bLive = 1;
+    }
+    return rc;
+  }
+  return bcvSessionGcOrphanAdd(pGc,pObj->aObjectId,pGc->iNow);
+}
+
+/* Mark an immutable candidate referenced by a live head.  Accepted request
+** heads can carry a candidate hash before the publication path has PUT the
+** candidate object, so a missing object is tolerated for those roots. A
+** live publishing/committed head or publication fence must find and verify
+** its candidate or cleanup fails closed. */
+static int bcvSessionGcMarkCandidate(
+  BcvSessionGc *pGc,
+  const u8 *aCandidateHash,
+  i64 iExpires,
+  int bProtected,
+  int bRequired
+){
+  BcvSessionGcFetch fetch;
+  BcvSessionGcObject tempObj;
+  BcvSessionGcObject *pObj;
+  char zHash[BCV_SESSION_GC_HASH_BYTES*2+1];
+  char *zName;
+  int bListed;
+  int rc;
+  if( aCandidateHash==0 || bcvSessionGcAllZero(aCandidateHash,32) ){
+    return SQLITE_CORRUPT;
+  }
+  hex_encode(aCandidateHash,BCV_SESSION_GC_HASH_BYTES,zHash,0);
+  zName = sqlite3_mprintf(
+      BCV_SESSION_GC_CANDIDATE_PREFIX "%s.bcv",zHash
+  );
+  if( zName==0 ) return SQLITE_NOMEM;
+  pObj = bcvSessionGcFindObject(pGc,zName);
+  bListed = pObj!=0;
+  if( pObj ) bcvSessionGcSetExpiry(pObj,iExpires);
+  if( !bProtected ){
+    sqlite3_free(zName);
+    return SQLITE_OK;
+  }
+  if( pObj && pObj->bReferenced ){
+    if( !pObj->bValidated ) rc = SQLITE_CORRUPT;
+    else rc = SQLITE_OK;
+    sqlite3_free(zName);
+    return rc;
+  }
+  if( pObj==0 && !bRequired ){
+    /* The accepted head records the candidate before candidate PUT. */
+    sqlite3_free(zName);
+    return SQLITE_OK;
+  }
+  if( pObj==0 ){
+    memset(&tempObj,0,sizeof(tempObj));
+    tempObj.eType = 4;
+    memcpy(tempObj.aObjectId,aCandidateHash,32);
+    pObj = &tempObj;
+  }else{
+    pObj->bReferenced = 1;
+  }
+  if( pObj->bFetched ){
+    rc = pObj->bValidated ? SQLITE_OK : SQLITE_CORRUPT;
+  }else{
+    rc = bcvSessionGcFetch(pGc,zName,&fetch);
+    if( rc==SQLITE_OK ){
+      if( bListed ){
+        pObj->iExpires = MAX(pObj->iExpires,iExpires);
+        pObj->bFetched = 1;
+        pObj->zETag = fetch.zETag;
+        fetch.zETag = 0;
+      }
+      rc = bcvSessionGcValidateCandidate(pGc,pObj,&fetch,1,0);
+    }
+    sqlite3_free(fetch.aData);
+    sqlite3_free(fetch.zETag);
+    sqlite3_free(fetch.zErr);
+  }
+  sqlite3_free(zName);
+  return rc;
+}
+
+static int bcvSessionGcObjectProtected(
+  BcvSessionGc *pGc,
+  i64 iExpires
+){
+  i64 iGrace;
+  if( pGc->nSecond<=0 ) iGrace = 0;
+  else if( pGc->nSecond > 0x7FFFFFFFFFFFFFFFLL/1000 ){
+    iGrace = 0x7FFFFFFFFFFFFFFFLL;
+  }else{
+    iGrace = (i64)pGc->nSecond*1000;
+  }
+  if( iExpires > 0x7FFFFFFFFFFFFFFFLL-iGrace ) return 1;
+  return pGc->iNow < iExpires+iGrace;
+}
+
+static int bcvSessionGcMarkCheckpoint(
+  BcvSessionGc *pGc,
+  const char *zSessionId,
+  const u8 *aCheckpointHash,
+  const u8 *aExpectedCandidateHash,
+  const u8 *aExpectedScope,
+  int iDepth,
+  u64 iChildSequence
+){
+  char *zName = 0;
+  char zHash[BCV_SESSION_GC_HASH_BYTES*2+1];
+  BcvSessionGcFetch fetch;
+  BcvSessionGcRecord rec;
+  BcvSessionGcObject *pObj;
+  BcvSessionGcObject tempObj;
+  Manifest *pMan = 0;
+  u8 aManifestHash[BCV_SESSION_GC_HASH_BYTES];
+  char *zErr = 0;
+  int rc;
+  int bListed;
+  if( iDepth>=BCV_SESSION_GC_MAX_CHAIN ) return SQLITE_TOOBIG;
+  if( aCheckpointHash==0 || bcvSessionGcAllZero(aCheckpointHash,32) ){
+    return SQLITE_CORRUPT;
+  }
+  hex_encode(aCheckpointHash,BCV_SESSION_GC_HASH_BYTES,zHash,0);
+  zName = sqlite3_mprintf(
+      BCV_SESSION_GC_CHECKPOINT_PREFIX "%s/%s.bcv",zSessionId,zHash
+  );
+  if( zName==0 ) return SQLITE_NOMEM;
+  pObj = bcvSessionGcFindObject(pGc,zName);
+  bListed = pObj!=0;
+  if( pObj && pObj->bReferenced ){
+    if( !pObj->bValidated ){
+      /* Re-entering an in-flight checkpoint is a predecessor cycle. */
+      sqlite3_free(zName);
+      return SQLITE_CORRUPT;
+    }
+    if( iChildSequence && pObj->iSequence>=iChildSequence ){
+      sqlite3_free(zName);
+      return SQLITE_CORRUPT;
+    }
+    if( aExpectedScope
+     && memcmp(pObj->aScopeHash,aExpectedScope,32)!=0
+    ){
+      sqlite3_free(zName);
+      return SQLITE_AUTH;
+    }
+    if( aExpectedCandidateHash
+     && memcmp(pObj->aManifestHash,aExpectedCandidateHash,32)!=0
+    ){
+      sqlite3_free(zName);
+      return SQLITE_CONSTRAINT;
+    }
+    sqlite3_free(zName);
+    return SQLITE_OK;
+  }
+  if( pObj ) pObj->bReferenced = 1;
+  if( pObj==0 ){
+    memset(&tempObj,0,sizeof(tempObj));
+    tempObj.eType = 1;
+    if( !bcvSessionGcUuid(
+        zSessionId,(int)strlen(zSessionId),tempObj.aUuid
+    ) ){
+      sqlite3_free(zName);
+      return SQLITE_CORRUPT;
+    }
+    memcpy(tempObj.aObjectId,aCheckpointHash,32);
+    pObj = &tempObj;
+  }
+  rc = bcvSessionGcFetch(pGc,zName,&fetch);
+  if( rc==SQLITE_OK ){
+    rc = bcvSessionGcRecordDecode(fetch.aData,fetch.nData,pObj,
+        &rec,&zErr);
+  }
+  if( rc==SQLITE_OK && rec.eType!=1 ) rc = SQLITE_CORRUPT;
+  if( rc==SQLITE_OK && rec.eState!=1 ) rc = SQLITE_CORRUPT;
+  if( rc==SQLITE_OK && rec.iSequence==0 ) rc = SQLITE_CORRUPT;
+  if( rc==SQLITE_OK && iChildSequence && rec.iSequence>=iChildSequence ){
+    rc = SQLITE_CORRUPT;
+  }
+  if( rc==SQLITE_OK && strcmp(rec.zSessionId,zSessionId)!=0 ) rc = SQLITE_AUTH;
+  if( rc==SQLITE_OK && aExpectedScope
+   && memcmp(rec.aScope,aExpectedScope,BCV_SESSION_GC_HASH_BYTES)!=0
+  ) rc = SQLITE_AUTH;
+  if( rc==SQLITE_OK && bListed ){
+    pObj->iExpires = rec.iExpires;
