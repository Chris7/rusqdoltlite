+static int bcvfsSessionManifestPut(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zIfMatch,
+  const unsigned char *aData,
+  int nData,
+  char **pzETag,
+  char **pzErr
+){
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  BcvSessionPutCtx ctx;
+  int rc;
+  int bAcquired = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( pzETag==0 || aData==0 || nData<=0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"manifest PUT arguments are required");
+  }
+  rc = bcvSessionConditionValid(zIfMatch,pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionAcquire(pFs,zAlias,0,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc==SQLITE_OK ){
+    bAcquired = 1;
+    if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session publication scope is not bound");
+    }
+  }
+  memset(&ctx,0,sizeof(ctx));
+  if( rc==SQLITE_OK ){
+    rc = bcvDispatchPutMax(
+        pDisp,pBcv,BCV_MANIFEST_FILE,zIfMatch,aData,nData,
+        SQLITE_BCVFS_SESSION_BODY_MAX_BYTES,64*1024,&ctx,bcvSessionPutCb
+    );
+  }
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  if( rc==SQLITE_OK ){
+    *pzETag = ctx.zETag;
+    ctx.zETag = 0;
+  }else if( pzErr && *pzErr==0 && ctx.zErr ){
+    *pzErr = ctx.zErr;
+    ctx.zErr = 0;
+  }
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  if( bAcquired ) bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
