+static int bcvSessionHexValue(unsigned char c){
+  if( c>='0' && c<='9' ) return c-'0';
+  if( c>='a' && c<='f' ) return c-'a'+10;
+  if( c>='A' && c<='F' ) return c-'A'+10;
+  return -1;
+}
+
+static int bcvSessionUuidDecode(
+  const char *z,
+  unsigned char aUuid[16]
+){
+  int iIn = 0;
+  int iOut = 0;
+  int n = 0;
+  if( z==0 ) return 0;
+  while( n<36 && z[n] ) n++;
+  if( n!=36 ) return 0;
+  if( z[36]!='\0' ) return 0;
+  while(iIn<36){
+    int hi;
+    int lo;
+    if( iIn==8 || iIn==13 || iIn==18 || iIn==23 ){
+      if( z[iIn]!='-' ) return 0;
+      iIn++;
+      continue;
+    }
+    hi = bcvSessionHexValue((unsigned char)z[iIn++]);
+    lo = (iIn<36) ? bcvSessionHexValue((unsigned char)z[iIn++]) : -1;
+    if( hi<0 || lo<0 || iOut>=16 ) return 0;
+    aUuid[iOut++] = (unsigned char)((hi<<4)|lo);
+  }
+  return iOut==16 && !bcvSessionAllZero(aUuid,16);
+}
+
+static void bcvSessionUuidEncode(
+  const unsigned char aUuid[16],
+  char zUuid[SQLITE_BCVFS_SESSION_ID_TEXT_BYTES]
+){
+  static const char aHex[] = "0123456789abcdef";
+  int i;
+  int j = 0;
+  for(i=0; i<16; i++){
+    zUuid[j++] = aHex[aUuid[i]>>4];
+    zUuid[j++] = aHex[aUuid[i]&15];
+    if( i==3 || i==5 || i==7 || i==9 ) zUuid[j++] = '-';
+  }
+  zUuid[j] = '\0';
+}
+
+static int bcvSessionScopeField(
+  SHA256_CTX *pSha,
+  const char *z,
+  int bRequired,
+  const char *zName,
+  char **pzErr
+){
+  unsigned char aLen[4];
+  size_t n;
+  size_t ii;
+  if( z==0 ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, zName);
+  }
+  n = strlen(z);
+  if( (bRequired && n==0) || n>BCV_SESSION_MAX_FIELD_BYTES ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, zName);
+  }
+  for(ii=0; ii<n; ii++){
+    unsigned char c = (unsigned char)z[ii];
+    if( c<0x20 || c==0x7F ){
+      return bcvSessionError(SQLITE_MISUSE, pzErr, zName);
+    }
+  }
+  bcvPutU32(aLen, (u32)n);
+  SHA256_Update(pSha, aLen, sizeof(aLen));
+  SHA256_Update(pSha, (const unsigned char*)z, n);
+  return SQLITE_OK;
+}
+
+typedef struct BcvSessionStorageParam BcvSessionStorageParam;
+struct BcvSessionStorageParam {
+  const char *z;
+  size_t iStart;
+  size_t iEnd;
+  size_t iEq;
+};
+
+static int bcvSessionStorageParamCmp(
+  const void *pLeft,
+  const void *pRight
+){
+  const BcvSessionStorageParam *pA = (const BcvSessionStorageParam*)pLeft;
+  const BcvSessionStorageParam *pB = (const BcvSessionStorageParam*)pRight;
+  size_t nA = pA->iEq-pA->iStart;
+  size_t nB = pB->iEq-pB->iStart;
+  size_t nMin = nA<nB ? nA : nB;
+  int rc = sqlite3_strnicmp(&pA->z[pA->iStart],&pB->z[pB->iStart],(int)nMin);
+  if( rc==0 && nA!=nB ) rc = nA<nB ? -1 : 1;
+  if( rc==0 ){
+    size_t nFullA = pA->iEnd-pA->iStart;
+    size_t nFullB = pB->iEnd-pB->iStart;
+    nMin = nFullA<nFullB ? nFullA : nFullB;
+    rc = memcmp(&pA->z[pA->iStart],&pB->z[pB->iStart],nMin);
+    if( rc==0 && nFullA!=nFullB ) rc = nFullA<nFullB ? -1 : 1;
+  }
+  return rc;
+}
+
+static int bcvSessionStorageParamAdd(
+  BcvSessionStorageParam **ppa,
+  int *pnParam,
+  const char *z,
+  size_t iStart,
+  size_t iEnd,
+  size_t iEq,
+  char **pzErr
+){
+  BcvSessionStorageParam *aNew;
+  int nParam = *pnParam;
+  if( nParam>=128 ){
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"too many storage parameters");
+  }
+  aNew = (BcvSessionStorageParam*)sqlite3_realloc64(
+      *ppa,(sqlite3_uint64)(nParam+1)*sizeof(*aNew)
+  );
+  if( aNew==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  aNew[nParam].z = z;
+  aNew[nParam].iStart = iStart;
+  aNew[nParam].iEnd = iEnd;
+  aNew[nParam].iEq = iEq;
+  *ppa = aNew;
+  *pnParam = nParam+1;
+  return SQLITE_OK;
+}
+
+/* Validate the endpoint spelling used by a scoped selector.  The provider
+** parsers accept host names case-insensitively, and DNS also treats a trailing
+** host dot as equivalent; retaining either spelling would fork one durable
+** publication fence.  Reject those aliases rather than trying to implement a
+** second URL parser.  Default ports are rejected for the same reason. */
+static int bcvSessionEndpointCanonical(
+  const char *z,
+  size_t n,
+  char **pzErr
+){
+  const char *zSep;
+  const char *zAuthority;
+  const char *zPath;
+  size_t nScheme;
+  size_t nAuthority;
+  size_t nHost;
+  size_t i;
+  size_t iPort = 0;
+  int bHttps;
+  if( z==0 || n==0 || n>BCV_SESSION_MAX_FIELD_BYTES ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid storage endpoint");
+  }
+  zSep = 0;
+  for(i=0; i+2<n; i++){
+    if( z[i]==':' && z[i+1]=='/' && z[i+2]=='/' ){
+      zSep = &z[i];
+      break;
+    }
+  }
+  if( zSep==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint requires an http(s) URL");
+  }
+  nScheme = (size_t)(zSep-z);
+  if( nScheme==4 && memcmp(z,"http",4)==0 ){
+    bHttps = 0;
+  }else if( nScheme==5 && memcmp(z,"https",5)==0 ){
+    bHttps = 1;
+  }else{
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint scheme is not canonical");
+  }
+  zAuthority = zSep+3;
+  zPath = (const char*)memchr(zAuthority,'/',n-(size_t)(zAuthority-z));
+  nAuthority = zPath ? (size_t)(zPath-zAuthority) : n-(size_t)(zAuthority-z);
+  if( nAuthority==0 || memchr(zAuthority,'@',nAuthority) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint authority is invalid");
+  }
+  nHost = nAuthority;
+  if( zAuthority[0]=='[' ){
+    const char *zClose = (const char*)memchr(zAuthority,']',nAuthority);
+    if( zClose==0 ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint IPv6 host is invalid");
+    }
+    nHost = (size_t)(zClose-zAuthority)+1;
+    if( nHost<nAuthority ){
+      if( zAuthority[nHost]!=':' ){
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint port is invalid");
+      }
+      iPort = nHost+1;
+    }
+  }else{
+    for(i=0; i<nAuthority; i++){
+      if( zAuthority[i]==':' ){
+        nHost = i;
+        iPort = i+1;
+        break;
+      }
+    }
+  }
+  if( nHost==0 || (nHost==1 && zAuthority[0]=='.')
+   || zAuthority[nHost-1]=='.'
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint host is not canonical");
+  }
+  for(i=0; i<nHost; i++){
+    unsigned char c = (unsigned char)zAuthority[i];
+    if( c>='A' && c<='Z' ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint host must be lowercase");
+    }
+    if( c<0x20 || c==0x7F || c=='?' || c=='#' || c=='@' ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint host is invalid");
+    }
+  }
+  if( iPort ){
+    unsigned int iValue = 0;
+    if( iPort>=nAuthority ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint port is empty");
+    }
+    if( iPort+1<nAuthority && zAuthority[iPort]=='0' ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint port is not canonical");
+    }
+    for(i=iPort; i<nAuthority; i++){
+      unsigned char c = (unsigned char)zAuthority[i];
+      if( c<'0' || c>'9' || iValue>6553 ){
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint port is invalid");
+      }
+      iValue = iValue*10 + (unsigned int)(c-'0');
+    }
+    if( iValue==0 || iValue>65535
+     || (bHttps && iValue==443) || (!bHttps && iValue==80)
+    ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint uses a non-canonical port");
+    }
+  }
+  if( zAuthority[0]!='[' ){
+    int bNumericHost = 1;
+    int nDot = 0;
+    size_t iPart = 0;
+    for(i=0; i<nHost; i++){
+      unsigned char c = (unsigned char)zAuthority[i];
+      if( c=='.' ){
+        if( i==iPart ){
+          return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint host is not canonical");
+        }
+        nDot++;
+        iPart = i+1;
+      }else if( c<'0' || c>'9' ){
+        bNumericHost = 0;
+      }
+    }
+    if( iPart==nHost ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint host is not canonical");
+    }
+    if( bNumericHost ){
+      if( nDot!=3 ){
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint IPv4 host is not canonical");
+      }
+      iPart = 0;
+      for(i=0; i<=nHost; i++){
+        if( i==nHost || zAuthority[i]=='.' ){
+          size_t nPart = i-iPart;
+          unsigned int iPartValue = 0;
+          size_t j;
+          if( nPart==0 || (nPart>1 && zAuthority[iPart]=='0') || nPart>3 ){
+            return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint IPv4 host is not canonical");
+          }
+          for(j=iPart; j<i; j++) iPartValue = iPartValue*10u + (unsigned int)(zAuthority[j]-'0');
+          if( iPartValue>255 ){
+            return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint IPv4 host is not canonical");
+          }
+          iPart = i+1;
+        }
+      }
+    }
+  }
+  for(i=(size_t)(zAuthority-z); i<n; i++){
+    unsigned char c = (unsigned char)z[i];
+    if( c<0x20 || c==0x7F || c=='?' || c=='#' ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint contains an invalid byte");
+    }
+  }
+  if( zPath ){
+    for(i=(size_t)(zPath-z); i<n; i++){
+      if( z[i]!='/' ){
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"storage endpoint path is not canonical");
+      }
+    }
+  }
+  return SQLITE_OK;
+}
+
+/* The provider modules trim trailing endpoint slashes while opening a
+** container.  Canonicalize the selector before hashing so equivalent URLs do
+** not fork the durable publication fence.  Query keys are case-insensitive
+** and query pairs are sorted because the provider parsers treat them as an
+** unordered set.  Values other than endpoint remain unchanged. */
+static int bcvSessionCanonicalStorage(
+  const char *zStorage,
+  char **pzCanonical,
+  char **pzErr
+){
+  size_t n;
+  size_t i;
+  size_t ii;
+  size_t o = 0;
+  size_t nAlloc;
+  char *zOut;
+  const char *zQuery;
+  BcvSessionStorageParam *aParam = 0;
+  int nParam = 0;
+  int bS3;
+  int bGoogle;
+  int bAzure;
+  int bHasRegion = 0;
+  int bHasEndpoint = 0;
+  int bHasMaxResults = 0;
+  int bHasApi = 0;
+  size_t nModule;
+  static const char zDefaultS3Region[] = "region=us-east-1";
+  static const char zDefaultGoogleEndpoint[] =
+      "endpoint=https://storage.googleapis.com";
+  if( pzCanonical ) *pzCanonical = 0;
+  if( zStorage==0 || pzCanonical==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid storage scope");
+  }
+  n = strlen(zStorage);
+  if( n==0 || n>BCV_SESSION_MAX_FIELD_BYTES ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid storage scope");
+  }
+  nAlloc = n + sizeof(zDefaultS3Region) + sizeof(zDefaultGoogleEndpoint) + 2;
+  zOut = (char*)sqlite3_malloc64(nAlloc);
+  if( zOut==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  zQuery = strchr(zStorage,'?');
+  nModule = zQuery ? (size_t)(zQuery-zStorage) : n;
+  bS3 = nModule==2 && sqlite3_strnicmp(zStorage,"s3",2)==0;
+  bGoogle = nModule==6 && sqlite3_strnicmp(zStorage,"google",6)==0;
+  bAzure = nModule==5 && sqlite3_strnicmp(zStorage,"azure",5)==0;
+  if( !bS3 && !bGoogle && !bAzure ){
+    sqlite3_free(zOut);
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"storage provider is not supported for session records");
+  }
+  i = 0;
+  while( i<n && zStorage+i!=zQuery ){
+    unsigned char c = (unsigned char)zStorage[i++];
+    if( c>='A' && c<='Z' ) c = (unsigned char)(c-'A'+'a');
+    zOut[o++] = (char)c;
+  }
+  if( zQuery ){
+    zOut[o++] = '?';
+    i = (size_t)(zQuery-zStorage)+1;
+    while( i<=n ){
+      size_t iStart = i;
+      size_t iEnd = iStart;
+      size_t iEq;
+      size_t nKey;
+      int bEndpoint;
+      int bRegion;
+      int bMaxResults;
+      int bApi;
+      while( iEnd<n && zStorage[iEnd]!='&' ) iEnd++;
+      if( iStart==iEnd ){
+        sqlite3_free(aParam);
+        sqlite3_free(zOut);
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"empty storage parameter");
+      }
+      iEq = iStart;
+      while( iEq<iEnd && zStorage[iEq]!='=' ) iEq++;
+      nKey = iEq-iStart;
+      if( nKey==0 || iEq==iEnd ){
+        sqlite3_free(aParam);
+        sqlite3_free(zOut);
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"storage parameters require values");
+      }
+      bEndpoint = nKey==8
+          && sqlite3_strnicmp(&zStorage[iStart],"endpoint",8)==0;
+      bRegion = nKey==6
+          && sqlite3_strnicmp(&zStorage[iStart],"region",6)==0;
+      bMaxResults = nKey==10
+          && sqlite3_strnicmp(&zStorage[iStart],"maxresults",10)==0;
+      bApi = nKey==3 && sqlite3_strnicmp(&zStorage[iStart],"api",3)==0;
+      if( !bEndpoint && !bRegion && !bMaxResults && !bApi ){
+        sqlite3_free(aParam);
+        sqlite3_free(zOut);
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"unknown storage parameter");
+      }
+      if( (!bS3 && bRegion) || (!bS3 && bEndpoint && bGoogle==0)
+       || (!bS3 && bMaxResults==0 && bGoogle==0 && bAzure==0)
+       || (!bGoogle && bApi)
+       || (bAzure && (bEndpoint || bRegion || bApi))
+      ){
+        sqlite3_free(aParam);
+        sqlite3_free(zOut);
+        return bcvSessionError(SQLITE_MISUSE,pzErr,"storage parameter is not valid for this provider");
+      }
+      if( bRegion ){
+        if( bHasRegion ){
+          sqlite3_free(aParam);
+          sqlite3_free(zOut);
+          return bcvSessionError(SQLITE_MISUSE,pzErr,"duplicate storage parameter");
+        }
+        bHasRegion = 1;
+        for(ii=iEq+1; ii<iEnd; ii++){
+          unsigned char c = (unsigned char)zStorage[ii];
+          if( c>='A' && c<='Z' ){
+            sqlite3_free(aParam);
+            sqlite3_free(zOut);
+            return bcvSessionError(SQLITE_MISUSE,pzErr,"S3 region must be lowercase");
+          }
+        }
+      }
+      if( bEndpoint ){
+        if( bHasEndpoint ){
+          sqlite3_free(aParam);
+          sqlite3_free(zOut);
+          return bcvSessionError(SQLITE_MISUSE,pzErr,"duplicate storage parameter");
+        }
+        bHasEndpoint = 1;
+        {
+          int rcEndpoint = bcvSessionEndpointCanonical(
+              &zStorage[iEq+1],iEnd-iEq-1,pzErr
+          );
+          if( rcEndpoint!=SQLITE_OK ){
+            sqlite3_free(aParam);
+            sqlite3_free(zOut);
+            return rcEndpoint;
+          }
+          if( bS3 ){
+            const char *zEndpoint = &zStorage[iEq+1];
+            size_t nEndpoint = iEnd-iEq-1;
+            const char *zAuthority = 0;
+            const char *zHostEnd;
+            size_t nAuthority;
+            size_t nHost;
+            static const char zAwsSuffix[] = ".amazonaws.com";
+            if( nEndpoint>=8 && memcmp(zEndpoint,"https://",8)==0 ){
+              zAuthority = zEndpoint+8;
+            }else if( nEndpoint>=7 && memcmp(zEndpoint,"http://",7)==0 ){
+              zAuthority = zEndpoint+7;
+            }
+            if( zAuthority ){
+              zHostEnd = (const char*)memchr(
+                  zAuthority, '/', nEndpoint-(size_t)(zAuthority-zEndpoint)
+              );
+              nAuthority = zHostEnd
+                  ? (size_t)(zHostEnd-zAuthority)
+                  : nEndpoint-(size_t)(zAuthority-zEndpoint);
+              nHost = nAuthority;
+              if( nHost && zAuthority[0]=='[' ){
+                const char *zClose = (const char*)memchr(zAuthority,']',nAuthority);
+                if( zClose ) nHost = (size_t)(zClose-zAuthority)+1;
+              }else{
+                const char *zColon = (const char*)memchr(zAuthority,':',nAuthority);
+                if( zColon ) nHost = (size_t)(zColon-zAuthority);
+              }
+              if( nHost==strlen(zAwsSuffix)-1
+               && sqlite3_strnicmp(
+                      &zAuthority[nHost-(strlen(zAwsSuffix)-1)],
+                      &zAwsSuffix[1], (int)(strlen(zAwsSuffix)-1)
+                  )==0
+              ){
+                sqlite3_free(aParam);
+                sqlite3_free(zOut);
+                return bcvSessionError(
+                    SQLITE_MISUSE,pzErr,
+                    "S3 AWS endpoint aliases are not valid scoped selectors"
+                );
+              }
+              if( nHost>strlen(zAwsSuffix)-1
+               && sqlite3_strnicmp(
+                      &zAuthority[nHost-strlen(zAwsSuffix)],
+                      zAwsSuffix, (int)strlen(zAwsSuffix)
+                  )==0
+              ){
+                sqlite3_free(aParam);
+                sqlite3_free(zOut);
+                return bcvSessionError(
+                    SQLITE_MISUSE,pzErr,
+                    "S3 AWS endpoint aliases are not valid scoped selectors"
+                );
+              }
+            }
+          }
+        }
+      }
+      if( bMaxResults ){
+        if( bHasMaxResults ){
+          sqlite3_free(aParam);
+          sqlite3_free(zOut);
+          return bcvSessionError(SQLITE_MISUSE,pzErr,"duplicate storage parameter");
+        }
+        bHasMaxResults = 1;
+      }
+      if( bApi ){
+        if( bHasApi ){
+          sqlite3_free(aParam);
+          sqlite3_free(zOut);
+          return bcvSessionError(SQLITE_MISUSE,pzErr,"duplicate storage parameter");
+        }
+        bHasApi = 1;
+      }
+      /* maxresults only controls listing page size.  Google api selects the
+      ** transport (XML versus JSON), not the bucket/object namespace. */
+      if( bMaxResults || bApi ){
+        goto next_storage_param;
+      }
+      {
+        int rcParam = bcvSessionStorageParamAdd(
+            &aParam,&nParam,zStorage,iStart,iEnd,iEq,pzErr
+        );
+        if( rcParam!=SQLITE_OK ){
+          sqlite3_free(aParam);
+          sqlite3_free(zOut);
+          return rcParam;
+        }
+      }
+    next_storage_param:
+      if( iEnd<n ){
+        i = iEnd+1;
+      }else{
+        i = n+1;
+      }
+    }
+  }
+  if( bS3 && !bHasRegion ){
+    int rcParam = bcvSessionStorageParamAdd(
+        &aParam,&nParam,zDefaultS3Region,0,strlen(zDefaultS3Region),6,pzErr
+    );
+    if( rcParam!=SQLITE_OK ){
+      sqlite3_free(aParam);
+      sqlite3_free(zOut);
+      return rcParam;
+    }
+  }
+  if( bGoogle && !bHasEndpoint ){
+    int rcParam = bcvSessionStorageParamAdd(
+        &aParam,&nParam,zDefaultGoogleEndpoint,0,
+        strlen(zDefaultGoogleEndpoint),8,pzErr
+    );
+    if( rcParam!=SQLITE_OK ){
+      sqlite3_free(aParam);
+      sqlite3_free(zOut);
+      return rcParam;
+    }
+  }
+  if( nParam>0 && zQuery==0 ) zOut[o++] = '?';
+  if( nParam>0 ){
+    qsort(aParam,(size_t)nParam,sizeof(*aParam),bcvSessionStorageParamCmp);
+    for(i=1; i<(size_t)nParam; i++){
+      size_t nKeyA = aParam[i-1].iEq-aParam[i-1].iStart;
+      size_t nKeyB = aParam[i].iEq-aParam[i].iStart;
+      if( nKeyA==nKeyB
+       && sqlite3_strnicmp(
+              &aParam[i-1].z[aParam[i-1].iStart],
+              &aParam[i].z[aParam[i].iStart],
+              (int)nKeyA
+          )==0
+      ){
+        sqlite3_free(aParam);
+        sqlite3_free(zOut);
+        return bcvSessionError(
+            SQLITE_MISUSE,pzErr,"duplicate storage parameter"
+        );
+      }
+    }
+    for(i=0; i<(size_t)nParam; i++){
+      size_t iKey = aParam[i].iStart;
+      size_t iValue = aParam[i].iEq;
+      size_t iValueEnd = aParam[i].iEnd;
+      const char *zParam = aParam[i].z;
+      int bEndpoint = iValue-iKey==8
+          && sqlite3_strnicmp(&zParam[iKey],"endpoint",8)==0;
+      while( iKey<iValue ){
+        unsigned char c = (unsigned char)zParam[iKey++];
+        if( c>='A' && c<='Z' ) c = (unsigned char)(c-'A'+'a');
+        zOut[o++] = (char)c;
+      }
+      if( iValue<aParam[i].iEnd ){
+        zOut[o++] = '=';
+        iValue++;
+        if( bEndpoint ){
+          while( iValueEnd>iValue && zParam[iValueEnd-1]=='/' ) iValueEnd--;
+        }
+        while( iValue<iValueEnd ) zOut[o++] = zParam[iValue++];
+      }
+      if( i+1<(size_t)nParam ) zOut[o++] = '&';
+    }
+  }
+  zOut[o] = '\0';
+  sqlite3_free(aParam);
+  *pzCanonical = zOut;
+  return SQLITE_OK;
+}
+
+/* S3 and Google treat one slash terminating a bucket prefix as a separator,
+** not part of the object namespace.  Match that provider normalization in the
+** scope fence, while preserving additional trailing slashes because they are
+** part of the provider's object prefix. Azure container names remain
+** byte-for-byte distinct. */
+static int bcvSessionCanonicalContainer(
+  const char *zStorage,
+  const char *zContainer,
+  char **pzCanonical,
+  char **pzErr
+){
+  const char *zQuery;
+  const char *zSlash;
+  size_t n;
+  size_t nOut;
+  size_t nModule;
+  int bNormalize;
+  char *zOut;
+  if( pzCanonical ) *pzCanonical = 0;
+  if( zStorage==0 || zContainer==0 || pzCanonical==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid container scope");
+  }
+  n = strlen(zContainer);
+  if( n==0 || n>BCV_SESSION_MAX_FIELD_BYTES ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid container scope");
+  }
+  zQuery = strchr(zStorage,'?');
+  nModule = zQuery ? (size_t)(zQuery-zStorage) : strlen(zStorage);
+  bNormalize = (nModule==2 && sqlite3_strnicmp(zStorage,"s3",2)==0)
+      || (nModule==6 && sqlite3_strnicmp(zStorage,"google",6)==0);
+  nOut = n;
+  zSlash = strchr(zContainer,'/');
+  if( bNormalize && zSlash ){
+    if( zSlash[1]=='\0' ){
+      /* bucket and bucket/ both select an empty prefix. */
+      nOut = (size_t)(zSlash-zContainer);
+    }else if( zContainer[nOut-1]!='/' ){
+      /* The provider appends exactly one separator when needed. */
+      nOut++;
+    }
+  }
+  zOut = (char*)sqlite3_malloc64(nOut+1);
+  if( zOut==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  memcpy(zOut,zContainer,n > nOut ? nOut : n);
+  if( nOut>n ) zOut[n] = '/';
+  zOut[nOut] = '\0';
+  *pzCanonical = zOut;
+  return SQLITE_OK;
+}
+
+static int bcvSessionValidEtagBytes(
+  const unsigned char *aEtag,
+  int nEtag,
+  int bRequired,
+  char **pzErr
+){
+  int ii;
+  if( nEtag<0 || (bRequired && nEtag==0) || nEtag>BCV_SESSION_MAX_ETAG_BYTES ){
+    return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid session ETag length");
+  }
+  for(ii=0; ii<nEtag; ii++){
+    unsigned char c = aEtag[ii];
+    if( c<0x20 || c==0x7F ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid session ETag bytes");
+    }
+  }
+  return SQLITE_OK;
+}
+
+static int bcvSessionBodyDecode(
+  int eType,
+  int eState,
+  const char *zSessionId,
+  const unsigned char *aBody,
+  int nBody,
+  sqlite3_bcvfs_session_body *pBody,
+  char **pzErr
+){
+  unsigned char aUuid[16];
+  unsigned char aExpectedUuid[16];
+  u32 nEtag;
+  u32 nManifest;
+  if( pzErr ) *pzErr = 0;
+  if( pBody ) memset(pBody,0,sizeof(*pBody));
+  if( pBody==0 || aBody==0 || nBody<8
+   || nBody>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES
+  ){
+    return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid session record body");
+  }
+  pBody->eType = eType;
+  if( eType==SQLITE_BCVFS_SESSION_CHECKPOINT ){
+    int bCompacted = 0;
+    if( nBody<24
+     || (memcmp(aBody,aBcvSessionCheckpointBodyMagic,8)!=0
+         && memcmp(aBody,aBcvSessionCompactedCheckpointBodyMagic,8)!=0)
+    ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid checkpoint body format");
+    }
+    bCompacted = memcmp(
+        aBody,aBcvSessionCompactedCheckpointBodyMagic,8
+    )==0;
+    pBody->iFileSize = bcvGetU64(&aBody[8]);
+    nManifest = bcvGetU32(&aBody[16]);
+    nEtag = bcvGetU32(&aBody[20]);
+    if( nEtag>BCV_SESSION_MAX_ETAG_BYTES
+     || nEtag>(u32)nBody-24
+     || nManifest==0
+     || (sqlite3_uint64)nManifest + (sqlite3_uint64)nEtag + 24
+           > (sqlite3_uint64)nBody
+     || ((bCompacted && (sqlite3_uint64)nBody
+             != (sqlite3_uint64)nManifest + (sqlite3_uint64)nEtag + 24
+                   + SQLITE_BCVFS_SESSION_COMPACTED_BODY_BYTES)
+         || (!bCompacted && (sqlite3_uint64)nBody
+             != (sqlite3_uint64)nManifest + (sqlite3_uint64)nEtag + 24))
+    ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid checkpoint body lengths");
+    }
+    pBody->bCompacted = bCompacted;
+    pBody->aBaseManifestETag = &aBody[24];
+    pBody->nBaseManifestETag = (int)nEtag;
+    pBody->aManifest = &aBody[24+nEtag];
+    pBody->nManifest = (int)nManifest;
+    if( bCompacted ){
+      const unsigned char *aBase = &aBody[24+nEtag+nManifest];
+      if( bcvSessionAllZero(aBase,SQLITE_BCVFS_SESSION_HASH_BYTES) ){
+        return bcvSessionError(
+            SQLITE_CORRUPT,pzErr,"compacted checkpoint has no predecessor root"
+        );
+      }
+      memcpy(pBody->aBaseCheckpointHash,aBase,SQLITE_BCVFS_SESSION_HASH_BYTES);
+    }
+    return bcvSessionValidEtagBytes(
+        pBody->aBaseManifestETag,pBody->nBaseManifestETag,1,pzErr
+    );
+  }
+  if( eType==SQLITE_BCVFS_SESSION_HEAD ){
+    u32 nHistory;
+    u32 nHeadEtag;
+    sqlite3_uint64 nOpsBytes;
+    sqlite3_uint64 nEtagOff;
+    int ii;
+    if( nBody<116 || memcmp(aBody,aBcvSessionHeadBodyMagic,8)!=0 ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid head body format");
+    }
+    nHistory = bcvGetU32(&aBody[108]);
+    nHeadEtag = bcvGetU32(&aBody[112]);
+    nOpsBytes = (sqlite3_uint64)nHistory * SQLITE_BCVFS_SESSION_HASH_BYTES;
+    nEtagOff = 116 + nOpsBytes;
+    if( nHistory>BCV_SESSION_MAX_HISTORY_OPERATIONS
+     || bcvGetU32(&aBody[8])!=0
+     || nEtagOff>(sqlite3_uint64)nBody
+     || nHeadEtag>BCV_SESSION_MAX_ETAG_BYTES
+     || nEtagOff+(sqlite3_uint64)nHeadEtag!=(sqlite3_uint64)nBody
+     || (eState!=SQLITE_BCVFS_SESSION_OPEN
+         && bcvSessionAllZero(&aBody[12],SQLITE_BCVFS_SESSION_HASH_BYTES))
+     || ((eState==SQLITE_BCVFS_SESSION_PUBLISHING
+          || eState==SQLITE_BCVFS_SESSION_COMMITTED)
+         && bcvSessionAllZero(&aBody[44],SQLITE_BCVFS_SESSION_HASH_BYTES))
+    ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid version 2 head body");
+    }
+    for(ii=0; ii<(int)nHistory; ii++){
+      if( bcvSessionAllZero(
+              &aBody[116 + ii*SQLITE_BCVFS_SESSION_HASH_BYTES],
+              SQLITE_BCVFS_SESSION_HASH_BYTES
+          )
+      ){
+        return bcvSessionError(SQLITE_CORRUPT,pzErr,
+            "head history contains an empty operation ID");
+      }
+    }
+    memcpy(pBody->aCheckpointHash,&aBody[12],SQLITE_BCVFS_SESSION_HASH_BYTES);
+    memcpy(pBody->aCandidateManifestHash,&aBody[44],SQLITE_BCVFS_SESSION_HASH_BYTES);
+    memcpy(pBody->aHistoryHeadHash,&aBody[76],SQLITE_BCVFS_SESSION_HASH_BYTES);
+    pBody->aHistoryOperations = &aBody[116];
+    pBody->nHistoryOperations = (int)nHistory;
+    pBody->aBaseManifestETag = &aBody[nEtagOff];
+    pBody->nBaseManifestETag = (int)nHeadEtag;
+    return bcvSessionValidEtagBytes(
+        pBody->aBaseManifestETag,pBody->nBaseManifestETag,1,pzErr
+    );
+  }
+  if( eType==SQLITE_BCVFS_SESSION_PUBLICATION ){
+    if( nBody<92 || memcmp(aBody,aBcvSessionPublicationBodyMagic,8)!=0 ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid publication body format");
+    }
+    memcpy(aUuid,&aBody[8],sizeof(aUuid));
+    if( bcvSessionAllZero(aUuid,sizeof(aUuid))
+     || zSessionId==0
+     || !bcvSessionUuidDecode(zSessionId,aExpectedUuid)
+     || !bcvSessionEqual(aUuid,aExpectedUuid,sizeof(aUuid))
+     || bcvSessionAllZero(&aBody[24],SQLITE_BCVFS_SESSION_HASH_BYTES)
+     || bcvSessionAllZero(&aBody[56],SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ){
+      return bcvSessionError(SQLITE_AUTH,pzErr,"publication body identity mismatch");
+    }
+    nEtag = bcvGetU32(&aBody[88]);
+    if( nEtag>BCV_SESSION_MAX_ETAG_BYTES || nBody!=92+(int)nEtag ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid publication body length");
+    }
+    memcpy(pBody->aSessionId,aUuid,sizeof(aUuid));
+    memcpy(pBody->aCheckpointHash,&aBody[24],SQLITE_BCVFS_SESSION_HASH_BYTES);
+    memcpy(pBody->aCandidateManifestHash,&aBody[56],SQLITE_BCVFS_SESSION_HASH_BYTES);
+    pBody->aBaseManifestETag = &aBody[92];
+    pBody->nBaseManifestETag = (int)nEtag;
+    return bcvSessionValidEtagBytes(
+        pBody->aBaseManifestETag,pBody->nBaseManifestETag,1,pzErr
+    );
+  }
+  if( eType==SQLITE_BCVFS_SESSION_HISTORY ){
+    u32 nHistory;
+    sqlite3_uint64 nExpected;
+    int ii;
+    if( nBody<48 || memcmp(aBody,aBcvSessionHistoryBodyMagic,8)!=0 ){
+      return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid session history body");
+    }
+    nHistory = bcvGetU32(&aBody[40]);
+    nExpected = 48 + (sqlite3_uint64)nHistory
+        * SQLITE_BCVFS_SESSION_HASH_BYTES;
+    if( nHistory==0
+     || nHistory>BCV_SESSION_MAX_HISTORY_OPERATIONS
+     || bcvGetU32(&aBody[44])!=0
+     || nExpected!=(sqlite3_uint64)nBody
+     || bcvSessionAllZero(&aBody[48],(int)((sqlite3_uint64)nHistory
+             * SQLITE_BCVFS_SESSION_HASH_BYTES))
+    ){
+      return bcvSessionError(SQLITE_CORRUPT,
+          pzErr,"invalid session history body");
+    }
+    for(ii=0; ii<(int)nHistory; ii++){
+      if( bcvSessionAllZero(
+              &aBody[48 + ii*SQLITE_BCVFS_SESSION_HASH_BYTES],
+              SQLITE_BCVFS_SESSION_HASH_BYTES
+          )
+      ){
+        return bcvSessionError(SQLITE_CORRUPT,pzErr,
+            "history contains an empty operation ID");
+      }
+    }
+    memcpy(pBody->aHistoryHeadHash,&aBody[8],SQLITE_BCVFS_SESSION_HASH_BYTES);
+    pBody->aHistoryOperations = &aBody[48];
+    pBody->nHistoryOperations = (int)nHistory;
+    return SQLITE_OK;
+  }
+  return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid session body type");
+}
+
+int sqlite3_bcvfs_session_body_decode(
+  int eType,
+  int eState,
+  const char *zSessionId,
+  const unsigned char *aBody,
+  int nBody,
+  sqlite3_bcvfs_session_body *pBody,
+  char **pzErr
+){
+  return bcvSessionBodyDecode(
+      eType,eState,zSessionId,aBody,nBody,pBody,pzErr
+  );
+}
+
+/* The CBS account argument is a signing credential for S3 and a bearer
+** project/token selector for Google-compatible storage. It is not a durable
+** object identity for session fencing. Derive the durable account component
+** from the provider selector: S3 and Google deliberately omit credentials,
+** Azure uses its stable storage-account name, and unknown modules fail closed
+** instead of allowing callers to invent a second publication fence. */
+static int bcvSessionStableAccount(
+  const char *zStorage,
+  const char *zAccount,
+  const char **pzStableAccount,
+  char **pzErr
+){
+  int nModule = 0;
+  if( pzStableAccount ) *pzStableAccount = 0;
+  if( zStorage==0 || zAccount==0 || pzStableAccount==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid storage identity");
+  }
+  while( zStorage[nModule] && zStorage[nModule]!='?' ) nModule++;
+  if( (nModule==2 && sqlite3_strnicmp(zStorage,"s3",2)==0)
+   || (nModule==6 && sqlite3_strnicmp(zStorage,"google",6)==0)
+  ){
+    *pzStableAccount = "";
+    return SQLITE_OK;
+  }
+  if( nModule==5 && sqlite3_strnicmp(zStorage,"azure",5)==0
+   && zAccount[0]!='\0'
+  ){
+    *pzStableAccount = zAccount;
+    return SQLITE_OK;
+  }
+  return bcvSessionError(
+      SQLITE_AUTH,pzErr,"session records require a recognized stable storage provider"
+  );
+}
+
+int sqlite3_bcvfs_session_scope_hash(
+  const char *zStorage,
+  const char *zAccount,
+  const char *zContainer,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  unsigned char aHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  static const unsigned char aTag[] = "BCV-SESSION-SCOPE-V1\0";
+  const char *zStableAccount = 0;
+  char *zCanonicalStorage = 0;
+  char *zCanonicalContainer = 0;
+  SHA256_CTX sha;
+  int rc = SQLITE_OK;
+  if( pzErr ) *pzErr = 0;
+  if( aHash==0 ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "scope hash output is required");
+  }
+  memset(aHash, 0, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  if( rc==SQLITE_OK ) rc = bcvSessionStableAccount(
+      zStorage,zAccount,&zStableAccount,pzErr
+  );
+  if( rc==SQLITE_OK ) rc = bcvSessionCanonicalStorage(
+      zStorage,&zCanonicalStorage,pzErr
+  );
+  if( rc==SQLITE_OK ) rc = bcvSessionCanonicalContainer(
+      zStorage,zContainer,&zCanonicalContainer,pzErr
+  );
+  SHA256_Init(&sha);
+  SHA256_Update(&sha, aTag, sizeof(aTag));
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zCanonicalStorage,1,"invalid storage scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zCanonicalContainer,1,"invalid container scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zStableAccount,0,"invalid stable account scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zPrincipal,1,"invalid principal scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zDatabase,1,"invalid database scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zOperations,1,"invalid operation scope",pzErr);
+  if( rc==SQLITE_OK ) SHA256_Final(aHash, &sha);
+  sqlite3_free(zCanonicalStorage);
+  sqlite3_free(zCanonicalContainer);
+  return rc;
+}
+
+int sqlite3_bcvfs_session_storage_scope_hash(
+  const char *zStorage,
+  const char *zAccount,
+  const char *zContainer,
+  unsigned char aHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  static const unsigned char aTag[] = "BCV-SESSION-STORAGE-V1\0";
+  const char *zStableAccount = 0;
+  char *zCanonicalStorage = 0;
+  char *zCanonicalContainer = 0;
+  SHA256_CTX sha;
+  int rc = SQLITE_OK;
+  if( pzErr ) *pzErr = 0;
+  if( aHash==0 ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "scope hash output is required");
+  }
+  memset(aHash, 0, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  if( rc==SQLITE_OK ) rc = bcvSessionStableAccount(
+      zStorage,zAccount,&zStableAccount,pzErr
+  );
+  if( rc==SQLITE_OK ) rc = bcvSessionCanonicalStorage(
+      zStorage,&zCanonicalStorage,pzErr
+  );
+  if( rc==SQLITE_OK ) rc = bcvSessionCanonicalContainer(
+      zStorage,zContainer,&zCanonicalContainer,pzErr
+  );
+  SHA256_Init(&sha);
+  SHA256_Update(&sha, aTag, sizeof(aTag));
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zCanonicalStorage,1,"invalid storage scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zCanonicalContainer,1,"invalid container scope",pzErr);
+  if( rc==SQLITE_OK ) rc = bcvSessionScopeField(&sha,zStableAccount,0,"invalid stable account scope",pzErr);
+  if( rc==SQLITE_OK ) SHA256_Final(aHash, &sha);
+  sqlite3_free(zCanonicalStorage);
+  sqlite3_free(zCanonicalContainer);
+  return rc;
+}
+
+static int bcvSessionValidRecordType(int eType){
+  return eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+      || eType==SQLITE_BCVFS_SESSION_HEAD
+      || eType==SQLITE_BCVFS_SESSION_PUBLICATION
+      || eType==SQLITE_BCVFS_SESSION_HISTORY;
+}
+
+static int bcvSessionValidState(int eState){
+  return eState>=SQLITE_BCVFS_SESSION_OPEN
+      && eState<=SQLITE_BCVFS_SESSION_EXPIRED;
+}
+
+static int bcvSessionValidOutcome(int eOutcome){
+  return eOutcome>=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+      && eOutcome<=SQLITE_BCVFS_SESSION_OUTCOME_CONFLICT;
+}
+
+/* A checkpoint is an immutable in-flight snapshot.  Session heads carry the
+** complete request lifecycle, while publication heads carry only the
+** publication lifecycle.  Keeping these combinations explicit prevents a
+** valid byte-level record from being interpreted as an impossible transition.
+*/
+static int bcvSessionValidTypeState(
+  int eType,
+  int eState,
+  int eOutcome
+){
+  if( !bcvSessionValidRecordType(eType)
+   || !bcvSessionValidState(eState)
+   || !bcvSessionValidOutcome(eOutcome)
+  ) return 0;
+  if( eType==SQLITE_BCVFS_SESSION_CHECKPOINT ){
+    return eState==SQLITE_BCVFS_SESSION_OPEN
+        && eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+  }
+  if( eType==SQLITE_BCVFS_SESSION_HISTORY ){
+    return eState==SQLITE_BCVFS_SESSION_ACCEPTED
+        && eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS;
+  }
+  if( eState==SQLITE_BCVFS_SESSION_COMMITTED ){
+    return eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS;
+  }
+  if( eState==SQLITE_BCVFS_SESSION_ABORTED ){
+    return eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_FAILURE
+        || eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_CONFLICT;
+  }
+  if( eState==SQLITE_BCVFS_SESSION_EXPIRED ){
+    return eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_FAILURE;
+  }
+  if( eState==SQLITE_BCVFS_SESSION_ACCEPTED ){
+    return eType==SQLITE_BCVFS_SESSION_HEAD
+        && (eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_NONE
+            || eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS);
+  }
+  return eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+}
+
+/* The operation token identifies the request whose retry/finalization state
+** is represented by a record. Checkpoints and accepted/publishing/committed
+** request-head states must carry it; a zero token would make two retries
+** indistinguishable during recovery. */
+static int bcvSessionRequiresOperationId(int eType, int eState){
+  return eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+      || eType==SQLITE_BCVFS_SESSION_HISTORY
+      || (eType==SQLITE_BCVFS_SESSION_HEAD
+          && (eState==SQLITE_BCVFS_SESSION_ACCEPTED
+              || eState==SQLITE_BCVFS_SESSION_PUBLISHING
+              || eState==SQLITE_BCVFS_SESSION_COMMITTED));
+}
+
+static int bcvSessionValidTime(sqlite3_int64 iCreated, sqlite3_int64 iExpires){
+  return iCreated>=0 && iExpires>iCreated
+      && iExpires-iCreated<=BCV_SESSION_TTL_MILLISECONDS;
+}
+
+int sqlite3_bcvfs_session_record_encode(
+  const sqlite3_bcvfs_session_record *pRecord,
+  unsigned char **paEncoded,
+  int *pnEncoded,
+  unsigned char aRecordHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  unsigned char aUuid[16];
+  unsigned char *aOut = 0;
+  unsigned char *aHash;
+  SHA256_CTX sha;
+  sqlite3_uint64 nTotal;
+  int nBody;
+  sqlite3_bcvfs_session_body body;
+  if( paEncoded ) *paEncoded = 0;
+  if( pnEncoded ) *pnEncoded = 0;
+  if( aRecordHash ) memset(aRecordHash, 0, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  if( pzErr ) *pzErr = 0;
+  if( pRecord==0 || paEncoded==0 || pnEncoded==0 || aRecordHash==0 ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "session record arguments are required");
+  }
+  if( !bcvSessionValidTypeState(
+          pRecord->eType,pRecord->eState,pRecord->eOutcome
+  ) ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "invalid session record type or state");
+  }
+  if( !bcvSessionUuidDecode(pRecord->zSessionId, aUuid) ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "session record requires a canonical UUID");
+  }
+  if( bcvSessionAllZero(aUuid,sizeof(aUuid)) ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "session record UUID is empty");
+  }
+  if( bcvSessionAllZero(pRecord->aScopeHash, SQLITE_BCVFS_SESSION_HASH_BYTES) ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "session record scope is empty");
+  }
+  if( bcvSessionRequiresOperationId(pRecord->eType,pRecord->eState)
+   && bcvSessionAllZero(pRecord->aOperationId,SQLITE_BCVFS_SESSION_HASH_BYTES)
+  ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "session record operation ID is empty");
+  }
+  if( !bcvSessionValidTime(pRecord->iCreated, pRecord->iExpires) ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "invalid session record expiration");
+  }
+  nBody = pRecord->nBody;
+  if( nBody<0 || (nBody>0 && pRecord->aBody==0) ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "invalid session record body");
+  }
+  nTotal = (sqlite3_uint64)BCV_SESSION_HEADER_BYTES
+         + (sqlite3_uint64)nBody
+         + (sqlite3_uint64)BCV_SESSION_TRAILER_BYTES;
+  if( nTotal>SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES || nTotal>0xFFFFFFFFu ){
+    return bcvSessionError(SQLITE_TOOBIG, pzErr, "session record exceeds size limit");
+  }
+  if( bcvSessionBodyDecode(
+          pRecord->eType,pRecord->eState,pRecord->zSessionId,
+          pRecord->aBody,nBody,&body,pzErr
+      )!=SQLITE_OK
+  ) return SQLITE_MISUSE;
+  aOut = (unsigned char*)sqlite3_malloc64(nTotal);
+  if( aOut==0 ) return bcvSessionError(SQLITE_NOMEM, pzErr, 0);
+  memset(aOut, 0, (size_t)nTotal);
+  memcpy(aOut, aBcvSessionMagic, BCV_SESSION_MAGIC_BYTES);
+  bcvSessionPutU16(&aOut[8], BCV_SESSION_VERSION);
+  aOut[10] = (unsigned char)pRecord->eType;
+  aOut[11] = (unsigned char)pRecord->eState;
+  aOut[12] = (unsigned char)pRecord->eOutcome;
+  aOut[13] = 0;
+  bcvSessionPutU16(&aOut[14], 0);
+  bcvPutU32(&aOut[16], BCV_SESSION_HEADER_BYTES);
+  bcvPutU32(&aOut[20], (u32)nTotal);
+  bcvPutU64(&aOut[24], (u64)pRecord->iSequence);
+  bcvPutU64(&aOut[32], (u64)pRecord->iCreated);
+  bcvPutU64(&aOut[40], (u64)pRecord->iExpires);
+  memcpy(&aOut[48], aUuid, sizeof(aUuid));
+  memcpy(&aOut[64], pRecord->aScopeHash, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memcpy(&aOut[96], pRecord->aPredecessorHash, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memcpy(&aOut[128], pRecord->aOperationId, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  bcvPutU32(&aOut[160], (u32)nBody);
+  bcvPutU32(&aOut[164], 0);
+  if( nBody ) memcpy(&aOut[BCV_SESSION_HEADER_BYTES], pRecord->aBody, nBody);
+  aHash = &aOut[BCV_SESSION_HEADER_BYTES+nBody];
+  SHA256_Init(&sha);
+  SHA256_Update(&sha, aOut, BCV_SESSION_HEADER_BYTES+nBody);
+  SHA256_Final(aHash, &sha);
+  memcpy(aRecordHash, aHash, SQLITE_BCVFS_SESSION_HASH_BYTES);
+  *paEncoded = aOut;
+  *pnEncoded = (int)nTotal;
+  return SQLITE_OK;
+}
+
+int sqlite3_bcvfs_session_record_decode(
+  const unsigned char *aEncoded,
+  int nEncoded,
+  const char *zExpectedSessionId,
+  const unsigned char *aExpectedScopeHash,
+  sqlite3_bcvfs_session_record *pRecord,
+  char **pzErr
+){
+  unsigned char aUuid[16];
+  unsigned char aExpectedUuid[16];
+  unsigned char aHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  SHA256_CTX sha;
+  u32 nHeader;
+  u32 nTotal;
+  u32 nBody;
+  u64 iCreated;
+  u64 iExpires;
+  sqlite3_bcvfs_session_body body;
+  if( pzErr ) *pzErr = 0;
+  if( pRecord ) memset(pRecord, 0, sizeof(*pRecord));
+  if( aEncoded==0 || pRecord==0 || nEncoded<BCV_SESSION_HEADER_BYTES+BCV_SESSION_TRAILER_BYTES ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "truncated session record");
+  }
+  if( nEncoded>SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES ){
+    return bcvSessionError(SQLITE_TOOBIG, pzErr, "session record exceeds size limit");
+  }
+  if( memcmp(aEncoded,aBcvSessionMagic,BCV_SESSION_MAGIC_BYTES)!=0
+   || bcvSessionGetU16(&aEncoded[8])!=BCV_SESSION_VERSION
+  ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "unknown session record format");
+  }
+  if( !bcvSessionValidTypeState(aEncoded[10],aEncoded[11],aEncoded[12])
+   || aEncoded[13]!=0
+   || bcvSessionGetU16(&aEncoded[14])!=0
+   || bcvGetU32(&aEncoded[16])!=BCV_SESSION_HEADER_BYTES
+  ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "invalid session record header");
+  }
+  nHeader = bcvGetU32(&aEncoded[16]);
+  nTotal = bcvGetU32(&aEncoded[20]);
+  nBody = bcvGetU32(&aEncoded[160]);
+  if( nHeader!=BCV_SESSION_HEADER_BYTES
+   || nTotal!=(u32)nEncoded
+   || nBody>(u32)nEncoded-BCV_SESSION_HEADER_BYTES-BCV_SESSION_TRAILER_BYTES
+   || nTotal!=BCV_SESSION_HEADER_BYTES+nBody+BCV_SESSION_TRAILER_BYTES
+   || bcvGetU32(&aEncoded[164])!=0
+  ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "invalid session record length");
+  }
+  SHA256_Init(&sha);
+  SHA256_Update(&sha, aEncoded, nEncoded-BCV_SESSION_TRAILER_BYTES);
+  SHA256_Final(aHash, &sha);
+  if( !bcvSessionEqual(aHash,&aEncoded[nEncoded-BCV_SESSION_TRAILER_BYTES],sizeof(aHash)) ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "session record integrity check failed");
+  }
+  memcpy(aUuid,&aEncoded[48],sizeof(aUuid));
+  if( bcvSessionAllZero(aUuid,sizeof(aUuid)) ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "session record UUID is empty");
+  }
+  if( bcvSessionRequiresOperationId(aEncoded[10],aEncoded[11])
+   && bcvSessionAllZero(&aEncoded[128],SQLITE_BCVFS_SESSION_HASH_BYTES)
+  ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "session record operation ID is empty");
+  }
+  if( zExpectedSessionId ){
+    if( !bcvSessionUuidDecode(zExpectedSessionId,aExpectedUuid)
+     || !bcvSessionEqual(aUuid,aExpectedUuid,sizeof(aUuid))
+    ){
+      return bcvSessionError(SQLITE_AUTH, pzErr, "session record UUID does not match the request");
+    }
+  }else if( aEncoded[10]!=SQLITE_BCVFS_SESSION_PUBLICATION
+         && aEncoded[10]!=SQLITE_BCVFS_SESSION_HISTORY
+  ){
+    return bcvSessionError(SQLITE_MISUSE, pzErr, "session UUID is required for this record");
+  }
+  if( aExpectedScopeHash==0
+   || bcvSessionAllZero(aExpectedScopeHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+   || !bcvSessionEqual(&aEncoded[64],aExpectedScopeHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+  ){
+    return bcvSessionError(SQLITE_AUTH, pzErr, "session record scope does not match the request");
+  }
+  iCreated = bcvGetU64(&aEncoded[32]);
+  iExpires = bcvGetU64(&aEncoded[40]);
+  if( iCreated>0x7FFFFFFFFFFFFFFFULL || iExpires>0x7FFFFFFFFFFFFFFFULL
+   || !bcvSessionValidTime((sqlite3_int64)iCreated,(sqlite3_int64)iExpires)
+  ){
+    return bcvSessionError(SQLITE_CORRUPT, pzErr, "invalid session record expiration");
+  }
+  pRecord->eType = aEncoded[10];
+  pRecord->eState = aEncoded[11];
+  pRecord->eOutcome = aEncoded[12];
+  pRecord->iSequence = bcvGetU64(&aEncoded[24]);
+  pRecord->iCreated = (sqlite3_int64)iCreated;
+  pRecord->iExpires = (sqlite3_int64)iExpires;
+  bcvSessionUuidEncode(aUuid,pRecord->zSessionId);
+  memcpy(pRecord->aScopeHash,&aEncoded[64],SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memcpy(pRecord->aPredecessorHash,&aEncoded[96],SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memcpy(pRecord->aOperationId,&aEncoded[128],SQLITE_BCVFS_SESSION_HASH_BYTES);
+  pRecord->aBody = &aEncoded[BCV_SESSION_HEADER_BYTES];
+  pRecord->nBody = (int)nBody;
+  memcpy(pRecord->aRecordHash,aHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  if( bcvSessionBodyDecode(
+          pRecord->eType,pRecord->eState,pRecord->zSessionId,
+          pRecord->aBody,pRecord->nBody,&body,pzErr
+      )!=SQLITE_OK
+  ){
+    memset(pRecord,0,sizeof(*pRecord));
+    return SQLITE_CORRUPT;
+  }
+  return SQLITE_OK;
+}
+
+int sqlite3_bcvfs_session_record_is_expired(
+  const sqlite3_bcvfs_session_record *pRecord,
+  sqlite3_int64 iNow
+){
+  return pRecord==0 || iNow>=pRecord->iExpires;
+}
+
+int sqlite3_bcvfs_session_object_name(
+  int eType,
+  const char *zSessionId,
+  const unsigned char *aObjectId,
+  char *zOut,
+  int nOut,
+  char **pzErr
+){
+  unsigned char aUuid[16];
+  char zUuid[SQLITE_BCVFS_SESSION_ID_TEXT_BYTES];
+  char zHash[SQLITE_BCVFS_SESSION_HASH_BYTES*2+1];
+  char *zName = 0;
+  if( pzErr ) *pzErr = 0;
+  if( zOut==0 || nOut<=0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session object output is required");
+  }
+  zOut[0] = '\0';
+  if( !bcvSessionValidRecordType(eType) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"invalid session object type");
+  }
+  if( (eType==SQLITE_BCVFS_SESSION_HEAD
+       || eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+       || eType==SQLITE_BCVFS_SESSION_HISTORY)
+   && !bcvSessionUuidDecode(zSessionId,aUuid)
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session object requires a canonical UUID");
+  }
+  if( eType==SQLITE_BCVFS_SESSION_PUBLICATION && zSessionId
+   && !bcvSessionUuidDecode(zSessionId,aUuid)
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"publication owner requires a canonical UUID");
+  }
+  if( eType==SQLITE_BCVFS_SESSION_HEAD ){
+    if( aObjectId ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"session head has no object hash");
+    }
+    bcvSessionUuidEncode(aUuid,zUuid);
+    zName = sqlite3_mprintf(BCV_SESSION_ROOT "head/%s.bcv", zUuid);
+  }else{
+    if( aObjectId==0 || bcvSessionAllZero(aObjectId,SQLITE_BCVFS_SESSION_HASH_BYTES) ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"session object hash is required");
+    }
+    hex_encode(aObjectId,SQLITE_BCVFS_SESSION_HASH_BYTES,zHash,0);
+    if( eType==SQLITE_BCVFS_SESSION_CHECKPOINT ){
+      bcvSessionUuidEncode(aUuid,zUuid);
+      zName = sqlite3_mprintf(BCV_SESSION_ROOT "checkpoint/%s/%s.bcv",zUuid,zHash);
+    }else if( eType==SQLITE_BCVFS_SESSION_HISTORY ){
+      bcvSessionUuidEncode(aUuid,zUuid);
+      zName = sqlite3_mprintf(BCV_SESSION_ROOT "history/%s/%s.bcv",zUuid,zHash);
+    }else{
+      zName = sqlite3_mprintf(BCV_SESSION_ROOT "publication/%s.bcv",zHash);
+    }
+  }
+  if( zName==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+  if( (int)strlen(zName)>=nOut ){
+    sqlite3_free(zName);
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"session object name buffer is too small");
+  }
+  memcpy(zOut,zName,strlen(zName)+1);
+  sqlite3_free(zName);
+  return SQLITE_OK;
+}
+
+typedef struct BcvSessionFetchCtx BcvSessionFetchCtx;
+struct BcvSessionFetchCtx {
+  int rc;
+  unsigned char *aData;
+  int nData;
+  char *zETag;
+  char *zErr;
+};
+
+static void bcvSessionFetchCb(
+  void *pArg,
+  int rc,
+  char *zETag,
+  const u8 *aData,
+  int nData,
+  const u8 *aHdrs,
+  int nHdrs
+){
+  BcvSessionFetchCtx *p = (BcvSessionFetchCtx*)pArg;
+  (void)aHdrs;
+  (void)nHdrs;
+  p->rc = rc;
+  if( rc==SQLITE_OK ){
+    if( nData<0 || nData>SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES ){
+      p->rc = nData<0 ? SQLITE_CORRUPT : SQLITE_TOOBIG;
+      p->zErr = sqlite3_mprintf("invalid session object size");
+    }else if( aData==0 && nData>0 ){
+      p->rc = SQLITE_CORRUPT;
+      p->zErr = sqlite3_mprintf("session object has no body bytes");
+    }else if( zETag==0 || zETag[0]=='\0' ){
+      p->rc = SQLITE_CORRUPT;
+      p->zErr = sqlite3_mprintf("session object has no opaque ETag");
+    }else if( strlen(zETag)>BCV_SESSION_MAX_ETAG_BYTES ){
+      p->rc = SQLITE_TOOBIG;
+      p->zErr = sqlite3_mprintf("session object ETag is too long");
+    }else{
+      p->aData = (unsigned char*)sqlite3_malloc64((sqlite3_uint64)nData+1);
+      p->zETag = sqlite3_mprintf("%s",zETag);
+      if( p->aData==0 || p->zETag==0 ){
+        p->rc = SQLITE_NOMEM;
+      }else{
+        if( nData ) memcpy(p->aData,aData,nData);
+        p->aData[nData] = 0;
+        p->nData = nData;
+      }
+    }
+  }else if( zETag ){
+    p->zErr = sqlite3_mprintf("%s",zETag);
+  }
+}
+
+typedef struct BcvSessionPutCtx BcvSessionPutCtx;
+struct BcvSessionPutCtx {
+  int rc;
+  char *zETag;
+  char *zErr;
+};
+
+static void bcvSessionPutCb(void *pArg, int rc, char *zETag){
+  BcvSessionPutCtx *p = (BcvSessionPutCtx*)pArg;
+  if( rc==HTTP_BUSY_SNAPSHOT ) rc = SQLITE_BUSY;
+  p->rc = rc;
+  if( rc==SQLITE_OK ){
+    if( zETag==0 || zETag[0]=='\0' ){
+      p->rc = SQLITE_CORRUPT;
+      p->zErr = sqlite3_mprintf("session object PUT returned no opaque ETag");
+    }else if( strlen(zETag)>BCV_SESSION_MAX_ETAG_BYTES ){
+      p->rc = SQLITE_TOOBIG;
+      p->zErr = sqlite3_mprintf("session object PUT ETag is too long");
+    }else{
+      p->zETag = sqlite3_mprintf("%s",zETag);
+      if( p->zETag==0 ) p->rc = SQLITE_NOMEM;
+    }
+  }else if( zETag ){
+    p->zErr = sqlite3_mprintf("%s",zETag);
+  }
+}
+
+static int bcvSessionConditionValid(const char *zIfMatch, char **pzErr){
+  size_t n;
+  size_t ii;
+  if( zIfMatch==0 || zIfMatch[0]=='\0' ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session record PUT requires an ETag condition");
+  }
+  n = strlen(zIfMatch);
+  if( n>BCV_SESSION_MAX_ETAG_BYTES ){
+    return bcvSessionError(SQLITE_TOOBIG,pzErr,"session ETag condition is too long");
+  }
+  for(ii=0; ii<n; ii++){
+    unsigned char c = (unsigned char)zIfMatch[ii];
+    if( c<0x20 || c==0x7F ){
+      return bcvSessionError(SQLITE_MISUSE,pzErr,"session ETag condition contains a control byte");
+    }
+  }
+  return SQLITE_OK;
+}
+
+static int bcvSessionAcquire(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  Container **ppCont,
+  BcvDispatch **ppDisp,
+  BcvContainer **ppBcv,
+  char **pzErr
+){
+  int rc = SQLITE_OK;
+  Container *pCont = 0;
+  if( ppCont ) *ppCont = 0;
+  if( ppDisp ) *ppDisp = 0;
+  if( ppBcv ) *ppBcv = 0;
+  if( pFs==0 || zAlias==0 || zAlias[0]=='\0' ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session storage arguments are required");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session records are unavailable through the CBS daemon");
+  }
+  ENTER_VFS_MUTEX; {
+    pCont = bcvfsFindContAlias(&pFs->c,zAlias,pzErr);
+    if( pCont==0 ){
+      rc = SQLITE_ERROR;
+    }else if( pCont->zSessionId==0 ){
+      rc = SQLITE_AUTH;
+      if( pzErr ) *pzErr = sqlite3_mprintf("container is not session-bound: %s",zAlias);
+    }else if( pCont->nSessionRef<=0 ){
+      rc = SQLITE_AUTH;
+      if( pzErr ) *pzErr = sqlite3_mprintf("session attachment has no live owner: %s",zAlias);
+    }else if( zSessionId && strcmp(pCont->zSessionId,zSessionId)!=0 ){
+      rc = SQLITE_AUTH;
+      if( pzErr ) *pzErr = sqlite3_mprintf("session does not own container alias: %s",zAlias);
+    }else{
+      /* Keep the container alive while the caller is outside the VFS mutex
+      ** performing network I/O. Session detach marks nSessionRef negative and
+      ** may otherwise free an idle container when nClient is zero. */
+      pCont->nClient++;
+      rc = bcvfsContainerGetBcv(pFs,pCont,ppDisp,ppBcv,pzErr);
+      if( rc!=SQLITE_OK ) pCont->nClient--;
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc==SQLITE_OK && ppCont ) *ppCont = pCont;
+  return rc;
+}
+
+static void bcvSessionRelease(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  BcvDispatch *pDisp,
+  BcvContainer *pBcv,
+  int bError
+){
+  ENTER_VFS_MUTEX; {
+    bcvfsContainerReleaseBcv(pFs,pCont,pDisp,pBcv,bError);
+    if( pCont ){
+      assert( pCont->nClient>0 );
+      pCont->nClient--;
+    }
+  } LEAVE_VFS_MUTEX;
+}
+
+/* Derive the record scope only after resolving the session-owned alias.  A
+** caller cannot substitute another provider/account/container while keeping
+** the same alias.  The principal, database and operation strings are still
+** supplied by the authorized application context and are length/control-byte
+** checked by the scope hash helper.  Publication heads intentionally use the
+** narrower per-container binding, but still require those context fields to
+** be present and valid at the API boundary. */
+static int bcvSessionBoundScope(
+  Container *pCont,
+  int eType,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzErr
+){
+  unsigned char aFullScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc;
+  if( zPrincipal==0 || zDatabase==0 || zOperations==0 ){
+    return bcvSessionError(
+        SQLITE_MISUSE,pzErr,"session request context arguments are required"
+    );
+  }
+  if( pCont->bSessionContext
+   && (pCont->zSessionPrincipal==0
+       || pCont->zSessionDatabase==0
+       || pCont->zSessionOperations==0
+       || strcmp(pCont->zSessionPrincipal,zPrincipal)!=0
+       || strcmp(pCont->zSessionDatabase,zDatabase)!=0
+       || strcmp(pCont->zSessionOperations,zOperations)!=0)
+  ){
+    return bcvSessionError(
+        SQLITE_AUTH,pzErr,"session request context does not match its binding"
+    );
+  }
+  rc = sqlite3_bcvfs_session_scope_hash(
+      pCont->zStorage,pCont->zAccount,pCont->zContainer,
+      zPrincipal,zDatabase,zOperations,aFullScope,pzErr
+  );
+  if( rc==SQLITE_OK && eType==SQLITE_BCVFS_SESSION_PUBLICATION ){
+    rc = sqlite3_bcvfs_session_storage_scope_hash(
+        pCont->zStorage,pCont->zAccount,pCont->zContainer,aScope,pzErr
+    );
+  }else if( rc==SQLITE_OK ){
+    memcpy(aScope,aFullScope,sizeof(aFullScope));
+  }
+  return rc;
+}
+
+int sqlite3_bcvfs_session_fetch(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  int eType,
+  const char *zSessionId,
+  const unsigned char *aObjectId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  unsigned char **paData,
+  int *pnData,
+  char **pzETag,
+  char **pzErr
+){
+  char zName[256];
+  BcvSessionFetchCtx ctx;
+  sqlite3_bcvfs_session_record record;
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc;
+  if( paData ) *paData = 0;
+  if( pnData ) *pnData = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( paData==0 || pnData==0 || pzETag==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session fetch outputs are required");
+  }
+  if( eType!=SQLITE_BCVFS_SESSION_PUBLICATION && zSessionId==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session fetch UUID is required");
+  }
+  rc = sqlite3_bcvfs_session_object_name(eType,zSessionId,aObjectId,zName,sizeof(zName),pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionAcquire(pFs,zAlias,zSessionId,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionBoundScope(
+      pCont,eType,zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ){
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  memset(&ctx,0,sizeof(ctx));
+  rc = bcvDispatchFetchMax(
+      pDisp,pBcv,zName,0,0,SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES,64*1024,
+      &ctx,bcvSessionFetchCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  if( rc==SQLITE_OK ){
+    rc = sqlite3_bcvfs_session_record_decode(
+        ctx.aData,ctx.nData,zSessionId,aScope,&record,pzErr
+    );
+    if( rc==SQLITE_OK && record.eType!=eType ){
+      rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"session object type does not match its key");
+    }
+    if( rc==SQLITE_OK && eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+     && !bcvSessionEqual(record.aRecordHash,aObjectId,SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ){
+      rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"checkpoint key does not match record hash");
+    }
+    if( rc==SQLITE_OK && eType==SQLITE_BCVFS_SESSION_HISTORY
+     && !bcvSessionEqual(record.aRecordHash,aObjectId,SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ){
+      rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"history key does not match record hash");
+    }
+    if( rc==SQLITE_OK && eType==SQLITE_BCVFS_SESSION_PUBLICATION
+     && !bcvSessionEqual(aObjectId,aScope,SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"publication key does not match scope");
+    }
+  }
+  if( rc==SQLITE_OK ){
+    *paData = ctx.aData;
+    *pnData = ctx.nData;
+    *pzETag = ctx.zETag;
+    ctx.aData = 0;
+    ctx.zETag = 0;
+  }else if( pzErr && *pzErr==0 && ctx.zErr ){
+    *pzErr = ctx.zErr;
+    ctx.zErr = 0;
+  }
+  sqlite3_free(ctx.aData);
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
+
+/* Resolve the accepted tip before binding a request context.  The proxy does
+** not supply an expected tip: the native VFS reads the session head using the
+** already-attached storage identity.  A missing head is the only case that
+** selects the zero initial predecessor.  ACCEPTED, PUBLISHING, and COMMITTED
+** heads all retain their checkpoint predecessor so publication recovery can
+** resume; transport failures, malformed heads and scope mismatches never fall
+** back to zero. */
+static int bcvfsSessionAcceptedTip(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  unsigned char aPredecessor[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  sqlite3_uint64 *piSequence,
+  unsigned char aHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzPredecessorETag,
+  char **pzErr
+){
+  unsigned char *aData = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_bcvfs_session_record record;
+  sqlite3_bcvfs_session_body body;
+  char *zETag = 0;
+  Container *pCont = 0;
+  int nData = 0;
+  int rc;
+  if( pzErr ) *pzErr = 0;
+  memset(aPredecessor,0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memset(aHeadHash,0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  *piSequence = 0;
+  if( pzPredecessorETag ) *pzPredecessorETag = 0;
+  rc = sqlite3_bcvfs_session_fetch(
+      pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+      zPrincipal,zDatabase,zOperations,&aData,&nData,&zETag,pzErr
+  );
+  if( rc==HTTP_NOT_FOUND ){
+    sqlite3_free(aData);
+    sqlite3_free(zETag);
+    if( pzErr ){
+      sqlite3_free(*pzErr);
+      *pzErr = 0;
+    }
+    return SQLITE_OK;
+  }
+  if( rc!=SQLITE_OK ) goto session_tip_done;
+
+  /* session_fetch already checks the record scope, but record_decode is
+  ** needed here to expose the sequence and typed head body. */
+  ENTER_VFS_MUTEX; {
+    pCont = bcvfsFindContAlias(&pFs->c,zAlias,0);
+    if( pCont==0 ){
+      rc = bcvSessionError(SQLITE_ERROR,pzErr,"session alias disappeared while reading its head");
+    }else{
+      rc = bcvSessionBoundScope(
+          pCont,SQLITE_BCVFS_SESSION_HEAD,zPrincipal,zDatabase,zOperations,
+          aScope,pzErr
+      );
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_record_decode(
+      aData,nData,zSessionId,aScope,&record,pzErr
+  );
+  if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_body_decode(
+      record.eType,record.eState,record.zSessionId,
+      record.aBody,record.nBody,&body,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    if( (record.eState!=SQLITE_BCVFS_SESSION_ACCEPTED
+         && record.eState!=SQLITE_BCVFS_SESSION_PUBLISHING
+         && record.eState!=SQLITE_BCVFS_SESSION_COMMITTED)
+     || (record.eState==SQLITE_BCVFS_SESSION_PUBLISHING
+         ? record.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+         : record.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS)
+    ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,"session head is not an accepted predecessor"
+      );
+    }else if( record.iSequence==0
+     && !bcvSessionAllZero(body.aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES)
+    ){
+      rc = bcvSessionError(
+          SQLITE_CORRUPT,pzErr,"session head has a checkpoint but no sequence"
+      );
+    }else{
+      memcpy(aPredecessor,body.aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+      memcpy(aHeadHash,record.aRecordHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+      *piSequence = record.iSequence;
+      if( pzPredecessorETag ){
+        *pzPredecessorETag = zETag;
+        zETag = 0;
+      }
+    }
+  }
+
+session_tip_done:
+  sqlite3_free(aData);
+  sqlite3_free(zETag);
+  return rc;
+}
+/*
+** Session-bound checkpoints
+**
+** xSync is a remote durability boundary for bytes in a session, but it is
+** deliberately not a publication boundary. Each checkpoint is an immutable
+** content-addressed record. The accepted head and manifest remain unchanged
+** until the application calls its explicit upload/finalize operation.
+*/
+
+static int bcvfsSessionContextStringsEqual(
+  Container *pCont,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations
+){
+  return pCont->bSessionContext
+      && 0==strcmp(pCont->zSessionPrincipal,zPrincipal)
+      && 0==strcmp(pCont->zSessionDatabase,zDatabase)
+      && 0==strcmp(pCont->zSessionOperations,zOperations);
+}
+
+static void bcvfsSessionContextClear(Container *pCont){
+  pCont->iSessionWriteFileSize = 0;
+  pCont->bSessionWriteFileSizeValid = 0;
+  pCont->bSessionOverlay = 0;
+  pCont->bSessionRehydrate = 0;
+  sqlite3_free(pCont->zSessionPrincipal);
+  sqlite3_free(pCont->zSessionDatabase);
+  sqlite3_free(pCont->zSessionOperations);
+  sqlite3_free(pCont->zSessionPredecessorETag);
+  pCont->zSessionPrincipal = 0;
+  pCont->zSessionDatabase = 0;
+  pCont->zSessionOperations = 0;
+  pCont->zSessionPredecessorETag = 0;
+  memset(pCont->aSessionPredecessorHash,0,sizeof(pCont->aSessionPredecessorHash));
+  memset(pCont->aSessionOperationId,0,sizeof(pCont->aSessionOperationId));
+  memset(pCont->aSessionExpectedCheckpointHash,0,sizeof(pCont->aSessionExpectedCheckpointHash));
+  memset(pCont->aSessionExpectedHeadHash,0,sizeof(pCont->aSessionExpectedHeadHash));
+  pCont->iSessionSequence = 0;
+  pCont->iSessionExpectedSequence = 0;
+  pCont->bSessionPredecessorPresent = 0;
+  pCont->bSessionContext = 0;
+}
+
+static int bcvfsSessionContextValidate(
+  Container *pCont,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  char **pzErr
+){
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc = sqlite3_bcvfs_session_scope_hash(
+      pCont->zStorage,pCont->zAccount,pCont->zContainer,
+      zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc==SQLITE_OK && bcvfsFindDatabase(pCont->pMan,zDatabase,-1)==0 ){
+    rc = bcvSessionError(SQLITE_AUTH,pzErr,"session database is not attached");
+  }
+  return rc;
+}
+
+static int bcvfsSessionBind(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const unsigned char *aOperationIdArg,
+  const unsigned char *aPredecessorHash,
+  sqlite3_uint64 iSequence,
+  char **pzErr
+){
+  Container *pCont = 0;
+  char *zPrincipalCopy = 0;
+  char *zDatabaseCopy = 0;
+  char *zOperationsCopy = 0;
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aPredecessor[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc = SQLITE_OK;
+  if( pzErr ) *pzErr = 0;
+  memset(aPredecessor,0,sizeof(aPredecessor));
+  if( aPredecessorHash ) memcpy(aPredecessor,aPredecessorHash,sizeof(aPredecessor));
+  if( pFs==0 || zAlias==0 || zSessionId==0
+   || zPrincipal==0 || zDatabase==0 || zOperations==0
+  ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session context arguments are required");
+  }
+  if( !bcvfsValidSessionId(zSessionId) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session ID must be a canonical non-nil UUID");
+  }
+  if( aOperationIdArg==0 || bcvSessionAllZero(aOperationIdArg,sizeof(aOperationId)) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session operation ID is required");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session context is unavailable through the CBS daemon");
+  }
+  memcpy(aOperationId,aOperationIdArg,sizeof(aOperationId));
+  ENTER_VFS_MUTEX; {
+    pCont = bcvfsFindContAlias(&pFs->c,zAlias,pzErr);
+    if( pCont==0 ){
+      rc = SQLITE_ERROR;
+    }else if( pCont->zSessionId==0
+           || strcmp(pCont->zSessionId,zSessionId)!=0
+           || pCont->nSessionRef<=0
+    ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session context does not own container alias");
+    }else if( pCont->eState!=CONTAINER_STATE_NONE ){
+      rc = bcvSessionError(SQLITE_BUSY,pzErr,"session context is busy");
+    }else{
+      rc = bcvfsSessionContextValidate(
+          pCont,zPrincipal,zDatabase,zOperations,pzErr
+      );
+      if( rc==SQLITE_OK && pCont->bSessionContext ){
+        if( !bcvfsSessionContextStringsEqual(
+                pCont,zPrincipal,zDatabase,zOperations
+            )
+         || memcmp(pCont->aSessionPredecessorHash,aPredecessor,sizeof(aPredecessor))!=0
+         || pCont->iSessionSequence!=iSequence
+         || memcmp(pCont->aSessionOperationId,aOperationId,sizeof(aOperationId))!=0
+        ){
+          rc = bcvSessionError(SQLITE_AUTH,pzErr,"session context is already bound");
+        }
+      }
+      if( rc==SQLITE_OK && !pCont->bSessionContext ){
+        zPrincipalCopy = sqlite3_mprintf("%s",zPrincipal);
+        zDatabaseCopy = sqlite3_mprintf("%s",zDatabase);
+        zOperationsCopy = sqlite3_mprintf("%s",zOperations);
+        if( zPrincipalCopy==0 || zDatabaseCopy==0 || zOperationsCopy==0 ){
+          rc = bcvSessionError(SQLITE_NOMEM,pzErr,0);
+        }
+      }
+      if( rc==SQLITE_OK && !pCont->bSessionContext ){
+        pCont->zSessionPrincipal = zPrincipalCopy;
+        pCont->zSessionDatabase = zDatabaseCopy;
+        pCont->zSessionOperations = zOperationsCopy;
+        zPrincipalCopy = zDatabaseCopy = zOperationsCopy = 0;
+        memcpy(pCont->aSessionPredecessorHash,aPredecessor,sizeof(aPredecessor));
+        memcpy(pCont->aSessionOperationId,aOperationId,sizeof(aOperationId));
+        pCont->iSessionSequence = iSequence;
+        pCont->bSessionContext = 1;
+      }
+    }
+  } LEAVE_VFS_MUTEX;
+  sqlite3_free(zPrincipalCopy);
+  sqlite3_free(zDatabaseCopy);
+  sqlite3_free(zOperationsCopy);
+  return rc;
+}
+
+int sqlite3_bcvfs_attach_session_scoped(
+  sqlite3_bcvfs *pFs,
+  const char *zStorage,
+  const char *zAccount,
+  const char *zContainer,
+  const char *zAlias,
+  const char *zSessionId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const unsigned char *aOperationId,
+  int flags,
+  char **pzErr
+){
+  unsigned char aPredecessor[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aExpectedHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_uint64 iSequence = 0;
+  char *zPredecessorETag = 0;
+  char *zBindErr = 0;
+  memset(aPredecessor,0,sizeof(aPredecessor));
+  int rc = sqlite3_bcvfs_attach_session(
+      pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,flags,pzErr
+  );
+  if( rc==SQLITE_OK ){
+    /* A detached owner may be reused by the next server invocation. Its
+    ** previous binding is not an authority for the new request predecessor. */
+    ENTER_VFS_MUTEX; {
+      Container *pCont = bcvfsFindContAlias(&pFs->c,zAlias,0);
+      if( pCont && (pCont->nClient>0 || pCont->bSessionRehydrate) ){
+        rc = bcvSessionError(
+            SQLITE_BUSY,&zBindErr,
+            "session alias is busy with an active request"
+        );
+      }else if( pCont ){
+        /* Rehydration below replaces all unaccepted local generations. A
+        ** detached cache is scratch, never an implicit accepted predecessor.
+        ** Durable pending_publish is retained for upload reconciliation. */
+        bcvfsSessionContextClear(pCont);
+      }
+    } LEAVE_VFS_MUTEX;
+    if( rc==SQLITE_OK ) rc = bcvfsSessionAcceptedTip(
+        pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,
+        aPredecessor,&iSequence,aExpectedHeadHash,&zPredecessorETag,&zBindErr
+    );
+    if( rc==SQLITE_OK ) rc = bcvfsSessionBind(
+        pFs,zAlias,zSessionId,zPrincipal,zDatabase,zOperations,aOperationId,
+        aPredecessor,iSequence,&zBindErr
+    );
+    if( rc==SQLITE_OK ){
+      ENTER_VFS_MUTEX; {
+        Container *pCont = bcvfsFindContAlias(&pFs->c,zAlias,0);
+        if( pCont==0 ){
+          rc = bcvSessionError(
+              SQLITE_ERROR,&zBindErr,"session alias disappeared before predecessor binding"
+          );
+        }else{
+          memcpy(pCont->aSessionExpectedCheckpointHash,aPredecessor,
+              sizeof(aPredecessor));
+          memcpy(pCont->aSessionExpectedHeadHash,aExpectedHeadHash,
+              sizeof(aExpectedHeadHash));
+          pCont->iSessionExpectedSequence = iSequence;
+          pCont->zSessionPredecessorETag = zPredecessorETag;
+          zPredecessorETag = 0;
+          pCont->bSessionPredecessorPresent =
+              pCont->zSessionPredecessorETag!=0;
+        }
+      } LEAVE_VFS_MUTEX;
+    }
+    if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_rehydrate(
+        pFs,zAlias,zSessionId,&zBindErr
+    );
+    if( rc!=SQLITE_OK ){
+      char *zCleanupErr = 0;
+      (void)sqlite3_bcvfs_detach_session(pFs,zAlias,zSessionId,&zCleanupErr);
+      sqlite3_free(zCleanupErr);
+      if( pzErr && *pzErr==0 ){
+        *pzErr = zBindErr;
+        zBindErr = 0;
+      }
+    }
+  }
+  sqlite3_free(zPredecessorETag);
+  sqlite3_free(zBindErr);
+  return rc;
+}
+
+/* Must be called with the VFS mutex held. */
+static void bcvfsSessionDirtyState(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  int *pbDirty,
+  int *pbBlocked
+){
+  int ii;
+  *pbDirty = 0;
+  *pbBlocked = 0;
+  for(ii=0; ii<pFs->c.nHash; ii++){
+    CacheEntry *pEntry;
+    for(pEntry=pFs->c.aHash[ii]; pEntry; pEntry=pEntry->pHashNext){
+      if( pEntry->pCont==pCont && pEntry->bDirty ){
+        *pbDirty = 1;
+        if( pEntry->nRef!=0 || pEntry->bStaging ) *pbBlocked = 1;
+      }
+    }
+  }
+}
+
+static int bcvfsSessionVerifyMappings(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  Manifest *pMan,
+  char **pzErr
+){
+  int iDb;
+  int nName = NAMEBYTES(pMan);
+  for(iDb=0; iDb<pMan->nDb; iDb++){
+    ManifestDb *pDb = &pMan->aDb[iDb];
+    ManifestDb *pBase = bcvfsFindDatabaseById(pCont->pMan,pDb->iDbId);
+    int iBlk;
+    if( pBase==0 && pDb->nBlkLocal==0 ) continue;
+    for(iBlk=0; iBlk<pDb->nBlkLocal; iBlk++){
+      int bChanged = pBase==0 || iBlk>=pBase->nBlkOrig
+          || pBase->aBlkOrig==0
+          || memcmp(
+              &pDb->aBlkLocal[iBlk*nName],&pBase->aBlkOrig[iBlk*nName],nName
+          )!=0;
+      if( bChanged ){
+        int rc = bcvfsStagedFind(
+            &pFs->c,pCont->zName,pDb->iDbId,iBlk,
+            &pDb->aBlkLocal[iBlk*nName],nName,0,0
+        );
+        if( rc!=SQLITE_OK ){
+          return bcvSessionError(
+              rc==SQLITE_NOTFOUND ? SQLITE_IOERR : rc,pzErr,
+              "checkpoint mapping has no verified staged object"
+          );
+        }
+      }
+    }
+  }
+  return SQLITE_OK;
+}
+
+/* bcvManifestCompose serializes aBlkOrig, not aBlkLocal. Make a private flat
+** copy with every current mapping promoted into aBlkOrig and parent links
+** removed before composing. */
+static int bcvfsSessionComposeBody(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  sqlite3_int64 iFileSize,
+  unsigned char **paBody,
+  int *pnBody,
+  char **pzErr
+){
+  Manifest *pMan = 0;
+  unsigned char *aManifest = 0;
+  unsigned char *aBody = 0;
+  int nManifest = 0;
+  int nETag = 0;
+  int bCompacted = 0;
+  sqlite3_uint64 nBody64;
+  int iDb;
+  int rc;
+  *paBody = 0;
+  *pnBody = 0;
+  bCompacted = pCont->iSessionExpectedSequence
+      >= (sqlite3_uint64)BCV_SESSION_COMPACTION_THRESHOLD
+      && pCont->iSessionSequence==pCont->iSessionExpectedSequence;
+  if( bCompacted && bcvSessionAllZero(
+      pCont->aSessionExpectedCheckpointHash,
+      SQLITE_BCVFS_SESSION_HASH_BYTES
+  ) ){
+    return bcvSessionError(
+        SQLITE_CORRUPT,pzErr,"compacted checkpoint has no accepted predecessor"
+    );
+  }
+  rc = bcvManifestDup(pCont->pMan,&pMan);
+  if( rc!=SQLITE_OK ) return bcvSessionError(rc,pzErr,"could not duplicate session manifest");
+  for(iDb=0; rc==SQLITE_OK && iDb<pMan->nDb; iDb++){
+    ManifestDb *pSrc = &pCont->pMan->aDb[iDb];
+    ManifestDb *pDst = &pMan->aDb[iDb];
+    sqlite3_uint64 nBytes;
+    u8 *aCurrent = 0;
+    if( pSrc->nBlkLocal<0 ){
+      rc = SQLITE_CORRUPT;
+      break;
+    }
+    nBytes = (sqlite3_uint64)pSrc->nBlkLocal * NAMEBYTES(pMan);
+    if( nBytes>0x7fffffffULL ){
+      rc = SQLITE_TOOBIG;
+      break;
+    }
+    if( nBytes>0 ){
+      if( pSrc->aBlkLocal==0 ){
+        rc = SQLITE_CORRUPT;
+        break;
+      }
+      aCurrent = (u8*)sqlite3_malloc64(nBytes);
+      if( aCurrent==0 ){
+        rc = SQLITE_NOMEM;
+        break;
+      }
+      memcpy(aCurrent,pSrc->aBlkLocal,(size_t)nBytes);
+    }
+    if( pDst->nBlkOrigAlloc ) sqlite3_free(pDst->aBlkOrig);
+    if( pDst->nBlkLocalAlloc ) sqlite3_free(pDst->aBlkLocal);
+    pDst->aBlkOrig = aCurrent;
+    pDst->nBlkOrig = pSrc->nBlkLocal;
+    pDst->nBlkOrigAlloc = pSrc->nBlkLocal;
+    pDst->aBlkLocal = aCurrent;
+    pDst->nBlkLocal = pSrc->nBlkLocal;
+    pDst->nBlkLocalAlloc = 0;
+    pDst->iParentId = 0;
+    if( pCont->zSessionDatabase
+     && 0==strcmp(pDst->zDName,pCont->zSessionDatabase)
+    ){
+      pDst->iFileSize = iFileSize;
+    }
+  }
+  if( rc==SQLITE_OK ) rc = bcvfsSessionVerifyMappings(pFs,pCont,pMan,pzErr);
+  if( rc==SQLITE_OK ){
+    aManifest = bcvManifestCompose(pMan,&nManifest);
+    if( aManifest==0 ) rc = SQLITE_NOMEM;
+  }
+  if( rc==SQLITE_OK ){
+    size_t n = pMan->zETag ? strlen(pMan->zETag) : 0;
+    if( n==0 ){
+      rc = bcvSessionError(SQLITE_IOERR,pzErr,"checkpoint requires a base manifest ETag");
+    }else if( n>BCV_SESSION_MAX_ETAG_BYTES ){
+      rc = bcvSessionError(SQLITE_TOOBIG,pzErr,"base manifest ETag is too long");
+    }else{
+      nETag = (int)n;
+    }
+  }
+  if( rc==SQLITE_OK ){
+    nBody64 = 24 + (sqlite3_uint64)nETag + (sqlite3_uint64)nManifest
+        + (bCompacted ? SQLITE_BCVFS_SESSION_COMPACTED_BODY_BYTES : 0);
+    if( nBody64>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES || nBody64>0x7fffffffULL ){
+      rc = bcvSessionError(SQLITE_TOOBIG,pzErr,"session checkpoint exceeds record limit");
+    }
+  }
+  if( rc==SQLITE_OK ){
+    aBody = (unsigned char*)sqlite3_malloc64(nBody64);
+    if( aBody==0 ) rc = SQLITE_NOMEM;
+  }
+  if( rc==SQLITE_OK ){
+    memset(aBody,0,(size_t)nBody64);
+    memcpy(aBody,bCompacted
+        ? aBcvSessionCompactedCheckpointBodyMagic
+        : aBcvSessionCheckpointBodyMagic,8);
+    bcvPutU64(&aBody[8],(u64)iFileSize);
+    bcvPutU32(&aBody[16],(u32)nManifest);
+    bcvPutU32(&aBody[20],(u32)nETag);
+    if( nETag ) memcpy(&aBody[24],pMan->zETag,nETag);
+    memcpy(&aBody[24+nETag],aManifest,nManifest);
+    if( bCompacted ) memcpy(
+        &aBody[24+nETag+nManifest],pCont->aSessionExpectedCheckpointHash,
+        SQLITE_BCVFS_SESSION_HASH_BYTES
+    );
+    *paBody = aBody;
+    *pnBody = (int)nBody64;
+    aBody = 0;
+  }
+  sqlite3_free(aBody);
+  sqlite3_free(aManifest);
+  bcvManifestDeref(pMan);
+  return rc;
+}
+
+/* Determine the logical EOF without interpreting the database format.  CBS
+** serves both SQLite-compatible files and DoltLite's CTLD/chunk-store files;
+** only the VFS sees every successful xWrite/xTruncate.  Before this session
+** observes an exact size, use the imported manifest's conservative rounded
+** extent.  A non-empty WAL sidecar is always rejected because this VFS has no
+** operation that merges WAL frames into the main logical mapping. */
+static int bcvfsSessionFileSize(
+  BcvfsFile *pFile,
+  sqlite3_int64 *piFileSize,
+  char **pzErr
+){
+  sqlite3_bcvfs *pFs = pFile ? pFile->pFs : 0;
+  Container *pCont = pFile ? pFile->pCont : 0;
+  ManifestDb *pDb = 0;
+  sqlite3_int64 iSize = 0;
+  int rc = SQLITE_OK;
+  if( pFs==0 || pCont==0 || piFileSize==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"checkpoint size context is unavailable");
+  }
+
+  /* Inspect the sidecar independently of the main-file format. */
+  {
+    int bWal = 0;
+    char *zWal = 0;
+    if( pCont->pMan ){
+      ENTER_VFS_MUTEX; {
+        ManifestDb *pDb = bcvfsFindDatabaseById(
+            pCont->pMan,pFile->iFileDbId
+        );
+        if( pDb ){
+          zWal = bcvfsLocalName(
+              &rc,pCont,pDb->zDName,1
+          );
+        }else{
+          rc = SQLITE_CORRUPT;
+        }
+      } LEAVE_VFS_MUTEX;
+      if( rc==SQLITE_OK ){
+        rc = bcvfsWalNonEmpty(&pFs->c,zWal,&bWal);
+      }
+      sqlite3_free(zWal);
+    }else{
+      rc = SQLITE_CORRUPT;
+    }
+    if( rc!=SQLITE_OK ){
+      return bcvSessionError(
+          rc,pzErr,"could not inspect SQLite WAL state for checkpoint"
+      );
+    }
+    if( bWal ){
+      return bcvSessionError(
+          SQLITE_MISUSE,pzErr,"checkpoint has committed WAL frames that are not merged"
+      );
+    }
+  }
+
+  ENTER_VFS_MUTEX; {
+    pDb = pCont->pMan
+        ? bcvfsFindDatabaseById(pCont->pMan,pFile->iFileDbId) : 0;
+    if( pDb==0 || pCont->pMan->szBlk<=0 || pDb->nBlkLocal<0 ){
+      rc = bcvSessionError(
+          SQLITE_CORRUPT,pzErr,"checkpoint database extent is unavailable"
+      );
+    }else if( pCont->bSessionWriteFileSizeValid ){
+      iSize = pCont->iSessionWriteFileSize;
+    }else{
+      /* The rounded extent is conservative for an imported base. Once a
+      ** session writes or truncates, the tracker above supersedes it. */
+      if( (sqlite3_int64)pDb->nBlkLocal
+          > (sqlite3_int64)0x7fffffffffffffffLL / pCont->pMan->szBlk
+      ){
+        rc = bcvSessionError(
+            SQLITE_TOOBIG,pzErr,"checkpoint database extent overflows"
+        );
+      }else{
+        iSize = (sqlite3_int64)pDb->nBlkLocal * pCont->pMan->szBlk;
+      }
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc!=SQLITE_OK ) return rc;
+  if( iSize<=0 ){
+    return bcvSessionError(
+        SQLITE_CORRUPT,pzErr,"checkpoint database has no logical extent"
+    );
+  }
+  *piFileSize = iSize;
+  return SQLITE_OK;
+}
+
+static int bcvfsSessionCheckpointForFile(
+  BcvfsFile *pFile,
+  int flags,
+  unsigned char *aCheckpointHash,
+  char **pzETag,
+  char **pzErr
+){
+  sqlite3_bcvfs *pFs = pFile ? pFile->pFs : 0;
+  Container *pCont = pFile ? pFile->pCont : 0;
+  unsigned char *aBody = 0;
+  unsigned char aHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char *aEncoded = 0;
+  char *zPutETag = 0;
+  char *zLocalErr = 0;
+  sqlite3_bcvfs_session_record record;
+  sqlite3_int64 iFileSize = 0;
+  int nBody = 0;
+  int nEncoded = 0;
+  int bEntered = 0;
+  int bDirty = 0;
+  int bBlocked = 0;
+  int rc = SQLITE_OK;
+  int rc2;
+  if( aCheckpointHash ) memset(aCheckpointHash,0,sizeof(aHash));
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( pFs==0 || pCont==0 || pCont->zSessionId==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session checkpoint requires a session file");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session checkpoints are unavailable through the CBS daemon");
+  }
+  ENTER_VFS_MUTEX; {
+    if( pCont->nSessionRef<=0 ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint has no live owner");
+    }else if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint scope is not bound");
+    }else if( pCont->eState!=CONTAINER_STATE_NONE ){
+      rc = bcvSessionError(SQLITE_BUSY,pzErr,"session checkpoint container is busy");
+    }else{
+      bcvfsEnterState(pFs,pCont,CONTAINER_STATE_UPLOAD);
+      bEntered = 1;
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc==SQLITE_OK && pFile->pCacheFile==0 ){
+    rc = bcvSessionError(SQLITE_IOERR,pzErr,"session checkpoint has no local cache file");
+  }
+  if( rc==SQLITE_OK ) rc = pFile->pCacheFile->pMethods->xSync(pFile->pCacheFile,flags);
+  if( rc==SQLITE_OK ) rc = bcvfsSessionFileSize(pFile,&iFileSize,pzErr);
+  if( rc==SQLITE_OK ){
+    ENTER_VFS_MUTEX; {
+      ManifestDb *pDb = bcvfsFindDatabaseById(pCont->pMan,pFile->iFileDbId);
+      sqlite3_int64 iExtent = 0;
+      if( pDb && pCont->pMan->szBlk>0 && pDb->nBlkLocal>0 ){
+        iExtent = (sqlite3_int64)pDb->nBlkLocal * pCont->pMan->szBlk;
+      }
+      if( pDb==0 || pDb->nBlkLocal<=0 || iExtent<iFileSize ){
+        rc = bcvSessionError(
+            SQLITE_CORRUPT,pzErr,
+            "checkpoint file size exceeds the checkpoint manifest extent"
+        );
+      }
+    } LEAVE_VFS_MUTEX;
+  }
+  while( rc==SQLITE_OK ){
+    ENTER_VFS_MUTEX; {
+      bcvfsSessionDirtyState(pFs,pCont,&bDirty,&bBlocked);
+    } LEAVE_VFS_MUTEX;
+    if( !bDirty ) break;
+    if( bBlocked ){
+      rc = bcvSessionError(SQLITE_BUSY,pzErr,"session checkpoint has pinned dirty cache entries");
+      break;
+    }
+    rc = bcvfsStageOneForSession(pFile);
+    if( rc==SQLITE_FULL ){
+      ENTER_VFS_MUTEX; {
+        bcvfsSessionDirtyState(pFs,pCont,&bDirty,&bBlocked);
+      } LEAVE_VFS_MUTEX;
+      if( !bDirty ) rc = SQLITE_OK;
+      else rc = bcvSessionError(SQLITE_BUSY,pzErr,"session dirty cache could not be staged");
+    }
+  }
+  if( rc==SQLITE_OK ){
+    ENTER_VFS_MUTEX; {
+      rc = bcvfsSessionComposeBody(
+          pFs,pCont,iFileSize,&aBody,&nBody,pzErr
+      );
+      if( rc==SQLITE_OK ){
+        memset(&record,0,sizeof(record));
+        record.eType = SQLITE_BCVFS_SESSION_CHECKPOINT;
+        record.eState = SQLITE_BCVFS_SESSION_OPEN;
+        record.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+        if( pCont->iSessionSequence==0xFFFFFFFFFFFFFFFFULL ){
+          rc = bcvSessionError(SQLITE_TOOBIG,pzErr,"session checkpoint sequence exhausted");
+        }else{
+          record.iSequence = pCont->iSessionSequence+1;
+        }
+        record.iCreated = sqlite_timestamp();
+        record.iExpires = record.iCreated + BCV_SESSION_TTL_MILLISECONDS;
+        memcpy(record.zSessionId,pCont->zSessionId,strlen(pCont->zSessionId)+1);
+        rc2 = sqlite3_bcvfs_session_scope_hash(
+            pCont->zStorage,pCont->zAccount,pCont->zContainer,
+            pCont->zSessionPrincipal,pCont->zSessionDatabase,
+            pCont->zSessionOperations,record.aScopeHash,pzErr
+        );
+        if( rc==SQLITE_OK ) rc = rc2;
+        if( pCont->iSessionExpectedSequence
+               >= (sqlite3_uint64)BCV_SESSION_COMPACTION_THRESHOLD
+         && pCont->iSessionSequence==pCont->iSessionExpectedSequence
+        ){
+          /* The compacted body carries a complete snapshot. Keep one
+          ** authenticated link to the predecessor checkpoint as well: the
+          ** direct finalizer uses this header fence, while rehydration stops
+          ** at the compacted body instead of walking the old chain. */
+          memcpy(record.aPredecessorHash,
+              pCont->aSessionExpectedCheckpointHash,
+              sizeof(record.aPredecessorHash));
+        }else{
+          memcpy(record.aPredecessorHash,pCont->aSessionPredecessorHash,
+              sizeof(record.aPredecessorHash));
+        }
+        memcpy(record.aOperationId,pCont->aSessionOperationId,sizeof(record.aOperationId));
+        record.aBody = aBody;
+        record.nBody = nBody;
+      }
+    } LEAVE_VFS_MUTEX;
+  }
+  if( rc==SQLITE_OK ){
+    rc = sqlite3_bcvfs_session_record_encode(
+        &record,&aEncoded,&nEncoded,aHash,&zLocalErr
+    );
+    if( rc!=SQLITE_OK && pzErr && *pzErr==0 ){
+      *pzErr = zLocalErr;
+      zLocalErr = 0;
+    }
+  }
+  if( rc==SQLITE_OK ){
+    rc = sqlite3_bcvfs_session_put(
+        pFs,pCont->zName,SQLITE_BCVFS_SESSION_CHECKPOINT,
+        pCont->zSessionId,aHash,pCont->zSessionPrincipal,
+        pCont->zSessionDatabase,pCont->zSessionOperations,"*",
+        aEncoded,nEncoded,&zPutETag,&zLocalErr
+    );
+    if( rc!=SQLITE_OK && pzErr && *pzErr==0 ){
+      *pzErr = zLocalErr;
+      zLocalErr = 0;
+    }
+  }
+  if( rc==SQLITE_OK ){
+    ENTER_VFS_MUTEX; {
+      memcpy(pCont->aSessionPredecessorHash,aHash,sizeof(aHash));
+      pCont->iSessionSequence = record.iSequence;
+      pCont->iSessionWriteFileSize = iFileSize;
+      pCont->bSessionWriteFileSizeValid = 1;
+      pCont->bSessionOverlay = 1;
+    } LEAVE_VFS_MUTEX;
+    if( aCheckpointHash ) memcpy(aCheckpointHash,aHash,sizeof(aHash));
+    if( pzETag ){
+      *pzETag = zPutETag;
+      zPutETag = 0;
+    }
+  }
+  sqlite3_free(zLocalErr);
+  sqlite3_free(zPutETag);
+  sqlite3_free(aEncoded);
+  sqlite3_free(aBody);
+  if( bEntered ){
+    ENTER_VFS_MUTEX; {
+      if( pCont->eState==CONTAINER_STATE_UPLOAD ) bcvfsLeaveState(pFs,pCont);
+    } LEAVE_VFS_MUTEX;
+  }
+  return rc;
+}
+
+int sqlite3_bcvfs_session_checkpoint(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  const char *zSessionId,
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES],
+  char **pzETag,
+  char **pzErr
+){
+  Container *pCont = 0;
+  i64 iFileDbId = 0;
+  char zDatabase[BCV_DBNAME_SIZE];
+  BcvfsFile work;
+  sqlite3_file *pCache = 0;
+  sqlite3_file *pLogical = 0;
+  char *zLocal = 0;
+  int rc = SQLITE_OK;
+  int bClient = 0;
+  if( aCheckpointHash==0 || pzETag==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session checkpoint outputs are required");
+  }
+  if( pzErr ) *pzErr = 0;
+  *pzETag = 0;
+  memset(aCheckpointHash,0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memset(&work,0,sizeof(work));
+  if( pFs==0 || zAlias==0 || !bcvfsValidSessionId(zSessionId) ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session checkpoint identity is invalid");
+  }
+  if( pFs->zPortnumber ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session checkpoints are unavailable through the CBS daemon");
+  }
+  ENTER_VFS_MUTEX; {
+    pCont = bcvfsFindContAlias(&pFs->c,zAlias,pzErr);
+    if( pCont==0 ){
+      rc = SQLITE_ERROR;
+    }else if( pCont->zSessionId==0 || strcmp(pCont->zSessionId,zSessionId)!=0
+          || pCont->nSessionRef<=0 ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session does not own container alias");
+    }else if( !pCont->bSessionContext ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint scope is not bound");
+    }else if( bcvfsFindDatabase(pCont->pMan,pCont->zSessionDatabase,-1)==0 ){
+      rc = bcvSessionError(SQLITE_AUTH,pzErr,"session database is not attached");
+    }else{
+      ManifestDb *pDb = bcvfsFindDatabase(pCont->pMan,pCont->zSessionDatabase,-1);
+      iFileDbId = pDb->iDbId;
+      memcpy(zDatabase,pDb->zDName,sizeof(zDatabase));
+      zDatabase[sizeof(zDatabase)-1] = 0;
+      pCont->nClient++;
+      bClient = 1;
+    }
+  } LEAVE_VFS_MUTEX;
+  if( rc==SQLITE_OK ) rc = bcvOpenLocal(pFs->zCacheFile,0,0,&pCache);
+  if( rc==SQLITE_OK ){
+    zLocal = bcvfsLocalName(&rc,pCont,zDatabase,0);
+    if( rc==SQLITE_OK ) rc = bcvOpenLocal(zLocal,0,0,&pLogical);
+  }
+  if( rc==SQLITE_OK ){
+    work.pFs = pFs;
+    work.pCont = pCont;
+    work.pCacheFile = pCache;
+    work.pFile = pLogical;
+    work.iFileDbId = iFileDbId;
+    rc = bcvfsSessionCheckpointForFile(&work,0,aCheckpointHash,pzETag,pzErr);
+  }
+  if( work.pMan ){
+    ENTER_VFS_MUTEX; {
+      bcvManifestDeref(work.pMan);
+      work.pMan = 0;
+      work.pManDb = 0;
+    } LEAVE_VFS_MUTEX;
+  }
+  if( pLogical ) bcvCloseLocal(pLogical);
+  if( pCache ) bcvCloseLocal(pCache);
+  sqlite3_free(zLocal);
+  if( bClient ){
+    ENTER_VFS_MUTEX; {
+      pCont->nClient--;
+    } LEAVE_VFS_MUTEX;
+  }
+  return rc;
+}
+
+ /*
+ ** Session request overlays
+ **
+ ** A Container is a mutable local cache, not an accepted session state.  A
+** new server invocation therefore has to replace all local generations with
+** the exact immutable checkpoint named by the session head.  ACCEPTED and
+** PUBLISHING heads use the checkpoint as their request state; a COMMITTED
+** head additionally proves that the published manifest is that candidate. The
+ ** object store is the authority for that state; cachefile.bcv and blocksdb
+ ** are only scratch space and are deliberately discarded here.
+ */
+ #define BCV_SESSION_REHYDRATE_MAX_CHAIN 64
+
+ static int bcvfsSessionCopyEtag(
+   const unsigned char *aEtag,
+   int nEtag,
+   char **pzOut,
+   char **pzErr
+ ){
+   char *zOut;
+   if( pzOut ) *pzOut = 0;
+   if( aEtag==0 || nEtag<=0 || nEtag>BCV_SESSION_MAX_ETAG_BYTES ){
+     return bcvSessionError(SQLITE_CORRUPT,pzErr,"invalid session base ETag");
+   }
+   zOut = (char*)sqlite3_malloc64((sqlite3_uint64)nEtag+1);
+   if( zOut==0 ) return bcvSessionError(SQLITE_NOMEM,pzErr,0);
+   memcpy(zOut,aEtag,nEtag);
+   zOut[nEtag] = '\0';
+   *pzOut = zOut;
+   return SQLITE_OK;
+ }
+
+ /* Fetch the published manifest without trusting the warm Container's cached
+ ** pMan. The caller owns the returned manifest. */
+ static int bcvfsSessionFetchPublishedManifest(
+   sqlite3_bcvfs *pFs,
+   Container *pCont,
+   Manifest **ppMan,
+   char **pzErr
+ ){
+   BcvDispatch *pDisp = 0;
+   BcvContainer *pBcv = 0;
+  Manifest *pMan = 0;
+  char *zErr = 0;
+  int rc = SQLITE_OK;
+  int bClient = 0;
+   if( ppMan ) *ppMan = 0;
+   if( pzErr ) *pzErr = 0;
+   if( pFs==0 || pCont==0 || ppMan==0 ){
+     return bcvSessionError(SQLITE_MISUSE,pzErr,"session manifest fetch arguments are required");
+   }
+   ENTER_VFS_MUTEX; {
+     /* Keep the container alive for the complete manifest request. The
+     ** rehydrate flag rejects detach, while nClient also protects the
+     ** container and dispatch handles from concurrent teardown. */
+     pCont->nClient++;
+     bClient = 1;
+     bcvfsEnterState(pFs,pCont,CONTAINER_STATE_POLL);
+     rc = bcvfsContainerGetBcv(pFs,pCont,&pDisp,&pBcv,&zErr);
+     if( rc!=SQLITE_OK ){
+       pCont->nClient--;
+       bClient = 0;
+     }
+   } LEAVE_VFS_MUTEX;
+   if( rc==SQLITE_OK ) rc = bcvfsFetchManifest(pDisp,pBcv,&pMan,&zErr);
+   ENTER_VFS_MUTEX; {
+     if( pCont->eState==CONTAINER_STATE_POLL ) bcvfsLeaveState(pFs,pCont);
+     if( pDisp || pBcv ){
+       bcvfsContainerReleaseBcv(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+     }
+     if( bClient ) pCont->nClient--;
+   } LEAVE_VFS_MUTEX;
+   if( rc==SQLITE_OK ){
+     *ppMan = pMan;
+     pMan = 0;
+   }
+   if( pzErr ) *pzErr = zErr;
+   else sqlite3_free(zErr);
+   if( pMan ) bcvManifestDeref(pMan);
+   return rc;
+ }
+
+/* The VFS mutex must be held. Remove both resident and durable local
+** generations. This does not issue remote DELETE requests: accepted and
+** unaccepted content-addressed objects are still candidates for another
+** session and are reclaimed only by the mark/sweep pass. */
+static int bcvfsSessionDeleteScratchPath(
+  sqlite3_vfs *pVfs,
+  const char *zPath
+){
+  int rc = pVfs->xDelete(pVfs,zPath,0);
+  return rc==SQLITE_IOERR_DELETE_NOENT ? SQLITE_OK : rc;
+}
+
+static int bcvfsSessionResetScratchLocked(
+   sqlite3_bcvfs *pFs,
+   Container *pCont,
+   char **pzErr
+ ){
+   BcvCommon *p = &pFs->c;
+   int iDb;
+   int ii;
+   int rc = SQLITE_OK;
+   /* The underlying SQLite files are only lock/WAL sidecars for the block
+   ** VFS. Remove them before installing a different accepted generation;
+   ** otherwise a warm alias could make SQLite inspect an abandoned WAL or
+   ** shared-memory index. No client is open when this helper is called. */
+   for(iDb=0; rc==SQLITE_OK && pCont->pMan && iDb<pCont->pMan->nDb; iDb++){
+     char *zFile = bcvfsLocalName(&rc,pCont,pCont->pMan->aDb[iDb].zDName,0);
+     char *zWal = zFile ? sqlite3_mprintf("%s-wal",zFile) : 0;
+     char *zShm = zFile ? sqlite3_mprintf("%s-shm",zFile) : 0;
+     if( zFile==0 || zWal==0 || zShm==0 ){
+       rc = SQLITE_NOMEM;
+     }else{
+      rc = bcvfsSessionDeleteScratchPath(p->pVfs,zFile);
+      if( rc==SQLITE_OK ) rc = bcvfsSessionDeleteScratchPath(p->pVfs,zWal);
+      if( rc==SQLITE_OK ) rc = bcvfsSessionDeleteScratchPath(p->pVfs,zShm);
+     }
+     sqlite3_free(zFile);
+     sqlite3_free(zWal);
+     sqlite3_free(zShm);
+   }
+   for(ii=0; ii<p->nHash && rc==SQLITE_OK; ii++){
+     CacheEntry *pEntry = p->aHash[ii];
+     while( pEntry ){
+       CacheEntry *pNext = pEntry->pHashNext;
+       if( pEntry->pCont==pCont ){
+         if( pEntry->nRef!=0 || pEntry->bStaging ){
+           rc = bcvSessionError(
+               SQLITE_BUSY,pzErr,
+               "cannot rehydrate a session with an active cache reference"
+           );
+           break;
+         }
+         rc = bcvfsClearBlock(p,pEntry);
+         if( rc==SQLITE_OK ){
+           if( pEntry->pLruPrev || pEntry->pLruNext
+            || p->pLruFirst==pEntry
+           ) bcvfsLruRemove(p,pEntry);
+           bcvfsHashRemove(p,pEntry);
+           bcvfsUnusedAdd(p,pEntry);
+         }
+       }
+       pEntry = pNext;
+     }
+   }
+   if( rc==SQLITE_OK ){
+     bcvExecPrintf(&rc,p->bdb,
+         "DELETE FROM block WHERE container=%Q;"
+         "DELETE FROM pinned WHERE container=%Q;"
+         "DELETE FROM staged WHERE container=%Q;"
+        "DELETE FROM staged_gc WHERE container=%Q;"
+        "DELETE FROM staged_sequence WHERE container=%Q;",
+        pCont->zName,pCont->zName,pCont->zName,
+        pCont->zName,pCont->zName
+     );
+   }
+   if( rc!=SQLITE_OK && pzErr && *pzErr==0 ){
+     *pzErr = sqlite3_mprintf("could not reset session local scratch");
+   }
+   return rc;
+ }
+
+static int bcvfsSessionManifestShapeValid(
+   Manifest *pBase,
+   Manifest *pOverlay,
+   const char *zDatabase,
+   sqlite3_uint64 iFileSize,
+   char **pzErr
+ ){
+  int iDb;
+  int nName;
+  ManifestDb *pTarget;
+  sqlite3_uint64 nRequired;
+   if( pBase==0 || pOverlay==0 || zDatabase==0 ){
+     return bcvSessionError(SQLITE_MISUSE,pzErr,"session overlay manifest arguments are required");
+   }
+   if( pBase->szBlk<=0 || pOverlay->szBlk!=pBase->szBlk
+    || pOverlay->nDb!=pBase->nDb
+   ){
+     return bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint base manifest does not match the published base");
+   }
+   nName = NAMEBYTES(pOverlay);
+   for(iDb=0; iDb<pOverlay->nDb; iDb++){
+     ManifestDb *pDb = &pOverlay->aDb[iDb];
+     ManifestDb *pBaseDb = bcvManifestDbidToDb(pBase,pDb->iDbId);
+     int iBlk;
+     if( pBaseDb==0 || 0!=memcmp(pBaseDb->zDName,pDb->zDName,BCV_DBNAME_SIZE) ){
+       return bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint contains an unauthorized database");
+     }
+     if( pDb->nBlkLocal<0 || (pDb->nBlkLocal>0 && pDb->aBlkLocal==0) ){
+       return bcvSessionError(SQLITE_CORRUPT,pzErr,"session checkpoint has an invalid block mapping");
+     }
+     for(iBlk=0; iBlk<pDb->nBlkLocal; iBlk++){
+       const unsigned char *aName = &pDb->aBlkLocal[iBlk*nName];
+       if( bcvSessionAllZero(aName,nName) ){
+         return bcvSessionError(SQLITE_CORRUPT,pzErr,"session checkpoint contains an empty block ID");
+       }
+     }
+   }
+   pTarget = bcvfsFindDatabase(pOverlay,zDatabase,-1);
+   if( pTarget==0 || pTarget->nBlkLocal<0 ){
+     return bcvSessionError(SQLITE_AUTH,pzErr,"session checkpoint target database is missing");
+   }
+  if( iFileSize>(sqlite3_uint64)0x7fffffffffffffffULL || pOverlay->szBlk<=0 ){
+    return bcvSessionError(SQLITE_CORRUPT,pzErr,"session checkpoint file size is invalid");
+  }
+  /* Compute ceil(iFileSize / szBlk) without overflowing uint64. */
+  nRequired = iFileSize / (sqlite3_uint64)pOverlay->szBlk;
+  if( iFileSize % (sqlite3_uint64)pOverlay->szBlk ) nRequired++;
+  if( nRequired!=(sqlite3_uint64)pTarget->nBlkLocal ){
+    return bcvSessionError(
+        SQLITE_CORRUPT,pzErr,
+        "session checkpoint mapping has blocks beyond the logical file size"
+    );
+  }
+  return SQLITE_OK;
+}
+
+ static int bcvfsSessionInstallOverlay(
+   sqlite3_bcvfs *pFs,
+   Container *pCont,
+   Manifest **ppMan,
+   sqlite3_int64 iFileSize,
+   const unsigned char *aCheckpointHash,
+   sqlite3_uint64 iSequence,
+   int bOverlay,
+   char **pzErr
+ ){
+   Manifest *pMan = ppMan ? *ppMan : 0;
+   int rc = SQLITE_OK;
+   if( pMan==0 ){
+     return bcvSessionError(SQLITE_MISUSE,pzErr,"session overlay manifest is required");
+   }
+   ENTER_VFS_MUTEX; {
+     bcvfsEnterState(pFs,pCont,CONTAINER_STATE_POLL);
+     if( pCont->nClient>0 ){
+       rc = bcvSessionError(SQLITE_BUSY,pzErr,"session overlay has open database clients");
+     }else{
+       rc = bcvfsSessionResetScratchLocked(pFs,pCont,pzErr);
+     }
+     if( rc==SQLITE_OK
+      && pFs->c.szBlk!=0 && pMan->szBlk!=pFs->c.szBlk
+     ){
+       rc = SQLITE_MISUSE;
+     }else if( rc==SQLITE_OK && pFs->c.szBlk==0 && pMan->szBlk>0
+            && (pFs->c.nMaxCache<pMan->szBlk
+                || pFs->c.nMaxCache%pMan->szBlk)
+     ){
+       rc = SQLITE_MISUSE;
+     }else if( rc==SQLITE_OK && pFs->c.szBlk==0 && pMan->szBlk>0
+            && pFs->c.nBlk>pFs->c.nMaxCache/pMan->szBlk
+     ){
+       rc = SQLITE_FULL;
+     }
+     if( rc==SQLITE_OK ){
+       /* bcvManifestInstall() takes ownership after the capacity checks. */
+       *ppMan = 0;
+       rc = bcvManifestInstall(&pFs->c,pCont,pMan);
+       if( rc==SQLITE_OK ){
+         if( bOverlay ){
+           memcpy(pCont->aSessionPredecessorHash,aCheckpointHash,
+               SQLITE_BCVFS_SESSION_HASH_BYTES);
+           pCont->iSessionSequence = iSequence;
+           pCont->iSessionWriteFileSize = iFileSize;
+           pCont->bSessionWriteFileSizeValid = 1;
+           pCont->bSessionOverlay = 1;
+         }else{
+           memset(pCont->aSessionPredecessorHash,0,
+               sizeof(pCont->aSessionPredecessorHash));
+           pCont->iSessionSequence = 0;
+           pCont->iSessionWriteFileSize = 0;
+           pCont->bSessionWriteFileSizeValid = 0;
+           pCont->bSessionOverlay = 0;
+         }
+       }
+     }
+     if( pCont->eState==CONTAINER_STATE_POLL ) bcvfsLeaveState(pFs,pCont);
+   } LEAVE_VFS_MUTEX;
+   return rc;
+ }
+
+ int sqlite3_bcvfs_session_rehydrate(
+   sqlite3_bcvfs *pFs,
+   const char *zAlias,
+   const char *zSessionId,
+   char **pzErr
+ ){
+   Container *pCont = 0;
+   Manifest *pBase = 0;
+   Manifest *pOverlay = 0;
+   unsigned char *aHead = 0;
+   unsigned char *aCheckpoint = 0;
+   unsigned char *aFirstManifest = 0;
+   unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+   unsigned char aHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+   unsigned char aSeen[BCV_SESSION_REHYDRATE_MAX_CHAIN][SQLITE_BCVFS_SESSION_HASH_BYTES];
+   char *zHeadETag = 0;
+   char *zCheckpointETag = 0;
+   char *zBaseETag = 0;
+   char *zPrincipal = 0;
+   char *zDatabase = 0;
+   char *zOperations = 0;
+   char *zErr = 0;
+   sqlite3_bcvfs_session_record head;
+   sqlite3_bcvfs_session_record checkpoint;
+   sqlite3_bcvfs_session_body headBody;
+   sqlite3_bcvfs_session_body checkpointBody;
+  sqlite3_uint64 iFileSize = 0;
+  sqlite3_uint64 iUpperSequence = 0;
+  sqlite3_int64 iNow = 0;
+   int nHead = 0;
+   int nCheckpoint = 0;
+   int nFirstManifest = 0;
+  int nSeen = 0;
+  int rc = SQLITE_OK;
+  int bHeld = 0;
+  int bBaseEtagMatch = 0;
+
+   if( pzErr ) *pzErr = 0;
+   if( pFs==0 || zAlias==0 || !bcvfsValidSessionId(zSessionId) ){
+     return bcvSessionError(SQLITE_MISUSE,pzErr,"session rehydration identity is invalid");
+   }
+   if( pFs->zPortnumber ){
+     return bcvSessionError(SQLITE_MISUSE,pzErr,"session rehydration is unavailable through the CBS daemon");
+   }
+   ENTER_VFS_MUTEX; {
+     pCont = bcvfsFindContAlias(&pFs->c,zAlias,&zErr);
+     if( pCont==0 ){
+       rc = SQLITE_ERROR;
+     }else if( pCont->zSessionId==0 || strcmp(pCont->zSessionId,zSessionId)!=0
+            || pCont->nSessionRef<=0 || !pCont->bSessionContext
+     ){
+       rc = bcvSessionError(SQLITE_AUTH,&zErr,"session rehydration does not own a bound attachment");
+     }else if( pCont->nClient>0 || pCont->bSessionRehydrate ){
+       rc = bcvSessionError(SQLITE_BUSY,&zErr,"session rehydration has open database clients");
+     }else{
+       pCont->bSessionRehydrate = 1;
+       bHeld = 1;
+       zPrincipal = sqlite3_mprintf("%s",pCont->zSessionPrincipal);
+       zDatabase = sqlite3_mprintf("%s",pCont->zSessionDatabase);
+       zOperations = sqlite3_mprintf("%s",pCont->zSessionOperations);
+       if( zPrincipal==0 || zDatabase==0 || zOperations==0 ){
+         rc = bcvSessionError(SQLITE_NOMEM,&zErr,0);
+       }
+     }
+   } LEAVE_VFS_MUTEX;
+   if( rc!=SQLITE_OK ) goto session_rehydrate_done;
+
+   rc = sqlite3_bcvfs_session_scope_hash(
+       pCont->zStorage,pCont->zAccount,pCont->zContainer,
+       zPrincipal,zDatabase,zOperations,aScope,&zErr
+   );
+   if( rc!=SQLITE_OK ) goto session_rehydrate_done;
+
+   rc = sqlite3_bcvfs_session_fetch(
+       pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+       zPrincipal,zDatabase,zOperations,&aHead,&nHead,&zHeadETag,&zErr
+   );
+   if( rc==HTTP_NOT_FOUND ){
+     sqlite3_free(zErr);
+     zErr = 0;
+     rc = bcvfsSessionFetchPublishedManifest(pFs,pCont,&pBase,&zErr);
+     if( rc==SQLITE_OK
+      && (pBase->zETag==0 || pBase->zETag[0]=='\0'
+          || bcvfsFindDatabase(pBase,zDatabase,-1)==0
+          || bcvfsFindDatabase(pBase,zDatabase,-1)->nBlkLocal<=0)
+     ){
+       rc = bcvSessionError(SQLITE_AUTH,&zErr,"published base has no session database");
+     }
+     if( rc==SQLITE_OK ) rc = bcvfsSessionInstallOverlay(
+         pFs,pCont,&pBase,0,0,0,0,&zErr
+     );
+     goto session_rehydrate_done;
+   }
+   if( rc!=SQLITE_OK ) goto session_rehydrate_done;
+
+   rc = sqlite3_bcvfs_session_record_decode(
+       aHead,nHead,zSessionId,aScope,&head,&zErr
+   );
+   if( rc==SQLITE_OK && (head.eType!=SQLITE_BCVFS_SESSION_HEAD
+       || (head.eState!=SQLITE_BCVFS_SESSION_ACCEPTED
+           && head.eState!=SQLITE_BCVFS_SESSION_PUBLISHING
+           && head.eState!=SQLITE_BCVFS_SESSION_COMMITTED)
+       || bcvSessionAllZero(head.aOperationId,sizeof(head.aOperationId))
+   ) ){
+     rc = bcvSessionError(SQLITE_CORRUPT,&zErr,"session head has an invalid state");
+   }
+   if( rc==SQLITE_OK
+    && pFs->c.pVfs->xCurrentTimeInt64(pFs->c.pVfs,&iNow)!=SQLITE_OK
+   ){
+     rc = bcvSessionError(SQLITE_IOERR,&zErr,"could not read session clock");
+   }
+   if( rc==SQLITE_OK
+    && sqlite3_bcvfs_session_record_is_expired(&head,iNow)
+   ){
+     rc = bcvSessionError(SQLITE_AUTH,&zErr,"session head has expired");
+   }
+   if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_body_decode(
+       head.eType,head.eState,head.zSessionId,head.aBody,head.nBody,
+       &headBody,&zErr
+   );
+   if( rc==SQLITE_OK && bcvSessionAllZero(
+       headBody.aCheckpointHash,sizeof(headBody.aCheckpointHash)
+   ) ){
+     rc = bcvSessionError(SQLITE_CORRUPT,&zErr,"session head has no checkpoint");
+   }
+   if( rc==SQLITE_OK ) rc = bcvfsSessionFetchPublishedManifest(
+       pFs,pCont,&pBase,&zErr
+   );
+   if( rc==SQLITE_OK ){
+     bBaseEtagMatch = pBase->zETag!=0
+       && (int)strlen(pBase->zETag)==headBody.nBaseManifestETag
+       && 0==memcmp(pBase->zETag,headBody.aBaseManifestETag,
+           (size_t)headBody.nBaseManifestETag);
+     if( !bBaseEtagMatch && head.eState==SQLITE_BCVFS_SESSION_ACCEPTED ){
+       rc = bcvSessionError(
+           SQLITE_BUSY,&zErr,
+           "published manifest changed since the accepted session head"
+       );
+     }
+   }
+   if( rc!=SQLITE_OK ) goto session_rehydrate_done;
+
+   memcpy(aHash,headBody.aCheckpointHash,sizeof(aHash));
+   iUpperSequence = head.iSequence;
+   while( rc==SQLITE_OK ){
+     int ii;
+     int bFirst = nSeen==0;
+     for(ii=0; ii<nSeen; ii++){
+       if( bcvSessionEqual(aSeen[ii],aHash,sizeof(aHash)) ){
+         rc = bcvSessionError(SQLITE_CORRUPT,&zErr,"session checkpoint chain contains a cycle");
+         break;
+       }
+     }
+     if( rc!=SQLITE_OK ) break;
+     if( nSeen>=BCV_SESSION_REHYDRATE_MAX_CHAIN ){
+       rc = bcvSessionError(SQLITE_TOOBIG,&zErr,"session checkpoint chain is too deep");
+       break;
+     }
+     rc = sqlite3_bcvfs_session_fetch(
+         pFs,zAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zSessionId,aHash,
+         zPrincipal,zDatabase,zOperations,&aCheckpoint,&nCheckpoint,
+         &zCheckpointETag,&zErr
+     );
+     if( rc!=SQLITE_OK ) break;
+     rc = sqlite3_bcvfs_session_record_decode(
+         aCheckpoint,nCheckpoint,zSessionId,aScope,&checkpoint,&zErr
+     );
+     if( rc==SQLITE_OK && (checkpoint.eType!=SQLITE_BCVFS_SESSION_CHECKPOINT
+         || checkpoint.eState!=SQLITE_BCVFS_SESSION_OPEN
+         || checkpoint.eOutcome!=SQLITE_BCVFS_SESSION_OUTCOME_NONE
+         || checkpoint.iSequence==0
+         || (bFirst && 0!=memcmp(
+             checkpoint.aOperationId,head.aOperationId,
+             sizeof(checkpoint.aOperationId)
+         ))
+         || (!bFirst && checkpoint.iSequence>=iUpperSequence)
+         || (bFirst && checkpoint.iSequence>iUpperSequence)
+     ) ){
+       rc = bcvSessionError(SQLITE_CORRUPT,&zErr,"session checkpoint identity or sequence is invalid");
+     }
+     if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_body_decode(
+         checkpoint.eType,checkpoint.eState,checkpoint.zSessionId,
+         checkpoint.aBody,checkpoint.nBody,&checkpointBody,&zErr
+     );
+     if( rc==SQLITE_OK && (checkpointBody.nBaseManifestETag!=headBody.nBaseManifestETag
+         || memcmp(checkpointBody.aBaseManifestETag,headBody.aBaseManifestETag,
+             (size_t)headBody.nBaseManifestETag)!=0
+     ) ){
+       rc = bcvSessionError(SQLITE_AUTH,&zErr,"session checkpoint base identity does not match the accepted head");
+     }
+    if( rc==SQLITE_OK && checkpointBody.bCompacted
+     && !bcvSessionEqual(
+          checkpoint.aPredecessorHash,
+          checkpointBody.aBaseCheckpointHash,
+          SQLITE_BCVFS_SESSION_HASH_BYTES
+        )
+    ){
+      rc = bcvSessionError(
+          SQLITE_CORRUPT,&zErr,
+          "compacted session checkpoint has the wrong predecessor link"
+      );
+     }
+     if( rc==SQLITE_OK && bFirst ){
+       iFileSize = checkpointBody.iFileSize;
+       nFirstManifest = checkpointBody.nManifest;
+       aFirstManifest = (unsigned char*)sqlite3_malloc64((sqlite3_uint64)nFirstManifest);
+       if( aFirstManifest==0 ) rc = SQLITE_NOMEM;
+       if( rc==SQLITE_OK ) memcpy(aFirstManifest,checkpointBody.aManifest,nFirstManifest);
+       if( rc==SQLITE_OK ) rc = bcvfsSessionCopyEtag(
+           checkpointBody.aBaseManifestETag,checkpointBody.nBaseManifestETag,
+           &zBaseETag,&zErr
+       );
+     }
+     if( rc==SQLITE_OK ){
+       memcpy(aSeen[nSeen],aHash,sizeof(aHash));
+       nSeen++;
+       iUpperSequence = checkpoint.iSequence;
+       if( checkpointBody.bCompacted
+        || bcvSessionAllZero(checkpoint.aPredecessorHash,sizeof(checkpoint.aPredecessorHash))
+       ){
+         break;
+       }
+       memcpy(aHash,checkpoint.aPredecessorHash,sizeof(aHash));
+     }
+     sqlite3_free(aCheckpoint);
+     aCheckpoint = 0;
+     sqlite3_free(zCheckpointETag);
+     zCheckpointETag = 0;
+   }
+   if( rc==SQLITE_OK ){
+     if( aFirstManifest==0 || zBaseETag==0 ){
+       rc = bcvSessionError(SQLITE_CORRUPT,&zErr,"accepted session checkpoint has no manifest");
+     }else{
+       char *zParseErr = 0;
+       rc = bcvManifestParseCopy(
+           aFirstManifest,nFirstManifest,zBaseETag,&pOverlay,&zParseErr
+       );
+       if( rc!=SQLITE_OK && zErr==0 ) zErr = zParseErr;
+       else sqlite3_free(zParseErr);
+     }
+   }
+   if( rc==SQLITE_OK ) rc = bcvfsSessionManifestShapeValid(
+       pBase,pOverlay,zDatabase,iFileSize,&zErr
+   );
+   if( rc==SQLITE_OK
+    && (!bBaseEtagMatch || head.eState==SQLITE_BCVFS_SESSION_COMMITTED)
+   ){
+     int nPublishedManifest = 0;
+     unsigned char *aPublishedManifest = bcvManifestCompose(
+         pBase,&nPublishedManifest
+     );
+     unsigned char aPublishedHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+     if( aPublishedManifest==0 ){
+       rc = SQLITE_NOMEM;
+     }else{
+       SHA256_CTX sha;
+       SHA256_Init(&sha);
+       SHA256_Update(&sha,aPublishedManifest,nPublishedManifest);
+       SHA256_Final(aPublishedHash,&sha);
+       if( memcmp(
+           aPublishedHash,headBody.aCandidateManifestHash,
+           SQLITE_BCVFS_SESSION_HASH_BYTES
+         )!=0
+        || nPublishedManifest!=nFirstManifest
+        || memcmp(aPublishedManifest,aFirstManifest,nFirstManifest)!=0
+       ){
+         rc = bcvSessionError(
+             SQLITE_BUSY,&zErr,
+             "session publication candidate is not the published manifest"
+         );
+       }
+       sqlite3_free(aPublishedManifest);
+     }
+   }
+   if( rc==SQLITE_OK ) rc = bcvfsSessionInstallOverlay(
+       pFs,pCont,&pOverlay,(sqlite3_int64)iFileSize,headBody.aCheckpointHash,
+       head.iSequence,1,&zErr
+   );
+
+ session_rehydrate_done:
+   if( bHeld ){
+     ENTER_VFS_MUTEX; {
+       if( pCont->bSessionRehydrate ) pCont->bSessionRehydrate = 0;
+     } LEAVE_VFS_MUTEX;
+   }
+   sqlite3_free(aHead);
+   sqlite3_free(aCheckpoint);
+   sqlite3_free(aFirstManifest);
+   sqlite3_free(zHeadETag);
+   sqlite3_free(zCheckpointETag);
+   sqlite3_free(zBaseETag);
+   sqlite3_free(zPrincipal);
+   sqlite3_free(zDatabase);
+   sqlite3_free(zOperations);
+   if( pBase ) bcvManifestDeref(pBase);
+   if( pOverlay ) bcvManifestDeref(pOverlay);
+   if( pzErr ) *pzErr = zErr;
+   else sqlite3_free(zErr);
+   return rc;
+ }
+
+int sqlite3_bcvfs_session_put(
+  sqlite3_bcvfs *pFs,
+  const char *zAlias,
+  int eType,
+  const char *zSessionId,
+  const unsigned char *aObjectId,
+  const char *zPrincipal,
+  const char *zDatabase,
+  const char *zOperations,
+  const char *zIfMatch,
+  const unsigned char *aData,
+  int nData,
+  char **pzETag,
+  char **pzErr
+){
+  char zName[256];
+  BcvSessionPutCtx ctx;
+  sqlite3_bcvfs_session_record record;
+  Container *pCont = 0;
+  BcvDispatch *pDisp = 0;
+  BcvContainer *pBcv = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  int rc;
+  int bReconciled = 0;
+  if( pzETag ) *pzETag = 0;
+  if( pzErr ) *pzErr = 0;
+  if( pzETag==0 || aData==0 || nData<0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session PUT arguments are required");
+  }
+  if( eType!=SQLITE_BCVFS_SESSION_PUBLICATION && zSessionId==0 ){
+    return bcvSessionError(SQLITE_MISUSE,pzErr,"session PUT UUID is required");
+  }
+  rc = bcvSessionConditionValid(zIfMatch,pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = sqlite3_bcvfs_session_object_name(eType,zSessionId,aObjectId,zName,sizeof(zName),pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionAcquire(pFs,zAlias,zSessionId,&pCont,&pDisp,&pBcv,pzErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = bcvSessionBoundScope(
+      pCont,eType,zPrincipal,zDatabase,zOperations,aScope,pzErr
+  );
+  if( rc!=SQLITE_OK ){
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  rc = sqlite3_bcvfs_session_record_decode(
+      aData,nData,zSessionId,aScope,&record,pzErr
+  );
+  if( rc!=SQLITE_OK ){
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  if( record.eType!=eType ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"session object type does not match its key");
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  if( eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+   && (aObjectId==0 || !bcvSessionEqual(record.aRecordHash,aObjectId,SQLITE_BCVFS_SESSION_HASH_BYTES))
+  ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"checkpoint key does not match record hash");
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  if( eType==SQLITE_BCVFS_SESSION_HISTORY
+   && (aObjectId==0 || !bcvSessionEqual(record.aRecordHash,aObjectId,SQLITE_BCVFS_SESSION_HASH_BYTES))
+  ){
+    rc = bcvSessionError(SQLITE_CORRUPT,pzErr,"history key does not match record hash");
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  if( eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+   || eType==SQLITE_BCVFS_SESSION_HISTORY
+  ){
+    if( strcmp(zIfMatch,"*")!=0 ){
+      rc = bcvSessionError(
+          SQLITE_MISUSE,pzErr,"immutable session records are create-only"
+      );
+      bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+      return rc;
+    }
+  }
+  if( eType==SQLITE_BCVFS_SESSION_PUBLICATION
+   && (aObjectId==0 || !bcvSessionEqual(aObjectId,aScope,SQLITE_BCVFS_SESSION_HASH_BYTES))
+  ){
+    rc = bcvSessionError(SQLITE_AUTH,pzErr,"publication key does not match scope");
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    return rc;
+  }
+  memset(&ctx,0,sizeof(ctx));
+  rc = bcvDispatchPutMax(
+      pDisp,pBcv,zName,zIfMatch,aData,nData,
+      SQLITE_BCVFS_SESSION_RECORD_MAX_BYTES,64*1024,&ctx,bcvSessionPutCb
+  );
+  if( rc==SQLITE_OK ) rc = bcvDispatchRunAll(pDisp);
+  if( rc==SQLITE_OK ) rc = ctx.rc;
+  /* A create-only immutable-record PUT may have reached the provider before the
+  ** response was lost, or may have lost a race with the same immutable
+  ** object. Re-read the content-addressed key and reconcile only an exact
+  ** byte-for-byte match. Never turn a different object into success. */
+  if( rc!=SQLITE_OK
+   && (eType==SQLITE_BCVFS_SESSION_CHECKPOINT
+       || eType==SQLITE_BCVFS_SESSION_HISTORY)
+   && zIfMatch!=0 && strcmp(zIfMatch,"*")==0
+  ){
+    int rcPut = rc;
+    char *zPutErr = ctx.zErr;
+    unsigned char *aExisting = 0;
+    int nExisting = 0;
+    char *zExistingETag = 0;
+    char *zFetchErr = 0;
+    ctx.zErr = 0;
+    bcvSessionRelease(pFs,pCont,pDisp,pBcv,1);
+    pCont = 0;
+    pDisp = 0;
+    pBcv = 0;
+    rc = sqlite3_bcvfs_session_fetch(
+        pFs,zAlias,eType,zSessionId,aObjectId,
+        zPrincipal,zDatabase,zOperations,
+        &aExisting,&nExisting,&zExistingETag,&zFetchErr
+    );
+    if( rc==SQLITE_OK
+     && nExisting==nData
+     && memcmp(aExisting,aData,nData)==0
+    ){
+      *pzETag = zExistingETag;
+      zExistingETag = 0;
+      bReconciled = 1;
+    }else if( rc==SQLITE_OK ){
+      rc = bcvSessionError(
+          SQLITE_CONSTRAINT,pzErr,
+          "immutable session key already contains different bytes"
+      );
+    }else{
+      rc = rcPut;
+      if( pzErr && *pzErr==0 && zPutErr ){
+        *pzErr = zPutErr;
+        zPutErr = 0;
+      }
+    }
+    sqlite3_free(zPutErr);
+    sqlite3_free(zFetchErr);
+    sqlite3_free(aExisting);
+    sqlite3_free(zExistingETag);
+  }
+  if( rc==SQLITE_OK && bReconciled==0 ){
+    *pzETag = ctx.zETag;
+    ctx.zETag = 0;
+  }else if( pzErr && *pzErr==0 && ctx.zErr ){
+    *pzErr = ctx.zErr;
+    ctx.zErr = 0;
+  }
+  sqlite3_free(ctx.zETag);
+  sqlite3_free(ctx.zErr);
+  bcvSessionRelease(pFs,pCont,pDisp,pBcv,rc!=SQLITE_OK);
+  return rc;
+}
+/*
+** Fenced session publication
+**
+** The session head is the only source of an accepted candidate.  A local
+** manifest or a cache overlay is never used as publication authority.  The
+** publication-head record serializes cooperative publishers, while the
+** provider's opaque ETag condition serializes each individual object update.
+*/
+
+typedef struct BcvSessionManifestCtx BcvSessionManifestCtx;
+struct BcvSessionManifestCtx {
+  int rc;
+  unsigned char *aData;
+  int nData;
+  char *zETag;
+  char *zErr;
+};
+
+static void bcvSessionManifestFetchCb(
+  void *pArg,
+  int rc,
+  char *zETag,
+  const u8 *aData,
+  int nData,
+  const u8 *aHdrs,
+  int nHdrs
+){
+  BcvSessionManifestCtx *p = (BcvSessionManifestCtx*)pArg;
+  (void)aHdrs;
+  (void)nHdrs;
+  p->rc = rc;
+  if( rc==SQLITE_OK ){
+    if( nData<0 || nData>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES ){
+      p->rc = nData<0 ? SQLITE_CORRUPT : SQLITE_TOOBIG;
+      p->zErr = sqlite3_mprintf("invalid manifest object size");
+    }else if( aData==0 && nData>0 ){
+      p->rc = SQLITE_CORRUPT;
+      p->zErr = sqlite3_mprintf("manifest object has no body bytes");
+    }else if( zETag==0 || zETag[0]=='\0' ){
+      p->rc = SQLITE_CORRUPT;
+      p->zErr = sqlite3_mprintf("manifest object has no opaque ETag");
+    }else if( strlen(zETag)>BCV_SESSION_MAX_ETAG_BYTES ){
+      p->rc = SQLITE_TOOBIG;
+      p->zErr = sqlite3_mprintf("manifest object ETag is too long");
+    }else{
+      p->aData = (unsigned char*)sqlite3_malloc64((sqlite3_uint64)nData+1);
+      p->zETag = sqlite3_mprintf("%s",zETag);
+      if( p->aData==0 || p->zETag==0 ){
+        p->rc = SQLITE_NOMEM;
+      }else{
+        if( nData ) memcpy(p->aData,aData,nData);
+        p->aData[nData] = 0;
+        p->nData = nData;
+      }
+    }
+  }else if( zETag ){
+    p->zErr = sqlite3_mprintf("%s",zETag);
+  }
+}
