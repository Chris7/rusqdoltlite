Subject: [PATCH] Support dolt_remote set-url SQL action
Base: DoltLite master ffa0eafa93ab695f7863703a2cdaaa3fb7663374

Expose remote URL replacement through dolt_remote('set-url', ...).

diff --git a/doltlite.c b/doltlite.c
--- a/doltlite.c
+++ b/doltlite.c
@@ -588010,6 +588010,7 @@
   const char *zUrl;
   int isDelete;
   int originRequired;
+  int action;
 };
 
 static const char *remoteSqlNormalizeName(
@@ -588056,6 +588057,7 @@
     }
     return chunkStoreDeleteRemote(cs, p->zName);
   }
+  if( p->action==2 ) return chunkStoreSetRemoteUrl(cs, p->zName, p->zUrl);
   return chunkStoreAddRemote(cs, p->zName, p->zUrl);
 }
 
@@ -588621,8 +588623,34 @@
         : rc==SQLITE_NOTFOUND ? "remote not found" : 0);
       return;
     }
+  }else if( strcmp(zAction, "set-url")==0 ){
+    const char *zUrl;
+    if( argc<3 ){
+      doltliteVcResultError(ctx, db, "url required for set-url");
+      return;
+    }
+    if( argc>3 ){
+      doltliteVcResultError(ctx, db, "too many arguments");
+      return;
+    }
+    zUrl = (const char*)sqlite3_value_text(argv[2]);
+    if( !zUrl ){
+      doltliteVcResultError(ctx, db, "url required for set-url");
+      return;
+    }
+    m.zName = zName;
+    m.zUrl = zUrl;
+    m.action = 2;
+    rc = doltliteMutateRefs(db, mutateRemoteRef, &m);
+    if( rc!=SQLITE_OK ){
+      (void)doltliteVcSealSavepointError(db);
+      remoteSqlResultError(ctx, rc,
+        rc==SQLITE_NOTFOUND ? "remote not found" : 0);
+      return;
+    }
   }else{
-    doltliteVcResultError(ctx, db, "unknown action: use 'add' or 'remove'");
+    doltliteVcResultError(ctx, db,
+      "unknown action: use 'add', 'remove', or 'set-url'");
     return;
   }
 
