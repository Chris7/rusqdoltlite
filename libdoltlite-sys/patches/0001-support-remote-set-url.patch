Subject: [PATCH] Support dolt_remote set-url
Base: DoltLite v0.11.50 (b29e5ff7b968c3d770beaf941ced83b87fa9a573)

Add dolt_remote('set-url', name, url) so an existing remote can be
retargeted without removing and recreating it.

diff --git a/doltlite.c b/doltlite.c
--- a/doltlite.c
+++ b/doltlite.c
@@ -23906,6 +23906,7 @@ int chunkStoreFindTag(ChunkStore *cs, const char *zName, ProllyHash *pCommit);
 int chunkStoreAddRemote(ChunkStore *cs, const char *zName, const char *zUrl);
 int chunkStoreDeleteRemote(ChunkStore *cs, const char *zName);
 int chunkStoreFindRemote(ChunkStore *cs, const char *zName, const char **pzUrl);
+int chunkStoreSetRemoteUrl(ChunkStore *cs, const char *zName, const char *zUrl);
 
 int chunkStoreUpdateTracking(ChunkStore *cs, const char *zRemote,
                              const char *zBranch, const ProllyHash *pCommit);
@@ -87254,6 +87255,7 @@ int chunkStoreFindTag(ChunkStore *cs, const char *zName, ProllyHash *pCommit);
 int chunkStoreAddRemote(ChunkStore *cs, const char *zName, const char *zUrl);
 int chunkStoreDeleteRemote(ChunkStore *cs, const char *zName);
 int chunkStoreFindRemote(ChunkStore *cs, const char *zName, const char **pzUrl);
+int chunkStoreSetRemoteUrl(ChunkStore *cs, const char *zName, const char *zUrl);
 
 int chunkStoreUpdateTracking(ChunkStore *cs, const char *zRemote,
                              const char *zBranch, const ProllyHash *pCommit);
@@ -290541,6 +290543,17 @@ int chunkStoreAddRemote(ChunkStore *cs, const char *zName, const char *zUrl){
   return SQLITE_OK;
 }
 
+int chunkStoreSetRemoteUrl(ChunkStore *cs, const char *zName, const char *zUrl){
+  int i = findRemoteIdx(cs, zName);
+  char *zNewUrl;
+  if( i<0 ) return SQLITE_NOTFOUND;
+  zNewUrl = sqlite3_mprintf("%s", zUrl);
+  if( !zNewUrl ) return SQLITE_NOMEM;
+  sqlite3_free(cs->refs.aRemotes[i].zUrl);
+  cs->refs.aRemotes[i].zUrl = zNewUrl;
+  return SQLITE_OK;
+}
+
 int chunkStoreDeleteRemote(ChunkStore *cs, const char *zName){
   int i = findRemoteIdx(cs, zName);
   int j;
@@ -353100,13 +353113,14 @@ typedef struct RemoteMutationCtx RemoteMutationCtx;
 struct RemoteMutationCtx {
   const char *zName;
   const char *zUrl;
-  int isDelete;
+  int action;
 };
 
 static int mutateRemoteRef(sqlite3 *db, ChunkStore *cs, void *pArg){
   RemoteMutationCtx *p = (RemoteMutationCtx*)pArg;
   (void)db;
-  if( p->isDelete ) return chunkStoreDeleteRemote(cs, p->zName);
+  if( p->action==1 ) return chunkStoreDeleteRemote(cs, p->zName);
+  if( p->action==2 ) return chunkStoreSetRemoteUrl(cs, p->zName, p->zUrl);
   return chunkStoreAddRemote(cs, p->zName, p->zUrl);
 }
 
@@ -353300,7 +353314,32 @@ static void doltRemoteFunc(sqlite3_context *ctx, int argc, sqlite3_value **argv)
       return;
     }
     m.zName = zName;
-    m.isDelete = 1;
+    m.action = 1;
+    rc = doltliteMutateRefs(db, mutateRemoteRef, &m);
+    if( rc!=SQLITE_OK ){
+      (void)doltliteVcSealSavepointError(db);
+      remoteSqlResultError(ctx, rc,
+        rc==SQLITE_NOTFOUND ? "remote not found" : 0);
+      return;
+    }
+  }else if( strcmp(zAction, "set-url")==0 ){
+    const char *zUrl;
+    if( argc<3 ){
+      doltliteVcResultError(ctx, db, "url required for set-url");
+      return;
+    }
+    if( argc>3 ){
+      doltliteVcResultError(ctx, db, "too many arguments");
+      return;
+    }
+    zUrl = (const char*)sqlite3_value_text(argv[2]);
+    if( !zUrl ){
+      doltliteVcResultError(ctx, db, "url required for set-url");
+      return;
+    }
+    m.zName = zName;
+    m.zUrl = zUrl;
+    m.action = 2;
     rc = doltliteMutateRefs(db, mutateRemoteRef, &m);
     if( rc!=SQLITE_OK ){
       (void)doltliteVcSealSavepointError(db);
@@ -353309,7 +353348,8 @@ static void doltRemoteFunc(sqlite3_context *ctx, int argc, sqlite3_value **argv)
       return;
     }
   }else{
-    doltliteVcResultError(ctx, db, "unknown action: use 'add' or 'remove'");
+    doltliteVcResultError(ctx, db,
+      "unknown action: use 'add', 'remove', or 'set-url'");
     return;
   }
 
