Subject: [PATCH] Report native Dolt clone transfer progress
Base: DoltLite v0.50.15 with local patches 0001-0009 applied

Intent:
- Preserve the existing `dolt_clone(...)` SQL API and unobserved transfer path.
- Add an opt-in connection-scoped callback with Started, actual cumulative
  verified transfer/reuse counters, Finalizing, and Completed events.
- Do not scan or download the source graph to estimate totals or percentages.
  During the existing sync, count successful source payload transfers and read
  already-present chunks only from the local destination to find descendants
  and report reuse. Do not add source payload requests for local reuse.
- Keep completion after native refs installation and SQL working-tree setup.
  Lazy clones reject an active observer because they do not fetch the full graph.
- Keep all implementation in this patch, applied to staged DoltLite sources.

diff --git a/doltlite.c b/doltlite.c
index 22bc4a1..5d7a174 100644
--- a/doltlite.c
+++ b/doltlite.c
@@ -514983,6 +514983,15 @@ typedef void (SQLITE_APICALL *DoltlitePushProgressCallback)(
     void*, int, sqlite3_int64, sqlite3_int64
 );
 
+#define DOLTLITE_CLONE_PROGRESS_STARTED 1
+#define DOLTLITE_CLONE_PROGRESS_PROGRESS 2
+#define DOLTLITE_CLONE_PROGRESS_FINALIZING 3
+#define DOLTLITE_CLONE_PROGRESS_COMPLETED 4
+#define DOLTLITE_CLONE_PROGRESS_CLIENTDATA "rusqdoltlite.dolt_clone_progress.v1"
+typedef void (SQLITE_APICALL *DoltliteCloneProgressCallback)(
+    void*, int, sqlite3_int64, sqlite3_int64, sqlite3_int64, sqlite3_int64
+);
+
 typedef struct DoltliteRemote DoltliteRemote;
 struct DoltliteRemote {
   int (*xGetChunk)(DoltliteRemote*, const ProllyHash*, u8**, int*);
@@ -515020,6 +515029,14 @@ struct DoltliteRemote {
   sqlite3_int64 nPushAcknowledgedChunks;
   sqlite3_int64 nPushAcknowledgedBytes;
   int bPushPutsAckOnFlush;
+  /* Optional connection-scoped full-clone progress observer. */
+  sqlite3 *pCloneProgressDb;
+  void *pCloneProgressCtx;
+  DoltliteCloneProgressCallback xCloneProgress;
+  sqlite3_int64 nCloneDownloadedChunks;
+  sqlite3_int64 nCloneDownloadedBytes;
+  sqlite3_int64 nCloneReusedChunks;
+  sqlite3_int64 nCloneReusedBytes;
 };
 
 typedef struct DoltlitePushProgressRegistration DoltlitePushProgressRegistration;
@@ -515132,6 +515149,152 @@ static int doltlitePushProgressInterrupted(DoltliteRemote *pRemote){
       && sqlite3_is_interrupted(pRemote->pPushProgressDb);
 }
 
+typedef struct DoltliteCloneProgressRegistration DoltliteCloneProgressRegistration;
+struct DoltliteCloneProgressRegistration {
+  void *pContext;
+  DoltliteCloneProgressCallback xCallback;
+  int active;
+};
+
+static void doltliteCloneProgressRegistrationFree(void *pArg){
+  sqlite3_free(pArg);
+}
+
+SQLITE_API int SQLITE_APICALL sqlite3_doltlite_set_clone_progress_callback(
+  sqlite3 *db,
+  void *pContext,
+  DoltliteCloneProgressCallback xCallback
+){
+  DoltliteCloneProgressRegistration *pRegistration;
+  int rc;
+  if( !db || !pContext || !xCallback ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  if( sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA) ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_MISUSE;
+  }
+  pRegistration = sqlite3_malloc64(sizeof(*pRegistration));
+  if( !pRegistration ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_NOMEM;
+  }
+  pRegistration->pContext = pContext;
+  pRegistration->xCallback = xCallback;
+  pRegistration->active = 0;
+  rc = sqlite3_set_clientdata(
+      db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA, pRegistration,
+      doltliteCloneProgressRegistrationFree
+  );
+  sqlite3_mutex_leave(db->mutex);
+  return rc;
+}
+
+SQLITE_API int SQLITE_APICALL sqlite3_doltlite_clear_clone_progress_callback(
+  sqlite3 *db,
+  void *pContext
+){
+  DoltliteCloneProgressRegistration *pRegistration;
+  if( !db || !pContext ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( !pRegistration || pRegistration->pContext!=pContext ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_MISUSE;
+  }
+  {
+    int rc = sqlite3_set_clientdata(
+        db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA, 0, 0
+    );
+    sqlite3_mutex_leave(db->mutex);
+    return rc;
+  }
+}
+
+static int doltliteCloneProgressAttach(
+  sqlite3 *db,
+  DoltliteRemote *pRemote,
+  int bLazy
+){
+  DoltliteCloneProgressRegistration *pRegistration;
+  if( !db || !pRemote ) return SQLITE_MISUSE;
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( !pRegistration ) return SQLITE_OK;
+  if( bLazy || pRegistration->active ) return SQLITE_MISUSE;
+  pRegistration->active = 1;
+  pRemote->pCloneProgressDb = db;
+  pRemote->pCloneProgressCtx = pRegistration->pContext;
+  pRemote->xCloneProgress = pRegistration->xCallback;
+  pRemote->nCloneDownloadedChunks = 0;
+  pRemote->nCloneDownloadedBytes = 0;
+  pRemote->nCloneReusedChunks = 0;
+  pRemote->nCloneReusedBytes = 0;
+  return SQLITE_OK;
+}
+
+static void doltliteCloneProgressEnd(sqlite3 *db, void *pContext){
+  DoltliteCloneProgressRegistration *pRegistration;
+  if( !db || !pContext ) return;
+  sqlite3_mutex_enter(db->mutex);
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( pRegistration && pRegistration->pContext==pContext ){
+    pRegistration->active = 0;
+  }
+  sqlite3_mutex_leave(db->mutex);
+}
+
+static void doltliteCloneProgressReport(
+  DoltliteRemote *pRemote,
+  int event,
+  sqlite3_int64 count,
+  sqlite3_int64 bytes,
+  sqlite3_int64 reusedCount,
+  sqlite3_int64 reusedBytes
+){
+  if( pRemote && pRemote->xCloneProgress ){
+    pRemote->xCloneProgress(
+        pRemote->pCloneProgressCtx, event, count, bytes,
+        reusedCount, reusedBytes);
+  }
+}
+
+static void doltliteCloneProgressReportDb(sqlite3 *db, int event){
+  DoltliteCloneProgressRegistration *pRegistration;
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( pRegistration ){
+    pRegistration->xCallback(pRegistration->pContext, event, 0, 0, 0, 0);
+  }
+}
+
+static int doltliteCloneProgressInterrupted(DoltliteRemote *pRemote){
+  return pRemote && pRemote->pCloneProgressDb
+      && sqlite3_is_interrupted(pRemote->pCloneProgressDb);
+}
+
+static int doltliteCloneProgressReportChunk(
+  DoltliteRemote *pRemote,
+  int bReused,
+  int nData
+){
+  sqlite3_int64 *pChunks;
+  sqlite3_int64 *pBytes;
+  if( !pRemote || !pRemote->xCloneProgress || nData<0 ) return SQLITE_MISUSE;
+  pChunks = bReused ? &pRemote->nCloneReusedChunks
+                    : &pRemote->nCloneDownloadedChunks;
+  pBytes = bReused ? &pRemote->nCloneReusedBytes
+                   : &pRemote->nCloneDownloadedBytes;
+  if( *pChunks==0x7fffffffffffffffLL
+   || *pBytes>0x7fffffffffffffffLL-nData ){
+    return SQLITE_TOOBIG;
+  }
+  (*pChunks)++;
+  *pBytes += nData;
+  doltliteCloneProgressReport(
+      pRemote, DOLTLITE_CLONE_PROGRESS_PROGRESS,
+      pRemote->nCloneDownloadedChunks, pRemote->nCloneDownloadedBytes,
+      pRemote->nCloneReusedChunks, pRemote->nCloneReusedBytes);
+  return doltliteCloneProgressInterrupted(pRemote) ? SQLITE_INTERRUPT : SQLITE_OK;
+}
+
 static inline int doltliteRemotePersistRefs(ChunkStore *cs){
   int rc = chunkStoreSerializeRefs(cs);
   if( rc==SQLITE_OK ) rc = chunkStoreCommit(cs);
@@ -572977,6 +573140,109 @@ int doltliteSyncChunks(
   return rc;
 }
 
+/* Observed clone progress walks local chunks too, because their descendants
+** may still be missing. Source chunks are fetched only when the destination
+** does not already have them. */
+static int doltliteSyncChunksWithCloneProgress(
+  DoltliteRemote *pSrc,
+  DoltliteRemote *pDst,
+  ProllyHash *aRoots,
+  int nRoots
+){
+  SyncQueue queue;
+  ProllyHashSet seen;
+  SyncBatchBuf *pB = 0;
+  int aFetchIndex[SYNC_BATCH_SIZE];
+  int bQueueInit = 0;
+  int bSeenInit = 0;
+  int rc;
+  int i;
+
+  memset(&queue, 0, sizeof(queue));
+  memset(&seen, 0, sizeof(seen));
+  pB = sqlite3_malloc64(sizeof(*pB));
+  if( !pB ) return SQLITE_NOMEM;
+  rc = syncQueueInit(&queue);
+  if( rc!=SQLITE_OK ) goto clone_sync_done;
+  bQueueInit = 1;
+  rc = prollyHashSetInit(&seen, 256);
+  if( rc!=SQLITE_OK ) goto clone_sync_done;
+  bSeenInit = 1;
+  for(i=0; i<nRoots && rc==SQLITE_OK; i++){
+    if( !prollyHashIsEmpty(&aRoots[i])
+     && !prollyHashSetContains(&seen, &aRoots[i]) ){
+      rc = prollyHashSetAdd(&seen, &aRoots[i]);
+      if( rc==SQLITE_OK ) rc = syncQueuePush(&queue, &aRoots[i]);
+    }
+  }
+
+  while( rc==SQLITE_OK && syncQueuePending(&queue)>0 ){
+    int nBatch = 0;
+    int nFetch = 0;
+    if( doltliteCloneProgressInterrupted(pSrc) ){
+      rc = SQLITE_INTERRUPT;
+      break;
+    }
+    while( nBatch<SYNC_BATCH_SIZE
+        && syncQueuePop(&queue, &pB->aBatch[nBatch]) ){
+      nBatch++;
+    }
+    if( nBatch==0 ) break;
+    rc = pDst->xHasChunks(pDst, pB->aBatch, nBatch, pB->aPresent);
+    if( rc!=SQLITE_OK ) break;
+    for(i=0; i<nBatch; i++){
+      if( !pB->aPresent[i] ){
+        pB->aFetch[nFetch] = pB->aBatch[i];
+        aFetchIndex[i] = nFetch++;
+      }else{
+        aFetchIndex[i] = -1;
+      }
+    }
+    if( nFetch>0 && pSrc->xGetChunks ){
+      memset(pB->apData, 0, sizeof(pB->apData[0])*nFetch);
+      rc = pSrc->xGetChunks(pSrc,pB->aFetch,nFetch,pB->apData,pB->anData);
+    }
+    for(i=0; i<nBatch && rc==SQLITE_OK; i++){
+      ProllyHash *pHash = &pB->aBatch[i];
+      u8 *pOwnedData = 0;
+      const u8 *pData = 0;
+      int nData = 0;
+      int bReused = pB->aPresent[i] ? 1 : 0;
+      if( bReused ){
+        rc = pDst->xGetChunk(pDst, pHash, &pOwnedData, &nData);
+        pData = pOwnedData;
+      }else if( pSrc->xGetChunks ){
+        pData = pB->apData[aFetchIndex[i]];
+        nData = pB->anData[aFetchIndex[i]];
+        if( !pData ) rc = SQLITE_NOTFOUND;
+      }else{
+        rc = pSrc->xGetChunk(pSrc, pHash, &pOwnedData, &nData);
+        pData = pOwnedData;
+      }
+      if( rc==SQLITE_OK ) rc = syncVerifyFetchedChunk(pHash, pData, nData);
+      if( rc==SQLITE_OK && !bReused ){
+        rc = pDst->xPutChunk(pDst, pHash, pData, nData);
+      }
+      if( rc==SQLITE_OK ) rc = syncEnqueueChildren(pData, nData, &queue, &seen);
+      if( rc==SQLITE_OK ){
+        rc = doltliteCloneProgressReportChunk(pSrc, bReused, nData);
+      }
+      sqlite3_free(pOwnedData);
+    }
+    if( pSrc->xGetChunks ){
+      for(i=0; i<nFetch; i++){
+        sqlite3_free(pB->apData[i]);
+        pB->apData[i] = 0;
+      }
+    }
+  }
+clone_sync_done:
+  if( bSeenInit ) prollyHashSetFree(&seen);
+  if( bQueueInit ) syncQueueFree(&queue);
+  sqlite3_free(pB);
+  return rc;
+}
