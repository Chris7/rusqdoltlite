+
+typedef struct DoltliteCloneProgressRegistration DoltliteCloneProgressRegistration;
+struct DoltliteCloneProgressRegistration {
+  void *pContext;
+  DoltliteCloneProgressCallback xCallback;
+  int active;
+};
+
+static void doltliteCloneProgressRegistrationFree(void *pArg){
+  sqlite3_free(pArg);
+}
+
+SQLITE_API int SQLITE_APICALL sqlite3_doltlite_set_clone_progress_callback(
+  sqlite3 *db,
+  void *pContext,
+  DoltliteCloneProgressCallback xCallback
+){
+  DoltliteCloneProgressRegistration *pRegistration;
+  int rc;
+  if( !db || !pContext || !xCallback ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  if( sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA) ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_MISUSE;
+  }
+  pRegistration = sqlite3_malloc64(sizeof(*pRegistration));
+  if( !pRegistration ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_NOMEM;
+  }
+  pRegistration->pContext = pContext;
+  pRegistration->xCallback = xCallback;
+  pRegistration->active = 0;
+  rc = sqlite3_set_clientdata(
+      db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA, pRegistration,
+      doltliteCloneProgressRegistrationFree
+  );
+  sqlite3_mutex_leave(db->mutex);
+  return rc;
+}
+
+SQLITE_API int SQLITE_APICALL sqlite3_doltlite_clear_clone_progress_callback(
+  sqlite3 *db,
+  void *pContext
+){
+  DoltliteCloneProgressRegistration *pRegistration;
+  if( !db || !pContext ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( !pRegistration || pRegistration->pContext!=pContext ){
+    sqlite3_mutex_leave(db->mutex);
+    return SQLITE_MISUSE;
+  }
+  {
+    int rc = sqlite3_set_clientdata(
+        db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA, 0, 0
+    );
+    sqlite3_mutex_leave(db->mutex);
+    return rc;
+  }
+}
+
+static int doltliteCloneProgressAttach(
+  sqlite3 *db,
+  DoltliteRemote *pRemote,
+  int bLazy
+){
+  DoltliteCloneProgressRegistration *pRegistration;
+  if( !db || !pRemote ) return SQLITE_MISUSE;
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( !pRegistration ) return SQLITE_OK;
+  if( bLazy || pRegistration->active ) return SQLITE_MISUSE;
+  pRegistration->active = 1;
+  pRemote->pCloneProgressDb = db;
+  pRemote->pCloneProgressCtx = pRegistration->pContext;
+  pRemote->xCloneProgress = pRegistration->xCallback;
+  pRemote->nCloneDownloadedChunks = 0;
+  pRemote->nCloneDownloadedBytes = 0;
+  pRemote->nCloneReusedChunks = 0;
+  pRemote->nCloneReusedBytes = 0;
+  return SQLITE_OK;
+}
+
+static void doltliteCloneProgressEnd(sqlite3 *db, void *pContext){
+  DoltliteCloneProgressRegistration *pRegistration;
+  if( !db || !pContext ) return;
+  sqlite3_mutex_enter(db->mutex);
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( pRegistration && pRegistration->pContext==pContext ){
+    pRegistration->active = 0;
+  }
+  sqlite3_mutex_leave(db->mutex);
+}
+
+static void doltliteCloneProgressReport(
+  DoltliteRemote *pRemote,
+  int event,
+  sqlite3_int64 count,
+  sqlite3_int64 bytes,
+  sqlite3_int64 reusedCount,
+  sqlite3_int64 reusedBytes
+){
+  if( pRemote && pRemote->xCloneProgress ){
+    pRemote->xCloneProgress(
+        pRemote->pCloneProgressCtx, event, count, bytes,
+        reusedCount, reusedBytes);
+  }
+}
+
+static void doltliteCloneProgressReportDb(sqlite3 *db, int event){
+  DoltliteCloneProgressRegistration *pRegistration;
+  pRegistration = sqlite3_get_clientdata(db, DOLTLITE_CLONE_PROGRESS_CLIENTDATA);
+  if( pRegistration ){
+    pRegistration->xCallback(pRegistration->pContext, event, 0, 0, 0, 0);
+  }
+}
+
+static int doltliteCloneProgressInterrupted(DoltliteRemote *pRemote){
+  return pRemote && pRemote->pCloneProgressDb
+      && sqlite3_is_interrupted(pRemote->pCloneProgressDb);
+}
+
+static int doltliteCloneProgressReportChunk(
+  DoltliteRemote *pRemote,
+  int bReused,
+  int nData
+){
+  sqlite3_int64 *pChunks;
+  sqlite3_int64 *pBytes;
+  if( !pRemote || !pRemote->xCloneProgress || nData<0 ) return SQLITE_MISUSE;
+  pChunks = bReused ? &pRemote->nCloneReusedChunks
+                    : &pRemote->nCloneDownloadedChunks;
+  pBytes = bReused ? &pRemote->nCloneReusedBytes
+                   : &pRemote->nCloneDownloadedBytes;
+  if( *pChunks==0x7fffffffffffffffLL
+   || *pBytes>0x7fffffffffffffffLL-nData ){
+    return SQLITE_TOOBIG;
+  }
+  (*pChunks)++;
+  *pBytes += nData;
+  doltliteCloneProgressReport(
+      pRemote, DOLTLITE_CLONE_PROGRESS_PROGRESS,
+      pRemote->nCloneDownloadedChunks, pRemote->nCloneDownloadedBytes,
+      pRemote->nCloneReusedChunks, pRemote->nCloneReusedBytes);
+  return doltliteCloneProgressInterrupted(pRemote) ? SQLITE_INTERRUPT : SQLITE_OK;
 }
 
