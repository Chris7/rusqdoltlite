@@ -575722,11 +576022,13 @@ static void doltCloneFunc(sqlite3_context *ctx, int argc, sqlite3_value **argv){
     }
     sqlite3_free(zPreparedBranch);
     if( rc!=SQLITE_OK ){
+      doltliteCloneProgressEnd(db, pCloneProgressCtx);
       remoteSqlRestoreAndReport(ctx, db, cs, &savedState, rc,
