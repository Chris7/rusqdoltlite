+/* Observed clone progress walks local chunks too, because their descendants
+** may still be missing. Source chunks are fetched only when the destination
+** does not already have them. */
+static int doltliteSyncChunksWithCloneProgress(
+  DoltliteRemote *pSrc,
+  DoltliteRemote *pDst,
+  ProllyHash *aRoots,
+  int nRoots
+){
+  SyncQueue queue;
+  ProllyHashSet seen;
+  SyncBatchBuf *pB = 0;
+  int aFetchIndex[SYNC_BATCH_SIZE];
+  int bQueueInit = 0;
+  int bSeenInit = 0;
+  int rc;
+  int i;
+
+  memset(&queue, 0, sizeof(queue));
+  memset(&seen, 0, sizeof(seen));
+  pB = sqlite3_malloc64(sizeof(*pB));
+  if( !pB ) return SQLITE_NOMEM;
+  rc = syncQueueInit(&queue);
+  if( rc!=SQLITE_OK ) goto clone_sync_done;
+  bQueueInit = 1;
+  rc = prollyHashSetInit(&seen, 256);
+  if( rc!=SQLITE_OK ) goto clone_sync_done;
+  bSeenInit = 1;
+  for(i=0; i<nRoots && rc==SQLITE_OK; i++){
+    if( !prollyHashIsEmpty(&aRoots[i])
+     && !prollyHashSetContains(&seen, &aRoots[i]) ){
+      rc = prollyHashSetAdd(&seen, &aRoots[i]);
+      if( rc==SQLITE_OK ) rc = syncQueuePush(&queue, &aRoots[i]);
+    }
+  }
+
+  while( rc==SQLITE_OK && syncQueuePending(&queue)>0 ){
+    int nBatch = 0;
+    int nFetch = 0;
+    if( doltliteCloneProgressInterrupted(pSrc) ){
+      rc = SQLITE_INTERRUPT;
+      break;
+    }
+    while( nBatch<SYNC_BATCH_SIZE
+        && syncQueuePop(&queue, &pB->aBatch[nBatch]) ){
+      nBatch++;
+    }
+    if( nBatch==0 ) break;
+    rc = pDst->xHasChunks(pDst, pB->aBatch, nBatch, pB->aPresent);
+    if( rc!=SQLITE_OK ) break;
+    for(i=0; i<nBatch; i++){
+      if( !pB->aPresent[i] ){
+        pB->aFetch[nFetch] = pB->aBatch[i];
+        aFetchIndex[i] = nFetch++;
+      }else{
+        aFetchIndex[i] = -1;
+      }
+    }
+    if( nFetch>0 && pSrc->xGetChunks ){
+      memset(pB->apData, 0, sizeof(pB->apData[0])*nFetch);
+      rc = pSrc->xGetChunks(pSrc,pB->aFetch,nFetch,pB->apData,pB->anData);
+    }
+    for(i=0; i<nBatch && rc==SQLITE_OK; i++){
+      ProllyHash *pHash = &pB->aBatch[i];
+      u8 *pOwnedData = 0;
+      const u8 *pData = 0;
+      int nData = 0;
+      int bReused = pB->aPresent[i] ? 1 : 0;
+      if( bReused ){
+        rc = pDst->xGetChunk(pDst, pHash, &pOwnedData, &nData);
+        pData = pOwnedData;
+      }else if( pSrc->xGetChunks ){
+        pData = pB->apData[aFetchIndex[i]];
+        nData = pB->anData[aFetchIndex[i]];
+        if( !pData ) rc = SQLITE_NOTFOUND;
+      }else{
+        rc = pSrc->xGetChunk(pSrc, pHash, &pOwnedData, &nData);
+        pData = pOwnedData;
+      }
+      if( rc==SQLITE_OK ) rc = syncVerifyFetchedChunk(pHash, pData, nData);
+      if( rc==SQLITE_OK && !bReused ){
+        rc = pDst->xPutChunk(pDst, pHash, pData, nData);
+      }
+      if( rc==SQLITE_OK ) rc = syncEnqueueChildren(pData, nData, &queue, &seen);
+      if( rc==SQLITE_OK ){
+        rc = doltliteCloneProgressReportChunk(pSrc, bReused, nData);
+      }
+      sqlite3_free(pOwnedData);
+    }
+    if( pSrc->xGetChunks ){
+      for(i=0; i<nFetch; i++){
+        sqlite3_free(pB->apData[i]);
+        pB->apData[i] = 0;
+      }
+    }
+  }
+clone_sync_done:
+  if( bSeenInit ) prollyHashSetFree(&seen);
+  if( bQueueInit ) syncQueueFree(&queue);
+  sqlite3_free(pB);
+  return rc;
+}
