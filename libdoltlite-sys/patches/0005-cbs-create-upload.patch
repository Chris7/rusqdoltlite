+static int bcvfsCreateLocalDatabase(
+  sqlite3_bcvfs *pFs,
+  Container *pCont,
+  const char *zName,
+  int nName
+){
+  int rc = SQLITE_OK;
+  Manifest *pMan = 0;
+
+  if( nName<=0 || nName>=BCV_DBNAME_SIZE ){
+    return SQLITE_CANTOPEN;
+  }
+
+  bcvfsEnterState(pFs, pCont, CONTAINER_STATE_COPY);
+  if( bcvfsFindDatabase(pCont->pMan, zName, nName) ){
+    rc = SQLITE_CANTOPEN;
+  }else{
+    rc = bcvManifestDup(pCont->pMan, &pMan);
+    if( rc==SQLITE_OK ){
+      ManifestDb *pDb = &pMan->aDb[pMan->nDb++];
+      memset(pDb, 0, sizeof(ManifestDb));
+      pDb->iDbId = pFs->iNextLocalId++;
+      pDb->iVersion = 1;
+      memcpy(pDb->zDName, zName, nName);
+      rc = bcvManifestInstall(&pFs->c, pCont, pMan);
+      pMan = 0;
+    }
+  }
+  bcvManifestDeref(pMan);
+  bcvfsLeaveState(pFs, pCont);
+  return rc;
+}
