+enum {
+  HTTP_CHUNK_SIZE = 0,
+  HTTP_CHUNK_SIZE_LF,
+  HTTP_CHUNK_EXT_BEFORE_SEMI,
+  HTTP_CHUNK_EXT_NAME_START,
+  HTTP_CHUNK_EXT_NAME,
+  HTTP_CHUNK_EXT_NAME_OWS,
+  HTTP_CHUNK_EXT_VALUE_START,
+  HTTP_CHUNK_EXT_TOKEN_VALUE,
+  HTTP_CHUNK_EXT_TOKEN_VALUE_OWS,
+  HTTP_CHUNK_EXT_QUOTED_VALUE,
+  HTTP_CHUNK_EXT_QUOTED_ESCAPE,
+  HTTP_CHUNK_EXT_QUOTED_END,
+  HTTP_CHUNK_DATA,
+  HTTP_CHUNK_DATA_CR,
+  HTTP_CHUNK_DATA_LF,
+  HTTP_CHUNK_TRAILER_START,
+  HTTP_CHUNK_TRAILER_LINE,
+  HTTP_CHUNK_TRAILER_LINE_LF,
+  HTTP_CHUNK_TRAILER_END_LF,
+  HTTP_CHUNK_DONE
+};
+
+typedef struct HttpChunkedDecoder HttpChunkedDecoder;
+struct HttpChunkedDecoder {
+  int state;
+  int nSizeDigits;
+  int nSizeLineBytes;
+  int nTrailerLineBytes;
+  int nTrailerNameBytes;
+  int bTrailerColon;
+  i64 nChunkSize;
+  i64 nChunkRemaining;
+  i64 nDecoded;
+  i64 nWire;
+  i64 nTrailerBytes;
+};
+
+static int httpChunkedHexValue(u8 c){
+  if( c>='0' && c<='9' ) return c-'0';
+  if( c>='a' && c<='f' ) return c-'a'+10;
+  if( c>='A' && c<='F' ) return c-'A'+10;
+  return -1;
+}
+
+static int httpTokenChar(u8 c){
+  if( (c>='0' && c<='9') || (c>='A' && c<='Z')
+   || (c>='a' && c<='z') ) return 1;
+  switch( c ){
+    case '!': case '#': case '$': case '%': case '&': case 0x27:
+    case '*': case '+': case '-': case '.': case '^': case '_':
+    case '`': case '|': case '~':
+      return 1;
+  }
+  return 0;
+}
+
+static int httpChunkQuotedTextChar(u8 c){
+  return c=='\t' || c==' ' || c==0x21
+      || (c>=0x23 && c<=0x5b) || (c>=0x5d && c<=0x7e) || c>=0x80;
+}
+
+static int httpChunkQuotedPairChar(u8 c){
+  return c=='\t' || c==' ' || (c>=0x21 && c<=0x7e) || c>=0x80;
+}
+
+static void httpChunkedDecoderInit(HttpChunkedDecoder *p){
+  memset(p, 0, sizeof(*p));
+  p->state = HTTP_CHUNK_SIZE;
+}
+
+/* Feed new wire bytes once. A NULL output validates framing without copying. */
+static int httpChunkedDecoderFeed(
+  HttpChunkedDecoder *p,
+  const u8 *pIn,
+  int nIn,
+  u8 *pOut,
+  int nOutMax,
+  int *pnOut,
+  int *pbDone
+){
+  int i = 0;
+  int nProduced = 0;
+
+  *pnOut = 0;
+  *pbDone = 0;
+  while( i<nIn ){
+    int c = pIn[i];
+
+    if( p->state==HTTP_CHUNK_DONE ) return SQLITE_PROTOCOL;
+    if( p->state==HTTP_CHUNK_DATA ){
+      i64 nTake = nIn - i;
+      if( nTake>p->nChunkRemaining ) nTake = p->nChunkRemaining;
+      if( nTake>HTTP_RESP_MAX_BYTES-p->nWire
+       || nTake>HTTP_RESP_MAX_BYTES-p->nDecoded ){
+        return SQLITE_TOOBIG;
+      }
+      if( pOut && (i64)nProduced+nTake>nOutMax ) return SQLITE_TOOBIG;
+      if( pOut ) memcpy(pOut+nProduced, pIn+i, (size_t)nTake);
+      p->nWire += nTake;
+      p->nDecoded += nTake;
+      p->nChunkRemaining -= nTake;
+      nProduced += (int)nTake;
+      i += (int)nTake;
+      if( p->nChunkRemaining==0 ) p->state = HTTP_CHUNK_DATA_CR;
+      continue;
+    }
+
+    if( p->nWire>=HTTP_RESP_MAX_BYTES ) return SQLITE_TOOBIG;
+    p->nWire++;
+    if( p->state<=HTTP_CHUNK_EXT_QUOTED_END ){
+      if( p->nSizeLineBytes>=HTTP_HEADER_MAX_BYTES ){
+        return SQLITE_TOOBIG;
+      }
+      p->nSizeLineBytes++;
+    }
+    if( p->state>=HTTP_CHUNK_TRAILER_START
+     && p->state<=HTTP_CHUNK_TRAILER_END_LF ){
+      if( p->nTrailerBytes>=HTTP_HEADER_MAX_BYTES ) return SQLITE_TOOBIG;
+      p->nTrailerBytes++;
+    }
+
+    switch( p->state ){
+      case HTTP_CHUNK_SIZE: {
+        int digit = httpChunkedHexValue((u8)c);
+        if( digit>=0 ){
+          if( p->nChunkSize>(HTTP_RESP_MAX_BYTES-digit)/16 ){
+            return SQLITE_TOOBIG;
+          }
+          p->nChunkSize = p->nChunkSize*16 + digit;
+          p->nSizeDigits++;
+        }else if( c=='\r' && p->nSizeDigits>0 ){
+          p->state = HTTP_CHUNK_SIZE_LF;
+        }else if( c==';' && p->nSizeDigits>0 ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+        }else if( (c==' ' || c=='\t') && p->nSizeDigits>0 ){
+          p->state = HTTP_CHUNK_EXT_BEFORE_SEMI;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      }
+      case HTTP_CHUNK_SIZE_LF:
+        if( c!='\n' ) return SQLITE_PROTOCOL;
+        if( p->nChunkSize==0 ){
+          p->state = HTTP_CHUNK_TRAILER_START;
+          p->nTrailerBytes = 0;
+        }else{
+          if( p->nChunkSize>HTTP_RESP_MAX_BYTES-p->nDecoded ){
+            return SQLITE_TOOBIG;
+          }
+          p->nChunkRemaining = p->nChunkSize;
+          p->state = HTTP_CHUNK_DATA;
+        }
+        break;
+      case HTTP_CHUNK_EXT_BEFORE_SEMI:
+        if( c==' ' || c=='\t' ) break;
+        if( c==';' ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+          break;
+        }
+        return SQLITE_PROTOCOL;
+      case HTTP_CHUNK_EXT_NAME_START:
+        if( c==' ' || c=='\t' ) break;
+        if( !httpTokenChar((u8)c) ) return SQLITE_PROTOCOL;
+        p->state = HTTP_CHUNK_EXT_NAME;
+        break;
+      case HTTP_CHUNK_EXT_NAME:
+        if( httpTokenChar((u8)c) ) break;
+        if( c=='=' ){
+          p->state = HTTP_CHUNK_EXT_VALUE_START;
+        }else if( c==';' ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+        }else if( c==' ' || c=='\t' ){
+          p->state = HTTP_CHUNK_EXT_NAME_OWS;
+        }else if( c=='\r' ){
+          p->state = HTTP_CHUNK_SIZE_LF;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_EXT_NAME_OWS:
+        if( c==' ' || c=='\t' ) break;
+        if( c=='=' ){
+          p->state = HTTP_CHUNK_EXT_VALUE_START;
+        }else if( c==';' ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+        }else if( c=='\r' ){
+          p->state = HTTP_CHUNK_SIZE_LF;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_EXT_VALUE_START:
+        if( c==' ' || c=='\t' ) break;
+        if( httpTokenChar((u8)c) ){
+          p->state = HTTP_CHUNK_EXT_TOKEN_VALUE;
+        }else if( c=='"' ){
+          p->state = HTTP_CHUNK_EXT_QUOTED_VALUE;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_EXT_TOKEN_VALUE:
+        if( httpTokenChar((u8)c) ) break;
+        if( c==' ' || c=='\t' ){
+          p->state = HTTP_CHUNK_EXT_TOKEN_VALUE_OWS;
+        }else if( c==';' ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+        }else if( c=='\r' ){
+          p->state = HTTP_CHUNK_SIZE_LF;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_EXT_TOKEN_VALUE_OWS:
+        if( c==' ' || c=='\t' ) break;
+        if( c==';' ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+        }else if( c=='\r' ){
+          p->state = HTTP_CHUNK_SIZE_LF;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_EXT_QUOTED_VALUE:
+        if( c=='"' ){
+          p->state = HTTP_CHUNK_EXT_QUOTED_END;
+        }else if( c==0x5c ){
+          p->state = HTTP_CHUNK_EXT_QUOTED_ESCAPE;
+        }else if( !httpChunkQuotedTextChar((u8)c) ){
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_EXT_QUOTED_ESCAPE:
+        if( !httpChunkQuotedPairChar((u8)c) ) return SQLITE_PROTOCOL;
+        p->state = HTTP_CHUNK_EXT_QUOTED_VALUE;
+        break;
+      case HTTP_CHUNK_EXT_QUOTED_END:
+        if( c==' ' || c=='\t' ) break;
+        if( c==';' ){
+          p->state = HTTP_CHUNK_EXT_NAME_START;
+        }else if( c=='\r' ){
+          p->state = HTTP_CHUNK_SIZE_LF;
+        }else{
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_DATA_CR:
+        if( c!='\r' ) return SQLITE_PROTOCOL;
+        p->state = HTTP_CHUNK_DATA_LF;
+        break;
+      case HTTP_CHUNK_DATA_LF:
+        if( c!='\n' ) return SQLITE_PROTOCOL;
+        p->state = HTTP_CHUNK_SIZE;
+        p->nChunkSize = 0;
+        p->nSizeDigits = 0;
+        p->nSizeLineBytes = 0;
+        break;
+      case HTTP_CHUNK_TRAILER_START:
+        if( c=='\r' ){
+          p->state = HTTP_CHUNK_TRAILER_END_LF;
+        }else if( c=='\n' || !httpTokenChar((u8)c) ){
+          return SQLITE_PROTOCOL;
+        }else{
+          p->state = HTTP_CHUNK_TRAILER_LINE;
+          p->nTrailerLineBytes = 1;
+          p->nTrailerNameBytes = 1;
+          p->bTrailerColon = 0;
+        }
+        break;
+      case HTTP_CHUNK_TRAILER_LINE:
+        if( p->nTrailerLineBytes>=HTTP_HEADER_MAX_BYTES ){
+          return SQLITE_TOOBIG;
+        }
+        p->nTrailerLineBytes++;
+        if( c=='\r' ){
+          if( !p->bTrailerColon || p->nTrailerNameBytes==0 ){
+            return SQLITE_PROTOCOL;
+          }
+          p->state = HTTP_CHUNK_TRAILER_LINE_LF;
+        }else if( c=='\n' ){
+          return SQLITE_PROTOCOL;
+        }else if( !p->bTrailerColon ){
+          if( c==':' ){
+            if( p->nTrailerNameBytes==0 ) return SQLITE_PROTOCOL;
+            p->bTrailerColon = 1;
+          }else{
+            if( !httpTokenChar((u8)c) ) return SQLITE_PROTOCOL;
+            p->nTrailerNameBytes++;
+          }
+        }else if( (c<0x20 && c!='\t') || c==0x7f ){
+          return SQLITE_PROTOCOL;
+        }
+        break;
+      case HTTP_CHUNK_TRAILER_LINE_LF:
+        if( c!='\n' ) return SQLITE_PROTOCOL;
+        p->state = HTTP_CHUNK_TRAILER_START;
+        break;
+      case HTTP_CHUNK_TRAILER_END_LF:
+        if( c!='\n' ) return SQLITE_PROTOCOL;
+        p->state = HTTP_CHUNK_DONE;
+        break;
+      default:
+        return SQLITE_PROTOCOL;
+    }
+    i++;
+  }
+  *pnOut = nProduced;
+  *pbDone = p->state==HTTP_CHUNK_DONE;
+  return SQLITE_OK;
+}
+
+static int httpDecodeChunkedBody(
+  const u8 *pIn,
+  int nIn,
+  u8 **ppOut,
+  int *pnOut
+){
+  HttpChunkedDecoder decoder;
+  u8 *pOut = 0;
+  int nDecoded = 0;
+  int bDone = 0;
+  int rc;
+
+  *ppOut = 0;
+  *pnOut = 0;
+  if( nIn<0 || (i64)nIn>HTTP_RESP_MAX_BYTES ) return SQLITE_TOOBIG;
+  pOut = sqlite3_malloc64((i64)nIn + 1);
+  if( !pOut ) return SQLITE_NOMEM;
+  httpChunkedDecoderInit(&decoder);
+  rc = httpChunkedDecoderFeed(&decoder, pIn, nIn, pOut, nIn,
+                              &nDecoded, &bDone);
+  if( rc==SQLITE_OK && !bDone ) rc = SQLITE_PROTOCOL;
+  if( rc!=SQLITE_OK ){
+    sqlite3_free(pOut);
+    return rc;
+  }
+  pOut[nDecoded] = 0;
+  *ppOut = pOut;
+  *pnOut = nDecoded;
+  return SQLITE_OK;
+}
