diff --git a/doltlite_server_socket.h b/doltlite_server_socket.h
new file mode 100644
index 0000000000000000000000000000000000000000..701805476a4a565399360c6511b83350ec764579
--- /dev/null
+++ b/doltlite_server_socket.h
@@ -0,0 +1,122 @@
+#ifndef DOLTLITE_SERVER_SOCKET_H
+#define DOLTLITE_SERVER_SOCKET_H
+
+#include <stddef.h>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+
+typedef SOCKET doltlite_server_socket_t;
+typedef int doltlite_server_socklen_t;
+typedef WSAPOLLFD doltlite_server_pollfd;
+#define DOLTLITE_SERVER_INVALID_SOCKET INVALID_SOCKET
+#define doltliteServerSocketClose closesocket
+#define doltliteServerSocketShutdown(fd) shutdown((fd), SD_BOTH)
+#define doltliteServerPoll(fds, n, ms) WSAPoll((fds), (ULONG)(n), (ms))
+#define DOLTLITE_SERVER_POLLIN POLLRDNORM
+#define DOLTLITE_SERVER_POLLOUT POLLWRNORM
+#define DOLTLITE_SERVER_POLLERR POLLERR
+#define DOLTLITE_SERVER_POLLHUP POLLHUP
+#define DOLTLITE_SERVER_POLLNVAL POLLNVAL
+
+static inline int doltliteServerSocketIsValid(doltlite_server_socket_t fd) {
+  return fd != INVALID_SOCKET;
+}
+
+static inline int doltliteServerSocketSend(
+  doltlite_server_socket_t fd,
+  const void *buffer,
+  size_t length
+){
+  if (length > 0x7fffffffU) length = 0x7fffffffU;
+  return send(fd, (const char *)buffer, (int)length, 0);
+}
+
+static inline int doltliteServerSocketRecv(
+  doltlite_server_socket_t fd,
+  void *buffer,
+  size_t length
+){
+  if (length > 0x7fffffffU) length = 0x7fffffffU;
+  return recv(fd, (char *)buffer, (int)length, 0);
+}
+
+static inline int doltliteServerSocketSetTimeout(
+  doltlite_server_socket_t fd,
+  int timeoutMs
+){
+  DWORD timeout = (DWORD)timeoutMs;
+  int rc1 = setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO,
+                       (const char *)&timeout, sizeof(timeout));
+  int rc2 = setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO,
+                       (const char *)&timeout, sizeof(timeout));
+  return rc1 == 0 && rc2 == 0 ? 0 : 1;
+}
+
+static inline int doltliteServerSocketSetNonblocking(
+  doltlite_server_socket_t fd
+){
+  u_long enabled = 1;
+  return ioctlsocket(fd, FIONBIO, &enabled) == 0 ? 0 : 1;
+}
+
+#else
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+typedef int doltlite_server_socket_t;
+typedef socklen_t doltlite_server_socklen_t;
+typedef struct pollfd doltlite_server_pollfd;
+#define DOLTLITE_SERVER_INVALID_SOCKET (-1)
+#define doltliteServerSocketClose close
+#define doltliteServerSocketShutdown(fd) shutdown((fd), SHUT_RDWR)
+#define doltliteServerPoll(fds, n, ms) poll((fds), (n), (ms))
+#define DOLTLITE_SERVER_POLLIN POLLIN
+#define DOLTLITE_SERVER_POLLOUT POLLOUT
+#define DOLTLITE_SERVER_POLLERR POLLERR
+#define DOLTLITE_SERVER_POLLHUP POLLHUP
+#define DOLTLITE_SERVER_POLLNVAL POLLNVAL
+
+static inline int doltliteServerSocketIsValid(doltlite_server_socket_t fd) {
+  return fd >= 0;
+}
+
+static inline int doltliteServerSocketSend(
+  doltlite_server_socket_t fd,
+  const void *buffer,
+  size_t length
+){
+  int flags = 0;
+#ifdef MSG_NOSIGNAL
+  flags = MSG_NOSIGNAL;
+#endif
+  return (int)send(fd, buffer, length, flags);
+}
+
+static inline int doltliteServerSocketRecv(
+  doltlite_server_socket_t fd,
+  void *buffer,
+  size_t length
+){
+  return (int)recv(fd, buffer, length, 0);
+}
+
+static inline int doltliteServerSocketSetTimeout(
+  doltlite_server_socket_t fd,
+  int timeoutMs
+){
+  struct timeval timeout;
+  int rc1, rc2;
+  timeout.tv_sec = timeoutMs / 1000;
+  timeout.tv_usec = (timeoutMs % 1000) * 1000;
+  rc1 = setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+  rc2 = setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+  return rc1 == 0 && rc2 == 0 ? 0 : 1;
+}
+#endif
+
+#endif
