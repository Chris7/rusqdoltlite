+                             doltliteInitializeMbedtlsThreading,
+                             NULL, NULL) ? 0 : 1;
+}
+#else
+static pthread_once_t doltliteMbedtlsThreadingOnce = PTHREAD_ONCE_INIT;
+static void doltliteInitializeMbedtlsThreading(void) {
+  mbedtls_threading_set_alt(doltliteMbedtlsMutexInit,
+                            doltliteMbedtlsMutexFree,
+                            doltliteMbedtlsMutexLock,
+                            doltliteMbedtlsMutexUnlock);
+}
+int doltliteMbedtlsThreadingInit(void) {
+  return pthread_once(&doltliteMbedtlsThreadingOnce,
+                      doltliteInitializeMbedtlsThreading);
+}
+#endif
+#else
+int doltliteMbedtlsThreadingInit(void) { return 0; }
