+static int doltliteMbedtlsMutexLock(mbedtls_threading_mutex_t *mutex) {
+  if (!mutex) return MBEDTLS_ERR_THREADING_BAD_INPUT_DATA;
+  return doltliteMutexLock(mutex) == 0 ? 0 : MBEDTLS_ERR_THREADING_MUTEX_ERROR;
