+#ifdef _WIN32
+static INIT_ONCE doltliteMbedtlsThreadingOnce = INIT_ONCE_STATIC_INIT;
+static BOOL CALLBACK doltliteInitializeMbedtlsThreading(
+  PINIT_ONCE once, PVOID parameter, PVOID *context
+){
+  (void)once;
+  (void)parameter;
+  (void)context;
+  mbedtls_threading_set_alt(doltliteMbedtlsMutexInit,
+                            doltliteMbedtlsMutexFree,
+                            doltliteMbedtlsMutexLock,
+                            doltliteMbedtlsMutexUnlock);
+  return TRUE;
+}
+int doltliteMbedtlsThreadingInit(void) {
