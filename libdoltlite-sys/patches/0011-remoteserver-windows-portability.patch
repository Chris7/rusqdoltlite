new file mode 100644
index 0000000000000000000000000000000000000000..0a72a2f66384c8d499b86eb9dab50f9779d5f70a
--- /dev/null
+++ b/doltlite_thread.h
@@ -0,0 +1,128 @@
+#ifndef DOLTLITE_THREAD_H
+#define DOLTLITE_THREAD_H
+
+#ifdef _WIN32
+#include <process.h>
+#include <stdint.h>
+#include <windows.h>
+
+typedef struct DoltliteMutex {
+  SRWLOCK lock;
+  int initialized;
+} DoltliteMutex;
+typedef CONDITION_VARIABLE DoltliteCond;
+typedef HANDLE DoltliteThread;
+typedef unsigned (__stdcall *DoltliteThreadEntry)(void *);
+#define DOLTLITE_THREAD_ENTRY(name) static unsigned __stdcall name(void *pArg)
+#define DOLTLITE_THREAD_RETURN return 0
+
+static inline int doltliteMutexInit(DoltliteMutex *mutex) {
+  InitializeSRWLock(&mutex->lock);
+  mutex->initialized = 1;
+  return 0;
+}
+static inline void doltliteMutexDestroy(DoltliteMutex *mutex) {
+  mutex->initialized = 0;
+}
+static inline int doltliteMutexLock(DoltliteMutex *mutex) {
+  if (!mutex->initialized) return -1;
+  AcquireSRWLockExclusive(&mutex->lock);
+  return 0;
+}
+static inline int doltliteMutexTryLock(DoltliteMutex *mutex) {
+  if (!mutex->initialized) return -1;
+  return TryAcquireSRWLockExclusive(&mutex->lock) ? 0 : -1;
+}
+static inline int doltliteMutexUnlock(DoltliteMutex *mutex) {
+  if (!mutex->initialized) return -1;
+  ReleaseSRWLockExclusive(&mutex->lock);
+  return 0;
+}
+static inline int doltliteCondInit(DoltliteCond *condition) {
+  InitializeConditionVariable(condition);
+  return 0;
+}
+static inline void doltliteCondDestroy(DoltliteCond *condition) {
+  (void)condition;
+}
+static inline int doltliteCondWait(DoltliteCond *condition, DoltliteMutex *mutex) {
+  return SleepConditionVariableSRW(condition, &mutex->lock, INFINITE, 0) ? 0 : -1;
+}
+static inline int doltliteCondSignal(DoltliteCond *condition) {
+  WakeConditionVariable(condition);
+  return 0;
+}
+static inline int doltliteCondBroadcast(DoltliteCond *condition) {
+  WakeAllConditionVariable(condition);
+  return 0;
+}
+static inline int doltliteThreadCreate(
+  DoltliteThread *thread, DoltliteThreadEntry entry, void *arg
+){
+  uintptr_t handle = _beginthreadex(NULL, 0, entry, arg, 0, NULL);
+  if (handle == 0) return -1;
+  *thread = (HANDLE)handle;
+  return 0;
+}
+static inline int doltliteThreadJoin(DoltliteThread thread) {
+  DWORD result = WaitForSingleObject(thread, INFINITE);
+  CloseHandle(thread);
+  return result == WAIT_OBJECT_0 ? 0 : -1;
+}
+#else
+#include <pthread.h>
+
+typedef struct DoltliteMutex {
+  pthread_mutex_t mutex;
+  int initialized;
+} DoltliteMutex;
+typedef pthread_cond_t DoltliteCond;
+typedef pthread_t DoltliteThread;
