+  DoltliteServerConn *c = (DoltliteServerConn*)sqlite3_malloc((int)sizeof(*c));
+  if( !c ) return NULL;
   memset(c, 0, sizeof(*c));
-  c->useTls = 0;
-  c->ownsConf = 0;
-  mbedtls_net_init(&c->net);
-  c->net.fd = clientFd;
+  c->serverFd = clientFd;
+  c->timeoutMs = timeoutMs;
+  c->stopCheck = stopCheck;
+  c->stopContext = stopContext;
   configureSocket(clientFd);
   return c;
 }
+
+int doltliteServerConnReadNonblock(DoltliteServerConn *c, void *buf, int nbuf){
+  int n;
+  if( !c || nbuf<=0 ) return -1;
+  if( !c->useTls ) return doltliteServerSocketRecvNonblock(c->serverFd, buf, nbuf);
+  c->bPolling = 1;
+  n = mbedtls_ssl_read(&c->ssl, (unsigned char*)buf, (size_t)nbuf);
+  if( n==MBEDTLS_ERR_SSL_WANT_READ || n==MBEDTLS_ERR_SSL_WANT_WRITE ) return -2;
+  if( n==MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY ) return 0;
+  return n<0 ? -1 : n;
+}
+
+int doltliteServerConnWriteAll(DoltliteServerConn *c, const void *buf, int nbuf){
+  const unsigned char *p = (const unsigned char*)buf;
+  int off = 0;
+  while( off<nbuf ){
+    int n = c->useTls
+          ? mbedtls_ssl_write(&c->ssl, p+off, (size_t)(nbuf-off))
+          : serverConnSend(c, p+off, (size_t)(nbuf-off));
+    if( n==MBEDTLS_ERR_SSL_WANT_READ || n==MBEDTLS_ERR_SSL_WANT_WRITE ) continue;
+    if( n<=0 ) return 1;
+    off += n;
+  }
+  return 0;
+}
+
+int doltliteServerConnRead(DoltliteServerConn *c, void *buf, int nbuf){
+  for(;;){
+    int n = c->useTls
+          ? mbedtls_ssl_read(&c->ssl, (unsigned char*)buf, (size_t)nbuf)
+          : serverConnRecv(c, (unsigned char*)buf, (size_t)nbuf);
+    if( n==MBEDTLS_ERR_SSL_WANT_READ || n==MBEDTLS_ERR_SSL_WANT_WRITE ) continue;
+    if( c->useTls && n==MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY ) return 0;
+    return n<0 ? -1 : n;
+  }
+}
+
+int doltliteServerConnSetTimeout(DoltliteServerConn *c, int timeoutMs){
+  if( !c ) return 1;
+  c->timeoutMs = timeoutMs;
+  return doltliteServerSocketSetTimeout(c->serverFd, timeoutMs);
+}
+
+void doltliteServerConnConfigureWorker(
+  DoltliteServerConn *c,
+  int timeoutMs,
+  DoltliteServerStopCheck stopCheck,
+  void *stopContext
+){
+  if( !c ) return;
+  c->bPolling = 0;
+  c->timeoutMs = timeoutMs;
+  c->stopCheck = stopCheck;
+  c->stopContext = stopContext;
+}
+
+void doltliteServerConnCloseNotify(DoltliteServerConn *c){
+  if( c && c->useTls ) (void)mbedtls_ssl_close_notify(&c->ssl);
+}
+
+void doltliteServerConnClose(DoltliteServerConn *c){
+  if( !c ) return;
+  if( c->useTls ) mbedtls_ssl_free(&c->ssl);
+  doltliteServerSocketClose(c->serverFd);
+  sqlite3_free(c);
+}
+
 #endif
