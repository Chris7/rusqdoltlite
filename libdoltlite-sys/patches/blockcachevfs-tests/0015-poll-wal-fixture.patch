@@ -7,9 +7,24 @@
 source [file join [file dirname [info script]] test_common.tcl]
 set testprefix bcvfs_poll1
 
+# These cases exercise WAL polling and corrupt-WAL recovery. Since CBS now
+# preserves SQLite's stored header bytes, seed them with a real WAL-mode
+# database rather than relying on VFS header rewriting.
+proc bcv_upload_new_wal_db {container dbname sql} {
+  file delete -force tmpccd.db tmpccd.db-wal tmpccd.db-shm
+  sqlite3 ccd tmpccd.db
+  set mode [ccd one {PRAGMA journal_mode=WAL}]
+  if {$mode!="wal"} { error "could not create WAL-mode test database" }
+  ccd eval $sql
+  ccd eval {PRAGMA wal_checkpoint(TRUNCATE)}
+  ccd close
+  bcv_upload_database -container $container tmpccd.db $dbname
+  file delete -force tmpccd.db tmpccd.db-wal tmpccd.db-shm
+}
+
 
 bcv_create_container mycont
-bcv_upload_new_db mycont xyz.db {
+bcv_upload_new_wal_db mycont xyz.db {
   CREATE TABLE t1(x);
   CREATE INDEX i1 ON t1(x);
   INSERT INTO t1 VALUES(2), (4), (6);
