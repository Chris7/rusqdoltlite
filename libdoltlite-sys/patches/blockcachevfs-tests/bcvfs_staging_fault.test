# Deterministic power-loss coverage for bounded/staged cache writes.
#
# This test is run by tools/run_blockcachevfs_cbs_tests in a disposable CBS
# checkout. The child process uses the patched bcvTest VFS: metadata writes
# are forwarded only at xSync, so _exit() drops writes that were not synced.

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_staging_fault

if {$::tcl_platform(platform)=="windows"} {
  finish_test
  return
}

bcv_install_vfs_wrapper

proc staging_upload_new_wal_db {container dbname sql} {
  file delete -force staging-wal-seed.db staging-wal-seed.db-wal staging-wal-seed.db-shm
  sqlite3 seed staging-wal-seed.db
  set mode [seed one {PRAGMA journal_mode=WAL}]
  if {$mode!="wal"} { error "could not create WAL-mode staging seed" }
  seed eval $sql
  seed eval {PRAGMA wal_checkpoint(TRUNCATE)}
  seed close
  bcv_upload_database -container $container staging-wal-seed.db $dbname
  file delete -force staging-wal-seed.db staging-wal-seed.db-wal staging-wal-seed.db-shm
}

proc staging_fault_child {} {
  global C
  set container $::env(BCV_STAGING_CONTAINER)
  set testdir $::env(BCV_STAGING_DIR)
  set event $::env(BCV_STAGING_EVENT)
  set cmd [bcvfs_create $testdir "bcvfs"]
  $cmd config cachesize [expr 2*$::D(blocksize)]
  bcvfs_attach -alias child $cmd $container
  sqlite3 db /child/staging.db -vfs bcvfs

  # The remote seed already contains a committed working state. The crash
  # below is therefore isolated to one unpublished transaction.
  bcv_metadata_sync_reset
  bcv_test_crash_event 0
  if {$event==4} {
    # A BLOB cast is intentional: concatenating a zero BLOB with X'01'
    # otherwise produces TEXT containing an embedded NUL, for which SQLite's
    # length()/substr() semantics hide the bytes after the first zero.
    db eval {
      BEGIN IMMEDIATE;
      UPDATE payload SET body=CAST(zeroblob(4095)||X'01' AS BLOB) WHERE id=1;
      WITH RECURSIVE c(i) AS (
        SELECT 1001 UNION ALL SELECT i+1 FROM c WHERE i<2000
      ) INSERT INTO payload(id, body)
        SELECT i, CAST(zeroblob(4095)||X'01' AS BLOB) FROM c;
      COMMIT;
    }
    puts stderr "staging event4 child before upload: [db eval {
      SELECT count(*), hex(substr(body,1,4)), hex(substr(body,-1)), length(body)
      FROM payload WHERE id=1
    }]"
    bcv_test_crash_event $event
    $cmd upload child
  } else {
    bcv_test_crash_event $event
    db eval {
      BEGIN IMMEDIATE;
      UPDATE payload SET body=CAST(zeroblob(4095)||X'01' AS BLOB) WHERE id=1;
      WITH RECURSIVE c(i) AS (
        SELECT 1001 UNION ALL SELECT i+1 FROM c WHERE i<2000
      ) INSERT INTO payload(id, body)
        SELECT i, CAST(zeroblob(4095)||X'01' AS BLOB) FROM c;
      COMMIT;
    }
  }
  db close
  $cmd destroy
}

if {[info exists ::env(BCV_STAGING_CHILD)]} {
  staging_fault_child
  finish_test
  return
}

# Keep each invocation isolated from a previous emulator run. The runner
# supplies a unique suffix for the backend matrix; the pid covers direct
# invocations which do not set one.
set run_suffix [expr {
  [info exists ::env(BLOCKCACHEVFS_TEST_SUFFIX)]
    ? $::env(BLOCKCACHEVFS_TEST_SUFFIX)
    : "[pid]"
}]
foreach event {1 2 3 4} {
  set container "bcv-staging-fault-$run_suffix-$event"
  set testdir "staging-fault-testdir-$run_suffix-$event"
  bcv_mkdir $testdir
  bcv_create_container $container
  staging_upload_new_wal_db $container staging.db {
    CREATE TABLE payload(id INTEGER PRIMARY KEY, body BLOB NOT NULL);
    INSERT INTO payload VALUES(0, zeroblob(4096));
    WITH RECURSIVE c(i) AS (
      SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<1000
    ) INSERT INTO payload(id, body) SELECT i, zeroblob(4096) FROM c;
  }

  set envcmd [list env \
      BCV_STAGING_CHILD=1 \
      BCV_STAGING_CONTAINER=$container \
      BCV_STAGING_DIR=$testdir \
      BCV_STAGING_EVENT=$event]
  set child [file normalize [info nameofexecutable]]
  # Keep both executable and script paths explicit so the child reuses this
  # test's backend config regardless of how the runner invoked bcvtclsqlite.
  set script [file normalize [info script]]
  set status [catch {exec {*}$envcmd $child $script} message options]
  set observed [list $status {} {}]
  if {$status} {
    set errorcode [dict get $options -errorcode]
    set observed [list $status [lindex $errorcode 0] [lindex $errorcode 2]]
    puts stderr "staging fault child failed: $message"
  }
  do_test $event.1 {
    set observed
  } [list 1 CHILDSTATUS [expr 200+$event]]

  sqlite3 metadata [file join $testdir blocksdb.bcv]
  set nStaged [metadata eval {SELECT count(*) FROM staged}]
  set stagedObjects [metadata eval {
    SELECT hex(blockid) || '.bcv' FROM staged
  }]
  set nObjectBytes 0
  set object ""
  metadata close
  do_test $event.2.staged {
    expr {$event==1 ? $nStaged==0 : $nStaged>0}
  } 1
  set cmd [bcvfs_create $testdir "bcvfs"]
  $cmd config cachesize [expr 2*$::D(blocksize)]
  bcvfs_attach -alias after $cmd $container

  # bcv_tfs fetches an individual cloud object through the same dispatch
  # layer as the VFS. This verifies that a staged block PUT really produced
  # a readable object, rather than merely leaving a metadata row behind.
  if {$nStaged>0} {
    sqlite3 objects /after -vfs bcvfs
    sqlite3_bcvfs_register_vtab objects
    set cloudObjects [objects eval {SELECT name FROM bcv_tfs}]
    foreach candidate $stagedObjects {
      # Immutable payloads now live in the dedicated namespace; the metadata
      # table still stores only the content hash.
      set candidate "blocks/$candidate"
      if {[lsearch -exact $cloudObjects $candidate]>=0} {
        set object $candidate
        break
      }
    }
    if {$object!=""} {
      set nObjectBytes [objects eval {
        SELECT IFNULL(length(content),0) FROM bcv_tfs WHERE name=$object
      }]
    }
    objects close
  }
  do_test $event.2.object {
    expr {$event==1 ? $nObjectBytes==0 : $nObjectBytes==$::D(blocksize)}
  } 1

  sqlite3 db /after/staging.db -vfs bcvfs
  do_execsql_test $event.3.integrity {
    PRAGMA integrity_check;
  } ok
  do_execsql_test $event.3.row_count {
    SELECT count(*) FROM payload;
  } [expr {$event==4 ? 2001 : 1001}]
  do_execsql_test $event.3.updated_row {
    SELECT hex(substr(body,1,4)), hex(substr(body,-1)) FROM payload WHERE id=1;
  } [expr {$event==4 ? {00000000 01} : {00000000 00}}]
  db close
  $cmd destroy
}

# A staged prefix must not hide a later dirty block from a one-request upload.
# Seed 1001 rows, then update one row and append rows 1001 through 2000. Retain
# the default watermark so the last dirty slot remains available for the tail.
set tail_container "bcv-staged-tail-$run_suffix"
set tail_dir "staging-tail-testdir-$run_suffix"
bcv_mkdir $tail_dir
bcv_create_container $tail_container
staging_upload_new_wal_db $tail_container staging.db {
  CREATE TABLE payload(id INTEGER PRIMARY KEY, body BLOB NOT NULL);
  INSERT INTO payload VALUES(0, zeroblob(4096));
  WITH RECURSIVE c(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<1000
  ) INSERT INTO payload(id, body) SELECT i, zeroblob(4096) FROM c;
}
set tail_request_count 1
set tail_cmd [bcvfs_create $tail_dir "bcvfs-tail"]
$tail_cmd config cachesize [expr 2*$::D(blocksize)]
$tail_cmd config nrequest $tail_request_count
bcvfs_attach -alias tail $tail_cmd $tail_container
sqlite3 taildb /tail/staging.db -vfs bcvfs-tail
taildb eval {
  BEGIN IMMEDIATE;
  UPDATE payload SET body=CAST(zeroblob(4095)||X'01' AS BLOB) WHERE id=1;
  WITH RECURSIVE c(i) AS (
    SELECT 1001 UNION ALL SELECT i+1 FROM c WHERE i<2000
  ) INSERT INTO payload(id, body)
    SELECT i, CAST(zeroblob(4095)||X'01' AS BLOB) FROM c;
  COMMIT;
}
taildb eval {PRAGMA wal_checkpoint(TRUNCATE)}
taildb close
$tail_cmd destroy

sqlite3 tailmeta [file join $tail_dir blocksdb.bcv]
set nTailStaged [tailmeta onecolumn {
  SELECT count(*) FROM staged WHERE container='tail'
}]
set nTailDirty [tailmeta onecolumn {
  SELECT count(*) FROM block WHERE container='tail'
}]
set tailDirtyDb [tailmeta onecolumn {
  SELECT db FROM block WHERE container='tail' LIMIT 1
}]
set tailDirtyPos [tailmeta onecolumn {
  SELECT min(dbpos) FROM block WHERE container='tail'
}]
set nTailStagedBeforeDirty [tailmeta onecolumn {
  SELECT count(DISTINCT dbpos) FROM staged
  WHERE container='tail' AND db=$tailDirtyDb AND dbpos<$tailDirtyPos
}]
tailmeta close
do_test 6.1.staged_prefix_precedes_dirty_tail {
  if {$nTailDirty!=1 || $nTailStagedBeforeDirty<=$tail_request_count} {
    error "expected > nrequest distinct staged db positions before one dirty tail (staged=$nTailStaged dirty=$nTailDirty prefix=$nTailStagedBeforeDirty dirty_db=$tailDirtyDb dirty_pos=$tailDirtyPos nrequest=$tail_request_count)"
  }
  set stagedPrefixVerified 1
  set stagedPrefixVerified
} 1

# Recreate the VFS over the same local metadata directory so it resumes the
# staged-prefix/dirty-tail mappings left by the first writer.
set tail_publish_cmd [bcvfs_create $tail_dir "bcvfs-tail-publish"]
$tail_publish_cmd config cachesize [expr 2*$::D(blocksize)]
$tail_publish_cmd config nrequest $tail_request_count
bcvfs_attach -ifnot -alias tail $tail_publish_cmd $tail_container
do_test 6.2.publish_staged_prefix_and_dirty_tail {
  catch {$tail_publish_cmd upload tail}
} 0
$tail_publish_cmd destroy

set tail_verify_dir "staging-tail-verify-$run_suffix"
bcv_mkdir $tail_verify_dir
set tail_verify_cmd [bcvfs_create $tail_verify_dir "bcvfs-tail-verify"]
$tail_verify_cmd config cachesize [expr 2*$::D(blocksize)]
bcvfs_attach -alias verify $tail_verify_cmd $tail_container
sqlite3 tailverify /verify/staging.db -vfs bcvfs-tail-verify
do_test 6.3.cold_integrity {
  tailverify onecolumn {PRAGMA integrity_check}
} ok
do_test 6.3.cold_row_count {
  tailverify onecolumn {SELECT count(*) FROM payload}
} 2001
do_test 6.3.cold_updated_row {
  tailverify eval {
    SELECT hex(substr(body,1,4)), hex(substr(body,-1)) FROM payload WHERE id=1
  }
} {00000000 01}
tailverify close
$tail_verify_cmd destroy

# A full cache can leave every changed block durably staged, with no dirty
# `block` row left to make an ordinary detach notice unpublished data. The
# alias must remain attached so the explicit upload can publish that same
# mapping.
set detach_container "bcv-staged-detach-$run_suffix"
set detach_dir "staging-detach-testdir-$run_suffix"
bcv_mkdir $detach_dir
bcv_create_container $detach_container
staging_upload_new_wal_db $detach_container staging.db {
  CREATE TABLE payload(id INTEGER PRIMARY KEY, body BLOB NOT NULL);
  WITH RECURSIVE c(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<1000
  ) INSERT INTO payload(id, body) SELECT i, zeroblob(4096) FROM c;
}
set cmd [bcvfs_create $detach_dir "bcvfs"]
$cmd config cachesize [expr 2*$::D(blocksize)]
$cmd config stagewatermark 50
bcvfs_attach -alias staged $cmd $detach_container
sqlite3 stageddb /staged/staging.db -vfs bcvfs
stageddb eval {
  BEGIN IMMEDIATE;
  UPDATE payload SET body=CAST(zeroblob(4095)||X'01' AS BLOB) WHERE id=1;
  WITH RECURSIVE c(i) AS (
    SELECT 1001 UNION ALL SELECT i+1 FROM c WHERE i<2000
  ) INSERT INTO payload(id, body)
    SELECT i, CAST(zeroblob(4095)||X'01' AS BLOB) FROM c;
  COMMIT;
}
stageddb eval {PRAGMA wal_checkpoint(TRUNCATE)}
set materialized [stageddb onecolumn {
  SELECT sum(length(hex(body))) FROM payload
}]
do_test 5.0.read_pressure {
  expr {$materialized==16384000}
} 1
stageddb close
$cmd destroy
sqlite3 metadata [file join $detach_dir blocksdb.bcv]
set nStaged [metadata eval {
  SELECT count(*) FROM staged WHERE container='staged'
}]
set nDirty [metadata eval {
  SELECT count(*) FROM block WHERE container='staged'
}]
metadata close
do_test 5.1.staged_only {
  expr {$nStaged>0 && $nDirty==0}
} 1
set cmd [bcvfs_create $detach_dir "bcvfs"]
$cmd config cachesize [expr 2*$::D(blocksize)]
bcvfs_attach -ifnot -alias staged $cmd $detach_container
set pre_dir "staging-detach-preupload-$run_suffix"
bcv_mkdir $pre_dir
set preCmd [bcvfs_create $pre_dir "bcvfs-preupload"]
bcvfs_attach -alias before $preCmd $detach_container
sqlite3 predb /before/staging.db -vfs bcvfs-preupload
do_test 5.1.remote_unpublished {
  predb onecolumn {SELECT hex(substr(body,-1)) FROM payload WHERE id=1}
} 00
predb close
$preCmd destroy
set detachStatus [catch {$cmd detach staged} detachMessage]
do_test 5.2.detach_busy {
  list $detachStatus [string match {*container has local changes*} $detachMessage]
} {1 1}
do_test 5.3.upload_after_busy_detach {
  catch {$cmd upload staged}
} 0
set verify_dir "staging-detach-verify-$run_suffix"
bcv_mkdir $verify_dir
set verifyCmd [bcvfs_create $verify_dir "bcvfs-verify"]
bcvfs_attach -alias verify $verifyCmd $detach_container
sqlite3 verifydb /verify/staging.db -vfs bcvfs-verify
do_test 5.4.manifest_published {
  verifydb onecolumn {SELECT count(*) FROM payload}
} 2000
do_test 5.5.updated_row_published {
  verifydb onecolumn {SELECT hex(substr(body,-1)) FROM payload WHERE id=1}
} 01
verifydb close
$verifyCmd destroy
$cmd detach staged
$cmd destroy

finish_test
