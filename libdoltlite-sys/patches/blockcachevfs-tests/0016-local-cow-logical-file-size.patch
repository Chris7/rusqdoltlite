+/* Verify the exact logical EOF after an ordinary COW write crosses a block
+** boundary, and after truncating the local extension back near the base EOF.
+** Both open handles must observe each size change. */
+static int bcvfsTestOrdinaryFileSizeWrite(
+  sqlite3 *db,
+  sqlite3 *dbShared,
+  sqlite3_int64 iBlockSize,
+  sqlite3_int64 iExpectedStart,
+  sqlite3_int64 *piExpectedAfterTruncate,
+  char **pzErr
+){
+  static const unsigned char aTail[] = {0xA7};
+  sqlite3_file *pFile = 0;
+  sqlite3_file *pShared = 0;
+  sqlite3_int64 iStart = 0;
+  sqlite3_int64 iShared = 0;
+  sqlite3_int64 iWrite = 0;
+  sqlite3_int64 iWriteEnd = 0;
+  sqlite3_int64 iExpectedWriteEnd = 0;
+  sqlite3_int64 iTruncate = 0;
+  sqlite3_int64 iExpectedTruncate = 0;
+  int rc;
+  if( pzErr ) *pzErr = 0;
+  if( db==0 || dbShared==0 || iBlockSize<=0
+   || piExpectedAfterTruncate==0
+  ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("invalid local file-size test input");
+    return SQLITE_MISUSE;
+  }
+  rc = sqlite3_file_control(db,"main",82460214,&pFile);
+  if( rc==SQLITE_OK && pFile && pFile->pMethods ){
+    rc = pFile->pMethods->xFileSize(pFile,&iStart);
+  }else if( rc==SQLITE_OK ){
+    rc = SQLITE_ERROR;
+  }
+  if( rc!=SQLITE_OK || iStart!=iExpectedStart ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("local file-size test start mismatch");
+    return rc==SQLITE_OK ? SQLITE_ERROR : rc;
+  }
+  rc = sqlite3_file_control(dbShared,"main",82460214,&pShared);
+  if( rc==SQLITE_OK && pShared && pShared->pMethods ){
+    rc = pShared->pMethods->xFileSize(pShared,&iShared);
+  }else if( rc==SQLITE_OK ){
+    rc = SQLITE_ERROR;
+  }
+  if( rc!=SQLITE_OK || iShared!=iStart ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("shared handle started at a different file size");
+    return rc==SQLITE_OK ? SQLITE_ERROR : rc;
+  }
+
+  iWrite = iStart + iBlockSize + 7;
+  iWriteEnd = iWrite + sizeof(aTail);
+  rc = pFile->pMethods->xWrite(pFile,aTail,sizeof(aTail),iWrite);
+  if( rc!=SQLITE_OK ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("ordinary local append failed");
+    return rc;
+  }
+  iExpectedWriteEnd = iWriteEnd;
+  rc = pFile->pMethods->xFileSize(pFile,&iStart);
+  if( rc==SQLITE_OK && iStart!=iExpectedWriteEnd ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("ordinary local append lost the logical EOF");
+    return SQLITE_ERROR;
+  }
+  if( rc==SQLITE_OK ) rc = pShared->pMethods->xFileSize(pShared,&iShared);
+  if( rc!=SQLITE_OK || iShared!=iExpectedWriteEnd ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("ordinary append was not visible to a shared handle");
+    return rc==SQLITE_OK ? SQLITE_ERROR : rc;
+  }
+
+  iTruncate = iExpectedStart + 17;
+  rc = pFile->pMethods->xTruncate(pFile,iTruncate);
+  if( rc!=SQLITE_OK ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("ordinary local truncate failed");
+    return rc;
+  }
+  iExpectedTruncate = iTruncate;
+  rc = pFile->pMethods->xFileSize(pFile,&iStart);
+  if( rc==SQLITE_OK && iStart!=iExpectedTruncate ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("ordinary local truncate lost the file size");
+    return SQLITE_ERROR;
+  }
+  if( rc==SQLITE_OK ) rc = pShared->pMethods->xFileSize(pShared,&iShared);
+  if( rc!=SQLITE_OK || iShared!=iExpectedTruncate ){
+    if( pzErr ) *pzErr = sqlite3_mprintf("ordinary truncate was not visible to a shared handle");
+    return rc==SQLITE_OK ? SQLITE_ERROR : rc;
+  }
+  *piExpectedAfterTruncate = iExpectedTruncate;
+  return SQLITE_OK;
+}
