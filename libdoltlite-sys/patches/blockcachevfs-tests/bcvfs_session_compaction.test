# Bounded V2 session history uses a low testing watermark (four operations)
# and immutable HEAD-rooted segments.  The native command also writes an
# unreferenced segment to model a losing HEAD CAS and runs the normal upload
# path after compaction.

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_session_compaction

bcv_mkdir testdir
set cmd [bcvfs_create testdir "bcvfs"]
set nonce [expr {[clock clicks] & 0xFFFFFFFFFFFF}]
set session_container [format "%s/session-compaction-%012x" $D(container) $nonce]
bcv_create_container $session_container
bcv_upload_new_db $session_container compaction.db {
  CREATE TABLE t(v);
}
set session_id [format "550e8400-e29b-41d4-a716-%012x" $nonce]
set fresh_dir [file join testdir [format "session-compaction-fresh-%012x" $nonce]]
bcv_mkdir $fresh_dir

set roots [$cmd session_compaction_test bcvfs $C(module) $C(user) \
    $session_container $session_id compaction.db $fresh_dir]
lassign $roots history_root orphan_history
set history_name [format "bcv-session/v1/history/%s/%s.bcv" \
    $session_id $history_root]
set orphan_name [format "bcv-session/v1/history/%s/%s.bcv" \
    $session_id $orphan_history]

set bcv [bcv_open $session_container]
$bcv config find_orphans 1
set rooted_copy [file join $fresh_dir rooted-history-after-gc.bcv]
set orphan_copy [file join $fresh_dir orphan-history-after-gc.bcv]
do_test 1.0 {
  list [$bcv get $history_name [file join $fresh_dir rooted-history-before-gc.bcv]] \
      [$bcv get $orphan_name [file join $fresh_dir orphan-history-before-gc.bcv]]
} {0 0}

# The current committed HEAD is the GC root.  Its history segment must remain
# available, while the deliberately unreferenced segment is eligible for
# ordinary session-object cleanup.
do_test 1.1 {
  set rc [$bcv cleanup 0]
  list $rc [$bcv errmsg]
} {0 {}}
do_test 1.2 {
  list [$bcv get $history_name $rooted_copy] \
      [file exists $rooted_copy]
} {0 1}
do_test 1.3 {
  list [$bcv get $orphan_name $orphan_copy] \
      [file exists $orphan_copy]
} {404 0}

$bcv close
$cmd destroy
finish_test
