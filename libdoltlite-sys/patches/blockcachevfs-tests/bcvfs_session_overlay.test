# Verify fresh serverless request overlays rehydrate the accepted checkpoint,
# reset warm scratch, reject poll replacement, and fail closed for stale state.

source [file join [file dirname [info script]] test_common.tcl]
set testprefix bcvfs_session_overlay

proc session_overlay_upload_new_wal_db {container dbname sql} {
  file delete -force session-overlay-seed.db session-overlay-seed.db-wal session-overlay-seed.db-shm
  sqlite3 seed session-overlay-seed.db
  set mode [seed one {PRAGMA journal_mode=WAL}]
  if {$mode!="wal"} { error "could not create WAL-mode session overlay seed" }
  seed eval $sql
  seed eval {PRAGMA wal_checkpoint(TRUNCATE)}
  seed close
  bcv_upload_database -container $container session-overlay-seed.db $dbname
  file delete -force session-overlay-seed.db session-overlay-seed.db-wal session-overlay-seed.db-shm
}

bcv_mkdir testdir
set nonce [expr {[clock clicks] & 0xFFFFFFFFFFFF}]
set session_container [format "%s/session-overlay-%012x" $D(container) $nonce]
bcv_create_container $session_container
session_overlay_upload_new_wal_db $session_container overlay.db {
  CREATE TABLE t(v);
}
set cmd [bcvfs_create testdir "bcvfs"]
set session_id [format "550e8400-e29b-41d4-a716-%012x" $nonce]
set fresh_dir [file join testdir [format "session-overlay-fresh-%012x" $nonce]]
bcv_mkdir $fresh_dir

do_test 1.1 {
  $cmd session_overlay_test bcvfs $C(module) $C(user) \
      $session_container $session_id overlay.db $fresh_dir
} {}

$cmd destroy
finish_test
