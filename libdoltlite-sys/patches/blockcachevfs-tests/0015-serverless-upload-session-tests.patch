+static int bcvfsSessionTestHeadBody(
+  unsigned char *aOut,
+  int nOut,
+  const char *zEtag,
+  const unsigned char *aCheckpointHash,
+  const unsigned char *aCandidateHash
+){
+  static const unsigned char aMagic[] = {'B','C','V','H','D','0','2','\0'};
+  int nEtag = zEtag ? (int)strlen(zEtag) : 0;
+  if( aOut==0 || nOut<116+nEtag || nEtag>SQLITE_BCVFS_SESSION_ETAG_MAX_BYTES ) return 0;
+  memset(aOut,0,116);
+  memcpy(aOut,aMagic,sizeof(aMagic));
+  if( aCheckpointHash ) memcpy(&aOut[12],aCheckpointHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  else memset(&aOut[12],0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  if( aCandidateHash ) memcpy(&aOut[44],aCandidateHash,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  else memset(&aOut[44],0,SQLITE_BCVFS_SESSION_HASH_BYTES);
+  bcvPutU32(&aOut[112],(u32)nEtag);
+  if( nEtag ) memcpy(&aOut[116],zEtag,nEtag);
+  return 116+nEtag;
+}
+
+static int bcvfsSessionTestCheckpointBody(
+  unsigned char *aOut,
+  int nOut,
+  sqlite3_uint64 iFileSize,
+  const char *zEtag,
+  const unsigned char *aManifest,
+  int nManifest
+){
+  static const unsigned char aMagic[] = {'B','C','V','C','P','0','1','\0'};
+  int nEtag = zEtag ? (int)strlen(zEtag) : 0;
+  if( aOut==0 || aManifest==0 || nManifest<=0
+   || nEtag>SQLITE_BCVFS_SESSION_ETAG_MAX_BYTES
+   || nManifest>SQLITE_BCVFS_SESSION_BODY_MAX_BYTES
+   || nOut<24+nEtag+nManifest
+  ) return 0;
+  memcpy(aOut,aMagic,sizeof(aMagic));
+  bcvPutU64(&aOut[8],(u64)iFileSize);
+  bcvPutU32(&aOut[16],(u32)nManifest);
+  bcvPutU32(&aOut[20],(u32)nEtag);
+  if( nEtag ) memcpy(&aOut[24],zEtag,nEtag);
+  memcpy(&aOut[24+nEtag],aManifest,nManifest);
+  return 24+nEtag+nManifest;
+}
