+  }
+  if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_record_encode(
+      &record,&aEncoded,&nEncoded,aCheckpointHash,&zErr
+  );
+  if( rc==SQLITE_OK ){
+    hex_encode(aCheckpointHash,sizeof(aCheckpointHash),zCheckpointHex,0);
+    zCheckpointName = sqlite3_mprintf(
+        "bcv-session/v1/checkpoint/%s/%s.bcv",zSessionId,zCheckpointHex
+    );
+    zCheckpointPath = sqlite3_mprintf(
+        "%s/candidate-checkpoint-%s.bcv",zFreshDir,zMode
+    );
+    if( zCheckpointName==0 || zCheckpointPath==0 ) rc = SQLITE_NOMEM;
+    else rc = test_bcvfs_session_write_binary(
+        zCheckpointPath,aEncoded,nEncoded
+    );
+  }
+  if( rc==SQLITE_OK ){
+    pResult = Tcl_NewListObj(0,0);
+    Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zName,-1));
+    Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zCheckpointPath,-1));
+    Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zCheckpointName,-1));
+    Tcl_SetObjResult(interp,pResult);
+  }else{
+    Tcl_SetObjResult(interp,Tcl_ObjPrintf(
+        "could not create candidate checkpoint rc=%d err=%s",
+        rc,zErr?zErr:"(none)"
+    ));
+  }
+  sqlite3_free(aData);
+  sqlite3_free(aBody);
+  sqlite3_free(aEncoded);
+  sqlite3_free(zCheckpointName);
+  sqlite3_free(zCheckpointPath);
+  sqlite3_free(zErr);
+  return rc==SQLITE_OK ? TCL_OK : TCL_ERROR;
+}
+
+/*
+** $vfs session_compaction_test VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR
+**
+** Exercise the bounded immutable operation history.  The test deliberately
+** writes a valid history object before omitting its HEAD CAS, so the object
+** must remain invisible to replay detection and must be collectible.  The
+** final operation uses the direct finalizer after a history roll to verify
+** that it carries the compacted root forward.
+*/
+static int test_bcvfs_session_compaction(
+  ClientData clientData,
+  Tcl_Interp *interp,
+  int objc,
+  Tcl_Obj *const objv[]
+){
+  TestBcvfs *pTest = (TestBcvfs*)clientData;
+  const char *zVfs;
+  const char *zStorage;
+  const char *zAccount;
+  const char *zContainer;
+  const char *zSessionId;
+  const char *zDatabase;
+  const char *zFreshDir;
+  const char *zAlias = "session-compaction-test";
+  const char *zPrincipal = "session-compaction-principal";
+  const char *zOperations = "read,write,commit";
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aFirstOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHistoryRoot[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aOrphanOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aOrphanHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aFinalizeOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHistoryBody[80];
+  sqlite3_bcvfs_session_record head;
+  sqlite3_bcvfs_session_record orphan;
+  sqlite3_bcvfs_session_body headBody;
+  sqlite3_vfs *pSessionVfs = 0;
+  sqlite3_file *pRaw = 0;
+  unsigned char *aHeadData = 0;
+  unsigned char *aOrphanEncoded = 0;
+  char *zImage = 0;
+  char *zPath = 0;
+  char *zErr = 0;
+  char *zEtag = 0;
+  int nHeadData = 0;
+  int nOrphanEncoded = 0;
+  int operationStatus = SQLITE_BCVFS_SESSION_STATUS_NEW;
+  int rc = SQLITE_OK;
+  int rcRet = TCL_OK;
+  int bAttached = 0;
+  int bRawOpen = 0;
+  int ii;
+  char zRootHash[SQLITE_BCVFS_SESSION_HASH_BYTES*2+1];
+  char zOrphanHash[SQLITE_BCVFS_SESSION_HASH_BYTES*2+1];
+  Tcl_Obj *pResult = 0;
+
+  if( objc!=9 ){
+    Tcl_WrongNumArgs(
+        interp,2,objv,
+        "VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR"
+    );
+    return TCL_ERROR;
+  }
+  zVfs = Tcl_GetString(objv[2]);
+  zStorage = Tcl_GetString(objv[3]);
+  zAccount = Tcl_GetString(objv[4]);
+  zContainer = Tcl_GetString(objv[5]);
+  zSessionId = Tcl_GetString(objv[6]);
+  zDatabase = Tcl_GetString(objv[7]);
+  zFreshDir = Tcl_GetString(objv[8]);
+  memset(aOperationId,0,sizeof(aOperationId));
+  memset(aFirstOperationId,0,sizeof(aFirstOperationId));
+  memset(aCheckpointHash,0,sizeof(aCheckpointHash));
+  memset(aHistoryRoot,0,sizeof(aHistoryRoot));
+  memset(aOrphanOperationId,0,sizeof(aOrphanOperationId));
+  memset(aOrphanHash,0,sizeof(aOrphanHash));
+  memset(aFinalizeOperationId,0,sizeof(aFinalizeOperationId));
+  memset(aScope,0,sizeof(aScope));
+  memset(&head,0,sizeof(head));
+  memset(&orphan,0,sizeof(orphan));
+  memset(&headBody,0,sizeof(headBody));
+
+#define SESSION_COMPACTION_FAIL(zMsg) do { \
+    Tcl_SetObjResult(interp,Tcl_ObjPrintf("%s rc=%d err=%s",(zMsg),rc,zErr ? zErr : "(none)")); \
+    rcRet = TCL_ERROR; \
+    goto session_compaction_done; \
+  } while(0)
+#define SESSION_COMPACTION_REQUIRE(cond,zMsg) \
+  do { if(!(cond)) SESSION_COMPACTION_FAIL(zMsg); } while(0)
+
+  pSessionVfs = sqlite3_vfs_find(zVfs);
+  SESSION_COMPACTION_REQUIRE(pSessionVfs!=0, "compaction VFS lookup failed");
+
+  /* SQLITE_BCVFS_TESTING lowers the production 1024-operation watermark to
+  ** four. Eight accepted operations therefore create multiple segments. */
+  for(ii=0; ii<8; ii++){
+    int rawFlags;
+    memset(aOperationId,0,sizeof(aOperationId));
+    aOperationId[0] = 0xC2;
+    aOperationId[1] = (unsigned char)ii;
+    if( ii==0 ) memcpy(aFirstOperationId,aOperationId,sizeof(aOperationId));
+    rc = sqlite3_bcvfs_attach_session_scoped(
+        pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+        zPrincipal,zDatabase,zOperations,aOperationId,0,&zErr
+    );
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction operation attach failed");
+    bAttached = 1;
+    zPath = sqlite3_mprintf("/%s/%s",zAlias,zDatabase);
+    zImage = sqlite3_mprintf("%s/compaction-%d.db",zFreshDir,ii);
+    SESSION_COMPACTION_REQUIRE(zPath!=0 && zImage!=0,
+        "compaction image path allocation failed");
+    rc = bcvfsSessionBuildPublicationImage(zImage,(ii&1)+1,&zErr);
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction image build failed");
+    pRaw = (sqlite3_file*)sqlite3_malloc64((sqlite3_uint64)pSessionVfs->szOsFile);
+    SESSION_COMPACTION_REQUIRE(pRaw!=0, "compaction raw file allocation failed");
+    memset(pRaw,0,(size_t)pSessionVfs->szOsFile);
+    rawFlags = SQLITE_OPEN_MAIN_DB|SQLITE_OPEN_READWRITE|SQLITE_OPEN_CREATE;
+    rc = pSessionVfs->xOpen(pSessionVfs,zPath,pRaw,rawFlags,&rawFlags);
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK && pRaw->pMethods!=0,
+        "compaction raw file open failed");
+    bRawOpen = 1;
+    rc = bcvfsSessionCopyImage(pRaw,zImage,&zErr);
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction image copy failed");
+    rc = pRaw->pMethods->xSync(pRaw,0);
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction image sync failed");
+    rc = pRaw->pMethods->xClose(pRaw);
+    sqlite3_free(pRaw);
+    pRaw = 0;
+    bRawOpen = 0;
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction raw file close failed");
+    sqlite3_free(zImage); zImage = 0;
+    sqlite3_free(zPath); zPath = 0;
+    sqlite3_free(zErr); zErr = 0;
+    rc = sqlite3_bcvfs_session_checkpoint(
+        pTest->pFs,zAlias,zSessionId,aCheckpointHash,&zEtag,&zErr
+    );
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK && zEtag!=0,
+        "compaction checkpoint failed");
+    sqlite3_free(zEtag); zEtag = 0;
+    rc = sqlite3_bcvfs_session_accept(
+        pTest->pFs,zAlias,zSessionId,&zEtag,&zErr
+    );
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK && zEtag!=0,
+        "compaction operation acceptance failed");
+    sqlite3_free(zEtag); zEtag = 0;
+    rc = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zAlias,zSessionId,&zErr
+    );
+    SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction operation detach failed");
+    bAttached = 0;
+    sqlite3_free(zErr); zErr = 0;
+  }
+
+  /* The accepted HEAD must contain only a bounded tail and a nonzero root. */
+  memset(aOrphanOperationId,0,sizeof(aOrphanOperationId));
+  aOrphanOperationId[0] = 0xD1;
+  aOrphanOperationId[1] = 1;
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aOrphanOperationId,0,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "orphan operation attach failed");
+  bAttached = 1;
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(
+      rc==SQLITE_OK && operationStatus==SQLITE_BCVFS_SESSION_STATUS_NEW,
+      "unaccepted operation was not initially NEW");
+  rc = sqlite3_bcvfs_session_scope_hash(
+      zStorage,zAccount,zContainer,zPrincipal,zDatabase,zOperations,
+      aScope,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compaction scope hash failed");
+  rc = sqlite3_bcvfs_session_fetch(
+      pTest->pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+      zPrincipal,zDatabase,zOperations,&aHeadData,&nHeadData,&zEtag,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK && aHeadData!=0,
+      "compacted HEAD fetch failed");
+  rc = sqlite3_bcvfs_session_record_decode(
+      aHeadData,nHeadData,zSessionId,aScope,&head,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compacted HEAD decode failed");
+  rc = sqlite3_bcvfs_session_body_decode(
+      head.eType,head.eState,head.zSessionId,head.aBody,head.nBody,
+      &headBody,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(
+      rc==SQLITE_OK && headBody.nHistoryOperations==0,
+      "compacted HEAD retained an unbounded operation tail");
+  for(ii=0; ii<SQLITE_BCVFS_SESSION_HASH_BYTES; ii++){
+    if( headBody.aHistoryHeadHash[ii]!=0 ) break;
+  }
+  SESSION_COMPACTION_REQUIRE(
+      ii<SQLITE_BCVFS_SESSION_HASH_BYTES,
+      "accepted operations did not produce a history root");
+  memcpy(aHistoryRoot,headBody.aHistoryHeadHash,sizeof(aHistoryRoot));
+  sqlite3_free(aHeadData); aHeadData = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+
+  /* Put a valid history record for the pending operation without changing
+  ** HEAD.  Replay detection must follow only the current HEAD root. */
+  memset(aHistoryBody,0,sizeof(aHistoryBody));
+  memcpy(aHistoryBody,"BCVHS02",7);
+  bcvPutU32(&aHistoryBody[40],1);
+  memcpy(&aHistoryBody[48],aOrphanOperationId,
+      SQLITE_BCVFS_SESSION_HASH_BYTES);
+  memset(&orphan,0,sizeof(orphan));
+  orphan.eType = SQLITE_BCVFS_SESSION_HISTORY;
+  orphan.eState = SQLITE_BCVFS_SESSION_ACCEPTED;
+  orphan.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS;
+  orphan.iSequence = 100000;
+  orphan.iCreated = sqlite_timestamp()-300000;
+  orphan.iExpires = orphan.iCreated + 60000;
+  sqlite3_snprintf(sizeof(orphan.zSessionId),orphan.zSessionId,
+      "%s",zSessionId);
+  memcpy(orphan.aScopeHash,aScope,sizeof(aScope));
+  memcpy(orphan.aOperationId,aOrphanOperationId,sizeof(aOrphanOperationId));
+  orphan.aBody = aHistoryBody;
+  orphan.nBody = sizeof(aHistoryBody);
+  rc = sqlite3_bcvfs_session_record_encode(
+      &orphan,&aOrphanEncoded,&nOrphanEncoded,aOrphanHash,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(
+      rc==SQLITE_OK && aOrphanEncoded!=0,
+      "orphan history segment encode failed");
+  rc = sqlite3_bcvfs_session_put(
+      pTest->pFs,zAlias,SQLITE_BCVFS_SESSION_HISTORY,zSessionId,aOrphanHash,
+      zPrincipal,zDatabase,zOperations,"*",aOrphanEncoded,nOrphanEncoded,
+      &zEtag,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "orphan history segment PUT failed");
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(
+      rc==SQLITE_OK && operationStatus==SQLITE_BCVFS_SESSION_STATUS_NEW,
+      "unreferenced history segment changed operation status");
+
+  rc = sqlite3_bcvfs_detach_session(
+      pTest->pFs,zAlias,zSessionId,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "orphan operation detach failed");
+  bAttached = 0;
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aFirstOperationId,0,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "historical operation attach failed");
+  bAttached = 1;
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(
+      rc==SQLITE_OK && operationStatus==SQLITE_BCVFS_SESSION_STATUS_CONFLICT,
+      "historical operation was not fenced after compaction");
+  rc = sqlite3_bcvfs_detach_session(
+      pTest->pFs,zAlias,zSessionId,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "historical operation detach failed");
+  bAttached = 0;
+
+  /* Start one new operation from the compacted HEAD and use the direct
+  ** finalizer. This specifically exercises preserving the history body in
+  ** the synthetic OPEN predecessor used by the PUBLISHING CAS. */
+  aFinalizeOperationId[0] = 0xC3;
+  aFinalizeOperationId[1] = 1;
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aFinalizeOperationId,0,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "final operation attach failed");
+  bAttached = 1;
+  zPath = sqlite3_mprintf("/%s/%s",zAlias,zDatabase);
+  zImage = sqlite3_mprintf("%s/compaction-final.db",zFreshDir);
+  SESSION_COMPACTION_REQUIRE(zPath!=0 && zImage!=0,
+      "final operation image path allocation failed");
+  rc = bcvfsSessionBuildPublicationImage(zImage,2,&zErr);
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "final operation image build failed");
+  pRaw = (sqlite3_file*)sqlite3_malloc64((sqlite3_uint64)pSessionVfs->szOsFile);
+  SESSION_COMPACTION_REQUIRE(pRaw!=0, "final operation raw file allocation failed");
+  memset(pRaw,0,(size_t)pSessionVfs->szOsFile);
+  {
+    int rawFlags = SQLITE_OPEN_MAIN_DB|SQLITE_OPEN_READWRITE|SQLITE_OPEN_CREATE;
+    rc = pSessionVfs->xOpen(pSessionVfs,zPath,pRaw,rawFlags,&rawFlags);
+  }
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK && pRaw->pMethods!=0,
+      "final operation raw file open failed");
+  bRawOpen = 1;
+  rc = bcvfsSessionCopyImage(pRaw,zImage,&zErr);
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "final operation image copy failed");
+  rc = pRaw->pMethods->xSync(pRaw,0);
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "final operation image sync failed");
+  rc = pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  pRaw = 0;
+  bRawOpen = 0;
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "final operation raw file close failed");
+  sqlite3_free(zImage); zImage = 0;
+  sqlite3_free(zPath); zPath = 0;
+  sqlite3_free(zErr); zErr = 0;
+  rc = sqlite3_bcvfs_session_finalize(
+      pTest->pFs,zAlias,zSessionId,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "compacted direct finalization failed");
+  rc = sqlite3_bcvfs_detach_session(
+      pTest->pFs,zAlias,zSessionId,&zErr
+  );
+  SESSION_COMPACTION_REQUIRE(rc==SQLITE_OK, "final operation detach failed");
+  bAttached = 0;
+
+  hex_encode(aHistoryRoot,sizeof(aHistoryRoot),zRootHash,0);
+  hex_encode(aOrphanHash,sizeof(aOrphanHash),zOrphanHash,0);
+  pResult = Tcl_NewListObj(0,0);
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zRootHash,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zOrphanHash,-1));
+  Tcl_SetObjResult(interp,pResult);
+  pResult = 0;
+
+session_compaction_done:
+  sqlite3_free(zErr);
+  sqlite3_free(zEtag);
+  sqlite3_free(zImage);
+  sqlite3_free(zPath);
+  sqlite3_free(aHeadData);
+  sqlite3_free(aOrphanEncoded);
+  if( bRawOpen && pRaw && pRaw->pMethods ) pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  if( bAttached ){
+    char *zDetachErr = 0;
+    int rcDetach = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zAlias,zSessionId,&zDetachErr
+    );
+    if( rcRet==TCL_OK && rcDetach!=SQLITE_OK ){
+      Tcl_SetObjResult(interp,Tcl_NewStringObj(
+          zDetachErr ? zDetachErr : "compaction detach failed",-1
+      ));
+      rcRet = TCL_ERROR;
+    }
+    sqlite3_free(zDetachErr);
+  }
+  if( pResult ) Tcl_DecrRefCount(pResult);
+#undef SESSION_COMPACTION_REQUIRE
+#undef SESSION_COMPACTION_FAIL
+  return rcRet;
+}
