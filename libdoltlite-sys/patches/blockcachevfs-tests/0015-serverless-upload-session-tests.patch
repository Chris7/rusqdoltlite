+/* Build a valid pre-head marker and a block object for the GC regression.
+** The fixture intentionally does not create a session head or checkpoint;
+** only the durable marker is allowed to preserve the otherwise unreferenced
+** ordinary block. */
+static int test_bcvfs_session_attempt_marker(
+  ClientData clientData,
+  Tcl_Interp *interp,
+  int objc,
+  Tcl_Obj *const objv[]
+){
+  const char *zSessionId;
+  const char *zFreshDir;
+  const char *zMode;
+  int nBlock = 0;
+  unsigned char aUuid[16];
+  unsigned char aOperation[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aBlock[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aAttempt[16];
+  unsigned char aBody[172];
+  unsigned char aDigest[SHA256_DIGEST_LENGTH];
+  unsigned char aBlockData[4096];
+  char zOperation[65];
+  char zBlock[65];
+  char zAttempt[33];
+  char zMarkerName[320];
+  char *zMarkerPath = 0;
+  char *zBlockPath = 0;
+  i64 iCreated;
+  int rc;
+  Tcl_Obj *pResult;
+  (void)clientData;
+  if( objc!=11 ){
+    Tcl_WrongNumArgs(
+        interp,2,objv,
+        "VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR MODE NAMEBYTES"
+    );
+    return TCL_ERROR;
+  }
+  zSessionId = Tcl_GetString(objv[6]);
+  zFreshDir = Tcl_GetString(objv[8]);
+  zMode = Tcl_GetString(objv[9]);
+  if( Tcl_GetIntFromObj(interp,objv[10],&nBlock) || nBlock<1
+   || nBlock>(int)sizeof(aBlock)
+  ){
+    Tcl_SetObjResult(interp,Tcl_NewStringObj("invalid block name size",-1));
+    return TCL_ERROR;
+  }
+  if( strcmp(zMode,"active")!=0 && strcmp(zMode,"expired")!=0
+   && strcmp(zMode,"guard")!=0 && strcmp(zMode,"idle")!=0
+  ){
+    Tcl_SetObjResult(interp,Tcl_NewStringObj("invalid marker mode",-1));
+    return TCL_ERROR;
+  }
+  if( !test_bcvfs_session_uuid_decode(zSessionId,aUuid) ){
+    Tcl_SetObjResult(interp,Tcl_NewStringObj("invalid session UUID",-1));
+    return TCL_ERROR;
+  }
+  memset(aOperation,0,sizeof(aOperation));
+  aOperation[0] = 0xA7;
+  aOperation[1] = 0x21;
+  memset(aBlock,0,sizeof(aBlock));
+  memset(aBlock,0xAB,(size_t)nBlock);
+  memset(aScope,0x53,sizeof(aScope));
+  for(rc=0; rc<(int)sizeof(aAttempt); rc++) aAttempt[rc] = (unsigned char)rc;
+  hex_encode(aOperation,sizeof(aOperation),zOperation,1);
+  hex_encode(aBlock,nBlock,zBlock,1);
+  hex_encode(aAttempt,sizeof(aAttempt),zAttempt,1);
+  sqlite3_snprintf(
+      sizeof(zMarkerName),zMarkerName,
+      "bcv-session/v1/attempt/%s/%s/%s/%s.bcv",
+      zSessionId,zOperation,zBlock,zAttempt
+  );
+  if( strcmp(zMode,"guard")==0 || strcmp(zMode,"idle")==0 ){
+    sqlite3_snprintf(
+        sizeof(zMarkerName),zMarkerName,"bcv-session/v1/guard.bcv"
+    );
+  }
+  zMarkerPath = sqlite3_mprintf("%s/session-attempt-marker.bcv",zFreshDir);
+  zBlockPath = sqlite3_mprintf("%s/session-attempt-block.bcv",zFreshDir);
+  if( zMarkerPath==0 || zBlockPath==0 ) rc = SQLITE_NOMEM;
+  else{
+    iCreated = sqlite_timestamp();
+    if( strcmp(zMode,"guard")==0 || strcmp(zMode,"idle")==0 ){
+      memset(aBody,0,68);
+      memcpy(aBody,"BCVGD01",7);
+      aBody[9] = 1;
+      if( strcmp(zMode,"guard")==0 ){
+        aBody[10] = 1;
+        bcvPutU64(&aBody[12],(u64)(iCreated + 30LL*24*60*60*1000));
+        memset(&aBody[20],0xC1,16);
+      }
+      SHA256(aBody,36,aDigest);
+      memcpy(&aBody[36],aDigest,sizeof(aDigest));
+    }else{
+      memset(aBody,0,sizeof(aBody));
+      memcpy(aBody,"BCVAT01",7);
+      aBody[9] = 1;
+      aBody[10] = (unsigned char)((nBlock>>8)&0xFF);
+      aBody[11] = (unsigned char)(nBlock&0xFF);
+      if( strcmp(zMode,"expired")==0 ){
+        iCreated -= 2LL*30*24*60*60*1000;
+      }
+      bcvPutU64(&aBody[12],(u64)iCreated);
+      bcvPutU64(&aBody[20],(u64)(iCreated + 30LL*24*60*60*1000));
+      memcpy(&aBody[28],aUuid,sizeof(aUuid));
+      memcpy(&aBody[44],aOperation,sizeof(aOperation));
+      memcpy(&aBody[76],aBlock,(size_t)nBlock);
+      memcpy(&aBody[108],aScope,sizeof(aScope));
+      SHA256(aBody,140,aDigest);
+      memcpy(&aBody[140],aDigest,sizeof(aDigest));
+    }
+    memset(aBlockData,'B',sizeof(aBlockData));
+    rc = test_bcvfs_session_write_binary(
+        zMarkerPath,aBody,
+        (strcmp(zMode,"guard")==0 || strcmp(zMode,"idle")==0) ? 68 : sizeof(aBody)
+    );
+    if( rc==SQLITE_OK ) rc = test_bcvfs_session_write_binary(
+        zBlockPath,aBlockData,sizeof(aBlockData)
+    );
+  }
+  if( rc!=SQLITE_OK ){
+    Tcl_SetObjResult(interp,Tcl_NewStringObj("could not create marker fixture",-1));
+    sqlite3_free(zMarkerPath);
+    sqlite3_free(zBlockPath);
+    return TCL_ERROR;
+  }
+  pResult = Tcl_NewListObj(0,0);
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zMarkerPath,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zMarkerName,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zBlockPath,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zBlock,-1));
+  Tcl_SetObjResult(interp,pResult);
+  sqlite3_free(zMarkerPath);
+  sqlite3_free(zBlockPath);
+  return TCL_OK;
+}
