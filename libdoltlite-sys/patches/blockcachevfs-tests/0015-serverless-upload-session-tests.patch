+static int test_bcvfs_session_write_binary(
+  const char *zPath,
+  const unsigned char *aData,
+  int nData
+){
+  FILE *pFile = fopen(zPath,"wb");
+  size_t nWrite;
+  if( pFile==0 ) return SQLITE_CANTOPEN;
+  nWrite = fwrite(aData,1,(size_t)nData,pFile);
+  if( fclose(pFile)!=0 || nWrite!=(size_t)nData ) return SQLITE_IOERR_WRITE;
+  return SQLITE_OK;
+}
