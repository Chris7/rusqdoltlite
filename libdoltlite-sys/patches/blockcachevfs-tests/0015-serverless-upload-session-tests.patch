+  );
+  sqlite3_free(zErr);
+  zErr = 0;
+
+session_overlay_done:
+  sqlite3_free(zErr);
+  sqlite3_free(zEtag);
+  sqlite3_free(zPath);
+  sqlite3_free(zImage);
+  sqlite3_free(zFreshVfs);
+  sqlite3_free(zBaseEtag);
+  sqlite3_free(aCheckpointData);
+  sqlite3_free(aBadCheckpointBody);
+  sqlite3_free(aHeadBody);
+  sqlite3_free(aBadHeadBody);
+  sqlite3_free(aHeadEncoded);
+  sqlite3_free(aBadCheckpointEncoded);
+  sqlite3_free(aBadHeadEncoded);
+  sqlite3_free(aExpiredHeadBody);
+  sqlite3_free(aExpiredCheckpointEncoded);
+  sqlite3_free(aExpiredHeadEncoded);
+  if( pStmt ) sqlite3_finalize(pStmt);
+  if( pFreshStmt ) sqlite3_finalize(pFreshStmt);
+  if( db ) sqlite3_close(db);
+  if( dbFresh ) sqlite3_close(dbFresh);
+  if( bRawOpen && pRaw ) pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  if( bFreshAttached && pFresh ){
+    char *zDetachErr = 0;
+    sqlite3_bcvfs_detach_session(pFresh,"fresh-overlay",zSessionId,&zDetachErr);
+    sqlite3_free(zDetachErr);
+  }
+  if( pFresh ) sqlite3_bcvfs_destroy(pFresh);
+  if( bBadAttached ){
+    char *zDetachErr = 0;
+    int rcDetach = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zBadAlias,zBadSession,&zDetachErr
+    );
+    if( rcRet==TCL_OK && rcDetach!=SQLITE_OK ){
+      Tcl_SetObjResult(interp,Tcl_NewStringObj(
+          zDetachErr ? zDetachErr : "invalid overlay detach failed",-1
+      ));
+      rcRet = TCL_ERROR;
+    }
+    sqlite3_free(zDetachErr);
+  }
+  if( bExpiredAttached ){
+    char *zDetachErr = 0;
+    int rcDetach = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zExpiredAlias,zExpiredSession,&zDetachErr
+    );
+    if( rcRet==TCL_OK && rcDetach!=SQLITE_OK ){
+      Tcl_SetObjResult(interp,Tcl_NewStringObj(
+          zDetachErr ? zDetachErr : "expired overlay detach failed",-1
+      ));
+      rcRet = TCL_ERROR;
+    }
+    sqlite3_free(zDetachErr);
+  }
+  if( bAttached ){
+    char *zDetachErr = 0;
+    int rcDetach = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zAlias,zSessionId,&zDetachErr
+    );
+    if( rcRet==TCL_OK && rcDetach!=SQLITE_OK ){
+      Tcl_SetObjResult(interp,Tcl_NewStringObj(
+          zDetachErr ? zDetachErr : "session overlay detach failed",-1
+      ));
+      rcRet = TCL_ERROR;
+    }
+    sqlite3_free(zDetachErr);
+  }
+  if( rcRet==TCL_OK ) Tcl_ResetResult(interp);
+#undef SESSION_OVERLAY_REQUIRE
+#undef SESSION_OVERLAY_FAIL
+  return rcRet;
+}
+
+/*
+** $vfs session_publication_test VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR
+**
+** Check that checkpoint bytes remain unpublished until the explicit fenced
+** upload call, that the legacy upload entry point cannot bypass that fence,
+** and that a repeated upload reconciles the already committed records.
+*/
+static int test_bcvfs_session_publication(
+  ClientData clientData,
+  Tcl_Interp *interp,
+  int objc,
+  Tcl_Obj *const objv[]
+){
+  TestBcvfs *pTest = (TestBcvfs*)clientData;
+  const char *zVfs;
+  const char *zStorage;
+  const char *zAccount;
+  const char *zContainer;
+  const char *zSessionId;
+  const char *zDatabase;
+  const char *zFreshDir;
+  const char *zAlias = "session-publication-test";
+  const char *zPrincipal = "session-publication-principal";
+  const char *zOperations = "read,write,commit";
+  const char *zNextAlias = "session-publication-next";
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aNextOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aStorageScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aHeadHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aPendingCandidateHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char *aCheckpointData = 0;
+  unsigned char *aHeadBody = 0;
+  unsigned char *aHeadEncoded = 0;
+  unsigned char *aHeadData = 0;
+  unsigned char *aPublicationData = 0;
+  unsigned char *aExpiredPublicationEncoded = 0;
+  unsigned char *aPendingPublicationBody = 0;
+  unsigned char *aBaseManifest = 0;
+  unsigned char *aCurrentManifest = 0;
+  unsigned char *aNextHeadBody = 0;
+  unsigned char *aNextHeadEncoded = 0;
+  sqlite3_bcvfs_session_record checkpointRecord;
+  sqlite3_bcvfs_session_record headRecord;
+  sqlite3_bcvfs_session_record decodedHead;
+  sqlite3_bcvfs_session_record publicationRecord;
+  sqlite3_bcvfs_session_record nextCheckpointRecord;
+  sqlite3_bcvfs_session_record nextHeadRecord;
+  sqlite3_bcvfs_session_body checkpointBody;
+  sqlite3_bcvfs_session_body publicationBody;
+  sqlite3_bcvfs_session_body nextCheckpointBody;
+  sqlite3_bcvfs *pFresh = 0;
+  sqlite3 *dbFresh = 0;
+  sqlite3_stmt *pStmt = 0;
+  sqlite3_vfs *pClockVfs;
+  sqlite3_vfs *pSessionVfs = 0;
+  sqlite3_file *pRaw = 0;
+  char *zPath = 0;
+  char *zImage = 0;
+  char *zFreshVfs = 0;
+  char *zFreshPath = 0;
+  char *zErr = 0;
+  char *zEtag = 0;
+  char *zBaseEtag = 0;
+  char *zBaseManifestEtag = 0;
+  char *zCurrentManifestEtag = 0;
+  char *zRestoredManifestEtag = 0;
+  char *zLegacyErr = 0;
+  char zNextSessionId[SQLITE_BCVFS_SESSION_ID_TEXT_BYTES];
+  int nCheckpointData = 0;
+  int nHeadBody = 0;
+  int nHeadEncoded = 0;
+  int nHeadData = 0;
+  int nPublicationData = 0;
+  int nExpiredPublicationEncoded = 0;
+  int nPendingPublicationBody = 0;
+  int nBaseManifest = 0;
+  int nCurrentManifest = 0;
+  int nNextHeadBody = 0;
+  int nNextHeadEncoded = 0;
+  sqlite3_int64 iCandidateFileSize = 0;
+  sqlite3_int64 iPublishedFileSize = 0;
+  sqlite3_int64 iNow = 0;
+  int rc = SQLITE_OK;
+  int rcRet = TCL_OK;
+  int bAttached = 0;
+  int bFreshAttached = 0;
+  int bNextAttached = 0;
+  int bRawOpen = 0;
+
+  if( objc!=9 ){
+    Tcl_WrongNumArgs(
+        interp,2,objv,
+        "VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR"
+    );
+    return TCL_ERROR;
+  }
+  zVfs = Tcl_GetString(objv[2]);
+  zStorage = Tcl_GetString(objv[3]);
+  zAccount = Tcl_GetString(objv[4]);
+  zContainer = Tcl_GetString(objv[5]);
+  zSessionId = Tcl_GetString(objv[6]);
+  zDatabase = Tcl_GetString(objv[7]);
+  zFreshDir = Tcl_GetString(objv[8]);
+  memset(aOperationId,0,sizeof(aOperationId));
+  aOperationId[0] = 0x19;
+  aOperationId[1] = 0x01;
+  memset(aNextOperationId,0,sizeof(aNextOperationId));
+  aNextOperationId[0] = 0x19;
+  aNextOperationId[1] = 0x02;
+  memset(&checkpointRecord,0,sizeof(checkpointRecord));
+  memset(&headRecord,0,sizeof(headRecord));
+  memset(&decodedHead,0,sizeof(decodedHead));
+  memset(&publicationRecord,0,sizeof(publicationRecord));
+  memset(&nextCheckpointRecord,0,sizeof(nextCheckpointRecord));
+  memset(&nextHeadRecord,0,sizeof(nextHeadRecord));
+  memset(&checkpointBody,0,sizeof(checkpointBody));
+  memset(&publicationBody,0,sizeof(publicationBody));
+  memset(aPendingCandidateHash,0,sizeof(aPendingCandidateHash));
+  memset(&nextCheckpointBody,0,sizeof(nextCheckpointBody));
+  sqlite3_snprintf(sizeof(zNextSessionId),zNextSessionId,"%s",zSessionId);
+  zNextSessionId[35] = zNextSessionId[35]=='1' ? '2' : '1';
+
+#define SESSION_PUBLICATION_FAIL(zMsg) do { \
+    Tcl_SetObjResult(interp,Tcl_NewStringObj((zMsg),-1)); \
+    rcRet = TCL_ERROR; \
+    goto session_publication_done; \
+  } while(0)
+#define SESSION_PUBLICATION_REQUIRE(cond,zMsg) \
+  do { if(!(cond)) SESSION_PUBLICATION_FAIL(zMsg); } while(0)
+
+  pClockVfs = sqlite3_vfs_find(0);
+  SESSION_PUBLICATION_REQUIRE(
+      pClockVfs!=0
+       && pClockVfs->xCurrentTimeInt64(pClockVfs,&iNow)==SQLITE_OK,
+      "session publication clock unavailable"
+  );
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aOperationId,0,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && zErr==0, "session publication attachment failed"
+  );
+  bAttached = 1;
+
+  zPath = sqlite3_mprintf("/%s/%s",zAlias,zDatabase);
+  SESSION_PUBLICATION_REQUIRE(zPath!=0, "session publication path allocation failed");
+  zImage = sqlite3_mprintf("%s/publication-image-1.db",zFreshDir);
+  SESSION_PUBLICATION_REQUIRE(zImage!=0, "publication image path allocation failed");
+  rc = bcvfsSessionBuildPublicationImage(zImage,1,&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "publication image build failed");
+  pSessionVfs = sqlite3_vfs_find(zVfs);
+  SESSION_PUBLICATION_REQUIRE(pSessionVfs!=0, "publication VFS lookup failed");
+  pRaw = (sqlite3_file*)sqlite3_malloc64((sqlite3_uint64)pSessionVfs->szOsFile);
+  SESSION_PUBLICATION_REQUIRE(pRaw!=0, "publication raw file allocation failed");
+  memset(pRaw,0,(size_t)pSessionVfs->szOsFile);
+  {
+    int rawFlags = SQLITE_OPEN_MAIN_DB|SQLITE_OPEN_READWRITE|SQLITE_OPEN_CREATE;
+    rc = pSessionVfs->xOpen(pSessionVfs,zPath,pRaw,rawFlags,&rawFlags);
+  }
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && pRaw->pMethods!=0, "publication raw file open failed"
+  );
+  bRawOpen = 1;
+  rc = bcvfsSessionCopyImage(pRaw,zImage,&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "publication image copy failed");
+  rc = pRaw->pMethods->xSync(pRaw,0);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "publication image sync failed");
+  rc = pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  pRaw = 0;
+  bRawOpen = 0;
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "publication raw file close failed");
+  sqlite3_free(zImage);
+  zImage = 0;
+
+  rc = sqlite3_bcvfs_session_checkpoint(
+      pTest->pFs,zAlias,zSessionId,aCheckpointHash,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && zEtag!=0 && zEtag[0],
+      "session publication checkpoint failed"
+  );
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_scope_hash(
+      zStorage,zAccount,zContainer,zPrincipal,zDatabase,zOperations,
+      aScope,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "session publication scope failed");
+  rc = sqlite3_bcvfs_session_storage_scope_hash(
+      zStorage,zAccount,zContainer,aStorageScope,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK, "session publication storage scope failed"
+  );
+  rc = sqlite3_bcvfs_session_fetch(
+      pTest->pFs,zAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zSessionId,
+      aCheckpointHash,zPrincipal,zDatabase,zOperations,&aCheckpointData,
+      &nCheckpointData,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && aCheckpointData!=0 && zEtag!=0,
+      "session publication checkpoint fetch failed"
+  );
+  rc = sqlite3_bcvfs_session_record_decode(
+      aCheckpointData,nCheckpointData,zSessionId,aScope,
+      &checkpointRecord,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK, "session publication checkpoint decode failed"
+  );
+  rc = sqlite3_bcvfs_session_body_decode(
+      checkpointRecord.eType,checkpointRecord.eState,
+      checkpointRecord.zSessionId,checkpointRecord.aBody,
+      checkpointRecord.nBody,&checkpointBody,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && checkpointBody.nBaseManifestETag>0
+       && checkpointBody.nManifest>0,
+      "session publication checkpoint body decode failed"
+  );
+  iCandidateFileSize = (sqlite3_int64)checkpointBody.iFileSize;
+  SESSION_PUBLICATION_REQUIRE(
+      iCandidateFileSize>0 && iCandidateFileSize<131072,
+      "checkpoint did not preserve the partial logical EOF"
+  );
+  zBaseEtag = (char*)sqlite3_malloc64(
+      (sqlite3_uint64)checkpointBody.nBaseManifestETag+1
+  );
+  SESSION_PUBLICATION_REQUIRE(zBaseEtag!=0, "base ETag allocation failed");
+  memcpy(zBaseEtag,checkpointBody.aBaseManifestETag,
+      checkpointBody.nBaseManifestETag);
+  zBaseEtag[checkpointBody.nBaseManifestETag] = '\0';
+  sqlite3_free(zEtag); zEtag = 0;
+
+  rc = sqlite3_bcvfs_upload(pTest->pFs,zAlias,0,0,&zLegacyErr);
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_AUTH && zLegacyErr!=0,
+      "legacy upload bypassed the session publication fence"
+  );
+  sqlite3_free(zLegacyErr); zLegacyErr = 0;
+
+  /* The ordinary view must remain at the old manifest until publication. */
+  zFreshVfs = sqlite3_mprintf("bcvfs-publication-pre-%s",zSessionId);
+  SESSION_PUBLICATION_REQUIRE(zFreshVfs!=0, "pre-publication VFS allocation failed");
+  rc = sqlite3_bcvfs_create(zFreshDir,zFreshVfs,&pFresh,&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && pFresh!=0, "pre-publication VFS creation failed");
+  if( pTest->pAuthCallback ){
+    rc = sqlite3_bcvfs_auth_callback(pFresh,(void*)pTest,bcvfsAuthCb);
+    SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "pre-publication auth setup failed");
+  }
+  rc = sqlite3_bcvfs_attach(
+      pFresh,zStorage,zAccount,zContainer,"fresh-publication",0,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "pre-publication attach failed");
+  bFreshAttached = 1;
+  zFreshPath = sqlite3_mprintf("/fresh-publication/%s",zDatabase);
+  SESSION_PUBLICATION_REQUIRE(zFreshPath!=0, "pre-publication path allocation failed");
+  rc = sqlite3_open_v2(zFreshPath,&dbFresh,SQLITE_OPEN_READONLY,zFreshVfs);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && dbFresh!=0, "pre-publication open failed");
+  rc = sqlite3_prepare_v2(dbFresh,"SELECT count(*) FROM t",-1,&pStmt,0);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "pre-publication query failed");
+  rc = sqlite3_step(pStmt);
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_ROW && sqlite3_column_int(pStmt,0)==0,
+      "checkpoint became visible before upload"
+  );
+  sqlite3_finalize(pStmt); pStmt = 0;
+  rc = bcvfsSessionFetchObject(
+      dbFresh,"manifest.bcv",&aBaseManifest,&nBaseManifest,
+      &zBaseManifestEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && aBaseManifest!=0 && nBaseManifest>0
+       && zBaseManifestEtag!=0,
+      "base manifest snapshot failed"
+  );
+  sqlite3_close(dbFresh); dbFresh = 0;
+
+  rc = sqlite3_bcvfs_session_finalize(pTest->pFs,zAlias,zSessionId,&zErr);
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && zErr==0,
+      "direct-to-publishing session finalization failed"
+  );
+  rc = sqlite3_bcvfs_session_upload(pTest->pFs,zAlias,zSessionId,&zErr);
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && zErr==0, "idempotent fenced upload failed"
+  );
+  rc = sqlite3_bcvfs_session_fetch(
+      pTest->pFs,zAlias,SQLITE_BCVFS_SESSION_HEAD,zSessionId,0,
+      zPrincipal,zDatabase,zOperations,&aHeadData,&nHeadData,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && aHeadData!=0, "head fetch failed");
+  rc = sqlite3_bcvfs_session_record_decode(
+      aHeadData,nHeadData,zSessionId,aScope,&decodedHead,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK
+       && decodedHead.eState==SQLITE_BCVFS_SESSION_COMMITTED
+       && decodedHead.eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+      "session head was not finalized"
+  );
+  sqlite3_free(aHeadData); aHeadData = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_fetch(
+      pTest->pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,
+      aStorageScope,zPrincipal,zDatabase,zOperations,&aPublicationData,
+      &nPublicationData,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && aPublicationData!=0, "publication fetch failed");
+  rc = sqlite3_bcvfs_session_record_decode(
+      aPublicationData,nPublicationData,0,aStorageScope,
+      &publicationRecord,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK
+       && publicationRecord.eState==SQLITE_BCVFS_SESSION_COMMITTED
+       && publicationRecord.eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+      "publication head was not finalized"
+  );
+  rc = sqlite3_bcvfs_session_body_decode(
+      publicationRecord.eType,publicationRecord.eState,
+      publicationRecord.zSessionId,publicationRecord.aBody,
+      publicationRecord.nBody,&publicationBody,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK,
+      "publication body decode failed"
+  );
+  memcpy(aPendingCandidateHash,publicationBody.aCandidateManifestHash,
+      sizeof(aPendingCandidateHash));
+
+  /* Restore the exact base manifest while retaining the immutable candidate
+  ** object written by the first upload. This is the state left by a process
+  ** which died after candidate PUT and publication-head CAS, but before the
+  ** conditional manifest PUT. */
+  rc = sqlite3_open_v2(zFreshPath,&dbFresh,SQLITE_OPEN_READONLY,zFreshVfs);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && dbFresh!=0,
+      "manifest restore connection failed");
+  rc = bcvfsSessionFetchObject(
+      dbFresh,"manifest.bcv",&aCurrentManifest,&nCurrentManifest,
+      &zCurrentManifestEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && aCurrentManifest!=0 && zCurrentManifestEtag!=0,
+      "published manifest snapshot failed"
+  );
+  rc = bcvfsSessionPutObject(
+      dbFresh,"manifest.bcv",zCurrentManifestEtag,
+      aBaseManifest,nBaseManifest,&zRestoredManifestEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && zRestoredManifestEtag!=0,
+      "base manifest restore failed"
+  );
+  sqlite3_close(dbFresh); dbFresh = 0;
+  sqlite3_free(aCurrentManifest); aCurrentManifest = 0;
+  sqlite3_free(zCurrentManifestEtag); zCurrentManifestEtag = 0;
+  rc = sqlite3_bcvfs_detach(pFresh,"fresh-publication",&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "manifest restore detach failed");
+  bFreshAttached = 0;
+  sqlite3_bcvfs_destroy(pFresh); pFresh = 0;
+  sqlite3_free(zFreshPath); zFreshPath = 0;
+  sqlite3_free(zFreshVfs); zFreshVfs = 0;
+
+  /* Rebuild the pending publication body with the ETag returned by the
+  ** restore. ETags are provider versions, not hashes: restoring identical
+  ** bytes still creates a new conditional version. */
+  nPendingPublicationBody = 92 + (int)strlen(zRestoredManifestEtag);
+  aPendingPublicationBody = (unsigned char*)sqlite3_malloc64(
+      (sqlite3_uint64)nPendingPublicationBody
+  );
+  SESSION_PUBLICATION_REQUIRE(aPendingPublicationBody!=0,
+      "pending publication body allocation failed");
+  memcpy(aPendingPublicationBody,publicationRecord.aBody,92);
+  bcvPutU32(&aPendingPublicationBody[88],
+      (u32)strlen(zRestoredManifestEtag));
+  memcpy(&aPendingPublicationBody[92],zRestoredManifestEtag,
+      strlen(zRestoredManifestEtag));
+  publicationRecord.aBody = aPendingPublicationBody;
+  publicationRecord.nBody = nPendingPublicationBody;
+
+  /* Simulate the crash after candidate persistence and publication fencing,
+  ** before manifest publication. A different session must replay the exact
+  ** candidate conditionally; its own stale-base candidate must not overwrite
+  ** that recovery result. */
+  publicationRecord.eState = SQLITE_BCVFS_SESSION_PUBLISHING;
+  publicationRecord.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+  publicationRecord.iSequence++;
+  publicationRecord.iCreated = iNow-120000;
+  /* Expiry is a GC horizon, not a takeover lease: a cooperative publisher
+  ** must still recover an exact pending candidate while the head exists. */
+  publicationRecord.iExpires = iNow - 1;
+  rc = sqlite3_bcvfs_session_record_encode(
+      &publicationRecord,&aExpiredPublicationEncoded,
+      &nExpiredPublicationEncoded,aHeadHash,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && aExpiredPublicationEncoded!=0,
+      "expired publication head encode failed"
+  );
+  rc = sqlite3_bcvfs_session_put(
+      pTest->pFs,zAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,
+      aStorageScope,zPrincipal,zDatabase,zOperations,zEtag,
+      aExpiredPublicationEncoded,nExpiredPublicationEncoded,
+      &zLegacyErr,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && zLegacyErr!=0,
+      "expired publication head update failed"
+  );
+  sqlite3_free(zEtag); zEtag = zLegacyErr; zLegacyErr = 0;
+  sqlite3_free(aPublicationData); aPublicationData = 0;
+  sqlite3_free(aExpiredPublicationEncoded); aExpiredPublicationEncoded = 0;
+  sqlite3_free(aCheckpointData); aCheckpointData = 0;
+  sqlite3_free(aHeadBody); aHeadBody = 0;
+  sqlite3_free(aHeadEncoded); aHeadEncoded = 0;
+  sqlite3_free(zBaseEtag); zBaseEtag = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zNextAlias,zNextSessionId,
+      zPrincipal,zDatabase,zOperations,aNextOperationId,0,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK, "successor session attachment failed"
+  );
+  bNextAttached = 1;
+  sqlite3_free(zPath); zPath = 0;
+  zPath = sqlite3_mprintf("/%s/%s",zNextAlias,zDatabase);
+  SESSION_PUBLICATION_REQUIRE(zPath!=0, "successor path allocation failed");
+  zImage = sqlite3_mprintf("%s/publication-image-2.db",zFreshDir);
+  SESSION_PUBLICATION_REQUIRE(zImage!=0, "successor image path allocation failed");
+  rc = bcvfsSessionBuildPublicationImage(zImage,2,&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "successor image build failed");
+  pRaw = (sqlite3_file*)sqlite3_malloc64((sqlite3_uint64)pSessionVfs->szOsFile);
+  SESSION_PUBLICATION_REQUIRE(pRaw!=0, "successor raw file allocation failed");
+  memset(pRaw,0,(size_t)pSessionVfs->szOsFile);
+  {
+    int rawFlags = SQLITE_OPEN_MAIN_DB|SQLITE_OPEN_READWRITE|SQLITE_OPEN_CREATE;
+    rc = pSessionVfs->xOpen(pSessionVfs,zPath,pRaw,rawFlags,&rawFlags);
+  }
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && pRaw->pMethods!=0, "successor raw file open failed"
+  );
+  bRawOpen = 1;
+  rc = bcvfsSessionCopyImage(pRaw,zImage,&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "successor image copy failed");
+  rc = pRaw->pMethods->xSync(pRaw,0);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "successor image sync failed");
+  rc = pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  pRaw = 0;
+  bRawOpen = 0;
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "successor raw file close failed");
+  sqlite3_free(zImage);
+  zImage = 0;
+  rc = sqlite3_bcvfs_session_checkpoint(
+      pTest->pFs,zNextAlias,zNextSessionId,aCheckpointHash,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && zEtag!=0, "successor checkpoint failed");
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_fetch(
+      pTest->pFs,zNextAlias,SQLITE_BCVFS_SESSION_CHECKPOINT,zNextSessionId,
+      aCheckpointHash,zPrincipal,zDatabase,zOperations,&aCheckpointData,
+      &nCheckpointData,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && aCheckpointData!=0, "successor checkpoint fetch failed");
+  rc = sqlite3_bcvfs_session_record_decode(
+      aCheckpointData,nCheckpointData,zNextSessionId,aScope,
+      &nextCheckpointRecord,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "successor checkpoint decode failed");
+  rc = sqlite3_bcvfs_session_body_decode(
+      nextCheckpointRecord.eType,nextCheckpointRecord.eState,
+      nextCheckpointRecord.zSessionId,nextCheckpointRecord.aBody,
+      nextCheckpointRecord.nBody,&nextCheckpointBody,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && nextCheckpointBody.nBaseManifestETag>0,
+      "successor checkpoint body decode failed"
+  );
+  zBaseEtag = (char*)sqlite3_malloc64(
+      (sqlite3_uint64)nextCheckpointBody.nBaseManifestETag+1
+  );
+  SESSION_PUBLICATION_REQUIRE(zBaseEtag!=0, "successor base ETag allocation failed");
+  memcpy(zBaseEtag,nextCheckpointBody.aBaseManifestETag,
+      nextCheckpointBody.nBaseManifestETag);
+  zBaseEtag[nextCheckpointBody.nBaseManifestETag] = '\0';
+  sqlite3_free(zEtag); zEtag = 0;
+  nNextHeadBody = 116 + nextCheckpointBody.nBaseManifestETag;
+  aNextHeadBody = (unsigned char*)sqlite3_malloc64((sqlite3_uint64)nNextHeadBody);
+  SESSION_PUBLICATION_REQUIRE(aNextHeadBody!=0, "successor head body allocation failed");
+  memset(aNextHeadBody,0,(size_t)nNextHeadBody);
+  nNextHeadBody = bcvfsSessionTestHeadBody(
+      aNextHeadBody,nNextHeadBody,zBaseEtag,aCheckpointHash,0
+  );
+  SESSION_PUBLICATION_REQUIRE(nNextHeadBody>0, "successor head body construction failed");
+  nextHeadRecord.eType = SQLITE_BCVFS_SESSION_HEAD;
+  nextHeadRecord.eState = SQLITE_BCVFS_SESSION_ACCEPTED;
+  nextHeadRecord.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS;
+  nextHeadRecord.iSequence = nextCheckpointRecord.iSequence+1;
+  nextHeadRecord.iCreated = iNow;
+  nextHeadRecord.iExpires = iNow + 60000;
+  sqlite3_snprintf(sizeof(nextHeadRecord.zSessionId),nextHeadRecord.zSessionId,
+      "%s",zNextSessionId);
+  memcpy(nextHeadRecord.aScopeHash,aScope,sizeof(aScope));
+  memcpy(nextHeadRecord.aOperationId,aNextOperationId,sizeof(aNextOperationId));
+  nextHeadRecord.aBody = aNextHeadBody;
+  nextHeadRecord.nBody = nNextHeadBody;
+  rc = sqlite3_bcvfs_session_record_encode(
+      &nextHeadRecord,&aNextHeadEncoded,&nNextHeadEncoded,aHeadHash,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && aNextHeadEncoded!=0, "successor head encode failed");
+  rc = sqlite3_bcvfs_session_put(
+      pTest->pFs,zNextAlias,SQLITE_BCVFS_SESSION_HEAD,zNextSessionId,0,
+      zPrincipal,zDatabase,zOperations,"*",aNextHeadEncoded,nNextHeadEncoded,
+      &zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && zEtag!=0, "successor head PUT failed");
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_upload(
+      pTest->pFs,zNextAlias,zNextSessionId,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_CONSTRAINT && zErr!=0,
+      "stale successor base was not rejected after candidate recovery"
+  );
+  sqlite3_free(zErr); zErr = 0;
+  rc = sqlite3_bcvfs_session_fetch(
+      pTest->pFs,zNextAlias,SQLITE_BCVFS_SESSION_PUBLICATION,0,
+      aStorageScope,zPrincipal,zDatabase,zOperations,&aPublicationData,
+      &nPublicationData,&zEtag,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK && aPublicationData!=0,
+      "recovered publication head fetch failed"
+  );
+  rc = sqlite3_bcvfs_session_record_decode(
+      aPublicationData,nPublicationData,0,aStorageScope,
+      &publicationRecord,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK
+       && publicationRecord.eState==SQLITE_BCVFS_SESSION_COMMITTED
+       && publicationRecord.eOutcome==SQLITE_BCVFS_SESSION_OUTCOME_SUCCESS,
+      "pending publication was not finalized before stale-base rejection"
+  );
+  rc = sqlite3_bcvfs_session_body_decode(
+      publicationRecord.eType,publicationRecord.eState,
+      publicationRecord.zSessionId,publicationRecord.aBody,
+      publicationRecord.nBody,&publicationBody,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_OK
+       && !memcmp(
+              publicationBody.aCandidateManifestHash,
+              aPendingCandidateHash,
+              SQLITE_BCVFS_SESSION_HASH_BYTES
+          ),
+      "recovery finalized a different candidate"
+  );
+  sqlite3_free(aPublicationData); aPublicationData = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+  {
+    char *zDetachErr = 0;
+    rc = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zNextAlias,zNextSessionId,&zDetachErr
+    );
+    sqlite3_free(zDetachErr);
+  }
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "successor detach failed");
+  bNextAttached = 0;
+  sqlite3_free(aCheckpointData); aCheckpointData = 0;
+  sqlite3_free(aNextHeadBody); aNextHeadBody = 0;
+  sqlite3_free(aNextHeadEncoded); aNextHeadEncoded = 0;
+  sqlite3_free(zBaseEtag); zBaseEtag = 0;
+  sqlite3_free(zPath); zPath = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+
+  sqlite3_free(aPublicationData); aPublicationData = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+
+  /* Re-open through an ordinary VFS after upload and verify the candidate. */
+  zFreshVfs = sqlite3_mprintf("bcvfs-publication-after-%s",zSessionId);
+  SESSION_PUBLICATION_REQUIRE(zFreshVfs!=0, "post-publication VFS allocation failed");
+  rc = sqlite3_bcvfs_create(zFreshDir,zFreshVfs,&pFresh,&zErr);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && pFresh!=0, "post-publication VFS creation failed");
+  if( pTest->pAuthCallback ){
+    rc = sqlite3_bcvfs_auth_callback(pFresh,(void*)pTest,bcvfsAuthCb);
+    SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "post-publication auth setup failed");
+  }
+  rc = sqlite3_bcvfs_attach(
+      pFresh,zStorage,zAccount,zContainer,"fresh-publication",0,&zErr
+  );
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "post-publication attach failed");
+  bFreshAttached = 1;
+  zFreshPath = sqlite3_mprintf("/fresh-publication/%s",zDatabase);
+  SESSION_PUBLICATION_REQUIRE(zFreshPath!=0, "post-publication path allocation failed");
+  rc = sqlite3_open_v2(zFreshPath,&dbFresh,SQLITE_OPEN_READONLY,zFreshVfs);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK && dbFresh!=0, "post-publication open failed");
+  {
+    sqlite3_file *pPublishedFile = 0;
+    /* BCV_FCNTL_FD is intentionally private to the VFS implementation. The
+    ** test uses its stable testing value to inspect xFileSize after an
+    ** ordinary (non-session) reopen. */
+    rc = sqlite3_file_control(dbFresh,"main",82460214,&pPublishedFile);
+    SESSION_PUBLICATION_REQUIRE(
+        rc==SQLITE_OK && pPublishedFile!=0 && pPublishedFile->pMethods!=0,
+        "post-publication file handle lookup failed"
+    );
+    rc = pPublishedFile->pMethods->xFileSize(
+        pPublishedFile,&iPublishedFileSize
+    );
+    SESSION_PUBLICATION_REQUIRE(
+        rc==SQLITE_OK && iPublishedFileSize==iCandidateFileSize,
+        "fresh ordinary reopen lost the exact logical EOF"
+    );
+  }
+  rc = sqlite3_prepare_v2(dbFresh,"SELECT count(*) FROM t",-1,&pStmt,0);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "post-publication query failed");
+  rc = sqlite3_step(pStmt);
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_ROW && sqlite3_column_int(pStmt,0)==1,
+      "recovered candidate was not conditionally published"
+  );
+  sqlite3_finalize(pStmt); pStmt = 0;
+  rc = sqlite3_prepare_v2(dbFresh,"SELECT v FROM t",-1,&pStmt,0);
+  SESSION_PUBLICATION_REQUIRE(rc==SQLITE_OK, "recovery row query failed");
+  rc = sqlite3_step(pStmt);
+  SESSION_PUBLICATION_REQUIRE(
+      rc==SQLITE_ROW
+       && 0==strcmp((const char*)sqlite3_column_text(pStmt,0),"fenced-row"),
+      "visible manifest is not the exact pending candidate"
+  );
+
+session_publication_done:
+  sqlite3_free(zErr);
+  sqlite3_free(zEtag);
+  sqlite3_free(zLegacyErr);
+  sqlite3_free(zPath);
+  sqlite3_free(zFreshPath);
+  sqlite3_free(zFreshVfs);
+  sqlite3_free(zBaseEtag);
+  sqlite3_free(zBaseManifestEtag);
+  sqlite3_free(zCurrentManifestEtag);
+  sqlite3_free(zRestoredManifestEtag);
+  sqlite3_free(zImage);
+  sqlite3_free(aCheckpointData);
+  sqlite3_free(aHeadBody);
+  sqlite3_free(aHeadEncoded);
+  sqlite3_free(aHeadData);
+  sqlite3_free(aPublicationData);
+  sqlite3_free(aExpiredPublicationEncoded);
+  sqlite3_free(aPendingPublicationBody);
+  sqlite3_free(aBaseManifest);
+  sqlite3_free(aCurrentManifest);
+  sqlite3_free(aNextHeadBody);
+  sqlite3_free(aNextHeadEncoded);
+  if( pStmt ) sqlite3_finalize(pStmt);
+  if( bRawOpen && pRaw && pRaw->pMethods ) pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  if( dbFresh ) sqlite3_close(dbFresh);
+  if( bFreshAttached && pFresh ){
+    char *zDetachErr = 0;
+    sqlite3_bcvfs_detach(pFresh,"fresh-publication",&zDetachErr);
+    sqlite3_free(zDetachErr);
+  }
+  if( pFresh ) sqlite3_bcvfs_destroy(pFresh);
+  if( bNextAttached ){
+    char *zDetachErr = 0;
+    sqlite3_bcvfs_detach_session(
+        pTest->pFs,zNextAlias,zNextSessionId,&zDetachErr
+    );
+    sqlite3_free(zDetachErr);
+  }
+  if( bAttached ){
+    char *zDetachErr = 0;
+    int rcDetach = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zAlias,zSessionId,&zDetachErr
+    );
+    if( rcRet==TCL_OK && rcDetach!=SQLITE_OK ){
+      Tcl_SetObjResult(interp,Tcl_NewStringObj(
+          zDetachErr ? zDetachErr : "session publication detach failed",-1
+      ));
+      rcRet = TCL_ERROR;
+    }
+    sqlite3_free(zDetachErr);
+  }
+  if( rcRet==TCL_OK ) Tcl_ResetResult(interp);
+#undef SESSION_PUBLICATION_REQUIRE
+#undef SESSION_PUBLICATION_FAIL
+  return rcRet;
+}
+
+/*
+** $vfs session_acceptance_test VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR
+**
+** Exercise the accepted-head CAS independently from publication. The first
+** acceptance must require a checkpoint, a successful acceptance must be
+** idempotent, a successor operation may use an accepted predecessor, and an
+** older operation ID remains fenced by checkpoint history.
+*/
+static int test_bcvfs_session_acceptance(
+  ClientData clientData,
+  Tcl_Interp *interp,
+  int objc,
+  Tcl_Obj *const objv[]
+){
+  TestBcvfs *pTest = (TestBcvfs*)clientData;
+  const char *zVfs;
+  const char *zStorage;
+  const char *zAccount;
+  const char *zContainer;
+  const char *zSessionId;
+  const char *zDatabase;
+  const char *zFreshDir;
+  const char *zAlias = "session-acceptance-test";
+  const char *zPrincipal = "session-acceptance-principal";
+  const char *zOperations = "read,write,commit";
+  unsigned char aOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aNextOperationId[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  sqlite3_vfs *pSessionVfs = 0;
+  sqlite3_file *pRaw = 0;
+  char *zImage = 0;
+  char *zPath = 0;
+  char *zErr = 0;
+  char *zEtag = 0;
+  int operationStatus = SQLITE_BCVFS_SESSION_STATUS_NEW;
+  int rc = SQLITE_OK;
+  int rcRet = TCL_OK;
+  int bAttached = 0;
+  int bRawOpen = 0;
+
+  if( objc!=9 ){
+    Tcl_WrongNumArgs(
+        interp,2,objv,
+        "VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR"
+    );
+    return TCL_ERROR;
+  }
+  zVfs = Tcl_GetString(objv[2]);
+  zStorage = Tcl_GetString(objv[3]);
+  zAccount = Tcl_GetString(objv[4]);
+  zContainer = Tcl_GetString(objv[5]);
+  zSessionId = Tcl_GetString(objv[6]);
+  zDatabase = Tcl_GetString(objv[7]);
+  zFreshDir = Tcl_GetString(objv[8]);
+  memset(aOperationId,0,sizeof(aOperationId));
+  memset(aNextOperationId,0,sizeof(aNextOperationId));
+  aOperationId[0] = 0x20;
+  aNextOperationId[0] = 0x21;
+
+#define SESSION_ACCEPTANCE_FAIL(zMsg) do { \
+    Tcl_SetObjResult(interp,Tcl_NewStringObj((zMsg),-1)); \
+    rcRet = TCL_ERROR; \
+    goto session_acceptance_done; \
+  } while(0)
+#define SESSION_ACCEPTANCE_REQUIRE(cond,zMsg) \
+  do { if(!(cond)) SESSION_ACCEPTANCE_FAIL(zMsg); } while(0)
+
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aOperationId,0,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && zErr==0, "session acceptance attachment failed"
+  );
+  bAttached = 1;
+
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && operationStatus==SQLITE_BCVFS_SESSION_STATUS_NEW,
+      "new operation did not report NEW status"
+  );
+  rc = sqlite3_bcvfs_session_accept(
+      pTest->pFs,zAlias,zSessionId,&zEtag,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_CONSTRAINT,
+      "accepted-head CAS succeeded without a final checkpoint"
+  );
+  sqlite3_free(zErr); zErr = 0;
+  sqlite3_free(zEtag); zEtag = 0;
+
+  zPath = sqlite3_mprintf("/%s/%s",zAlias,zDatabase);
+  zImage = sqlite3_mprintf("%s/acceptance-image.db",zFreshDir);
+  SESSION_ACCEPTANCE_REQUIRE(zPath!=0 && zImage!=0, "acceptance image path allocation failed");
+  rc = bcvfsSessionBuildPublicationImage(zImage,1,&zErr);
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "acceptance image build failed");
+  pSessionVfs = sqlite3_vfs_find(zVfs);
+  SESSION_ACCEPTANCE_REQUIRE(pSessionVfs!=0, "acceptance VFS lookup failed");
+  pRaw = (sqlite3_file*)sqlite3_malloc64((sqlite3_uint64)pSessionVfs->szOsFile);
+  SESSION_ACCEPTANCE_REQUIRE(pRaw!=0, "acceptance raw file allocation failed");
+  memset(pRaw,0,(size_t)pSessionVfs->szOsFile);
+  {
+    int rawFlags = SQLITE_OPEN_MAIN_DB|SQLITE_OPEN_READWRITE|SQLITE_OPEN_CREATE;
+    rc = pSessionVfs->xOpen(pSessionVfs,zPath,pRaw,rawFlags,&rawFlags);
+  }
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && pRaw->pMethods!=0, "acceptance raw file open failed"
+  );
+  bRawOpen = 1;
+  rc = bcvfsSessionCopyImage(pRaw,zImage,&zErr);
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "acceptance image copy failed");
+  rc = pRaw->pMethods->xSync(pRaw,0);
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "acceptance image sync failed");
+  rc = pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  pRaw = 0;
+  bRawOpen = 0;
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "acceptance raw file close failed");
+
+  rc = sqlite3_bcvfs_session_checkpoint(
+      pTest->pFs,zAlias,zSessionId,aCheckpointHash,&zEtag,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && zEtag!=0, "acceptance checkpoint failed"
+  );
+  sqlite3_free(zEtag); zEtag = 0;
+  /* xSync/final-checkpoint may run more than once before the application
+  ** accepts the request. Acceptance must validate this immutable chain back
+  ** to the captured predecessor, not only the newest record. */
+  rc = sqlite3_bcvfs_session_checkpoint(
+      pTest->pFs,zAlias,zSessionId,aCheckpointHash,&zEtag,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && zEtag!=0, "acceptance follow-up checkpoint failed"
+  );
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_accept(
+      pTest->pFs,zAlias,zSessionId,&zEtag,&zErr
+  );
+  if( rc!=SQLITE_OK || zEtag==0 ){
+    Tcl_SetObjResult(interp,Tcl_ObjPrintf(
+        "accepted-head CAS failed rc=%d err=%s",rc,zErr ? zErr : "(none)"
+    ));
+    rcRet = TCL_ERROR;
+    goto session_acceptance_done;
+  }
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && operationStatus==SQLITE_BCVFS_SESSION_STATUS_ACCEPTED,
+      "accepted operation did not report ACCEPTED status"
+  );
+
+  /* A lost response after the conditional HEAD PUT is an exact success. */
+  rc = sqlite3_bcvfs_session_accept(
+      pTest->pFs,zAlias,zSessionId,&zEtag,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && zEtag!=0, "exact accepted-head retry was not reconciled"
+  );
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_detach_session(
+      pTest->pFs,zAlias,zSessionId,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "first acceptance detach failed");
+  bAttached = 0;
+
+  /* A new operation may advance an accepted predecessor. */
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aNextOperationId,0,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "successor operation attach failed");
+  bAttached = 1;
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  if( rc!=SQLITE_OK || operationStatus!=SQLITE_BCVFS_SESSION_STATUS_NEW ){
+    Tcl_SetObjResult(interp,Tcl_ObjPrintf(
+        "successor operation was not reported NEW rc=%d status=%d err=%s",
+        rc,operationStatus,zErr ? zErr : "(none)"
+    ));
+    rcRet = TCL_ERROR;
+    goto session_acceptance_done;
+  }
+  rc = sqlite3_bcvfs_session_checkpoint(
+      pTest->pFs,zAlias,zSessionId,aCheckpointHash,&zEtag,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "successor checkpoint failed");
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_session_accept(
+      pTest->pFs,zAlias,zSessionId,&zEtag,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "successor acceptance failed");
+  sqlite3_free(zEtag); zEtag = 0;
+  rc = sqlite3_bcvfs_detach_session(
+      pTest->pFs,zAlias,zSessionId,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "successor detach failed");
+  bAttached = 0;
+
+  /* The first operation remains a historical receipt and cannot be replayed. */
+  rc = sqlite3_bcvfs_attach_session_scoped(
+      pTest->pFs,zStorage,zAccount,zContainer,zAlias,zSessionId,
+      zPrincipal,zDatabase,zOperations,aOperationId,0,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(rc==SQLITE_OK, "historical operation attach failed");
+  bAttached = 1;
+  rc = sqlite3_bcvfs_session_operation_status(
+      pTest->pFs,zAlias,zSessionId,&operationStatus,&zErr
+  );
+  SESSION_ACCEPTANCE_REQUIRE(
+      rc==SQLITE_OK && operationStatus==SQLITE_BCVFS_SESSION_STATUS_CONFLICT,
+      "historical operation was not fenced"
+  );
+
+session_acceptance_done:
+  sqlite3_free(zErr);
+  sqlite3_free(zEtag);
+  sqlite3_free(zImage);
+  sqlite3_free(zPath);
+  if( bRawOpen && pRaw && pRaw->pMethods ) pRaw->pMethods->xClose(pRaw);
+  sqlite3_free(pRaw);
+  if( bAttached ){
+    char *zDetachErr = 0;
+    int rcDetach = sqlite3_bcvfs_detach_session(
+        pTest->pFs,zAlias,zSessionId,&zDetachErr
+    );
+    if( rcRet==TCL_OK && rcDetach!=SQLITE_OK ){
+      Tcl_SetObjResult(interp,Tcl_NewStringObj(
+          zDetachErr ? zDetachErr : "acceptance detach failed",-1
+      ));
+      rcRet = TCL_ERROR;
+    }
+    sqlite3_free(zDetachErr);
+  }
+  if( rcRet==TCL_OK ) Tcl_ResetResult(interp);
+#undef SESSION_ACCEPTANCE_REQUIRE
+#undef SESSION_ACCEPTANCE_FAIL
+  return rcRet;
+}
