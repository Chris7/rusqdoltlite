+/* Create an expired, otherwise well-formed head and checkpoint pair. The
+** head is intentionally not reachable from a current live session, so GC
+** must sweep both superseded records after validating their envelopes. */
+static int test_bcvfs_session_expired_records(
+  ClientData clientData,
+  Tcl_Interp *interp,
+  int objc,
+  Tcl_Obj *const objv[]
+){
+  const char *zStorage;
+  const char *zAccount;
+  const char *zContainer;
+  const char *zSessionId;
+  const char *zDatabase;
+  const char *zFreshDir;
+  const char *zManifestPath;
+  const char *zPrincipal = "gc-expired-principal";
+  const char *zOperations = "read,write,commit";
+  const char *zHeadEtag = "expired-head-etag";
+  const char *zCheckpointEtag = "expired-checkpoint-etag";
+  unsigned char *aManifest = 0;
+  unsigned char aScope[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aOperation[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aCheckpointHash[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char aZero[SQLITE_BCVFS_SESSION_HASH_BYTES];
+  unsigned char *aBody = 0;
+  unsigned char *aEncoded = 0;
+  char zCheckpointHex[SQLITE_BCVFS_SESSION_HASH_BYTES*2+1];
+  char *zHeadPath = 0;
+  char *zCheckpointPath = 0;
+  char *zHeadName = 0;
+  char *zCheckpointName = 0;
+  FILE *pManifest = 0;
+  char *zErr = 0;
+  sqlite3_bcvfs_session_record record;
+  sqlite3_int64 iNow;
+  int nBody;
+  int nManifest = 0;
+  int nBodyCapacity = 0;
+  long nManifestFile = 0;
+  int nEncoded = 0;
+  int rc = SQLITE_OK;
+  Tcl_Obj *pResult = 0;
+  (void)clientData;
+  if( objc!=10 ){
+    Tcl_WrongNumArgs(
+        interp,2,objv,
+        "VFS MODULE ACCOUNT CONTAINER SESSION_ID DATABASE FRESH_DIR MANIFEST_PATH"
+    );
+    return TCL_ERROR;
+  }
+  zStorage = Tcl_GetString(objv[3]);
+  zAccount = Tcl_GetString(objv[4]);
+  zContainer = Tcl_GetString(objv[5]);
+  zSessionId = Tcl_GetString(objv[6]);
+  zDatabase = Tcl_GetString(objv[7]);
+  zFreshDir = Tcl_GetString(objv[8]);
+  zManifestPath = Tcl_GetString(objv[9]);
+  pManifest = fopen(zManifestPath,"rb");
+  if( pManifest==0 ) rc = SQLITE_CANTOPEN;
+  if( rc==SQLITE_OK ){
+    if( fseek(pManifest,0,SEEK_END)!=0 ) rc = SQLITE_IOERR_READ;
+    else{
+      nManifestFile = ftell(pManifest);
+      if( nManifestFile<=0
+       || nManifestFile>(long)(SQLITE_BCVFS_SESSION_BODY_MAX_BYTES
+                             -24-(int)strlen(zCheckpointEtag))
+       || fseek(pManifest,0,SEEK_SET)!=0
+      ) rc = SQLITE_CORRUPT;
+    }
+  }
+  if( rc==SQLITE_OK ){
+    nManifest = (int)nManifestFile;
+    nBodyCapacity = 24+(int)strlen(zCheckpointEtag)+nManifest;
+    aManifest = (unsigned char*)sqlite3_malloc64((sqlite3_uint64)nManifest);
+    aBody = (unsigned char*)sqlite3_malloc64((sqlite3_uint64)nBodyCapacity);
+    if( aManifest==0 || aBody==0 ) rc = SQLITE_NOMEM;
+  }
+  if( rc==SQLITE_OK
+   && fread(aManifest,1,(size_t)nManifestFile,pManifest)!=(size_t)nManifestFile
+  ) rc = SQLITE_IOERR_READ;
+  if( pManifest && fclose(pManifest)!=0 && rc==SQLITE_OK ) rc = SQLITE_IOERR;
+  pManifest = 0;
+  memset(aOperation,0,sizeof(aOperation));
+  aOperation[0] = 0xE7;
+  memset(aZero,0,sizeof(aZero));
+  if( rc==SQLITE_OK ) rc = sqlite3_bcvfs_session_scope_hash(
+      zStorage,zAccount,zContainer,zPrincipal,zDatabase,zOperations,
+      aScope,&zErr
+  );
+  if( rc==SQLITE_OK ){
+    memset(&record,0,sizeof(record));
+    record.eType = SQLITE_BCVFS_SESSION_CHECKPOINT;
+    record.eState = SQLITE_BCVFS_SESSION_OPEN;
+    record.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+    record.iSequence = 1;
+    iNow = sqlite_timestamp();
+    record.iCreated = iNow-2LL*30*24*60*60*1000;
+    record.iExpires = iNow-30LL*24*60*60*1000;
+    sqlite3_snprintf(sizeof(record.zSessionId),record.zSessionId,"%s",zSessionId);
+    memcpy(record.aScopeHash,aScope,sizeof(aScope));
+    memcpy(record.aOperationId,aOperation,sizeof(aOperation));
+    nBody = bcvfsSessionTestCheckpointBody(
+        aBody,nBodyCapacity,4096,zCheckpointEtag,aManifest,nManifest
+    );
+    if( nBody<=0 ) rc = SQLITE_CORRUPT;
+    if( rc==SQLITE_OK ){
+      record.aBody = aBody;
+      record.nBody = nBody;
+      rc = sqlite3_bcvfs_session_record_encode(
+          &record,&aEncoded,&nEncoded,aCheckpointHash,&zErr
+      );
+    }
+  }
+  if( rc==SQLITE_OK ){
+    hex_encode(aCheckpointHash,sizeof(aCheckpointHash),zCheckpointHex,0);
+    zCheckpointName = sqlite3_mprintf(
+        "bcv-session/v1/checkpoint/%s/%s.bcv",zSessionId,zCheckpointHex
+    );
+    zCheckpointPath = sqlite3_mprintf(
+        "%s/expired-checkpoint.bcv",zFreshDir
+    );
+    if( zCheckpointName==0 || zCheckpointPath==0 ) rc = SQLITE_NOMEM;
+    else rc = test_bcvfs_session_write_binary(
+        zCheckpointPath,aEncoded,nEncoded
+    );
+  }
+  sqlite3_free(aEncoded); aEncoded = 0; nEncoded = 0;
+  if( rc==SQLITE_OK ){
+    memset(&record,0,sizeof(record));
+    record.eType = SQLITE_BCVFS_SESSION_HEAD;
+    record.eState = SQLITE_BCVFS_SESSION_OPEN;
+    record.eOutcome = SQLITE_BCVFS_SESSION_OUTCOME_NONE;
+    record.iSequence = 2;
+    record.iCreated = iNow-2LL*30*24*60*60*1000;
+    record.iExpires = iNow-30LL*24*60*60*1000;
+    sqlite3_snprintf(sizeof(record.zSessionId),record.zSessionId,"%s",zSessionId);
+    memcpy(record.aScopeHash,aScope,sizeof(aScope));
+    memcpy(record.aOperationId,aOperation,sizeof(aOperation));
+    nBody = bcvfsSessionTestHeadBody(
+        aBody,nBodyCapacity,zHeadEtag,aCheckpointHash,aZero
+    );
+    record.aBody = aBody;
+    record.nBody = nBody;
+    rc = sqlite3_bcvfs_session_record_encode(
+        &record,&aEncoded,&nEncoded,aZero,&zErr
+    );
+    if( rc==SQLITE_OK ){
+      zHeadName = sqlite3_mprintf(
+          "bcv-session/v1/head/%s.bcv",zSessionId
+      );
+      zHeadPath = sqlite3_mprintf("%s/expired-head.bcv",zFreshDir);
+      if( zHeadName==0 || zHeadPath==0 ) rc = SQLITE_NOMEM;
+      else rc = test_bcvfs_session_write_binary(zHeadPath,aEncoded,nEncoded);
+    }
+  }
+  if( rc!=SQLITE_OK ){
+    Tcl_SetObjResult(interp,Tcl_ObjPrintf(
+        "could not create expired records rc=%d err=%s",rc,zErr?zErr:"(none)"
+    ));
+    goto session_expired_records_done;
+  }
+  pResult = Tcl_NewListObj(0,0);
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zHeadPath,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zHeadName,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zCheckpointPath,-1));
+  Tcl_ListObjAppendElement(interp,pResult,Tcl_NewStringObj(zCheckpointName,-1));
+  Tcl_SetObjResult(interp,pResult);
+
+session_expired_records_done:
+  sqlite3_free(aManifest);
+  sqlite3_free(aBody);
+  sqlite3_free(aEncoded);
+  sqlite3_free(zHeadPath);
+  sqlite3_free(zCheckpointPath);
+  sqlite3_free(zHeadName);
+  sqlite3_free(zCheckpointName);
+  sqlite3_free(zErr);
+  return rc==SQLITE_OK ? TCL_OK : TCL_ERROR;
+}
