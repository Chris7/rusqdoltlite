+/*
+** sqlite3_bcvfs_create DIR VFSNAME
+*/
+static int test_bcvfs_session_uuid_decode(
+  const char *z,
+  unsigned char aUuid[16]
+){
+  static const int aDash[] = { 8, 13, 18, 23 };
+  int ii = 0;
+  int jj = 0;
+  int kk;
+  if( z==0 || strlen(z)!=36 ) return 0;
+  for(ii=0; ii<36; ){
+    int hi;
+    int lo;
+    for(kk=0; kk<4; kk++){
+      if( ii==aDash[kk] ){
+        if( z[ii]!='-' ) return 0;
+        ii++;
+        break;
+      }
+    }
+    if( ii>=36 ) break;
+    hi = z[ii]>='0' && z[ii]<='9' ? z[ii]-'0'
+       : z[ii]>='a' && z[ii]<='f' ? z[ii]-'a'+10
+       : z[ii]>='A' && z[ii]<='F' ? z[ii]-'A'+10 : -1;
+    ii++;
+    lo = z[ii]>='0' && z[ii]<='9' ? z[ii]-'0'
+       : z[ii]>='a' && z[ii]<='f' ? z[ii]-'a'+10
+       : z[ii]>='A' && z[ii]<='F' ? z[ii]-'A'+10 : -1;
+    ii++;
+    if( hi<0 || lo<0 || jj>=16 ) return 0;
+    aUuid[jj++] = (unsigned char)((hi<<4)|lo);
+  }
+  return jj==16;
+}
