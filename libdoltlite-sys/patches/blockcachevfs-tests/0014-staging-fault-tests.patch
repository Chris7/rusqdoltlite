+/*
+** bcv_test_crash_event EVENT
+**
+** The runtime test patch calls bcv_test_event() at named streaming-write
+** boundaries.  Exiting from that callback is intentional: pending metadata
+** writes are still held by the wrapper and are discarded with the process.
+** Event 1 is after block PUT, event 2 after staged-map xSync, event 3 after
+** slot reuse, and event 4 after manifest PUT.
+*/
+int bcv_test_event(int eEvent){
+  if( eEvent==2 ){
+    /* Remember the staged-map boundary even when the test is waiting for
+    ** event 3. This prevents a generic later xWrite from masquerading as
+    ** slot reuse. */
+    g.bStagedMapSeen = 1;
+    if( g.iCrashAfterSync==-2 && g.nMetadataSync==0 ){
+#if !defined(_WIN32)
+      _exit(250);
+#endif
+    }
+  }
+  if( eEvent==3 && g.iCrashAfterSync==-3 && g.bStagedMapSeen==0 ){
+#if !defined(_WIN32)
+    _exit(251);
+#endif
+  }
+  if( g.iCrashAfterSync<0 && -g.iCrashAfterSync==eEvent ){
+#if !defined(_WIN32)
+    _exit(200+eEvent);
+#endif
+  }
+  return SQLITE_OK;
+}
+
+static int test_bcv_crash_event(
+  ClientData clientData,
+  Tcl_Interp *interp,
+  int objc,
+  Tcl_Obj *const objv[]
+){
+  int eEvent;
+  if( objc!=2 ){
+    Tcl_WrongNumArgs(interp, 1, objv, "EVENT");
+    return TCL_ERROR;
+  }
+  if( Tcl_GetIntFromObj(interp, objv[1], &eEvent) ) return TCL_ERROR;
+  g.iCrashAfterSync = -eEvent;
+  Tcl_SetObjResult(interp, Tcl_NewIntObj(eEvent));
+  return TCL_OK;
+}
