+/*
+** The test wrapper below deliberately makes metadata writes volatile until
+** xSync.  This is a small storage-layer model of power loss: a child that
+** exits without closing its files loses every write that was not covered by
+** an xSync, regardless of the host filesystem's page-cache behaviour.
+*/
+typedef struct BcvTestPending BcvTestPending;
+struct BcvTestPending {
+  int eType;
+  sqlite3_int64 iOfst;
+  sqlite3_int64 nByte;
+  unsigned char *aData;
+  BcvTestPending *pNext;
+};
+
+#define BCV_TEST_PENDING_WRITE    1
+#define BCV_TEST_PENDING_TRUNCATE 2
 
 
