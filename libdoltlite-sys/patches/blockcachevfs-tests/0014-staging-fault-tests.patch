+static int bcvTestIsMetadata(const char *zName){
+  const char *zBase = zName ? strrchr(zName, '/') : 0;
+#ifdef _WIN32
+  const char *zBackslash = zName ? strrchr(zName, '\\') : 0;
+  if( zBase==0 || (zBackslash && zBackslash>zBase) ) zBase = zBackslash;
+#endif
+  zBase = zBase ? &zBase[1] : zName;
+  return zBase && (
+      strcmp(zBase, "blocksdb.bcv")==0
+   || strcmp(zBase, "blocksdb.bcv-journal")==0
+   || strcmp(zBase, "blocksdb.bcv-wal")==0
+  );
+}
+
+static int bcvTestIsCache(const char *zName){
+  const char *zBase = zName ? strrchr(zName, '/') : 0;
+#ifdef _WIN32
+  const char *zBackslash = zName ? strrchr(zName, '\\') : 0;
+  if( zBase==0 || (zBackslash && zBackslash>zBase) ) zBase = zBackslash;
+#endif
+  zBase = zBase ? &zBase[1] : zName;
+  return zBase && strcmp(zBase, "cachefile.bcv")==0;
+}
+
+static void bcvTestPendingFree(BcvTestFile *p){
+  BcvTestPending *pOp = p->pPending;
+  while( pOp ){
+    BcvTestPending *pNext = pOp->pNext;
+    sqlite3_free(pOp);
+    pOp = pNext;
+  }
+  p->pPending = 0;
+}
+
+static int bcvTestPendingWrite(
+  BcvTestFile *p, const void *aData, int nByte, sqlite3_int64 iOfst
+){
+  BcvTestPending *pOp = (BcvTestPending*)sqlite3_malloc(
+      sizeof(BcvTestPending) + (size_t)nByte
+  );
+  if( pOp==0 ) return SQLITE_NOMEM;
+  memset(pOp, 0, sizeof(BcvTestPending));
+  pOp->aData = (unsigned char*)&pOp[1];
+  memcpy(pOp->aData, aData, (size_t)nByte);
+  pOp->eType = BCV_TEST_PENDING_WRITE;
+  pOp->iOfst = iOfst;
+  pOp->nByte = nByte;
+  pOp->pNext = p->pPending;
+  p->pPending = pOp;
+  if( p->nLogical<iOfst+nByte ) p->nLogical = iOfst+nByte;
+  return SQLITE_OK;
+}
+
+static int bcvTestPendingTruncate(BcvTestFile *p, sqlite3_int64 nByte){
+  BcvTestPending *pOp = (BcvTestPending*)sqlite3_malloc(sizeof(BcvTestPending));
+  if( pOp==0 ) return SQLITE_NOMEM;
+  memset(pOp, 0, sizeof(BcvTestPending));
+  pOp->eType = BCV_TEST_PENDING_TRUNCATE;
+  pOp->nByte = nByte;
+  pOp->pNext = p->pPending;
+  p->pPending = pOp;
+  p->nLogical = nByte;
+  return SQLITE_OK;
+}
+
+static int bcvTestFlushPending(BcvTestFile *p){
+  BcvTestPending *pOp;
+  BcvTestPending **apOp = 0;
+  int nOp = 0;
+  int ii;
+  int rc = SQLITE_OK;
+
+  for(pOp=p->pPending; pOp; pOp=pOp->pNext) nOp++;
+  if( nOp==0 ) return SQLITE_OK;
+  apOp = (BcvTestPending**)sqlite3_malloc(sizeof(BcvTestPending*)*nOp);
+  if( apOp==0 ) return SQLITE_NOMEM;
+  for(pOp=p->pPending, ii=nOp-1; pOp; pOp=pOp->pNext, ii--){
+    apOp[ii] = pOp;
+  }
+  for(ii=0; ii<nOp && rc==SQLITE_OK; ii++){
+    pOp = apOp[ii];
+    if( pOp->eType==BCV_TEST_PENDING_WRITE ){
+      rc = p->pReal->pMethods->xWrite(
+          p->pReal, pOp->aData, (int)pOp->nByte, pOp->iOfst
+      );
+    }else{
+      rc = p->pReal->pMethods->xTruncate(p->pReal, pOp->nByte);
+    }
+  }
+  sqlite3_free(apOp);
+  return rc;
+}
+
+static void bcvTestOverlayRead(
+  BcvTestFile *p, void *pBuf, int iAmt, sqlite3_int64 iOfst
+){
+  BcvTestPending *pOp;
+  BcvTestPending **apOp;
+  int nOp = 0;
+  int ii;
+  sqlite3_int64 iEnd = iOfst + iAmt;
+  unsigned char *aOut = (unsigned char*)pBuf;
+  for(pOp=p->pPending; pOp; pOp=pOp->pNext) nOp++;
+  if( nOp==0 ) return;
+  apOp = (BcvTestPending**)sqlite3_malloc(sizeof(BcvTestPending*)*nOp);
+  if( apOp==0 ) return;
+  for(pOp=p->pPending, ii=nOp-1; pOp; pOp=pOp->pNext, ii--){
+    apOp[ii] = pOp;
+  }
+  /* Apply oldest writes first so a later overlapping write wins. */
+  for(ii=0; ii<nOp; ii++){
+    pOp = apOp[ii];
+    sqlite3_int64 iOpEnd;
+    sqlite3_int64 iStart;
+    sqlite3_int64 nCopy;
+    if( pOp->eType!=BCV_TEST_PENDING_WRITE ) continue;
+    iOpEnd = pOp->iOfst + pOp->nByte;
+    iStart = MAX(iOfst, pOp->iOfst);
+    if( iStart>=MIN(iEnd, iOpEnd) ) continue;
+    nCopy = MIN(iEnd, iOpEnd) - iStart;
+    memcpy(
+      &aOut[iStart-iOfst], &pOp->aData[iStart-pOp->iOfst], (size_t)nCopy
+    );
+  }
+  sqlite3_free(apOp);
+}
